<% brand = authentication_branding %>
<section class="auth-story" aria-label="<%= brand.name %>">
  <%= render "authentication/brand" %>
  <div class="auth-story-copy">
    <p class="auth-kicker"><%= brand.text("eyebrow") || (brand.platform? ? "People / Stories / Brighter Together" : "Welcome to #{brand.name}") %></p>
    <h2><%= brand.text("headline") || "Your space." %><br><em><%= brand.text("headline") ? "" : "Your next chapter." %></em></h2>
    <p><%= brand.text("description") || "Create, connect and make yourself at home. Everything you need, in one place." %></p>
  </div>
</section>
