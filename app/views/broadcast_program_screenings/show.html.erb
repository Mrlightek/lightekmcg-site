<% content_for :page_title, @license.title %>
<%= stylesheet_link_tag "/lightek/live/studio.css?v=10" %>
<%= stylesheet_link_tag "/lightek/live/playout.css?v=1" %>
<main class="ll-studio ll-playout">
  <header class="ll-header"><h1><%= @license.title %></h1></header>
  <section class="ll-panel">
    <%= video_tag broadcast_program_screening_video_path(@license.web_screening_key), controls: true, playsinline: true, preload: "metadata", width: "100%" %>
  </section>
</main>
