<section id="cart" class="lt-shop-cart"><h2>Your cart</h2><% @cart.each do |id, quantity| %><% if (product = @products.find { |p| p.id.to_s == id.split(":").first }) %><% variant = id.include?(":") ? product.variants.find_by(id: id.split(":").last) : nil %><p><%= product.name %><%= " / #{variant.name}" if variant %> × <%= quantity %> — <%= number_to_currency((variant&.price_cents || product.price_cents) * quantity.to_i / 100.0) %> <%= button_to "Remove", commerce_cart_remove_path(site_id: @site.id, product_id: id), method: :delete %></p><% end %><% end %><% if @cart.any? %><h3>Secure checkout</h3><%= form_with url: commerce_checkout_path(site_id: @site.id), method: :post do |f| %><%= email_field_tag :customer_email, nil, placeholder: "Email", required: true %><%= f.submit "Continue to secure payment" %><% end %><% end %></section>