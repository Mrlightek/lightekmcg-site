<div id="lightek-cart">
<section id="cart" class="lt-shop-cart"><h2>Your cart</h2>
<%= link_to 'My orders', commerce_account_path(site_id: @site.id) %><% @cart.each do |id, quantity| %><% if (product = @products.find { |p| p.id.to_s == id.split(":").first }) %><% variant = id.include?(":") ? product.variants.find_by(id: id.split(":").last) : nil %><% workspace_seats = Gatekeeper::Hosting::WorkspacePlans.seats_for(product) %>
<% if workspace_seats&.cover?(quantity) %>
  <% total = Gatekeeper::Hosting::WorkspacePlans.monthly_price(starting_price: product.price_cents, seats: quantity, seat_range: workspace_seats) %>
  <p><%= product.name %> · <%= pluralize(quantity, "seat") %> — <%= number_to_currency(total / 100.0) %>
<% else %>
  <p><%= product.name %><%= " / #{variant.name}" if variant %> × <%= quantity %> — <%= number_to_currency(((variant&.price_cents || product.price_cents) * quantity.to_i) / 100.0) %>
<% end %><% if product.billing_interval != "one_time" %>/<%= product.billing_interval %><% end %> <%= button_to "Remove", commerce_cart_remove_path(site_id: @site.id, product_id: id), method: :delete %></p><% end %><% end %><% if @cart.any? && @products.any? { |product| product.product_type == "physical" && @cart.keys.any? { |key| key.split(":").first == product.id.to_s } } %><h3>Delivery address</h3><%= form_with url: commerce_shipping_quotes_path(site_id: @site.id), scope: :recipient, method: :post do |address| %><% {name: "Name", phone: "Phone", street: "Street", city: "City", state: "State", postal_code: "ZIP", country: "Country"}.each do |key, label| %><label><%= label %><%= address.text_field key, value: key == :country ? "US" : nil, required: true %></label><% end %><%= address.submit "Get delivery options" %><% end %><% end %><% if @buyer_fee_cart_error %><p role="status"><%= @buyer_fee_cart_error %></p><% elsif @cart.any? %><h3>Secure checkout</h3>
<%= form_with url: commerce_cart_discount_path(site_id: @site.id), method: :post do %>
  <label>Discount code <%= text_field_tag :discount_code, @discount_code, maxlength: 40 %></label>
  <%= submit_tag 'Apply code' %>
<% end %>
<% if @discount_code %>
  <%= button_to 'Remove discount code', commerce_cart_discount_path(site_id: @site.id), method: :post %>
<% end %>
<% if @discount_error %><p role="alert"><%= @discount_error %></p><% end %>
<% if @discount %><p><%= @discount.name %> · <%= number_to_currency(@discount_cents / 100.0) %> off merchandise</p><% end %>
<% if @buyer_fee_cart %>
<p><strong><%= number_to_currency((@discounted_buyer_price || @buyer_fee_cart.fetch('buyer_cents')) / 100.0) %><%= "/#{@buyer_fee_interval}" unless @buyer_fee_interval == 'one_time' %></strong> before tax · Includes Lightek checkout fees<%= ' · Shipping shown separately' if @cart.keys.any? { |key| @products.any? { |product| product.id.to_s == key.split(':').first && product.product_type == 'physical' } } %></p>
<% end %><%= form_with url: commerce_checkout_path(site_id: @site.id), method: :post do |f| %><%= hidden_field_tag :expected_discount_cents, @discount_cents.to_i %><%= hidden_field_tag :buyer_fee_token, @buyer_fee_token if @buyer_fee_token %><% Array(@shipping_quotes).each do |quote| %><label><%= radio_button_tag :shipping_quote_key, quote.public_key, false, required: true %> <%= quote.service_name %> · <%= number_to_currency(quote.customer_price_cents / 100.0) %><%= " · TEST" if quote.sandbox? %></label><% end %><%= email_field_tag :customer_email, nil, placeholder: "Email", required: true %><%= f.submit(respond_to?(:experiment_text) ? experiment_text("commerce_checkout", "Continue to secure payment") : "Continue to secure payment") %><% end %><% end %></section>
</div>
