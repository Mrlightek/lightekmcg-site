<div id="lightek-cart">
<section id="cart" class="lt-shop-cart"><h2>Your cart</h2><% @cart.each do |id, quantity| %><% if (product = @products.find { |p| p.id.to_s == id.split(":").first }) %><% variant = id.include?(":") ? product.variants.find_by(id: id.split(":").last) : nil %><p><%= product.name %><%= " / #{variant.name}" if variant %> × <%= quantity %> — <%= number_to_currency((variant&.price_cents || product.price_cents) * quantity.to_i / 100.0) %><% if product.billing_interval != "one_time" %>/<%= product.billing_interval %><% end %> <%= button_to "Remove", commerce_cart_remove_path(site_id: @site.id, product_id: id), method: :delete %></p><% end %><% end %><% if @cart.any? && @products.any? { |product| product.product_type == "physical" && @cart.keys.any? { |key| key.split(":").first == product.id.to_s } } %><h3>Delivery address</h3><%= form_with url: commerce_shipping_quotes_path(site_id: @site.id), scope: :recipient, method: :post do |address| %><% {name: "Name", phone: "Phone", street: "Street", city: "City", state: "State", postal_code: "ZIP", country: "Country"}.each do |key, label| %><label><%= label %><%= address.text_field key, value: key == :country ? "US" : nil, required: true %></label><% end %><%= address.submit "Get delivery options" %><% end %><% end %><% if @cart.any? %><h3>Secure checkout</h3><%= form_with url: commerce_checkout_path(site_id: @site.id), method: :post do |f| %><% Array(@shipping_quotes).each do |quote| %><label><%= radio_button_tag :shipping_quote_key, quote.public_key, false, required: true %> <%= quote.service_name %> · <%= number_to_currency(quote.customer_price_cents / 100.0) %><%= " · TEST" if quote.sandbox? %></label><% end %><%= email_field_tag :customer_email, nil, placeholder: "Email", required: true %><%= f.submit "Continue to secure payment" %><% end %><% end %></section>
</div>
