<div id="lightek-cart">
<section id="cart" class="lt-shop-cart"><h2>Your cart</h2>
<%= link_to 'My orders', commerce_account_path(site_id: @site.id) %>
<% if @gift_cards_redeemable && authenticated? %>
  <details>
    <summary>Check a gift card balance</summary>
    <%= form_with url: commerce_gift_card_balance_path(site_id: @site.id), method: :post, local: true do %>
      <label>Gift card code <%= password_field_tag :gift_code, nil, id: 'gift-balance-code', maxlength: 40, autocomplete: 'off', required: true %></label>
      <%= submit_tag 'Check balance' %>
    <% end %>
  </details>
<% end %>
<% if @gift_cards_enabled %>
  <details>
    <summary>Buy a gift card</summary>
    <% if authenticated? %>
      <%= form_with url: commerce_buy_gift_card_path(site_id: @site.id), method: :post, local: true do %>
        <label>Gift card amount <%= select_tag :denomination, options_for_select(LightekCommerce::GiftCards::DENOMINATIONS.map { |amount| [number_to_currency(amount / 100.0), amount] }) %></label>
        <label>Recipient email <%= email_field_tag :gift_recipient_email, nil, maxlength: 254, placeholder: 'Your account email if blank' %></label>
        <label>Delivery date <%= date_field_tag :gift_delivery_date, nil, min: Date.current, max: Date.current + LightekCommerce::GiftDelivery::MAX_SCHEDULE_DAYS %></label>
        <p>Leave the date blank to send after payment. Scheduled gifts are sent at 9 a.m. <%= Time.zone.name %>.</p>
        <%= submit_tag 'Buy gift card' %>
      <% end %>
    <% else %>
      <%= link_to 'Sign in to buy a gift card', commerce_account_path(site_id: @site.id) %>
    <% end %>
  </details>
<% end %><% @cart.each do |id, quantity| %><% if (product = @products.find { |p| p.id.to_s == id.split(":").first }) %><% variant = id.include?(":") ? product.variants.find_by(id: id.split(":").last) : nil %><% workspace_seats = Gatekeeper::Hosting::WorkspacePlans.seats_for(product) %>
<% if workspace_seats&.cover?(quantity) %>
  <% total = Gatekeeper::Hosting::WorkspacePlans.monthly_price(starting_price: product.price_cents, seats: quantity, seat_range: workspace_seats) %>
  <p><%= product.name %> · <%= pluralize(quantity, "seat") %> — <%= number_to_currency(total / 100.0) %>
<% else %>
  <p><%= product.name %><%= " / #{variant.name}" if variant %> × <%= quantity %> — <%= number_to_currency(((variant&.price_cents || product.price_cents) * quantity.to_i) / 100.0) %>
<% end %><% if product.billing_interval != "one_time" %>/<%= product.billing_interval %><% end %> <%= button_to "Remove", commerce_cart_remove_path(site_id: @site.id, product_id: id), method: :delete %></p><% end %><% end %><% if @cart.any? && @products.any? { |product| product.product_type == "physical" && @cart.keys.any? { |key| key.split(":").first == product.id.to_s } } %><h3>Delivery address</h3><%= form_with url: commerce_shipping_quotes_path(site_id: @site.id), scope: :recipient, method: :post do |address| %><% {name: "Name", phone: "Phone", street: "Street", city: "City", state: "State", postal_code: "ZIP", country: "Country"}.each do |key, label| %><label><%= label %><%= address.text_field key, value: key == :country ? "US" : nil, required: true %></label><% end %><%= address.submit "Get delivery options" %><% end %><% end %><% if @buyer_fee_cart_error %><p role="status"><%= @buyer_fee_cart_error %></p><% elsif @cart.any? %><h3>Secure checkout</h3>
<%= form_with url: commerce_cart_discount_path(site_id: @site.id), method: :post do %>
  <label>Discount code <%= text_field_tag :discount_code, nil, maxlength: 40, required: true %></label>
  <%= submit_tag 'Apply code' %>
<% end %>
<% Array(@discount_codes).each do |code| %>
  <%= button_to "Remove #{code}", commerce_cart_discount_path(site_id: @site.id), method: :post, params: {remove_discount: code} %>
<% end %>
<% if @shipping_code_enabled %>
  <% if @shipping_code_applied %>
    <p>Shipping code applied. Free shipping appears on eligible delivery options.</p>
    <%= button_to 'Remove shipping code', commerce_cart_discount_path(site_id: @site.id), method: :post, params: {remove_shipping_code: '1'} %>
  <% else %>
    <%= form_with url: commerce_cart_discount_path(site_id: @site.id), method: :post do %>
      <label>Shipping code <%= text_field_tag :shipping_discount_code, nil, maxlength: 40, required: true %></label>
      <%= submit_tag 'Apply shipping code' %>
    <% end %>
  <% end %>
<% end %>
<% if @discount_error %><p role="alert"><%= @discount_error %></p><% end %>
<% if @discount %>
  <ul aria-label="Applied discounts">
    <% @discount.entries.each do |rule, amount| %>
      <li><%= rule.name %> · <%= number_to_currency(amount / 100.0) %> off merchandise</li>
    <% end %>
  </ul>
<% end %>
<% if @buyer_fee_cart %>
<p><strong><%= number_to_currency((@discounted_buyer_price || @buyer_fee_cart.fetch('buyer_cents')) / 100.0) %><%= "/#{@buyer_fee_interval}" unless @buyer_fee_interval == 'one_time' %></strong> before tax · Includes Lightek checkout fees<%= ' · Shipping shown separately' if @cart.keys.any? { |key| @products.any? { |product| product.id.to_s == key.split(':').first && product.product_type == 'physical' } } %></p>
<% end %><%= form_with url: commerce_checkout_path(site_id: @site.id), method: :post do |f| %><%= hidden_field_tag :expected_discount_cents, @discount_cents.to_i %><%= hidden_field_tag :discount_review_token, @discount_review_token if @discount_review_token %><%= hidden_field_tag :buyer_fee_token, @buyer_fee_token if @buyer_fee_token %><% Array(@shipping_quotes).each do |quote| %>
  <% review = @shipping_promotions&.fetch(quote.id, nil) %>
  <% if review %><%= hidden_field_tag "shipping_reviews[#{quote.public_key}]", review, id: nil %><% end %>
  <label>
    <%= radio_button_tag :shipping_quote_key, quote.public_key, false, required: true %>
    <%= quote.service_name %> · <%= review ? 'Free shipping' : number_to_currency(quote.customer_price_cents / 100.0) %><%= ' · TEST' if quote.sandbox? %>
  </label>
<% end %><%= email_field_tag :customer_email, nil, placeholder: "Email", required: true %><% if @gift_cards_redeemable %>
  <details>
    <summary>Use a gift card</summary>
    <label>Gift card code <%= password_field_tag :gift_code, nil, maxlength: 40, autocomplete: 'off' %></label>
    <p>Enter your billing address for digital items and services. Physical items use the selected shipping quote.</p>
    <% {line1: 'Street', city: 'City', state: 'State', postal_code: 'ZIP code'}.each do |key, label| %>
      <label><%= label %> <%= text_field_tag "gift_address[#{key}]", nil, maxlength: 120 %></label>
    <% end %>
    <%= hidden_field_tag 'gift_address[country]', 'US' %>
  </details>
<% end %>
<%= f.submit(respond_to?(:experiment_text) ? experiment_text("commerce_checkout", "Continue to secure payment") : "Continue to secure payment") %><% end %><% end %></section>
</div>
