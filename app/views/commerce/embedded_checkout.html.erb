<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<% content_for :title, "Checkout · #{@site.name}" %>
<main class="auth-shell">
  <section class="auth-story">
    <div class="auth-story-copy">
      <h2><%= @site.name %></h2>
      <%= link_to 'Back to the store', commerce_shop_path(site_id: @site.id), class: 'auth-link' %>
    </div>
  </section>
  <section class="auth-panel">
    <div class="auth-card" data-embedded-checkout data-turbo="false"
      data-publishable-key="<%= @publishable_key %>" data-checkout-secret="<%= @checkout.client_secret %>"
      data-completion-url="<%= @completion_url %>">
      <h1>Checkout</h1>
      <p role="status" data-checkout-status aria-live="polite">Loading secure checkout…</p>
      <div data-checkout-form></div>
      <noscript>Turn on JavaScript to use secure checkout, then reload this page.</noscript>
    </div>
  </section>
</main>
<%= javascript_include_tag 'https://js.stripe.com/dahlia/stripe.js', defer: true, 'data-turbo-track': 'reload' %>
<%= javascript_include_tag '/lightek/embedded-commerce-checkout.js', defer: true, 'data-turbo-track': 'reload' %>
