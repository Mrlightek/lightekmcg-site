<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<% content_for :title, "Gift card checkout · #{@site.name}" %>
<main class="auth-shell">
  <section class="auth-story"><div class="auth-story-copy">
    <h2><%= @appearance&.dig('brand_name') || @site.name %></h2>
    <%= link_to 'Back to store', commerce_shop_path(site_id: @site.id), class: 'auth-link' %>
  </div></section>
  <section class="auth-panel">
    <div class="auth-card">
      <h1><%= @appearance&.dig('checkout_title') || 'Checkout' %></h1>
      <% if @appearance&.dig('checkout_message') %><p><%= @appearance['checkout_message'] %></p><% end %>
      <dl>
        <dt>Order total</dt><dd><%= number_to_currency(@checkout.total_cents / 100.0) %></dd>
        <dt>Gift card</dt><dd><%= number_to_currency(@checkout.gift_cents / 100.0) %></dd>
        <dt>Due by card</dt><dd><%= number_to_currency(@checkout.cash_cents / 100.0) %></dd>
      </dl>
      <% if @checkout.cash_cents.zero? %>
        <%= button_to 'Pay with gift card', commerce_confirm_gift_payment_path(site_id: @site.id, order_id: @payment_order.id), class: 'auth-button' %>
      <% else %>
      <form data-gift-payment data-turbo="false" data-publishable-key="<%= @publishable_key %>"
        data-client-secret="<%= @checkout.client_secret %>" data-return-url="<%= @completion_url %>">
        <div data-payment-element></div>
        <p role="status" aria-live="polite" data-payment-result>Loading secure payment…</p>
        <button class="auth-button" type="submit" disabled>Pay remaining balance</button>
      </form>
      <% end %>
      <%= button_to 'Cancel payment', commerce_cancel_gift_payment_path(site_id: @site.id, order_id: @payment_order.id), class: 'auth-link' %>
    </div>
  </section>
</main>
<% if @checkout.cash_cents.positive? %>
<%= javascript_include_tag 'https://js.stripe.com/dahlia/stripe.js', defer: true %>
<%= javascript_include_tag '/lightek/gift-card-payment.js', defer: true %>
<% end %>
