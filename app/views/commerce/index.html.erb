<main class="lt-commerce"><h1><%= @site.name %> · Shop</h1><div class="lt-commerce-grid"><% @products.each do |product| %><article><h2><%= product.name %></h2><p><%= product.description %></p><strong><%= number_to_currency(product.price_cents / 100.0) %></strong><p><%= product.inventory_quantity > 0 ? "Available: #{product.inventory_quantity}" : "Out of stock" %></p><% if product.inventory_quantity > 0 %><%= form_with url: commerce_cart_add_path(site_id: @site.id), method: :post do |f| %><%= hidden_field_tag :product_id, product.id %><%= number_field_tag :quantity, 1, min: 1, max: [100, product.inventory_quantity].min %><%= f.submit "Add to cart" %><% end %><% end %></article><% end %></div><section><h2>Your cart</h2><% @cart.each do |id, quantity| %><% if (product = @products.find { |p| p.id.to_s == id }) %><p><%= product.name %> × <%= quantity %> — <%= number_to_currency(product.price_cents * quantity.to_i / 100.0) %> <%= button_to "Remove", commerce_cart_remove_path(site_id: @site.id, product_id: id), method: :delete %></p><% end %><% end %><% if @cart.any? %><h3>Secure checkout</h3><%= form_with url: commerce_checkout_path(site_id: @site.id), method: :post do |f| %><%= email_field_tag :customer_email, nil, placeholder: "Email", required: true %><%= f.submit "Continue to secure payment" %><% end %><% end %></section></main>
