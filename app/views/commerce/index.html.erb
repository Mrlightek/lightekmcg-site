<main class="lt-commerce"><h1><%= @site.name %> · Shop</h1><div class="lt-commerce-grid"><% @products.each do |product| %><article><% if product.photos.attached? %><%= image_tag product.photos.first.variant(resize_to_limit: [640,480]), alt: product.name, loading: "lazy", style: "width:100%;max-width:320px;aspect-ratio:4/3;object-fit:cover;border-radius:12px" %><% elsif product.image_url.present? %><%= image_tag product.image_url, alt: product.name, loading: "lazy", style: "width:100%;max-width:320px;aspect-ratio:4/3;object-fit:cover;border-radius:12px" %><% end %><h2><%= product.name %></h2><% if product.short_description.present? %><p><strong><%= product.short_description %></strong></p><% end %><p><%= product.description %></p><strong><%= number_to_currency(product.price_cents / 100.0) %></strong><% if product.compare_at_cents.to_i > product.price_cents %> <del><%= number_to_currency(product.compare_at_cents / 100.0) %></del><% end %><p><%= product.inventory_quantity > 0 ? "Available: #{product.inventory_quantity}" : "Out of stock" %></p><% if product.inventory_quantity > 0 || product.variants.where(active: true).where("inventory_quantity > 0").exists? %><%= form_with url: commerce_cart_add_path(site_id: @site.id), method: :post do |f| %><%= hidden_field_tag :product_id, product.id %><% if product.variants.where(active: true).exists? %><%= select_tag :variant_id, options_from_collection_for_select(product.variants.where(active: true,).where("inventory_quantity > 0"), :id, :name), prompt: "Select an option", required: true %><% end %><%= number_field_tag :quantity, 1, min: 1, max: 100 %><%= f.submit "Add to cart" %><% end %><% end %></article><% end %></div><section><h2>Your cart</h2><% @cart.each do |id, quantity| %><% if (product = @products.find { |p| p.id.to_s == id.split(":").first }) %><% variant = id.include?(":") ? product.variants.find_by(id: id.split(":").last) : nil %><p><%= product.name %><%= " / #{variant.name}" if variant %> × <%= quantity %> — <%= number_to_currency((variant&.price_cents || product.price_cents) * quantity.to_i / 100.0) %> <%= button_to "Remove", commerce_cart_remove_path(site_id: @site.id, product_id: id), method: :delete %></p><% end %><% end %><% if @cart.any? %><h3>Secure checkout</h3><%= form_with url: commerce_checkout_path(site_id: @site.id), method: :post do |f| %><%= email_field_tag :customer_email, nil, placeholder: "Email", required: true %><%= f.submit "Continue to secure payment" %><% end %><% end %></section><section><h2>Stay connected</h2><p>Subscribe for optional updates. We will email you to confirm.</p><%= form_with url: marketing_subscribe_path(site_id: @site.id), method: :post do %><%= email_field_tag :email, nil, placeholder: "Your email", required: true %><%= submit_tag "Request subscription" %><% end %></section></main>
