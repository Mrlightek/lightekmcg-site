<section class="lp-card"><h2>Bookkeeping bank accounts</h2><p>These are accounting records. Actual bank connections, payouts and subscriptions continue through Dymond Bank.</p><div class="lp-departments"><% @accounts.each do |account| %><article><h3><%= account.name %></h3><p>Opening <%= account.opening_on %> · <%= accounting_money(account.data['opening_cents']) %></p><% if account.data['last_four'].present? %><small>Ending <%= account.data['last_four'] %></small><% end %></article><% end %></div></section><% if @can_write %><section class="lp-card"><h2>Add bank account</h2><%= form_with url: dashboard_accounting_accounts_path(employer_id: @employer.id,book_id: @book.id),scope: :account,class: 'lp-form' do |f| %><label>Account label<%= f.text_field :name,required: true,placeholder: 'Business checking' %></label><div class="lp-grid"><label>Opening balance date<%= f.date_field :opening_on,required: true %></label><label>Opening balance (USD)<%= f.number_field :opening_amount,step: '0.01',required: true,value: '0.00' %></label></div><label>Last four digits · optional<%= f.text_field :last_four,maxlength: 4,pattern: '[0-9]{4}' %></label><%= f.submit 'Add bookkeeping account',class: 'lp-button' %><% end %></section><% end %>
