<section class="lp-card"><h2>Accounting audit trail</h2><p>Actor, action, record identity and encrypted proof digest are recorded without copying financial details into logs.</p><div class="lp-table-wrap"><table><thead><tr><th>When</th><th>Person</th><th>Action</th><th>Record</th><th>Proof digest</th></tr></thead><tbody><% @audit_events.each do |event| %><tr><td><%= event.created_at %></td><td><%= event.actor.full_name %></td><td><%= event.action.humanize %></td><td><%= event.record_type.demodulize %> #<%= event.record_id %></td><td><code><%= event.proof_digest&.first(16) %></code></td></tr><% end %></tbody></table></div></section>
