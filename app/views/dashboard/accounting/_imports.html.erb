<section class="lp-card"><h2>Import bank statement</h2><p>Drop or choose CSV, TSV, TXT, OFX or QFX, or paste delimited text. Map columns and preview before the worker records transactions. Source files and financial content are encrypted with Vault’s envelope encryption.</p><% if @can_write %><%= form_with url: dashboard_accounting_imports_path(employer_id: @employer.id,book_id: @book.id),multipart: true,class: 'lp-form' do |f| %><label>Destination account<%= f.select :bank_account_id,@accounts.map { |a| [a.name,a.id] },{},required: true %></label><label>Statement file · up to 5 MB<%= f.file_field :file,accept: '.csv,.tsv,.txt,.ofx,.qfx' %></label><label>Or paste statement text<%= f.text_area :pasted_statement,rows: 5 %></label><%= f.submit 'Upload & preview',class: 'lp-button' %><% end %><% end %></section><nav class="lp-runs" aria-label="Recent imports"><% @imports.each do |record| %><%= link_to "Import #{record.id} · #{record.status.humanize}",accounting_path(tab: 'imports',import_id: record.id) %><% end %></nav>
<% if @import %><% data=@import.data %><section class="lp-card"><div class="lp-section"><div><h2>Statement preview</h2><p><%= @import.bank_account.name %> · <%= @import.status.humanize %> · <%= data['preview'].size %> mapped rows</p></div></div><% if data['error'] %><p role="alert"><%= data['error'] %></p><% end %><% if @can_write && @import.status == 'preview' %><%= form_with url: map_dashboard_accounting_import_path(@import,employer_id: @employer.id,book_id: @book.id),scope: :mapping,class: 'lp-form' do |f| %><div class="lp-grid"><% [['date','Posted date'],['description','Description'],['memo','Memo (optional)'],['amount','Signed amount'],['credit','Deposit amount'],['debit','Withdrawal amount'],['reference','Bank reference / FITID (optional)']].each do |key,label| %><label><%= label %><%= f.select key, data['headers'].each_with_index.map { |name,index| ["#{name} · column #{index + 1}",index.to_s] },include_blank: 'Not mapped',selected: data['mapping'][key] %></label><% end %><label>Date format<%= f.select :date_format,[['Year-month-day','iso'],['Month/day/year','mdy'],['Day/month/year','dmy'],['OFX date','ofx']],selected: data['mapping']['date_format'] %></label><label>Amount format<%= f.select :mode,[['Signed amount: deposits positive','signed'],['Signed amount: withdrawals positive','debits_positive'],['Separate deposits and withdrawals','split']],selected: data['mapping']['mode'] %></label></div><%= f.submit 'Validate mapping & preview',class: 'lp-button secondary' %><% end %><% end %><div class="lp-table-wrap"><table><thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Bank reference</th></tr></thead><tbody><% data['preview'].first(100).each do |row| %><tr><td><%= row['date'] %></td><td><%= row['description'] %></td><td><%= accounting_money(row['amount_cents']) %></td><td><%= row['reference'] %></td></tr><% end %></tbody></table></div><p>Showing up to 100 preview rows. All validated rows are processed together.</p><% if @can_write && %w[preview failed].include?(@import.status) && data['preview'].any? %><%= form_with url: commit_dashboard_accounting_import_path(@import,employer_id: @employer.id,book_id: @book.id),class: 'lp-form' do |f| %><label class="lp-check"><%= check_box_tag :accept_duplicates,'1',false %> I reviewed repeated dates, amounts and descriptions and authorize possible duplicate CSV rows. Exact source rows and matching bank references remain deduplicated.</label><%= f.submit 'Commit reviewed statement',class: 'lp-button' %><% end %><% end %></section><% end %>
