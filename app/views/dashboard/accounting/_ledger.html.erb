<section class="lp-card"><div class="lp-section"><div><h2>Transaction ledger</h2><p>Search the latest 500 matching rows. Narrow by account and dates for older records.</p></div><span class="lp-badge"><%= pluralize(@transactions.size,'transaction') %></span></div><%= form_with url: dashboard_accounting_path, method: :get, class: 'lp-form' do |f| %><%= hidden_field_tag :employer_id,@employer.id %><%= hidden_field_tag :book_id,@book.id %><div class="lp-grid"><label>Search description<%= f.search_field :q, value: params[:q] %></label><label>Bank account<%= f.select :account_id, @accounts.map { |a| [a.name,a.id] }, include_blank: 'All accounts', selected: params[:account_id] %></label><label>From<%= f.date_field :first, value: params[:first] %></label><label>Through<%= f.date_field :last, value: params[:last] %></label></div><%= f.submit 'Filter ledger', class: 'lp-button secondary' %><% end %><%= form_with url: dashboard_accounting_categorize_path(employer_id: @employer.id,book_id: @book.id) do |f| %><div class="lp-table-wrap"><table><thead><tr><th>Select</th><th>Date</th><th>Description</th><th>Account</th><th>Amount</th><th>Category</th><th>Cleared</th></tr></thead><tbody><% @transactions.each do |row| %><tr><td><%= check_box_tag 'transaction_ids[]',row.id,false,disabled: !@can_write,aria: {label: "Select transaction dated #{row.posted_on}"} %></td><td><%= row.posted_on %></td><td><%= row.data['description'] %></td><td><%= row.bank_account.name %></td><td><%= accounting_money(row.amount_cents) %></td><td><%= row.category&.name || 'Uncategorized' %></td><td><%= row.reconciliation_id ? 'Reconciled' : 'Uncleared' %></td></tr><% end %></tbody></table></div><% if @can_write %><div class="lp-actions"><label>Category for selected rows<%= select_tag :category_id, options_from_collection_for_select(@categories,:id,:name), required: true %></label><%= f.submit 'Categorize selected',class: 'lp-button secondary' %></div><% end %><% end %></section><% if @can_write %><section class="lp-card"><details><summary>Add a manual transaction or correcting entry</summary><p>Deposits are positive; withdrawals are negative. Posted financial values stay immutable.</p><%= form_with url: dashboard_accounting_transactions_path(employer_id: @employer.id,book_id: @book.id), scope: :entry, class: 'lp-form' do |f| %><div class="lp-grid"><label>Account<%= f.select :bank_account_id,@accounts.map { |a| [a.name,a.id] },{},required: true %></label><label>Posted date<%= f.date_field :posted_on, required: true %></label><label>Amount (USD)<%= f.number_field :amount,step: '0.01',required: true %></label><label>Category<%= f.select :category_id,@categories.map { |c| [c.name,c.id] },include_blank: 'Uncategorized' %></label></div><label>Description<%= f.text_field :description,required: true,maxlength: 2000 %></label><%= f.submit 'Record transaction',class: 'lp-button' %><% end %></details></section>
<% end %>