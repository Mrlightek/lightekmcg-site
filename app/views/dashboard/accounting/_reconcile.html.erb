<section class="lp-card"><h2>Bank reconciliation</h2><p>Start with the account’s opening balance date, then reconcile consecutive periods. Earlier uncleared checks and deposits can clear in the current statement. Both proofs must reach zero before finalization.</p><%= form_with url: dashboard_accounting_path,method: :get,class: 'lp-form' do |f| %><%= hidden_field_tag :employer_id,@employer.id %><%= hidden_field_tag :book_id,@book.id %><%= hidden_field_tag :tab,'reconcile' %><label>Account<%= f.select :account_id,@accounts.map { |a| [a.name,a.id] },selected: @reconcile_account&.id %></label><%= f.submit 'Choose account',class: 'lp-button secondary' %><% end %></section>
<% if @reconcile_account %><section class="lp-card"><h2><%= @reconcile_account.name %> · statement proof</h2><% if @proof %><div class="lp-departments"><article role="status"><h3>Cleared movement difference</h3><strong><%= accounting_money(@proof['cleared_difference_cents']) %></strong></article><article role="status"><h3>Adjusted statement / book difference</h3><strong><%= accounting_money(@proof['book_difference_cents']) %></strong></article><article><h3>Outstanding checks</h3><strong><%= accounting_money(@proof['outstanding_checks_cents']) %></strong></article><article><h3>Deposits in transit</h3><strong><%= accounting_money(@proof['deposits_in_transit_cents']) %></strong></article></div><p role="alert"><%= @proof['cleared_difference_cents'].zero? && @proof['book_difference_cents'].zero? ? 'Both proofs balance. Review the selection before finalizing.' : 'Discrepancy detected. Review statement balances and cleared transactions.' %></p><% end %><%= form_with url: dashboard_accounting_reconcile_path(employer_id: @employer.id,book_id: @book.id),data: {accounting_reconciliation: true} do |f| %><%= hidden_field_tag :bank_account_id,@reconcile_account.id %><div class="lp-form lp-grid"><label>Statement starts<%= f.date_field :starts_on,value: params[:starts_on].presence || @prior_reconciliation&.ends_on&.next_day || @reconcile_account.opening_on,required: true %></label><label>Statement ends<%= f.date_field :ends_on,value: params[:ends_on].presence || Date.current.end_of_month,required: true %></label><label>Statement starting balance (USD)<%= f.number_field :starting_amount,step: '0.01',value: params[:starting_amount].presence || BigDecimal((@prior_reconciliation&.data&.fetch('ending_cents') || @reconcile_account.data['opening_cents']).to_s)/100,required: true %></label><label>Statement ending balance (USD)<%= f.number_field :ending_amount,step: '0.01',value: params[:ending_amount],required: true %></label></div><div class="lp-table-wrap"><table><thead><tr><th>Cleared on statement</th><th>Date</th><th>Description</th><th>Amount</th></tr></thead><tbody><% @uncleared.each do |row| %><tr><td><%= check_box_tag 'selected[]',row.id,Array(params[:selected]).include?(row.id.to_s),aria: {label: "Clear #{row.posted_on} transaction"} %></td><td><%= row.posted_on %></td><td><%= row.data['description'] %></td><td><%= accounting_money(row.amount_cents) %></td></tr><% end %></tbody></table></div><p>Up to 1,000 uncleared entries shown. Select only items cleared by this statement’s ending date.</p><p data-reconciliation-feedback role="status" aria-live="polite">Live proof updates as balances and cleared items change.</p><div class="lp-actions"><%= f.button 'Check live proof',name: :finalize,value: '0',class: 'lp-button secondary' %><%= f.button 'Prove & finalize',name: :finalize,value: '1',class: 'lp-button' if @can_review %></div><% end %></section><% end %>
<section class="lp-card"><h2>Reconciliation history</h2><% @reconciliations.each do |record| %><article class="lp-election"><div><strong><%= record.bank_account.name %> · <%= record.starts_on %> – <%= record.ends_on %></strong><p><%= record.status.humanize %> · ending <%= accounting_money(record.data['ending_cents']) %></p></div><% if @can_review && record.status == 'final' %><%= button_to 'Reopen latest period',reopen_dashboard_accounting_reconciliation_path(record,employer_id: @employer.id,book_id: @book.id),class: 'lp-button secondary' %><% end %></article><% end %></section>

<%= javascript_include_tag "/lightek/accounting-live.js",defer: true %>
