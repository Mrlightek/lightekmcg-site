<% content_for :page_title, 'Books & accounting' %><%= stylesheet_link_tag '/lightek/people-workspace.css?v=20261113' %><main class="lp-workspace"><header class="lp-heading"><div><span class="lp-eyebrow">DYMOND BANK / ACCOUNTING</span><h1>Books & accounting</h1><p>Import statements, organize your ledger, prove reconciliations and prepare financial workpapers.</p></div><% if @book %><%= link_to 'Export ledger', dashboard_accounting_export_path(employer_id: @employer.id,book_id: @book.id), class: 'lp-button secondary' %><% end %></header><%= form_with url: dashboard_accounting_path, method: :get, class: 'lp-form' do |f| %><div class="lp-grid"><label>Employer<%= f.select :employer_id, @employers.map { |e| [e.email_address,e.id] }, selected: @employer.id %></label><label>Book<%= f.select :book_id, @books.map { |b| [b.name,b.id] }, include_blank: 'Choose a book', selected: @book&.id %></label></div><%= f.submit 'Open workspace', class: 'lp-button secondary' %><% end %><% if @can_admin %><details class="lp-card"><summary>Create a business book</summary><%= form_with url: dashboard_accounting_books_path(employer_id: @employer.id), scope: :book, class: 'lp-form' do |f| %><label>Business / book name<%= f.text_field :name, required: true, maxlength: 150 %></label><label>Business time zone<%= f.select :timezone, ActiveSupport::TimeZone.all.map { |z| [z.tzinfo.name,z.tzinfo.name] }.uniq, selected: 'America/New_York' %></label><%= f.submit 'Create book', class: 'lp-button' %><% end %></details><% end %>
<% if @book %><nav class="lp-tabs" aria-label="Accounting workspace"><% [['ledger','Ledger'],['imports','Statement imports'],['reconcile','Reconciliation'],['reports','P&L & tax reserves'],['workbooks','Spreadsheet systems'],['rules','Categories & rules'],['accounts','Bank accounts'],['audit','Audit trail']].each do |key,label| %><%= link_to label, accounting_path(tab: key), aria: {current: @tab == key ? 'page' : nil} %><% end %></nav><%= render(@tab.in?(%w[ledger imports reconcile reports workbooks rules accounts audit]) ? @tab : 'ledger') %><% else %><section class="lp-card"><h2>Create your first book</h2><p>Start with a business book, then add its bank accounts and opening balances. Imported records remain private accounting data and do not create spendable Dymond Bank balances.</p></section><% end %></main>
