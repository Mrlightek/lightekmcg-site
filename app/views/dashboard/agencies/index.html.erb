<% content_for :page_title, "Agency workspace" %><%= render "dashboard/infrastructure/styles" %>
<main class="infra"><header class="infra-hero"><div><span class="infra-eyebrow">Agency / White label</span><h1>Your brand. Your clients.</h1><p>Manage your agency identity, client accounts, websites and commerce.</p></div><%= link_to "Hosting plans", hosting_dashboard_servers_path, class: "infra-button infra-button-primary" %></header>
<section class="infra-panel"><h2>Enable a white label account</h2><%= form_with url: dashboard_agencies_path, class: "infra-form" do |f| %><div class="infra-fields"><div class="infra-field"><%= f.label :user_id, "Existing client account" %><%= f.collection_select :user_id, (current_user.role == "super_admin" ? User.where(role: "client") : current_user.agency_clients.where(role: "client")).order(:email_address), :id, :email_address %></div><div class="infra-field"><%= f.label :brand_name %><%= f.text_field :brand_name, required: true %></div></div><%= f.submit "Enable agency", class: "infra-button" %><% end %></section>
<% @agencies.each do |agency| %><section class="infra-panel"><h2><%= agency.agency_profile&.brand_name || agency.email_address %></h2><p><%= agency.email_address %></p><%= form_with scope: :agency_profile, url: dashboard_agency_path(agency), method: :patch, class: "infra-form" do |f| %><div class="infra-fields"><% [:brand_name, :logo_url, :support_email, :accent_color].each do |field| %><div class="infra-field"><%= f.label field %><%= f.text_field field, value: agency.agency_profile&.public_send(field), required: field == :brand_name %></div><% end %></div><%= f.submit "Save branding", class: "infra-button" %><% end %>
<% if current_user.role == "super_admin" || agency.agency_id == current_user.id %><%= form_with url: update_terms_dashboard_agency_path(agency), method: :patch, class: "infra-form" do |f| %><div class="infra-field"><%= f.label :upstream_share_bps, "Upstream share on this account and its descendants' sales (basis points; 500 = 5%)" %><%= f.number_field :upstream_share_bps, value: agency.upstream_share_bps, min: 0, max: 10000, required: true %><small>Recipient: <%= agency.agency&.email_address || "No upstream account" %>. Applies to merchandise subtotal, excluding tax and shipping. Hosting prices are separate.</small></div><%= f.submit "Save sale revenue terms", class: "infra-button" %><% end %><% end %>
<h3>Direct subaccounts</h3><% agency.agency_clients.order(:email_address).each do |client| %><p><%= client.full_name %> · <%= client.email_address %></p><% if client.password_setup_required? %><%= button_to "Send setup invitation", send_setup_invitation_dashboard_agency_path(agency), params: {client_id: client.id}, method: :post, class: "infra-button" %><% end %><% end %><%= form_with scope: :client, url: create_client_dashboard_agency_path(agency), class: "infra-form" do |f| %><div class="infra-fields"><% [:first_name, :last_name, :email_address].each do |field| %><div class="infra-field"><%= f.label field %><%= f.text_field field, required: true %></div><% end %></div><%= f.submit "Create client account", class: "infra-button" %><% end %></section><% end %></main>
