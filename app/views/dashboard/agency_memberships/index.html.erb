<main class="lt-settings"><h1>Agency access · <%= @site.name %></h1><p>Grant a registered teammate delegated access to this website. Owners retain control.</p><%= form_with url: dashboard_agency_memberships_path(site_id: @site.id), method: :post do %><%= email_field_tag :email_address, nil, required: true, placeholder: "Registered user email" %><%= select_tag :role, options_for_select([["Marketer","marketer"],["Designer","designer"],["Manager","manager"]]) %><%= submit_tag "Grant access" %><% end %><h2>Team</h2><% @memberships.each do |member| %><p><%= member.user.email_address %> · <%= member.role.humanize %> <%= button_to "Revoke", dashboard_agency_membership_path(member, site_id: @site.id), method: :delete %></p><% end %><%= link_to "Back to Business", dashboard_business_hub_path(site_id: @site.id) %></main>