<% content_for :page_title, "Agency Portfolio" %><main class="lt-settings"><h1>Agency portfolio</h1><p>Authorized sites only. Sales reflect recorded orders, not bank settlements.</p><table><thead><tr><th>Site</th><th>Recorded net sales</th><th>Paid orders</th><th>Campaigns</th><th>Subscribers</th><th>Queued messages</th><th>Workspace</th></tr></thead><tbody><% @reports.each do |row| %><tr><td><%= row[:site].name %></td><td><%= number_to_currency(row[:sales_cents] / 100.0) %></td><td><%= row[:orders] %></td><td><%= row[:campaigns] %></td><td><%= row[:subscribed] %></td><td><%= row[:messages_queued] %></td><td><%= link_to "Open", dashboard_business_hub_path(site_id: row[:site].id) %></td></tr><% end %></tbody></table><%= link_to "Business Command Center", dashboard_business_hub_path %></main>