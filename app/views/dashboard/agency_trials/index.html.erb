<% content_for :page_title, 'Agency demos' %>
<%= stylesheet_link_tag '/lightek/people-workspace.css' %>
<main class="lp-workspace">
  <header class="lp-heading">
    <div><h1>Agency demos</h1><p>Publish a demo for your website or invite a prospect directly.</p></div>
  </header>

  <section class="lp-card">
    <h2>Public agency demo</h2>
    <p>Share this form on your website or in Live Studio. Price changes apply to new checkouts. Existing checkouts and subscriptions keep their agreed price.</p>
    <% @sites.each do |site| %>
      <div>
        <strong><%= site.name %></strong>
        <%= form_with url: pricing_dashboard_agency_trials_path, method: :patch, class: 'lp-form' do %>
          <%= hidden_field_tag :site_id, site.id %>
          <div>
            <%= label_tag "annual_price_#{site.id}", 'Annual membership price (USD)' %>
            <%= number_field_tag :annual_price, format('%.2f', LightekAgency::Trial.annual_price_cents(site).fdiv(100)),
              id: "annual_price_#{site.id}", min: LightekAgency::Trial::MIN_ANNUAL_PRICE_CENTS.fdiv(100), max: '999999.99', step: '0.01', required: true %>
          </div>
          <%= submit_tag 'Save annual price', class: 'lp-button secondary' %>
        <% end %>
        <% if LightekAgency::Trial.public_site?(site) %>
          <% url = request_agency_demo_url(host: site.host, protocol: 'https', port: nil) %>
          <p><%= link_to url, url %></p>
          <%= button_to 'Close public requests', publish_dashboard_agency_trials_path, method: :patch, params: {site_id: site.id, enabled: '0'}, class: 'lp-button secondary' %>
        <% else %>
          <%= button_to 'Enable public requests', publish_dashboard_agency_trials_path, method: :patch, params: {site_id: site.id, enabled: '1'}, class: 'lp-button' %>
        <% end %>
      </div>
    <% end %>
    <% if @sites.empty? %><p>Add a Lightek storefront to publish the request form.</p><% end %>
  </section>

  <section class="lp-card">
    <h2>Send a private invitation</h2>
    <% if @sites.empty? %>
      <p>Create a Lightek storefront under your operator account to take membership payments.</p>
    <% else %>
      <%= form_with scope: :trial, url: dashboard_agency_trials_path, class: 'lp-form' do |f| %>
        <div class="lp-grid">
          <div><%= f.label :brand_name, 'Agency name' %><%= f.text_field :brand_name, maxlength: 120, required: true %></div>
          <div><%= f.label :email_address, 'Prospect email' %><%= f.email_field :email_address, required: true %></div>
          <div><%= f.label :first_name %><%= f.text_field :first_name, required: true %></div>
          <div><%= f.label :last_name %><%= f.text_field :last_name, required: true %></div>
          <div><%= f.label :business_type %><%= f.select :business_type, LightekAgency::Trial::BUSINESS_TYPES.invert.to_a, selected: 'general' %></div>
          <div><%= f.label :duration_days, 'Trial length in days' %><%= f.number_field :duration_days, value: LightekAgency::Trial::DEFAULT_DURATION_DAYS, min: 1, max: 90, required: true %></div>
          <% if @sites.one? %>
            <%= f.hidden_field :billing_site_id, value: @sites.first.id %>
          <% else %>
            <div><%= f.label :billing_site_id, 'Lightek billing storefront' %><%= f.collection_select :billing_site_id, @sites, :id, :name, {prompt: 'Select a storefront'}, required: true %></div>
          <% end %>
        </div>
        <%= f.submit 'Create demo and invite', class: 'lp-button' %>
      <% end %>
    <% end %>
  </section>

  <section class="lp-card">
    <h2>Agency demos</h2>
    <% @trials.each do |trial| %>
      <p><strong><%= trial.brand_name %></strong> · <%= trial.prospect.email_address %> ·
        <%= if trial.paid_access?
              "Paid through #{l(trial.paid_through.to_date, format: :long)}"
            elsif trial.activated_at?
              'Membership ended'
            elsif trial.preview_open?
              "Demo until #{l(trial.expires_at.to_date, format: :long)}"
            else
              'Demo ended'
            end %></p>
      <% if trial.prospect.password_setup_required? %>
        <%= button_to 'Send setup invitation', resend_dashboard_agency_trial_path(trial), class: 'lp-button secondary' %>
      <% end %>
    <% end %>
    <% if @trials.empty? %><p>No agency demos yet.</p><% end %>
  </section>
</main>
