<% content_for :page_title, 'Lightek Agency' %>
<%= stylesheet_link_tag '/lightek/people-workspace.css' %>
<main class="lp-workspace">
  <header class="lp-heading"><div><h1><%= @trial.brand_name %></h1><p>Lightek Agency</p></div></header>

  <% if @trial.preview_open? %>
    <section class="lp-card">
      <h2>Try your agency workspace</h2>
      <p>Your demo ends on <%= l(@trial.expires_at.to_date, format: :long) %>. Your agency name carries over when you upgrade.</p>
      <%= form_with model: @trial, scope: :trial, url: dashboard_agency_trial_path(@trial), class: 'lp-form' do |f| %>
        <div class="lp-grid">
          <div><%= f.label :brand_name, 'Agency name' %><%= f.text_field :brand_name, maxlength: 120, required: true %></div>
          <div><%= f.label :sample_client_name, 'Sample client' %><%= f.text_field :sample_client_name, maxlength: 120, required: true %></div>
          <div><%= f.label :sample_retail_dollars, 'Sample hosting resale price per month (USD)' %>
            <%= f.number_field :sample_retail_dollars, min: LightekAgency::Trial::SAMPLE_WHOLESALE_DOLLARS, max: 10_000, required: true %></div>
        </div>
        <p>Preview a hosting offer for <strong><%= @trial.sample_client_name %></strong>. Sample wholesale cost <strong><%= number_to_currency(LightekAgency::Trial::SAMPLE_WHOLESALE_DOLLARS, precision: 0) %>/month</strong>.
           Your sample margin is <strong><%= number_to_currency(@trial.sample_retail_dollars - LightekAgency::Trial::SAMPLE_WHOLESALE_DOLLARS, precision: 0) %>/month</strong> before fees.</p>
        <%= f.submit 'Save demo changes', class: 'lp-button secondary' %>
      <% end %>
    </section>
  <% elsif !@trial.activated_at? %>
    <section class="lp-card"><h2>Your demo has ended</h2><p>You can still activate your agency with this login.</p></section>
  <% end %>

  <section class="lp-card">
    <h2>Agency membership</h2>
    <% if @trial.paid_access? && current_user.white_label? %>
      <p>Active through <%= l(@trial.paid_through.to_date, format: :long) %>.</p>
      <%= link_to 'Open agency workspace', dashboard_agencies_path, class: 'lp-button' %>
    <% else %>
      <% if params[:checkout] == 'returned' && @trial.order&.status == 'pending_payment' %>
        <p>Waiting for payment confirmation. Refresh this page to check your membership.</p>
      <% end %>
      <p>Your membership unlocks client management, white-label branding, and reseller tools. Hosting is purchased separately. The membership renews annually, plus applicable tax.</p>
      <% price = number_to_currency(LightekAgency::Trial::ANNUAL_PRICE_CENTS / 100, precision: 0) %>
      <%= button_to "Upgrade for #{price}/year", upgrade_dashboard_agency_trial_path(@trial), class: 'lp-button', form: {data: {turbo: false}} %>
    <% end %>
  </section>
</main>
