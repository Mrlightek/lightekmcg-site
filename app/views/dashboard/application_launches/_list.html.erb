<% if @launches.any? %>
<section class="infra-panel"><div class="infra-panel-header"><div><h2>Application installations</h2><p>Separate installations from saved templates. Failed installations retain their server for retry.</p></div></div>
<div class="infra-table-wrap"><table class="infra-table"><thead><tr><th>Application / domain</th><th>Template</th><th>Server</th><th>Status</th><th>Actions</th></tr></thead><tbody>
<% @launches.each do |launch| %><tr><td><strong><%= launch.name %></strong><small><%= launch.domain %></small><small><%= launch.error_message %></small></td><td><%= launch.gatekeeper_application_template.name %></td><td><% if launch.gatekeeper_node %><%= link_to launch.gatekeeper_node.name, dashboard_server_path(launch.gatekeeper_node) %><% else %>Allocating new server<% end %></td><td><%= infrastructure_status_badge(launch.status) %><% if launch.receipt["mail_port_status"] == "pending" %><small>Mail port request pending</small><% end %></td><td><% if launch.status == "ready" %><%= link_to "Open ↗", "https://#{launch.domain}", target: "_blank", rel: "noopener", class: "infra-button" %><% end %><% if launch.status == "failed" %><%= button_to "Retry installation", retry_dashboard_application_launch_path(launch), class: "infra-button" %><% end %></td></tr><% end %>
</tbody></table></div></section>
<% end %>
