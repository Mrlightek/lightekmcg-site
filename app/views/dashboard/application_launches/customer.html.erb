<% content_for :page_title, "Add website" %><%= render "dashboard/infrastructure/styles" %><main class="infra"><%= link_to "← Server workspace", dashboard_server_path(@node), class: "infra-back" %><header class="infra-hero"><div><span class="infra-eyebrow">Hosting / New website</span><h1>Add a website to <%= @node.name %></h1><p>Choose an independent Lightek installation. Your plan's website allowance applies.</p></div></header><section class="infra-panel"><%= form_with url: dashboard_application_launches_path, scope: :launch, class: "infra-form" do |f| %><%= f.hidden_field :node_id, value: @node.id %><div class="infra-fields"><div class="infra-field"><%= f.label :name %><%= f.text_field :name, required: true %></div><div class="infra-field"><%= f.label :domain, "Website hostname" %><%= f.text_field :domain, required: true %></div><div class="infra-field"><%= f.label :template_id, "Installation" %><%= f.collection_select :template_id, @templates, :id, :name %></div><div class="infra-field"><%= f.label :owner_id, "Client account" %><%= f.collection_select :owner_id, @owners, :id, :email_address %></div></div><p>Rails on the server uses Docker dependencies. A Lightek Docker template runs the application and dependencies in its own container stack.</p><%= f.submit "Create & install website", class: "infra-button infra-button-primary" %><% end %></section></main>
