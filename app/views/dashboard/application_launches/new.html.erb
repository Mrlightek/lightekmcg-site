<% content_for :page_title, "Create server & application" %>
<%= render "dashboard/infrastructure/styles" %>
<div class="infra">
<%= link_to "← Servers & applications", dashboard_servers_path, class: "infra-back" %>
<header class="infra-hero"><div><span class="infra-eyebrow">Infrastructure / Application installer</span><h1>Create server & application</h1><p>Choose a design or application image, then install it on an existing server or a brand new instance.</p></div></header>
<% if @vault_error %><div class="infra-note" role="alert"><%= @vault_error %> <%= link_to "Repair Vault access →", dashboard_vault_path %></div><% end %>
<section class="infra-panel"><div class="infra-panel-header"><div><h2>Application templates</h2><p>Choose by the template's domain or design. Each Docker installation gets its own container, database and storage.</p></div></div>
<div class="infra-shortcuts"><% @templates.each do |template| %><div class="infra-shortcut"><i class="ti ti-apps"></i><strong><%= template.name %></strong><small><%= template.preview_domain.presence || "Lightek application" %> · <%= template.kind.humanize %></small><% if template.preview_domain.to_s.match?(/\A[a-z0-9.-]+\.[a-z]+\z/) %><%= link_to "Preview design ↗", "https://#{template.preview_domain}", target: "_blank", rel: "noopener" %><% end %><%= button_to "Retire template", disable_template_dashboard_application_launch_path(template), method: :patch, class: "infra-button" %></div><% end %></div>
<% if @templates.empty? %><div class="infra-empty">Save your first Rails or Docker template below to begin.</div><% end %></section>
<section class="infra-panel"><div class="infra-panel-header"><div><h2>Install application</h2><p>Select an existing server to add an independent application, or choose a new instance.</p></div></div>
<%= form_with url: new_dashboard_application_launch_path, method: :get, class: "infra-form" do |f| %><div class="infra-fields"><div class="infra-field"><%= f.label :provider_id, "Load provider catalog" %><%= f.select :provider_id, @providers.map { |p| [p.name, p.id] }, selected: @provider&.id %></div><div class="infra-field"><%= f.label :region, "Price for region" %><%= f.select :region, @catalog.fetch("regions").map { |r| [r["label"] || r["id"], r["id"]] }, selected: params[:region] %></div></div><%= f.hidden_field :node_id, value: params[:node_id] %><%= f.submit "Refresh sizes & prices", class: "infra-button" %><% end %><br>
<%= form_with url: dashboard_application_launches_path, scope: :launch, class: "infra-form" do |f| %><div class="infra-fields">
<div class="infra-field"><%= f.label :template_id, "Application / design" %><%= f.select :template_id, @templates.map { |t| ["#{t.name} — #{t.preview_domain.presence || t.kind}", t.id] }, {}, required: true %></div>
<div class="infra-field"><%= f.label :node_id, "Destination" %><%= f.select :node_id, [["Create a brand new server", ""]] + @nodes.map { |n| [n.name, n.id] }, selected: params[:node_id] %><small>Provider settings below apply only when creating a new server.</small></div>
<div class="infra-field"><%= f.label :name, "Application name" %><%= f.text_field :name, required: true, maxlength: 120 %></div>
<div class="infra-field"><%= f.label :domain, "Application hostname" %><%= f.text_field :domain, required: true, placeholder: "client.example.com" %></div>
<div class="infra-field"><%= f.label :owner_id, "Client account" %><%= f.select :owner_id, @owners.map { |o| [o.email_address, o.id] }, selected: current_user.id %></div>
<div class="infra-field"><%= f.label :server_name, "New server name (optional)" %><%= f.text_field :server_name, placeholder: "client-production-01", maxlength: 64 %><small>Leave blank to generate a name from the application.</small></div>
<div class="infra-field"><%= f.label :compute_provider_id, "New server provider" %><%= f.select :compute_provider_id, @providers.map { |p| [p.name, p.id] }, selected: @provider&.id %></div>
<div class="infra-field"><%= f.label :region, "New server region" %><%= f.select :region, @catalog.fetch("regions").map { |r| [r["label"] || r["id"], r["id"]] }, selected: params[:region] %></div>
<div class="infra-field"><%= f.label :plan, "New server size / monthly price" %><%= f.select :plan, @catalog.fetch("plans").map { |p| ["#{p['label']} — $#{format('%.2f', p['monthly_cents'].to_i / 100.0)}/mo", p["id"]] } %><small>Ubuntu 24.04 is installed automatically. Provider charges start when the server is allocated; regional pricing is checked when submitted.</small></div>
</div><div class="infra-form-footer"><p>DNS is configured through connected zones. Setup, HTTPS verification and the mail port request run in the background.</p><%= f.submit "Create & install application →", class: "infra-button infra-button-primary" %></div><% end %></section>
<section class="infra-panel"><div class="infra-panel-header"><div><h2>Image build connection</h2><p>Select credentials already stored in Vault. Lightek prepares callbacks, reuses existing CI settings and connects registry credentials automatically.</p></div></div>
<%= form_with url: setup_builds_dashboard_application_launches_path, method: :post, class: "infra-form" do |f| %><div class="infra-fields">
<div class="infra-field"><%= f.label :github_credential_slug, "GitHub connection" %><%= f.select :github_credential_slug, @github_credentials.map { |s| [s.name, s.slug] }, include_blank: "Detect existing connection" %><small><%= link_to "Connect a credential in Vault", dashboard_vault_path %> once if GitHub has not been connected yet.</small></div>
<div class="infra-field"><%= f.label :dependency_slug, "CI GitHub App (only if missing from GitHub)" %><%= f.select :dependency_slug, @github_credentials.map { |s| [s.name, s.slug] }, include_blank: "Reuse existing CI credentials" %></div>
<div class="infra-field"><%= f.label :registry_slug, "Private image registry (optional existing credential)" %><%= f.select :registry_slug, @registry_credentials.map { |s| [s.name, s.slug] }, include_blank: "Reuse connected registry / GitHub package access" %></div>
<div class="infra-field"><%= f.label :origin, "This environment's public HTTPS address" %><%= f.url_field :origin, value: @build_setup["origin"].presence || request.base_url, required: true %><small>GitHub sends build results here. For local development, this must be a public address that reaches this same application and database.</small></div>
</div><%= f.submit "Connect & prepare automatically", class: "infra-button infra-button-primary" %><% end %>
<% if @build_setup.present? %><p>Connected. Callback identity is created automatically for each build; no callback token or GitHub callback variable needs to be copied.</p><% end %></section>
<section class="infra-panel"><div class="infra-panel-header"><div><h2>Build a Rails Docker image</h2><p>Build this application's code from a design branch. GitHub Actions packages private dependencies, publishes the image and saves the finished template here.</p></div></div>
<%= form_with url: build_image_dashboard_application_launches_path, scope: :build, class: "infra-form" do |f| %><div class="infra-fields"><div class="infra-field"><%= f.label :name, "Design template name" %><%= f.text_field :name, required: true %></div><div class="infra-field"><%= f.label :preview_domain, "Design domain" %><%= f.text_field :preview_domain %></div><div class="infra-field"><%= f.label :source_ref, "Source branch or tag" %><%= f.text_field :source_ref, value: "develop", required: true %></div><div class="infra-field"><%= f.label :credential_slug, "Application environment secret (optional)" %><%= f.text_field :credential_slug %></div></div><%= f.submit "Build Rails image", class: "infra-button infra-button-primary" %><% end %>
<% @builds.each do |build| %><div class="infra-list-row"><strong><%= build.name %></strong><span><%= build.build_status %> · <%= build.source_ref %></span></div><% end %><p><%= link_to "View build progress and published images ↗", "https://github.com/Mrlightek/lightekmcg-site/actions/workflows/application-image.yml", target: "_blank", rel: "noopener" %></p></section>
<section class="infra-panel"><div class="infra-panel-header"><div><h2>Save an application template</h2><p>Save different client designs as separate Docker images. Use a registry image pinned by its SHA256 digest. Rails images must include bin/rails and bind their web server to the selected port.</p></div></div>
<%= form_with url: create_template_dashboard_application_launches_path, scope: :template, class: "infra-form" do |f| %><div class="infra-fields">
<div class="infra-field"><%= f.label :name, "Template name" %><%= f.text_field :name, required: true %></div>
<div class="infra-field"><%= f.label :preview_domain, "Design / preview domain" %><%= f.text_field :preview_domain, placeholder: "design.example.com" %></div>
<div class="infra-field"><%= f.label :kind, "Installation type" %><%= f.select :kind, [["Lightek Rails application (standard installer)", "native_rails"], ["Docker image (Rails or another web application)", "docker"]] %></div>
<div class="infra-field"><%= f.label :image, "Docker registry image" %><%= f.text_field :image, placeholder: "ghcr.io/your-org/design@sha256:..." %></div>
<div class="infra-field"><%= f.label :container_port, "Web port inside the container" %><%= f.number_field :container_port, value: 3000, min: 1, max: 65535 %></div>
<div class="infra-field"><%= f.label :credential_slug, "Vault secret slug (optional)" %><%= f.text_field :credential_slug %><small>For Docker environment variables, store an environment object in Vault with consumer Gatekeeper::Hosting::Launches and purpose application_install.</small></div>
<div class="infra-field"><%= f.label :rails_database, "Rails application with PostgreSQL and Redis" %><%= f.check_box :rails_database, checked: true %><small>Runs bin/rails db:prepare before starting the Rails web application. Disable for non-Rails web images.</small></div>
<div class="infra-field"><%= f.label :rails_worker, "Run a Sidekiq worker (image must include Sidekiq)" %><%= f.check_box :rails_worker %></div></div><%= f.submit "Save template", class: "infra-button infra-button-primary" %><% end %></section></div>
