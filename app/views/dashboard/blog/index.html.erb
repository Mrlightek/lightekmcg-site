<%= render "dashboard/shared/business_workspace", active: "Design & Content" %>
<% content_for :page_title,"Journal & Articles" %><%= stylesheet_link_tag "/lightek/site-content.css?v=1" %><%= javascript_include_tag "/lightek/site-content.js?v=1",defer:true %>
<main class="content-hub"><header class="content-heading"><div><span class="content-eyebrow">LIGHTEK / DESIGN & CONTENT</span><h1>Write something worth sharing.</h1><p>Articles for your website and PWA, using the same publishing records.</p></div><%= link_to "Back to Design & Content",dashboard_website_designs_path(site_id:@site.id),class:"content-button" %></header>
<%= form_with url:dashboard_blog_index_path,method: :get,local:true,class:"content-actions" do %><label>Website<%= select_tag :site_id,options_from_collection_for_select(@sites,:id,:name,@site.id) %></label><%= submit_tag "Switch website",class:"content-button" %><% end %>
<% values=@article_values || {}; post=@entry.post %><% if @error %><p class="content-error" role="alert"><%= @error %></p><% end %>
<div class="content-columns"><section class="content-card"><h2><%= @entry.persisted? ? "Edit article" : "New article" %></h2><%= form_with url:(@entry.persisted? ? dashboard_blog_path(@entry,site_id:@site.id) : dashboard_blog_index_path(site_id:@site.id)),method:(@entry.persisted? ? :patch : :post),scope: :article,local:true,class:"content-form",data:{article_editor:true} do |f| %>
<%= f.hidden_field :lock_version,value:values.fetch("lock_version",@entry.lock_version) %><label>Title<%= f.text_field :title,value:values.fetch("title",post.title),required:true,maxlength:160 %></label><label>URL slug<%= f.text_field :slug,value:values.fetch("slug",@entry.slug),required:true,maxlength:160,pattern:"[a-z0-9]+(-[a-z0-9]+)*",data:{article_slug:true,slug_auto:@entry.new_record? && values.fetch("slug",@entry.slug).blank?},placeholder:"our-next-chapter" %></label>
<label>Category<%= f.text_field :category,value:values.fetch("category",@entry.category),maxlength:80,placeholder:"News, ideas, behind the scenes…" %></label><label>Excerpt<%= f.text_area :excerpt,value:values.fetch("excerpt",@entry.excerpt),maxlength:600,rows:3 %></label>
<div class="content-format" aria-label="Article formatting"><% {"strong"=>"Bold","em"=>"Italic","h2"=>"Heading","blockquote"=>"Quote","p"=>"Paragraph"}.each do |tag,label| %><button type="button" data-article-wrap="<%= tag %>" class="content-button"><%= label %></button><% end %></div><label id="article-body-label">Article body</label><% body=values.fetch("content",post.content).to_s; clean=sanitize(body,tags:%w[p br h2 h3 strong em ul ol li blockquote a],attributes:%w[href title]) %><div class="content-rich" role="textbox" aria-labelledby="article-body-label" aria-multiline="true" contenteditable="true" data-article-rich><%= body.match?(/<(?:p|h[23]|ul|ol|blockquote)\b/i) ? clean : simple_format(clean,{},sanitize:false) %></div><%= f.text_area :content,value:body,maxlength:50000,rows:20,data:{article_body:true},class:"content-rich-source",aria:{label:"Article body"} %><noscript><style>.content-rich-source{display:block!important}.content-rich{display:none}</style></noscript><small>Write directly in the article. Select text to apply formatting; paste brings in plain text.</small>
<label>Publication<%= f.select :status,[["Draft · only you can preview","draft"],["Published · website & PWA","published"],["Archived · hidden from readers","archived"]],selected:values.fetch("status",@entry.status) %></label><%= f.submit "Save article",class:"content-button primary",data:{turbo_submits_with:"Saving…"} %><% end %></section>
<aside class="content-card"><div class="content-heading"><h2>Your articles</h2><%= link_to "New article",dashboard_blog_index_path(site_id:@site.id),class:"content-button" %></div><% @entries.each do |entry| %><article class="content-article-row"><span class="content-eyebrow"><%= entry.status %> · <%= entry.category %></span><h3><%= entry.post.title %></h3><p><%= entry.excerpt %></p><%= link_to "Edit",dashboard_blog_index_path(site_id:@site.id,entry_id:entry.id),class:"content-button" %><%= link_to "Preview",preview_dashboard_blog_path(entry,site_id:@site.id),class:"content-button",target:"_blank",rel:"noopener" %><% if entry.status=="published" %><%= link_to "View live","https://#{@site.host}/blog/#{entry.slug}",class:"content-button",target:"_blank",rel:"noopener" %><% end %></article><% end %><% if @entries.empty? %><p>Your first article starts here. Save a draft, preview it, then publish when ready.</p><% end %></aside></div></main>
