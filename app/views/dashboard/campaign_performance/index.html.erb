<% content_for :page_title, 'Campaign performance' %>
<main class="sales-workspace growth-workspace">
<%= stylesheet_link_tag '/lightek/sales-workspace.css?v=4' %><%= stylesheet_link_tag '/lightek/growth-workspace.css?v=6' %>
<%= render 'dashboard/shared/business_workspace', active: 'Performance' %>
<header class="sales-header"><div><span class="sales-eyebrow">LIGHTEK / MEASURE · REVIEW · IMPROVE</span><h1>Campaign performance</h1><p>Connect reviewed creative to observed business outcomes.</p></div>
<%= form_with url: dashboard_campaign_performance_path, method: :get, class: 'sales-site' do %><%= label_tag :site_id, 'Business website' %><%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @site.id) %><%= submit_tag 'Switch', class: 'sales-button secondary' %><% end %></header>
<% if flash[:alert] %><div class="sales-errors" role="alert"><%= flash[:alert] %></div><% end %><% if flash[:notice] %><p role="status"><%= flash[:notice] %></p><% end %>
<aside class="sales-coach"><h2>Evidence before another experiment</h2><p>Compare two pinned social campaign versions using separate native tracking links. Counts describe observed visit cohorts, not randomized allocation or causal lift. Audience exposure, impressions, spend, likes and total website traffic are unknown here.</p><p>Publication receipts show delivery state only. Older tracking links cannot establish which creative a visitor saw.</p></aside>
<% if @comparison %>
<section class="sales-panel growth-performance-summary"><span class="sales-eyebrow">COMPARISON #<%= @comparison.id %> / <%= @comparison.variable.humanize %></span><h2><%= @comparison.name %></h2><p><%= @comparison.hypothesis %></p><p>Visit window: <%= @comparison.starts_on %> to <%= @comparison.ends_on %> · <%= Time.zone.name %></p><p>Intended audience: <%= @comparison.brief_snapshot['audience'] %> · Offer: <%= @comparison.brief_snapshot['offering'] %></p><small>Declared business context, not verified audience assignment.</small>
<%= button_to 'Measure a fresh review', review_dashboard_campaign_performance_path(@comparison, site_id: @site.id), params: {request_key: SecureRandom.uuid}, class: 'sales-button' %>
<p><code>/growth review <%= @site.id %> <%= @comparison.id %></code> runs the same measured review through Nevaeh. Existing agent scheduling and structured reports apply.</p></section>
<section class="sales-two-col growth-performance-arms" aria-label="Pinned creative and placement links">
<% @arms.each do |arm| %><article class="sales-panel growth-performance-arm"><span class="sales-eyebrow"><%= arm.label.upcase %> / CAMPAIGN #<%= arm.campaign_id %></span><h2><%= arm.creative_snapshot['campaign_name'] %></h2><p><strong><%= arm.creative_snapshot['headline'] %></strong></p><p class="growth-performance-copy"><%= arm.creative_snapshot['message'] %></p><p><%= arm.creative_snapshot['cta_label'] %></p><details class="growth-plan-evidence"><summary>Pinned version and placement</summary><p>Approved <%= arm.creative_snapshot['approved_at'] %> by user #<%= arm.creative_snapshot['approved_by_id'] %></p><code class="growth-performance-digest"><%= arm.content_digest %></code><p>Link #<%= arm.link_id %> · <%= arm.link.source %> / <%= arm.link.medium %> · <%= arm.link.destination_path %></p></details><label>Tracking URL for <%= arm.label %><%= text_field_tag nil, growth_link_url(token: arm.link.token, host: @site.host, protocol: 'https'), readonly: true %></label><p><small><%= arm.creative_snapshot['placement_link_in_copy'] ? 'The reviewed CTA already uses this tracked link.' : 'Use this link in the intended placement alongside this exact version.' %> Counts start when the version was pinned, within the visit window. Links are not injected into campaigns and no posts are sent. Changing the campaign’s copy/CTA requires new approval and a fresh comparison.</small></p><%= link_to 'Open campaign', edit_dashboard_marketing_campaign_path(arm.campaign_id, site_id: @site.id) %></article><% end %></section>
<% if @review %><section class="sales-panel"><span class="sales-eyebrow">REVIEW #<%= @review.id %> / <%= @review.rules_version %></span><h2>Observed results</h2><p>Measured <%= @review.measured_at.to_fs(:long) %> · <%= @review.snapshot['time_zone'] %>. Each stage counts distinct attributed visits; multiple orders can share one visit. Enrollment began <%= @review.snapshot['enrolled_at'] %>; earlier visits are excluded. Outcomes may arrive after the visit window.</p>
<div class="sales-two-col growth-performance-arms"><% @review.snapshot.fetch('arms').each do |row| %><article class="growth-performance-arm"><h3><%= row['label'].humanize %></h3><p><%= row['version_current'] ? 'Pinned version current at review' : 'Version or approval changed — inspect coverage' %> · <%= row['link_enabled'] ? 'Link enabled' : 'Link disabled' %></p><dl class="growth-performance-stages"><% row.fetch('stages').each do |name, count| %><div><dt><%= name %></dt><dd><%= count %></dd></div><% end %></dl><p>Inquiry / tracked visits: <strong><%= row['inquiry_rate'].nil? ? 'Unknown — no tracked visits' : "#{row['inquiry_rate']}%" %></strong></p><p>Payment / tracked visits: <strong><%= row['payment_rate'].nil? ? 'Unknown — no tracked visits' : "#{row['payment_rate']}%" %></strong></p>
<% row.fetch('money').each do |money| %><p><%= money['currency'] %> · <%= money['paid_orders'] %> paid orders · collected <%= number_with_precision(money['collected_cents'] / 100.0, precision: 2) %> · refunded <%= number_with_precision(money['refunded_cents'] / 100.0, precision: 2) %></p><% end %><small>Recorded order amounts by currency; no mixed-currency total, profit or processor settlement claim.</small><p>Matching calendar receipts: <%= row['publication_states'].present? ? row['publication_states'].map { |state, count| "#{state.humanize}: #{count}" }.join(' · ') : 'None recorded' %></p><small><%= row['publication_note'] %></small></article><% end %></div></section>
<% recommendation = @review.snapshot.fetch('recommendation') %><section class="sales-coach"><span class="sales-eyebrow">NEVAEH / NEXT REVIEWED MOVE</span><h2><%= recommendation['title'] %></h2><p><%= recommendation['reason'] %></p><p><%= recommendation['next_change'] %></p><small>Rule: <%= @review.rules_version %> · minimum <%= @review.snapshot['minimum_visits_per_arm'] %> tracked visits per placement · <%= @review.snapshot['outcome_lag_days'] %> full days after window close. Authored review heuristics; no statistical significance or guaranteed outcome.</small>
<% if @review.followup %><%= link_to 'Open prepared follow-up draft', edit_dashboard_marketing_campaign_path(@review.followup.campaign_id, site_id: @site.id), class: 'sales-button' %><% elsif recommendation['can_draft'] && @reviews.first == @review && @review.measured_at >= 7.days.ago %><%= form_with url: draft_dashboard_campaign_performance_path(@review, site_id: @site.id), class: 'sales-form growth-audit-confirmation' do %><label><%= check_box_tag :confirmed, '1', false, required: true %> I reviewed this evidence and want editable starting copy from the pinned <%= recommendation['starting_arm'] %>.</label><%= submit_tag 'Prepare editable follow-up', class: 'sales-button' %><% end %><p><small>The draft reuses reviewed starting copy, uses the selected local destination and omits media. Create a new tracking link for the draft before copy approval. Make the deliberate change, review its content and produce media in Studio. Nothing is automatically approved or published.</small></p><% end %></section>
<nav class="growth-plan-history" aria-label="Performance review history"><strong>Saved reviews:</strong><% @reviews.each do |review| %><%= link_to "##{review.id} · #{review.measured_at.to_fs(:short)}", dashboard_campaign_performance_path(site_id: @site.id, comparison_id: @comparison.id, review_id: review.id) %><% end %></nav>
<% else %><p class="sales-empty">No measured review yet. Use both placement links, then measure the available evidence.</p><% end %><% end %>
<details class="sales-panel growth-performance-setup" <%= 'open' unless @comparison %>><summary>Prepare a comparison</summary><p>Complete your business brief and explicitly approve two distinct social campaigns first. Choose one intended difference. This records your hypothesis and creates two separate links; it does not distribute traffic or verify equal exposure. If a reviewed CTA already uses a native tracked link, match its source, medium and destination below; it will be bound instead of creating another link. To put a new link inside post copy, create it in Growth first and approve that campaign version before pinning.</p>
<%= form_with url: dashboard_campaign_performance_path(site_id: @site.id), scope: :comparison, class: 'sales-form' do |f| %><%= hidden_field_tag :request_key, SecureRandom.uuid %>
<label>Comparison name<%= f.text_field :name, required: true, maxlength: 160 %></label><label>Hypothesis<%= f.text_area :hypothesis, rows: 2, required: true, maxlength: 1000, placeholder: 'A clearer action may produce more customer inquiries.' %></label><label>Intended difference<%= f.select :variable, LightekGrowth::Comparison::VARIABLES.map { |v| [v.humanize, v] } %></label>
<div class="sales-form-grid"><label>Control campaign<%= f.select :control_campaign_id, options_from_collection_for_select(@campaigns, :id, :name), {include_blank: 'Choose reviewed campaign'}, required: true %></label><label>Challenger campaign<%= f.select :challenger_campaign_id, options_from_collection_for_select(@campaigns, :id, :name), {include_blank: 'Choose reviewed campaign'}, required: true %></label><label>First visit day<%= f.date_field :starts_on, value: Date.current, required: true %></label><label>Last visit day<%= f.date_field :ends_on, value: Date.current + 6, required: true %></label><label>Source<%= f.text_field :source, value: 'instagram', required: true, maxlength: 80 %></label><label>Medium<%= f.text_field :medium, value: 'social', required: true, maxlength: 80 %></label><label>Control destination path<%= f.text_field :control_path, value: '/', required: true, maxlength: 500 %></label><label>Challenger destination path<%= f.text_field :challenger_path, value: '/', required: true, maxlength: 500 %></label></div><label class="growth-performance-confirm"><%= f.check_box :confirmed, {required: true}, '1', '0' %> I reviewed the two versions and will use each assigned link in its intended placement.</label><%= f.submit 'Pin versions and create placement links', class: 'sales-button' %><% end %></details>
<nav class="growth-plan-history" aria-label="Campaign comparison history"><strong>Recent comparisons:</strong><% @comparisons.each do |row| %><%= link_to row.name, dashboard_campaign_performance_path(site_id: @site.id, comparison_id: row.id) %><% end %></nav>
</main>
