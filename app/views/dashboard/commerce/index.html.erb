<% content_for :page_title, "Commerce" %><%= render "dashboard/infrastructure/styles" %><main class="infra"><header class="infra-hero"><div><span class="infra-eyebrow">Commerce / Revenue workspace</span><h1>Make it easy to buy.</h1><p>Products, recurring services, orders and payouts in one place.</p></div><% if current_user.role == "super_admin" %><%= link_to "Hosting prices & margins", dashboard_hosting_packages_path, class: "infra-button" %><% end %></header>
<%= form_with url: dashboard_commerce_path, method: :get, class: "infra-form" do |f| %><div class="infra-field"><%= f.label :site_id, "Storefront" %><%= f.collection_select :site_id, @sites, :id, :name, selected: @site&.id %></div><%= f.submit "Open storefront", class: "infra-button" %><% end %>
<% if @site %><section class="infra-stats"><% [["Collected after refunds", number_to_currency(@revenue / 100.0)], ["Paid orders", @paid_count], ["Awaiting fulfillment", @awaiting_fulfillment], ["Published products", @products.where(published: true).count]].each do |label, value| %><div class="infra-stat"><span><%= label %></span><strong><%= value %></strong></div><% end %></section>
<section class="infra-panel"><h2><%= @site.name %></h2><div class="infra-shortcuts"><% [["Customer records", dashboard_customers_path(site_id: @site.id)], ["Products & pricing", dashboard_commerce_products_path(site_id: @site.id)], ["Orders & fulfillment", dashboard_commerce_orders_path(site_id: @site.id)], ["Shipping & labels", dashboard_shipping_path(site_id: @site.id)], ["Payouts", dashboard_commerce_payouts_path(site_id: @site.id)], ["View store", commerce_shop_path(site_id: @site.id)]].each do |label, path| %><%= link_to label, path, class: "infra-shortcut" %><% end %></div></section>
<section class="infra-panel"><h2>Recurring subscriptions</h2><p>Prices are preserved from checkout. Cancellations take effect after the paid period.</p><% @subscriptions.each do |subscription| %><div class="infra-list-row"><div><strong><%= subscription.order.customer_email %></strong><small><%= number_to_currency(subscription.amount_cents / 100.0) %>/<%= subscription.billing_interval %> · <%= subscription.status.humanize %> · through <%= subscription.current_period_end&.to_date %></small></div><% unless subscription.cancel_at_period_end? || %w[canceled unpaid incomplete_expired].include?(subscription.status) %><%= button_to "Cancel at period end", cancel_subscription_dashboard_commerce_path(subscription), method: :post, class: "infra-button", data: {turbo_confirm: "End this subscription after the paid period?"} %><% end %></div><% subscription.billing_invoices.order(paid_at: :desc).limit(5).each do |invoice| %><p>Payment received <%= invoice.paid_at.to_date %> · <%= number_to_currency(invoice.amount_paid_cents / 100.0) %> · <%= invoice.processor_reference %></p><% end %><% end %><% if @subscriptions.empty? %><p>No recurring subscriptions yet. Create a service product and choose monthly or annual billing.</p><% end %></section><% else %><section class="infra-panel"><p>No storefront is assigned to your account yet.</p></section><% end %></main>

<% if @earned_shares&.any? %><section class="infra-panel"><h2>Your downstream sale earnings</h2><p>Each amount is tied to a paid order. Pending shares become payable after fulfillment and payment checks.</p><% @earned_shares.each do |share| %><div class="infra-list-row"><strong>Order #<%= share.order_id %></strong><span><%= number_to_currency((share.amount_cents - share.reversed_cents) / 100.0) %> · <%= share.basis_points / 100.0 %>% · <%= share.status.humanize %></span></div><% end %></section><% end %>
