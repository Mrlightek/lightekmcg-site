<article class="packing-slip">
  <h1>Packing slip</h1>
  <p><%= @site.name %> · Order #<%= slip.order.id %> · <%= l(slip.order.paid_at.to_date) %></p>
  <% if slip.recipient %>
    <section>
      <h2>Ship to</h2>
      <% address = slip.recipient.fetch('address', {}) %>
      <address>
        <%= slip.recipient.dig('contact', 'personName') %><br>
        <% Array(address['streetLines']).each do |street| %><%= street %><br><% end %>
        <%= [address['city'], address['stateOrProvinceCode'], address['postalCode']].compact.join(' ') %><br>
        <%= address['countryCode'] %>
      </address>
    </section>
  <% end %>
  <section>
    <h2>Items</h2>
    <table>
      <thead><tr><th scope="col">Item</th><th scope="col">Quantity</th></tr></thead>
      <tbody>
        <% slip.items.each do |item| %>
          <tr><td><%= item.name %></td><td><%= item.quantity %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
</article>
