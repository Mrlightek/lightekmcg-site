<main class="lt-settings"><h1>Commerce · Orders</h1><p><%= @site.name %> · Payment must be verified before fulfillment.</p><p><%= link_to "Products", dashboard_commerce_products_path(site_id: @site.id) %></p><table><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th></tr></thead><tbody><% @orders.each do |order| %><tr><td>#<%= order.id %></td><td><%= order.customer_email %></td><td><%= order.items.map { |item| "#{item.quantity} × #{item.name}" }.join(", ") %></td><td><%= number_to_currency(order.total_cents / 100.0) %></td><td><%= order.status.humanize %><% if %w[paid partially_refunded].include?(order.status) %><%= form_with url: dashboard_commerce_refund_path(order_id: order.id, site_id: @site.id), method: :post do |form| %><%= number_field_tag :amount_cents, order.total_cents - order.refunded_cents, min: 1, max: order.total_cents - order.refunded_cents, required: true, aria: { label: "Refund amount in cents" } %><%= form.submit "Refund amount" %><% end %><% end %></td></tr><% end %></tbody></table></main>
