<main class="lt-settings"><h1>Commerce · Orders</h1><p><%= @site.name %> · Payment must be verified before fulfillment.</p><p><%= link_to "Products", dashboard_commerce_products_path(site_id: @site.id) %></p><table><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th></tr></thead><tbody><% @orders.each do |order| %><tr><td>#<%= order.id %></td><td><%= order.customer_email %></td><td><%= order.items.map { |item| "#{item.quantity} × #{item.name}" }.join(", ") %></td><td><%= number_to_currency(order.total_cents / 100.0) %></td><td><%= order.status.humanize %><% if order.status == "paid" %><%= button_to "Full refund", dashboard_commerce_refund_path(order_id: order.id, site_id: @site.id), method: :post, form: {data: {turbo_confirm: "Refund this paid order?"}} %><% end %></td></tr><% end %></tbody></table></main>
