<main class="lt-settings">
  <h1>Commerce · Orders</h1>
  <p><%= link_to "Application installations", dashboard_installations_path %></p>
  <p><%= @site.name %> · Payment must be verified before fulfillment.</p>
  <p><%= link_to "Merchant payouts", dashboard_commerce_payouts_path(site_id: @site.id) %></p>
  <p><%= link_to "Products", dashboard_commerce_products_path(site_id: @site.id) %></p>

  <p>Delete unpaid test or abandoned orders to clear this list. Reserved inventory is released and open Stripe checkouts are expired. Payment records are retained for reconciliation.</p>
  <%= form_with url: dashboard_commerce_orders_path(site_id: @site.id), method: :delete,
      id: "delete-selected-orders", data: { turbo_confirm: "Delete the selected unpaid orders and cancel their checkouts?" } do %>
    <%= submit_tag "Delete selected unpaid orders", class: "btn btn-danger" %>
  <% end %>

  <table>
    <thead><tr><th>Select</th><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td>
            <% if order.removable? %>
              <%= check_box_tag "order_ids[]", order.id, false, id: "select-order-#{order.id}", form: "delete-selected-orders", aria: { label: "Select unpaid order ##{order.id}" } %>
            <% end %>
          </td>
          <td>#<%= order.id %></td>
          <td><%= order.customer_email %></td>
          <td><%= order.items.map { |item| "#{item.quantity} × #{item.name}" }.join(", ") %></td>
          <td><%= number_to_currency(order.total_cents / 100.0) %></td>
          <td>
            <%= order.status.humanize %>
            <% if order.items.any? { |item| item.product.product_type == "lightek_instance" } %>
              <p>Installation: <%= order.provisioning_state.presence || "Awaiting paid confirmation" %></p>
              <% if LightekCommerce::Installations.ready?(order) && LightekCommerce::Installations.can_manage_access?(current_user, order) %>
                <p><%= link_to "Set password & open application", installation_path(order) %></p>
              <% end %>
              <% if order.provisioning_error.present? %><p role="alert"><%= order.provisioning_error %></p><% end %>
              <% if order.paid_at? && !order.provisioned_at? %>
                <%= button_to "Resume installation", dashboard_commerce_retry_provisioning_path(site_id: @site.id, order_id: order.id), method: :post %>
              <% end %>
            <% end %>
            <% if order.status == "paid" %>
              <%= form_with url: dashboard_commerce_fulfill_path(order_id: order.id, site_id: @site.id), method: :post do %>
                <%= text_field_tag :fulfillment_reference, nil, placeholder: "Tracking / delivery reference" %>
                <%= text_field_tag :fulfillment_note, nil, placeholder: "Fulfillment note" %>
                <%= submit_tag "Mark fulfilled" %>
              <% end %>
            <% end %>
            <% if %w[paid partially_refunded].include?(order.status) %>
              <%= form_with url: dashboard_commerce_refund_path(order_id: order.id, site_id: @site.id), method: :post do |form| %>
                <%= number_field_tag :amount_cents, order.total_cents - order.refunded_cents, min: 1, max: order.total_cents - order.refunded_cents, required: true, aria: { label: "Refund amount in cents" } %>
                <%= form.submit "Refund amount" %>
              <% end %>
            <% end %>
          </td>
          <td>
            <% if order.removable? %>
              <%= button_to "Delete unpaid order", dashboard_commerce_order_path(site_id: @site.id, order_id: order.id), method: :delete,
                  class: "btn btn-danger", form: { data: { turbo_confirm: "Delete unpaid order ##{order.id} and cancel its checkout?" } } %>
            <% else %>
              <span>Payment / installation record retained</span>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @orders.empty? %><tr><td colspan="7">No orders to display.</td></tr><% end %>
    </tbody>
  </table>
</main>
