<main class="lt-settings"><h1>Commerce · Orders</h1><p><%= link_to "Application installations", dashboard_installations_path %></p><p><%= @site.name %> · Payment must be verified before fulfillment.</p><p><%= link_to "Merchant payouts", dashboard_commerce_payouts_path(site_id: @site.id) %></p><p><%= link_to "Products", dashboard_commerce_products_path(site_id: @site.id) %></p><table><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th></tr></thead><tbody><% @orders.each do |order| %><tr><td>#<%= order.id %></td><td><%= order.customer_email %></td><td><%= order.items.map { |item| "#{item.quantity} × #{item.name}" }.join(", ") %></td><td><%= number_to_currency(order.total_cents / 100.0) %></td><td><%= order.status.humanize %><% if order.items.any? { |item| item.product.product_type == "lightek_instance" } %><p>Installation: <%= order.provisioning_state.presence || "Awaiting paid confirmation" %></p><% if LightekCommerce::Installations.ready?(order) && LightekCommerce::Installations.can_manage_access?(current_user, order) %><p><%= link_to "Set password & open application", installation_path(order) %></p><% end %><% if order.provisioning_error.present? %><p role="alert"><%= order.provisioning_error %></p><% end %><% if order.paid_at? && !order.provisioned_at? %><%= button_to "Resume installation", dashboard_commerce_retry_provisioning_path(site_id: @site.id, order_id: order.id), method: :post %><% end %><% end %><% if order.status == "paid" %><%= form_with url: dashboard_commerce_fulfill_path(order_id: order.id, site_id: @site.id), method: :post do %><%= text_field_tag :fulfillment_reference, nil, placeholder: "Tracking / delivery reference" %><%= text_field_tag :fulfillment_note, nil, placeholder: "Fulfillment note" %><%= submit_tag "Mark fulfilled" %><% end %><% end %><% if %w[paid partially_refunded].include?(order.status) %><%= form_with url: dashboard_commerce_refund_path(order_id: order.id, site_id: @site.id), method: :post do |form| %><%= number_field_tag :amount_cents, order.total_cents - order.refunded_cents, min: 1, max: order.total_cents - order.refunded_cents, required: true, aria: { label: "Refund amount in cents" } %><%= form.submit "Refund amount" %><% end %><% end %></td></tr><% end %></tbody></table></main>
