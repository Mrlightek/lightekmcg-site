<main class="lt-settings"><h1><%= @product.persisted? ? "Edit product" : "Add product" %></h1><% if @product.errors.any? %><div role="alert"><%= @product.errors.full_messages.to_sentence %></div><% end %><%= form_with model: @product, scope: :product, url: (@product.persisted? ? dashboard_commerce_product_path(@product, site_id: @site.id) : dashboard_commerce_products_path(site_id: @site.id)) do |f| %><p><%= f.label :name %><%= f.text_field :name, required: true %></p><p><%= f.label :slug %><%= f.text_field :slug, required: true %></p><p><%= f.label :description %><%= f.text_area :description %></p><p><%= f.label :price_cents, "Price (cents)" %><%= f.number_field :price_cents, min: 0, required: true %></p><p><%= f.label :inventory_quantity %><%= f.number_field :inventory_quantity, min: 0, required: true %></p><p><%= f.label :position %><%= f.number_field :position, min: 0 %></p><p><%= f.label :published %><%= f.check_box :published %></p><%= f.submit "Save product" %><% end %><p><%= link_to "Back to products", dashboard_commerce_products_path(site_id: @site.id) %></p></main>
