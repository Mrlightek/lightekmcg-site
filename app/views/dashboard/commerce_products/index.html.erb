<main class="lt-settings"><h1>Commerce · Products</h1><p>Manage products for <strong><%= @site.name %></strong>.</p><p><%= link_to "Add product", new_dashboard_commerce_product_path(site_id: @site.id) %> · <%= link_to "Pages & Sections", dymond_dash.pages_path(site_id: @site.id) %></p><table><thead><tr><th>Name</th><th>Price</th><th>Available</th><th>Published</th><th></th></tr></thead><tbody><% @products.each do |product| %><tr><td><%= product.name %></td><td><%= number_to_currency(product.price_cents / 100.0) %></td><td><%= product.inventory_quantity %></td><td><%= product.published? ? "Yes" : "Draft" %></td><td><%= link_to "Edit", edit_dashboard_commerce_product_path(product, site_id: @site.id) %> <%= button_to "Delete", dashboard_commerce_product_path(product, site_id: @site.id), method: :delete, form: { data: { turbo_confirm: "Delete this product?" } } %></td></tr><% end %></tbody></table></main>
