<% content_for :page_title, 'Inventory adjustment history' %>
<main class="dd-workspace">
  <header class="dd-page-header">
    <div><h1>Inventory adjustment history</h1><p><%= @site.name %></p></div>
    <%= link_to 'Inventory', dashboard_commerce_products_path(site_id: @site.id, inventory: '1'), class: 'dd-button' %>
  </header>
  <section class="dd-panel" aria-label="Stock adjustments">
    <% if @inventory_changes.empty? %>
      <p>There are no stock adjustments in this view.</p>
    <% else %>
      <table>
        <thead><tr><th scope="col">Time</th><th scope="col">Product</th><th scope="col">Stock state</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Changed by</th><th scope="col">Source</th><th scope="col">Reason</th><th scope="col">Reference</th></tr></thead>
        <tbody>
          <% @inventory_changes.each do |change| %>
            <tr>
              <td><time datetime="<%= change.created_at.iso8601 %>"><%= l(change.created_at.in_time_zone, format: :short) %></time></td>
              <th scope="row"><%= [change.product_name, change.variant_name].compact.join(' · ') %></th>
              <td><%= change.stock_state.humanize %></td>
              <td><%= change.before_quantity %></td>
              <td><%= change.after_quantity %></td>
              <td><%= change.actor_name %></td>
              <td><%= change.source_label %></td>
              <td><%= change.reason_label || '—' %></td>
              <td>
                <% if change.supplier_order_id %>
                  <%= link_to "PO ##{change.supplier_order_id}", dashboard_commerce_supplier_order_path(change.supplier_order_id, site_id: @site.id) %>
                <% elsif change.merchandise_return_id %>
                  Return #<%= change.merchandise_return_id %>
                <% elsif change.source.in?(%w[csv_import stock_state_adjustment]) %>
                  <span title="<%= change.batch_key %>"><%= change.batch_key.first(8) %></span>
                <% elsif change.order_id %>
                  Order #<%= change.order_id %>
                <% else %>—<% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <% if @more_inventory_changes %>
      <%= link_to 'Older adjustments', dashboard_commerce_products_path(site_id: @site.id, inventory_history: '1',
        before: @inventory_changes.last.id), class: 'dd-button' %>
    <% end %>
  </section>
</main>
