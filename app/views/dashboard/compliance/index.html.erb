<% content_for :page_title,'Legal & compliance' %><%= stylesheet_link_tag '/lightek/people-workspace.css' %><main class="lp-workspace"><header class="lp-heading"><div><span class="lp-eyebrow">LIGHTEK / LEGAL & COMPLIANCE</span><h1>Jurisdiction monitoring</h1><p>Select an operating state, watch documented legislative sources and review changes with their source links.</p></div></header><%= form_with url: dashboard_compliance_path,method: :get,class: 'lp-form' do |f| %><label>Employer<%= f.select :employer_id,@employers.map { |e| [e.email_address,e.id] },selected: @employer.id %></label><%= f.submit 'Switch employer',class: 'lp-button secondary' %><% end %><section class="lp-card"><h2>Source connections</h2><p>Open States provides state legislative activity. New York’s official source also provides law documents. Coverage, effective dates and business applicability must be reviewed; monitoring does not certify compliance.</p><% if @is_owner %><%= form_with url: credentials_dashboard_compliance_path(employer_id: @employer.id),class: 'lp-form' do |f| %><label>Provider<%= f.select :provider,[['Open States · state legislation','openstates'],['New York Senate · laws','ny_openleg']] %></label><label>API key<%= f.password_field :api_key,required: true,autocomplete: 'new-password' %></label><label>Current password · employer owner<%= f.password_field :password,required: true,autocomplete: 'current-password' %></label><%= f.submit 'Save credential in Vault',class: 'lp-button secondary' %><% end %><% end %></section><% if @can_manage %><section class="lp-card"><h2>Add a state monitor</h2><%= form_with url: dashboard_compliance_path(employer_id: @employer.id),scope: :monitor,class: 'lp-form' do |f| %><div class="lp-grid"><label>Operating state<%= f.select :state,LightekCompliance::Monitor::STATES,{},required: true %></label><label>Source<%= f.select :provider,[['State legislative activity','openstates'],['New York law documents','ny_openleg']] %></label></div><label>Topic / search terms<%= f.text_field :query,required: true,maxlength: 200,placeholder: 'Payroll, bookkeeping, data privacy…' %></label><%= f.submit 'Create daily monitor',class: 'lp-button' %><% end %></section><% end %><% @monitors.each do |monitor| %><section class="lp-card"><div class="lp-section"><div><h2><%= monitor.state %> · <%= monitor.query %></h2><p><%= monitor.enabled? ? 'Enabled' : 'Stopped' %> · Last successful check: <%= monitor.last_checked_at || 'Awaiting source connection' %></p><% if monitor.error_code %><p role="alert">Source refresh needs attention (<%= monitor.error_code %>). Previous results may be stale.</p><% end %></div><span class="lp-badge">Review required</span></div><p><%= monitor.snapshot['scope'] %></p><% Array(monitor.snapshot['items']).each do |item| %><article class="lp-election"><div><strong><%= item['identifier'] %> · <%= item['title'] %></strong><p><%= item['kind'].humanize %> · <%= item['status'] || item['published_on'] %></p></div><%= link_to 'Review source ↗',item['source_url'],rel: 'noopener',class: 'lp-button secondary' if item['source_url'] %></article><% end %><div class="lp-actions"><%= button_to 'Refresh source',refresh_dashboard_compliance_path(monitor,employer_id: @employer.id),class: 'lp-button secondary' if @can_manage && monitor.enabled? %><%= button_to 'Stop monitor',dashboard_compliance_monitor_path(monitor,employer_id: @employer.id),method: :delete,class: 'lp-button secondary' if @can_manage && monitor.enabled? %></div></section><% end %></main>
