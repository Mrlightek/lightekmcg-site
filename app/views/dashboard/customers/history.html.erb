<% content_for :page_title, "Customer history" %><%= render "dashboard/infrastructure/styles" %><main class="infra"><%= link_to "← Customers", dashboard_customers_path(site_id: @site.id), class: "infra-back" %><header class="infra-hero"><div><h1><%= @email %></h1><p><%= @site.name %> · Marketing consent: <%= (@contact&.subscribed_at && !@contact&.unsubscribed_at) ? "Subscribed" : "Not subscribed" %></p></div></header><section class="infra-panel"><% @orders.each do |order| %><div class="infra-list-row"><div><strong>Order #<%= order.id %></strong><small><%= order.items.map(&:name).join(", ") %> · <%= order.status.humanize %></small></div><strong><%= number_to_currency((order.total_cents - order.refunded_cents) / 100.0) %></strong></div><% end %></section></main>
