<% content_for :page_title, "Customers" %><%= render "dashboard/infrastructure/styles" %><main class="infra"><header class="infra-hero"><div><span class="infra-eyebrow">Business / Customers</span><h1>Your customer relationships.</h1><p>Purchase history and customer value for <%= @site.name %>. Purchases do not automatically subscribe anyone to marketing.</p></div><%= link_to "Commerce", dashboard_commerce_path(site_id: @site.id), class: "infra-button" %></header><%= form_with url: dashboard_customers_path, method: :get, class: "infra-form" do |f| %><%= f.hidden_field :site_id, value: @site.id %><div class="infra-field"><%= f.label :q, "Find by email" %><%= f.search_field :q, value: params[:q] %></div><%= f.submit "Find customers", class: "infra-button" %><% end %><section class="infra-panel"><% @customers.each do |customer| %><div class="infra-list-row"><div><strong><%= link_to customer.customer_email, history_dashboard_customers_path(site_id: @site.id, email: customer.customer_email) %></strong><small><%= customer[:order_count] %> orders · last purchase <%= customer[:last_purchase_at]&.to_date %></small></div><strong><%= number_to_currency(customer[:collected_cents].to_i / 100.0) %> after refunds</strong></div><% end %></section></main>
