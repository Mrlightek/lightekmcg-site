<% content_for :page_title, "Hosting retail pricing" %><%= render "dashboard/infrastructure/styles" %><main class="infra"><header class="infra-hero"><div><span class="infra-eyebrow">Operator / Revenue controls</span><h1>Hosting packages & margins</h1><p>Publish your selling price. Vendor costs and provider configuration stay here.</p></div></header>
<section class="infra-panel">
  <h2>Create a Workspace plan</h2>
  <% if @workspace_sources.any? %>
    <p>Choose a tier and the hosting package it will use. Workspace plans start hidden so you can review the price and publish from Hosting packages. Starting prices may increase to cover hosting costs, fees, and your minimum margin.</p>
    <%= form_with scope: :workspace, url: create_workspace_dashboard_hosting_packages_path, class: "infra-form" do |form| %>
      <div class="infra-fields">
        <div class="infra-field">
          <%= form.label :tier, "Workspace tier" %>
          <%= form.select :tier, Gatekeeper::Hosting::WorkspacePlans::TIERS.map { |key, tier|
            ["#{tier.fetch(:name)} · #{number_to_currency(tier.fetch(:cents) / 100.0)}/month · #{pluralize(tier.fetch(:users), 'user')}", key] } %>
        </div>
        <div class="infra-field">
          <%= form.label :source_package_id, "Hosting configuration" %>
          <%= form.collection_select :source_package_id, @workspace_sources, :id, ->(package) { package.product.name } %>
        </div>
      </div>
      <%= form.submit "Create Workspace plan", class: "infra-button infra-button-primary" %>
    <% end %>
  <% else %>
    <p>Create a retail hosting package below to set the infrastructure and cost limits for Workspace.</p>
  <% end %>
</section>
<section class="infra-panel"><h2>Hosting packages</h2><% @packages.each do |package| %><div class="infra-list-row"><div><strong><%= package.product.name %></strong><small>Retail <%= number_to_currency(package.product.price_cents / 100.0) %>/month · cost ceiling <%= number_to_currency(package.monthly_cost_ceiling_cents / 100.0) %> · <%= package.active? && package.product.published? ? "Available" : "Hidden" %></small></div><%= form_with scope: :package, url: dashboard_hosting_package_path(package), method: :patch, class: "infra-form" do |f| %><div class="infra-field"><%= f.label :price_cents, "Direct customer price (cents) · #{package.product.name}", for: "package_#{package.id}_price_cents" %><%= f.number_field :price_cents, value: package.product.price_cents, min: 1, step: 1, required: true, id: "package_#{package.id}_price_cents" %></div><div class="infra-field"><%= f.label :minimum_margin_cents, "Your minimum profit (cents) · #{package.product.name}", for: "package_#{package.id}_minimum_margin_cents" %><%= f.number_field :minimum_margin_cents, value: package.minimum_margin_cents, min: 1, step: 1, required: true, id: "package_#{package.id}_minimum_margin_cents" %></div><div class="infra-field"><%= f.label :wholesale_price_cents, "Agency wholesale price (cents) · #{package.product.name}", for: "package_#{package.id}_wholesale_price_cents" %><%= f.number_field :wholesale_price_cents, value: package.wholesale_price_cents, min: 1, step: 1, placeholder: "Use direct price until set", id: "package_#{package.id}_wholesale_price_cents" %></div><div class="infra-field"><%= f.label :reseller_minimum_margin_cents, "Required agency margin (cents) · #{package.product.name}", for: "package_#{package.id}_reseller_minimum_margin_cents" %><%= f.number_field :reseller_minimum_margin_cents, value: package.reseller_minimum_margin_cents, min: 0, step: 1, required: true, id: "package_#{package.id}_reseller_minimum_margin_cents" %></div><small>Blank wholesale follows the direct price; set it explicitly to keep the two independent. The price must cover the cost ceiling, this margin and payment fees. Applies to new checkouts. Existing subscriptions keep their agreed price.</small><%= f.submit "Save pricing", class: "infra-button infra-button-primary" %><% end %><%= button_to "Toggle availability", dashboard_hosting_package_path(package), method: :patch, class: "infra-button" %></div><% end %></section>
<section class="infra-panel"><h2>Create a retail package</h2><%= form_with scope: :package, url: dashboard_hosting_packages_path, class: "infra-form" do |f| %><div class="infra-fields">
<div class="infra-field"><%= f.label :site_id, "Platform storefront" %><%= f.collection_select :site_id, @sites, :id, :name %></div><div class="infra-field"><%= f.label :subscription_plan_id %><%= f.collection_select :subscription_plan_id, @plans, :id, :name %></div><div class="infra-field"><%= f.label :compute_provider_id %><%= f.collection_select :compute_provider_id, @providers, :id, :name %></div><div class="infra-field"><%= f.label :gatekeeper_application_template_id, "Deployment type" %><%= f.collection_select :gatekeeper_application_template_id, @templates, :id, :name %></div>
<% {name: "Package name", price_cents: "Direct monthly price (cents)", wholesale_price_cents: "Agency wholesale price (cents; blank follows direct)", reseller_minimum_margin_cents: "Required agency margin (cents)", region: "Provider region ID", provider_plan: "Provider size ID", monthly_cost_ceiling_cents: "Maximum vendor cost (cents/month)", minimum_margin_cents: "Minimum gross margin (cents/month)"}.each do |key, label| %><div class="infra-field"><%= f.label key, label %><%= f.text_field key, required: key != :wholesale_price_cents, value: [:minimum_margin_cents, :reseller_minimum_margin_cents].include?(key) ? 500 : nil %></div><% end %></div><p>Live regional pricing is checked before publishing and checkout. Use your provider catalog to choose a size and region.</p><%= link_to "Open provider sizes", new_dashboard_application_launch_path %><%= render "dashboard/reseller_packages/policy_fields", policy: LightekAgency::PackagePolicy.defaults, upstream: nil, prefix: "package_policy" %><%= f.submit "Publish hosting package", class: "infra-button infra-button-primary" %><% end %></section></main>
