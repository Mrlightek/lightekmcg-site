<% content_for :page_title, "Hosting retail pricing" %><%= render "dashboard/infrastructure/styles" %><main class="infra"><header class="infra-hero"><div><span class="infra-eyebrow">Operator / Revenue controls</span><h1>Hosting packages & margins</h1><p>Publish your selling price. Vendor costs and provider configuration stay here.</p></div></header>
<section class="infra-panel"><h2>Published packages</h2><% @packages.each do |package| %><div class="infra-list-row"><div><strong><%= package.product.name %></strong><small>Retail <%= number_to_currency(package.product.price_cents / 100.0) %>/month · cost ceiling <%= number_to_currency(package.monthly_cost_ceiling_cents / 100.0) %> · <%= package.active? ? "Available" : "Paused" %></small></div><%= button_to "Toggle availability", dashboard_hosting_package_path(package), method: :patch, class: "infra-button" %></div><% end %></section>
<section class="infra-panel"><h2>Create a retail package</h2><%= form_with scope: :package, url: dashboard_hosting_packages_path, class: "infra-form" do |f| %><div class="infra-fields">
<div class="infra-field"><%= f.label :site_id, "Platform storefront" %><%= f.collection_select :site_id, @sites, :id, :name %></div><div class="infra-field"><%= f.label :subscription_plan_id %><%= f.collection_select :subscription_plan_id, @plans, :id, :name %></div><div class="infra-field"><%= f.label :compute_provider_id %><%= f.collection_select :compute_provider_id, @providers, :id, :name %></div><div class="infra-field"><%= f.label :gatekeeper_application_template_id, "Deployment type" %><%= f.collection_select :gatekeeper_application_template_id, @templates, :id, :name %></div>
<% {name: "Package name", price_cents: "Monthly retail price (cents)", region: "Provider region ID", provider_plan: "Provider size ID", monthly_cost_ceiling_cents: "Maximum vendor cost (cents/month)", minimum_margin_cents: "Minimum gross margin (cents/month)"}.each do |key, label| %><div class="infra-field"><%= f.label key, label %><%= f.text_field key, required: true %></div><% end %></div><p>Live regional pricing is checked before publishing and checkout. Use your provider catalog to choose a size and region.</p><%= link_to "Open provider sizes", new_dashboard_application_launch_path %><%= render "dashboard/reseller_packages/policy_fields", policy: LightekAgency::PackagePolicy.defaults, upstream: nil, prefix: "package_policy" %><%= f.submit "Publish hosting package", class: "infra-button infra-button-primary" %><% end %></section></main>
