<style>
.infra{--infra-line:var(--dd-border,rgba(255,255,255,.1));--infra-surface:var(--dd-sidebar-bg,#111318);--infra-muted:var(--dd-text-secondary,#9a9890);--infra-gold:var(--dd-accent,#c4952a);max-width:1440px;margin:auto;display:grid;gap:24px}
.infra *{box-sizing:border-box}.infra a{color:inherit}.infra h1{font-size:clamp(26px,3vw,38px);letter-spacing:-.04em;line-height:1.15;margin:8px 0 12px}.infra h2{font-size:17px;letter-spacing:-.02em;margin:0}.infra p{margin:0}.infra small,.infra .infra-muted{color:var(--infra-muted)}.infra small{font-size:12px}.infra-eyebrow{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:var(--infra-gold)}
.infra-hero{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:30px;border:1px solid var(--infra-line);border-radius:16px;background:radial-gradient(ellipse at top right,rgba(196,149,42,.13),transparent 65%),var(--infra-surface)}.infra-hero p{max-width:660px;color:var(--infra-muted);line-height:1.65}.infra-actions{display:flex;align-items:center;flex-wrap:wrap;gap:10px;flex-shrink:0}
.infra .infra-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 16px;border:1px solid var(--infra-line);border-radius:8px;background:transparent;color:var(--dd-text-primary);text-decoration:none;font:inherit;font-size:12px;font-weight:650;cursor:pointer}.infra .infra-button:hover{background:rgba(128,128,128,.12)}.infra .infra-button-primary{background:var(--infra-gold);border-color:var(--infra-gold);color:#111318}.infra .infra-button-danger{background:var(--dd-danger,#cd4d3d);border-color:transparent;color:#fff}.infra :is(a,button,input,select,summary):focus-visible{outline:3px solid var(--infra-gold);outline-offset:4px}
.infra-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.infra-stat,.infra-panel{padding:24px;border:1px solid var(--infra-line);border-radius:12px;background:var(--infra-surface);min-width:0}.infra-stat{position:relative;overflow:hidden}.infra-stat-label{display:flex;align-items:center;justify-content:space-between;color:var(--infra-muted);font-size:12px}.infra-stat-label i{font-size:20px;color:var(--infra-gold)}.infra-stat strong{display:block;font-size:clamp(24px,2.4vw,34px);font-weight:650;letter-spacing:-.04em;margin:10px 0 4px;font-variant-numeric:tabular-nums}.infra-stat small{font-size:11px}.infra-columns{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:24px}.infra-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.infra-panel-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px}.infra-panel-header p{font-size:12px;color:var(--infra-muted);margin-top:5px}.infra-panel-header a{font-size:12px;color:var(--infra-gold);text-decoration:none}
.infra-badge{display:inline-flex;align-items:center;gap:7px;font-size:10px;font-weight:650;padding:5px 9px;border-radius:6px;white-space:nowrap;background:rgba(128,128,128,.12);color:var(--infra-muted)}.infra-badge:before{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}.infra-good{color:var(--dd-success,#3dae82);background:rgba(61,174,130,.12)}.infra-danger{color:#f08b7e;background:rgba(205,77,61,.13)}.infra-warning{color:#e6b95e;background:rgba(196,149,42,.12)}
.infra-meter{height:9px;background:var(--infra-line);border-radius:8px;overflow:hidden;display:flex}.infra-meter span{display:block;height:100%;background:var(--infra-gold)}.infra-meter .infra-fill-good{background:var(--dd-success,#3dae82)}.infra-meter .infra-fill-danger{background:var(--dd-danger,#cd4d3d)}.infra-meter .infra-fill-neutral{background:#7b8496}.infra-meter-label{display:flex;justify-content:space-between;gap:12px;margin:18px 0 8px;font-size:12px}.infra-chart{display:flex;align-items:center;gap:28px;padding:6px 0 18px}.infra-ring{width:148px;height:148px;border-radius:50%;display:grid;place-items:center;flex-shrink:0}.infra-ring-center{width:118px;height:118px;border-radius:50%;background:var(--infra-surface);display:flex;align-items:center;justify-content:center;flex-direction:column}.infra-ring strong{font-size:28px;letter-spacing:-.04em}.infra-legend{display:grid;gap:12px;width:100%;font-size:12px}.infra-legend-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.infra-dot{display:inline-block;width:8px;height:8px;border-radius:3px;margin-right:8px;background:var(--infra-gold)}.infra-dot-good{background:var(--dd-success,#3dae82)}.infra-dot-danger{background:var(--dd-danger,#cd4d3d)}.infra-dot-neutral{background:#7b8496}.infra-legend-row strong{font-variant-numeric:tabular-nums}
.infra-shortcuts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.infra-shortcut{display:block;padding:20px;border:1px solid var(--infra-line);border-radius:10px;text-decoration:none;transition:border-color .15s}.infra-shortcut:hover{border-color:var(--infra-gold)}.infra-shortcut i{display:block;color:var(--infra-gold);font-size:24px;margin-bottom:14px}.infra-shortcut strong{display:block;margin-bottom:6px;font-size:13px}.infra-shortcut small{display:block;line-height:1.6}
.infra-table-wrap{overflow-x:auto}.infra-table{width:100%;border-collapse:collapse;text-align:left;font-size:12px}.infra-table th{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--infra-muted);padding:0 12px 14px;border-bottom:1px solid var(--infra-line)}.infra-table td{padding:16px 12px;border-bottom:1px solid var(--infra-line);vertical-align:middle}.infra-table th:first-child,.infra-table td:first-child{padding-left:0}.infra-table tr:last-child td{border-bottom:0}.infra-table td strong{display:block;font-weight:600;font-size:13px}.infra-table td small{display:block;margin-top:4px;overflow-wrap:anywhere}.infra-table a{text-decoration:none}.infra-table a:hover{color:var(--infra-gold)}.infra-list-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 0;border-bottom:1px solid var(--infra-line)}.infra-list-row:last-child{border-bottom:0}.infra-list-row strong{display:block;font-size:13px}.infra-list-row small{display:block;margin-top:4px;overflow-wrap:anywhere}.infra-empty{padding:32px 16px;text-align:center;color:var(--infra-muted);font-size:13px;line-height:1.8}.infra-empty i{display:block;font-size:28px;color:var(--infra-gold);margin-bottom:12px}
.infra-form{display:grid;gap:20px}.infra-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.infra-field{display:grid;gap:8px}.infra-field label{font-size:12px;font-weight:600}.infra-field input,.infra-field select{width:100%;min-height:46px;border:1px solid var(--infra-line);border-radius:8px;background:var(--dd-card-bg,#181b22);color:var(--dd-text-primary,#f0eee8);padding:11px 13px;font:inherit;font-size:13px}.infra-field small{font-size:11px;line-height:1.6}.infra-form-footer{border-top:1px solid var(--infra-line);padding-top:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}.infra-form-footer p{font-size:12px;color:var(--infra-muted);max-width:440px}.infra-note{padding:14px 16px;border-radius:8px;background:rgba(196,149,42,.08);border:1px solid rgba(196,149,42,.2);font-size:12px;line-height:1.7}.infra-delete{border-color:rgba(205,77,61,.35)}.infra-delete summary{cursor:pointer;display:list-item;font-weight:600;font-size:14px;color:#f08b7e}.infra-delete[open] summary{margin-bottom:20px}.infra-delete p{font-size:13px;color:var(--infra-muted);line-height:1.7;margin-bottom:20px}.infra-back{font-size:12px;text-decoration:none;color:var(--infra-muted)!important}.infra-pagination{padding-top:20px;border-top:1px solid var(--infra-line)}
@media(max-width:1100px){.infra-hero{align-items:flex-start;flex-direction:column}.infra-columns{grid-template-columns:1fr}.infra-stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.infra-stat{padding:18px}}
@media(max-width:650px){.infra{gap:16px}.infra-hero,.infra-panel{padding:20px}.infra-stats,.infra-two,.infra-fields{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.infra-two,.infra-fields{grid-template-columns:1fr}.infra-chart{gap:20px}.infra-ring{width:120px;height:120px}.infra-ring-center{width:96px;height:96px}.infra-shortcuts{grid-template-columns:1fr}.infra-table{min-width:550px}.infra-stat strong{font-size:24px;overflow-wrap:anywhere}.infra-actions{width:100%}.infra-actions .infra-button{flex:1}}
</style>
