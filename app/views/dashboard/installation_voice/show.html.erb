<% content_for :page_title, "Lightek Voice" %>
<%= render "dashboard/settings_home/style" %>
<main class="lt-settings">
  <p><%= link_to "Your workspace", dashboard_client_home_path %></p>
  <h1>Lightek Voice</h1>
  <section class="card">
    <h2><%= {
      "available" => "Add phone service",
      "pending_payment" => "Checkout pending",
      "provisioning" => "Phone service is being set up",
      "in_service" => "Phone service active",
      "suspended" => "Phone service suspended",
      "needs_review" => "Contact support about this order",
      "unavailable" => "Phone service signup is unavailable"
    }.fetch(@voice["status"], "Phone service status unavailable") %></h2>
    <% if @voice["status"] == "available" %>
      <p>Voice is billed separately from your existing service.</p>
      <div class="grid">
        <% @voice.fetch("offers").each do |offer| %>
          <section class="card">
            <h3><%= offer.fetch("name") %></h3>
            <% if offer["description"].present? %><p><%= offer["description"] %></p><% end %>
            <p><%= number_to_currency(offer.fetch("price_cents") / 100.0) %> per <%= offer.fetch("billing_interval") %>, plus applicable taxes.</p>
            <%= button_to "Choose #{offer.fetch("name")}", dashboard_installation_voice_path, params: { plan: offer.fetch("key") } %>
          </section>
        <% end %>
      </div>
    <% elsif @voice["status"] == "pending_payment" %>
      <p><%= number_to_currency(@voice.fetch("price_cents") / 100.0) %> per <%= @voice.fetch("billing_interval") %>, plus applicable taxes.</p>
      <%= button_to "Resume checkout", dashboard_installation_voice_path %>
    <% elsif @voice["billing_status"].present? %>
      <p>Subscription <%= @voice["billing_status"].humanize.downcase %></p>
    <% end %>
    <p><%= link_to "Customer Service & Billing", dashboard_customer_service_path %></p>
  </section>
</main>
