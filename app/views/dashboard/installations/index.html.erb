<% content_for :page_title, "Application installations" %>
<main class="lt-settings" style="padding:28px;max-width:1200px"><h1>Application installations</h1><p>Track paid orders through delivery and resume an existing allocation when needed.</p><p><%= link_to "My Applications", installations_path %> · <%= link_to "Network Controllers", dashboard_network_path %></p>
<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse"><thead><tr><th style="text-align:left;padding:14px">Order / customer</th><th style="text-align:left;padding:14px">Payment</th><th style="text-align:left;padding:14px">Installation</th><th style="text-align:left;padding:14px">Actions</th></tr></thead><tbody>
<% @orders.each do |order| %><% status = LightekCommerce::Installations.summary(order) %><tr style="border-top:1px solid #ddd"><td style="padding:14px">#<%= order.id %> · <%= order.site.name %><br><%= order.customer_email %></td><td style="padding:14px"><%= order.status.humanize %><br><%= number_to_currency(order.total_cents / 100.0) %></td><td style="padding:14px"><strong><%= status[:state].humanize %></strong><br><%= status[:hostname] %><% if order.provisioned_at? %><br><small>Verified <%= l(order.provisioned_at, format: :short) %></small><% end %></td><td style="padding:14px"><% if status[:ready] %><%= link_to "Open application", status[:url], target: "_blank", rel: "noopener" %><% if LightekCommerce::Installations.can_manage_access?(current_user, order) %><br><%= link_to "Account setup & access", installation_path(order) %><% end %><% elsif status[:retryable] %><%= button_to "Resume paid installation", resume_dashboard_installation_path(order), method: :post, data: {turbo: false} %><% else %>Waiting for <%= order.paid_at? ? "installation" : "payment" %><% end %></td></tr><% end %>
<% if @orders.empty? %><tr><td colspan="4" style="padding:24px">No application orders yet. Customers purchase from My Applications.</td></tr><% end %></tbody></table></div></main>
