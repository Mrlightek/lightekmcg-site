<% content_for :page_title, 'Onboarding & offboarding' %>
<%= stylesheet_link_tag '/lightek/people-workspace.css?v=20261113' %>
<main class="lp-workspace"><header class="lp-heading"><div><span class="lp-eyebrow">LIGHTEK / PEOPLE & AGENCIES</span><h1>Onboarding & offboarding</h1><p>Prepare the person. Verify access. Hand off the work. Preserve the records.</p></div><%= link_to 'People & access', dashboard_people_path(employer_id: @employer.id), class: 'lp-button secondary' %></header>
<%= form_with url: dashboard_lifecycle_path, method: :get, class: 'lp-form' do %><label>Business account<%= select_tag :employer_id, options_from_collection_for_select(@employers, :id, :email_address, @employer.id) %></label><%= submit_tag 'Switch', class: 'lp-button secondary' %><% end %>
<section class="lp-card"><h2>Prepare a lifecycle</h2><p>Create inactive team memberships in People before employee onboarding. HR prepares identity and handoff steps; IT reviews access. Agency activation is reviewed by the upstream owner. Preparing agency onboarding pauses client management until the checklist is complete; existing client services remain running.</p>
<%= form_with url: start_dashboard_lifecycle_path(employer_id: @employer.id), class: 'lp-form' do %><div class="lp-grid"><label>Employee membership<%= select_tag :subject_id, options_for_select(@people.map { |person| ["#{person.worker.email_address} · #{person.title}", person.id] }), required: true %></label><label>Process<%= select_tag :kind, options_for_select([['Employee onboarding', 'employee_onboarding'], ['Employee offboarding', 'employee_offboarding']]) %></label></div><%= submit_tag 'Prepare employee process', class: 'lp-button' %><% end %>
<%= form_with url: start_dashboard_lifecycle_path(employer_id: @employer.id), class: 'lp-form' do %><div class="lp-grid"><label>Direct agency account<%= select_tag :subject_id, options_from_collection_for_select(@agencies, :id, :email_address), required: true %></label><label>Process<%= select_tag :kind, options_for_select([['Agency onboarding', 'agency_onboarding'], ['Agency offboarding', 'agency_offboarding']]) %></label></div><%= submit_tag 'Prepare agency process', class: 'lp-button secondary' %><% end %></section>
<% @cases.each do |record| %><section class="lp-card"><span class="lp-eyebrow"><%= record.status.humanize %></span><h2><%= record.kind.humanize %> · <%= record.subject.is_a?(User) ? record.subject.email_address : record.subject.worker.email_address %></h2><p>Prepared by <%= record.created_by.email_address %> · <%= record.created_at.to_fs(:short) %></p>
<% if record.kind.end_with?('_offboarding') && !record.access_revoked_at? %><div role="note"><p>Revoke now: disable the employer membership or agency login, end application sessions, rotate the API token, revoke Connect access and hand off active sales work. Completed sales, payments, customers and client services are retained. External access and running jobs still require verification below.</p><%= form_with url: revoke_dashboard_lifecycle_path(id: record.id, employer_id: @employer.id), class: 'lp-form' do %><%= hidden_field_tag :lock_version, record.lock_version %><label class="lp-check"><%= check_box_tag :confirmed, '1', false, required: true %> I reviewed the access impact and handoff to the business owner.</label><%= submit_tag 'Revoke access & hand off work', class: 'lp-button' %><% end %></div><% end %>
<% LightekPeople::Lifecycle::STEPS.fetch(record.kind).each do |key, (permission, label)| %><article style="padding:16px 0;border-bottom:1px solid var(--dd-border)"><h3><%= label %></h3><small>Authority: <%= permission.humanize %></small><% if record.steps[key] %><p><%= record.steps[key]['evidence'] %></p><small>Actor #<%= record.steps[key]['actor_id'] %> · <%= record.steps[key]['at'] %></small><% elsif !record.status.in?(%w[completed canceled]) %><%= form_with url: step_dashboard_lifecycle_path(id: record.id, employer_id: @employer.id), class: 'lp-form' do %><%= hidden_field_tag :lock_version, record.lock_version %><%= hidden_field_tag :step, key %><label>Completed work / evidence<%= text_area_tag :evidence, nil, required: true, maxlength: 2000, rows: 2 %></label><%= submit_tag 'Record completion', class: 'lp-button secondary' %><% end %><% end %></article><% end %>
<% if record.access_revoked_at? %><h3>Revocation receipt</h3><p>Revoked by <%= record.revoked_by&.email_address %> · <%= record.access_revoked_at.to_fs(:long) %></p><% if record.receipt['handoff_state'] != 'completed' %><p role="alert">Access is revoked. Open-work handoff needs attention: <%= record.receipt['handoff_error'] %></p><% failed = record.receipt['handoff_failed_record'] %><% repair_kind = LightekSales::Workspace::RECORDS.find { |key, model| model.name == failed&.fetch('type', nil) }&.first %><% if repair_kind && failed['site_id'] %><p><%= link_to 'Open record needing repair', dashboard_sales_record_path(kind: repair_kind, id: failed['id'], site_id: failed['site_id']) %></p><% end %><%= button_to 'Retry open-work handoff', revoke_dashboard_lifecycle_path(id: record.id, employer_id: @employer.id), params: {lock_version: record.lock_version, confirmed: '1'}, class: 'lp-button secondary' %><% end %><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= JSON.pretty_generate(record.receipt) %></pre><% end %>
<% unless record.status.in?(%w[completed canceled]) %><% if record.kind.end_with?('_onboarding') %><%= button_to 'Cancel onboarding', cancel_dashboard_lifecycle_path(id: record.id, employer_id: @employer.id), params: {lock_version: record.lock_version}, class: 'lp-button secondary' %><% end %><%= button_to 'Complete lifecycle', complete_dashboard_lifecycle_path(id: record.id, employer_id: @employer.id), params: {lock_version: record.lock_version}, class: 'lp-button' %><% end %></section><% end %></main>
