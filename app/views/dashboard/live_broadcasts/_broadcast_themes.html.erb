<div class="ll-theme-controls" data-look-themes="<%= kind %>">
  <div class="ll-grid">
    <label>Theme name<input type="text" maxlength="40" data-theme-name></label>
    <label>Saved themes<select data-theme-list></select></label>
  </div>
  <button type="button" data-theme-save>Save theme</button>
  <button type="button" data-theme-load>Load theme</button>
  <button type="button" data-theme-delete>Delete theme</button>
  <p class="ll-note" role="status" data-theme-status>Themes are saved in this browser.</p>
</div>
