<details class="ll-config" data-live-effects>
  <summary>Special effects layer</summary>
  <canvas width="1280" height="720" class="ll-effects-preview" data-effects-preview aria-label="Private animation preview"></canvas>
  <div class="ll-slate-fields">
    <label>Animation<select data-effect="kind">
      <option value="burst">Spark burst</option>
      <option value="confetti">Confetti</option>
      <option value="sweep">Light sweep</option>
      <option value="gif">Animated GIF</option>
    </select></label>
    <label>GIF file<input type="file" accept=".gif,image/gif" data-effect="file"></label>
    <label>Color<input type="color" value="#f7c460" data-effect="color"></label>
    <label>Size (%)<input type="range" min="8" max="90" value="35" data-effect="size"></label>
    <label>Horizontal position (%)<input type="range" min="0" max="100" value="50" data-effect="x"></label>
    <label>Vertical position (%)<input type="range" min="0" max="100" value="45" data-effect="y"></label>
    <label>Opacity (%)<input type="range" min="10" max="100" value="85" data-effect="opacity"></label>
    <label>Cue length (seconds)<input type="number" min="1" max="30" value="3" data-effect="seconds"></label>
    <label><input type="checkbox" data-effect="loop"> Loop until cleared</label>
  </div>
  <button type="button" data-effects-try>Preview effect</button>
  <button type="button" data-effects-cue>Cue on program</button>
  <button type="button" data-effects-clear>Clear effects layer</button>
  <p class="ll-note" role="status" data-effects-status>Preview stays private. Cue uses the current settings.</p>
</details>
