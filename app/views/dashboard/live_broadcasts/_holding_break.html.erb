<details class="ll-config" data-holding-break data-break-scope="<%= current_user.id %>:<%= @site.id %>" data-break-brand="<%= @site.name %>">
  <summary>Holding screen & commercial breaks</summary>
  <p class="ll-note">The holding screen hides the camera and screen and mutes microphones and guests. Start a break manually to play your lineup. If a source drops unexpectedly, viewers see the slate.</p>
  <%= render "dashboard/live_broadcasts/slate_design" %>
  <% break_visuals = @library_assets.select { |asset| %w[image video].include?(asset.kind) } %>
  <% 1.upto(3) do |position| %>
    <label>Break item <%= position %><select data-break-item>
      <option value="">Empty</option>
      <% break_visuals.each do |asset| %>
        <option value="<%= asset.id %>" data-kind="<%= asset.kind %>"><%= asset.name %> · <%= asset.kind %></option>
      <% end %>
    </select></label>
  <% end %>
  <p class="ll-note">Images play for 10 seconds. Commercials play with their own sound. At the end of the lineup, the slate returns.</p>
  <label>Break music<select data-break-music>
    <option value="">No break music</option>
    <% @library_assets.select { |asset| asset.kind == "audio" }.each do |asset| %>
      <option value="<%= asset.id %>"><%= asset.name %></option>
    <% end %>
  </select></label>
  <label>Music level<input type="range" min="0" max="1" step="0.05" value="0.25" data-break-volume></label>
  <% if @break_agency_demo_url || @break_demo_url %>
    <label><input type="checkbox" data-break-demo="<%= @break_agency_demo_url || @break_demo_url %>"> Show demo registration QR during breaks</label>
    <% if @break_agency_demo_url && @break_demo_url %>
      <label>Demo form for the QR<select data-break-demo-target>
        <option value="<%= @break_agency_demo_url %>">Agency membership demo</option>
        <option value="<%= @break_demo_url %>">Client workspace demo</option>
      </select></label>
    <% end %>
    <% if @break_agency_demo_url %><%= link_to 'Open the agency demo form', @break_agency_demo_url, target: '_blank', rel: 'noopener' %><% end %>
    <% if @break_demo_url %><%= link_to 'Open the client demo form', @break_demo_url, target: '_blank', rel: 'noopener' %><% end %>
    <% if @break_agency_settings_path %><%= link_to 'Agency demo settings', @break_agency_settings_path %><% end %>
  <% else %>
    <p class="ll-note">
      Enable a public demo form to add a registration QR.
      <% if @break_agency_settings_path %><%= link_to 'Agency demo settings', @break_agency_settings_path %><% end %>
      <% if @break_demo_settings_path %><%= link_to 'Client demo settings', @break_demo_settings_path %><% end %>
    </p>
  <% end %>
  <button type="button" data-break-save>Save break settings</button>
  <button type="button" data-break-next disabled>Skip to next item</button>
  <p role="status" data-break-status>Start a break with the Holding screen button. Settings are saved in this browser.</p>
</details>
