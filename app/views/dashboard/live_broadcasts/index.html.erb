<% content_for :page_title, "Live Studio" %>
<%= stylesheet_link_tag "/lightek/live/studio.css?v=3" %>
<%= javascript_include_tag "/lightek/live/studio.js?v=8", defer: true %>
<%= javascript_include_tag '/lightek/vendor/livekit-2.23.0.umd.js', defer: true %>
<%= javascript_include_tag '/lightek/live/audience.js?v=1', defer: true %>
<main class="ll-studio" data-live-studio data-create-url="<%= dashboard_live_sessions_path(site_id: @site.id) %>">
  <%= render "shared/production_navigation", site: @site, section: "Live Studio" %>
  <header class="ll-header"><div><span class="ll-eyebrow">LIGHTEK / STUDIO</span><h1>Your work. On air.</h1><p>Build, share and broadcast from Lightek.</p></div><span class="ll-badge" data-state>Preview only</span></header>
  <nav class="ll-workflow-links" aria-label="Live production steps"><a href="#live-guests">1 · Guests</a><a href="#live-program">2 · Program & stage</a><a href="#live-destinations">3 · Broadcast</a><a href="#live-audience">4 · Audience</a></nav>
  <div class="ll-grid">
    <section class="ll-monitor" id="live-program" aria-label="Broadcast preview">
      <div class="ll-monitor-top"><span>PROGRAM PREVIEW</span><span>720p · 24 fps</span></div>
      <div class="ll-screen"><video autoplay muted playsinline data-preview></video><div class="ll-placeholder" data-placeholder><span>◉</span><h2>Choose your camera or screen</h2><p>Preview your Mac camera, a shared window, or both. Nothing is sent until you start a session.</p></div></div>
      <div class="ll-monitor-bottom"><span data-source-status>No video source selected</span><span data-clock>00:00</span></div>
      <div class="ll-controls"><button type="button" data-share>Choose screen</button><button type="button" data-mic aria-pressed="false">Enable microphone</button><button type="button" data-hold aria-pressed="false">Holding screen</button><button type="button" data-release>Release capture</button></div>
      <div class="ll-inputs"><button type="button" data-camera aria-pressed="false">Enable camera</button><label>Camera<select data-camera-device><option value="">System default camera</option></select></label><label>Broadcast view<select data-layout><option value="screen">Screen only</option><option value="camera">Camera only</option><option value="combined">Screen + camera</option><option value="library">Library image / video</option><option value="stage">3D stage + camera</option><option value="session">Lightek session room</option></select></label></div>
      <details class="ll-config" open id="live-guests"><summary>Guests & room source</summary><p><%= link_to "Create or open a room", dashboard_rooms_path(site_id: @site.id) %> · <%= link_to "Set up room service", dashboard_session_media_path(site_id: @site.id) %></p><p>Keep your session room open in its own tab. Everyone joining accepts the broadcast notice. Connect here to mix their audio, cameras, or shared screen into the program.</p><label>Session room<select data-session-key><option value="">Choose a scheduled room</option><% @session_rooms.each do |room| %><option value="<%= room.key %>" <%= 'selected' if params[:session_room] == room.key %>><%= room.resource.name %> · <%= room.starts_at.strftime('%b %-d, %H:%M') %></option><% end %></select></label><button type="button" data-connect-session>Connect session source</button>
<% if @session_rooms.empty? %><p class="ll-note">No active rooms yet. Create a private room from Rooms & guests, or open a confirmed video/audio booking from Reservations.</p><% end %>
<div data-session-director><h3>Choose your program layout</h3><div class="production-presets"><button type="button" data-stage-preset="gallery">Panel</button><button type="button" data-stage-preset="presenter">Presenter</button><button type="button" data-stage-preset="split">Interview</button><button type="button" data-stage-preset="fullscreen">Featured guest</button></div><p>Connect an open room to see its guests in the program. Choose a layout, then save to reuse it for this room.</p><details data-presentation-options><summary>Customize layout & branding</summary><div data-presentation-fields><label>Stage layout<select data-presentation="layout"><option value="gallery">Branded panel / gallery</option><option value="presenter">Presenter + guest sidebar</option><option value="split">Side by side interview</option><option value="fullscreen">Featured guest / screen</option></select></label><label>Show title<input data-presentation="title" maxlength="120"></label><label>Subtitle<input data-presentation="subtitle" maxlength="120"></label><label>Brand<input data-presentation="brand" maxlength="120"></label><label>Background<input type="color" value="#142f2c" data-presentation="background"></label><label>Accent<input type="color" value="#d6edac" data-presentation="accent"></label><label>Scrolling banner<input data-presentation="ticker" maxlength="300"></label><label>Featured participant<select data-presentation="featured"><option value="">Automatic / shared screen first</option></select></label><label>Style participant<select data-style-person><option value="">Choose a connected participant</option></select></label><label>Display name<input data-person-style="name" maxlength="80"></label><label>Lower-third role / title<input data-person-style="role" maxlength="80"></label><label>Camera effect<select data-person-style="effect"><option value="clean">Clean</option><option value="mono">Monochrome</option><option value="warm">Warm</option><option value="cool">Cool</option><option value="soft">Soft focus</option></select></label><label>Frame<select data-person-style="fit"><option value="contain">Fit full image</option><option value="cover">Fill / crop</option></select></label><label><input type="checkbox" data-person-style="mirror"> Mirror this guest</label></div></details><button type="button" data-save-presentation>Save this room’s presentation</button><p data-presentation-status>Adjustments update the program preview. Save to reuse this room’s stage.</p></div><p data-session-status>Connect when the host opens the room. Gallery output includes up to 12 tiles; choose presenter, interview, or featured layouts above. The composed session can also become a live screen inside your Blender/GLB stage.</p></details>
      <%= render "dashboard/live_broadcasts/library_sources" %>
      <details class="ll-config"><summary>Advanced · virtual production · Blender stage</summary><p>Load a prepared Blender/GLB asset. Its animation, cameras and geometry enter this program feed. Your keyed camera becomes a plane inside the 3D scene, so stage geometry can appear in front of or behind it.</p><label>3D stage subject<select data-stage-subject-source><option value="camera">My camera</option><option value="session">Composed session stage</option></select></label><label>3D set / stage<select data-stage-asset><option value="">Choose a prepared Blender asset</option><% @stage_assets.each do |asset| %><option value="<%= asset.id %>" data-stage-url="/api/lightek/pwa/assets/<%= asset.id %>/proxy" <%= "selected" if params[:library_asset_id].to_s==asset.id.to_s %>><%= asset.name %></option><% end %></select></label><button type="button" data-stage-load>Load 3D stage</button><label>Stage camera<select data-stage-camera><option value="">Automatic stage framing</option></select></label><label><input type="checkbox" data-stage-subject checked> Include my camera in the set</label><label><input type="checkbox" data-stage-key checked> Remove chroma background</label><label>Background key color<input type="color" value="#00ff00" data-stage-color></label><label>Key tolerance<input type="range" min="0.05" max="1" step="0.01" value="0.4" data-stage-threshold></label><label>Subject X<input type="number" step="0.1" value="0" data-stage-x></label><label>Subject depth<input type="number" step="0.1" value="0" data-stage-depth></label><label>Subject Z<input type="number" step="0.1" value="1.5" data-stage-z></label><label>Subject height<input type="number" step="0.1" min="0.1" value="3" data-stage-height></label><p role="status" data-stage-status>Choose a Blender stage to begin. Webcam compositing uses chroma key; a green/blue background gives the best cutout.</p></details>
      <div class="ll-meter"><label>Microphone level <meter min="0" max="1" value="0" data-meter></meter></label><span data-mic-status>Microphone off</span></div>
      <p class="ll-note">The preview is muted to prevent feedback. Holding screen hides both screen and camera and mutes the microphone. Ending an active video source also activates holding screen.</p>
    </section>
    <aside class="ll-panel" id="live-destinations"><h2>Broadcast</h2>
      <label>Session title<input type="text" value="Building Lightek · Live" maxlength="120" data-title></label>
      <label>Destination<select data-destination><option value="lightek">Lightek · community or My Space</option><option value="test">Private test recording · 2 minutes max</option><option value="simulcast" <%= "disabled" unless @restream_ready %>>Lightek / OTT + Restream</option><option value="restream" <%= "disabled" unless @restream_ready %>>Restream · TikTok & connected channels<%= " · connection needed" unless @restream_ready %></option><option value="tiktok" <%= "disabled" unless @tiktok_ready %>>TikTok LIVE<%= " · connection needed" unless @tiktok_ready %></option></select></label>
      <label>Community<select data-community><option value="">My Space</option><% @communities.each do |community| %><option value="<%= community.slug %>" <%= "selected" if params[:community_slug]==community.slug %>><%= community.name %></option><% end %></select></label><label>Audience<select data-audience><option value="everyone">Everyone allowed in this space</option><option value="women">Women only</option><option value="men">Men only</option></select></label>
      <div class="ll-checks"><p><span class="<%= @encoder_ready ? 'll-good' : 'll-wait' %>">●</span> Server encoder: <%= @encoder_ready ? "ready" : "installation needed" %></p><p><span class="<%= @restream_ready ? 'll-good' : 'll-wait' %>">●</span> Restream: <%= @restream_ready ? "destination stored; verify TikTok channel in Restream" : "not connected" %></p><p><span class="<%= @tiktok_ready ? 'll-good' : 'll-wait' %>">●</span> TikTok direct: <%= @tiktok_ready ? "destination stored; access not yet verified" : "not connected" %></p></div>
      <button type="button" class="ll-primary" data-start <%= "disabled" unless @encoder_ready %>>Start private test</button>
      <button type="button" class="ll-stop" data-stop disabled>Stop session</button>
      <p role="status" aria-live="polite" data-status>Choose your camera, screen or guest room to begin.</p><p role="alert" data-error hidden></p><a data-download hidden>Download test recording</a>
      <p class="ll-note">A private test stays on your server. “Sending” means the server encoder is producing output; confirm visibility in TikTok separately. Restream sends to the channels enabled in your Restream stream.</p>
    </aside>
  </div>
  <% if current_user.role.to_s.in?(%w[admin super_admin]) || current_user.can_access_feature?("live") %>
    <details class="ll-config"><summary>Connect Restream for TikTok & multistreaming</summary>
      <ol><li><a href="https://app.restream.io/" target="_blank" rel="noopener noreferrer">Open Restream</a>. Go to Channels → Add New → TikTok Live and authorize your TikTok account. If access is denied, complete Restream’s application before broadcasting.</li><li>Create New Stream → Encoder | RTMP. Enable your TikTok channel and disable any channels you do not intend to broadcast to.</li><li>Choose RTMPS when available. Copy Restream’s server URL and stream key into the fields below.</li><li>Save, select “Restream · TikTok & connected channels” above, and start from Lightek. Check the Restream preview and confirm the broadcast on TikTok.</li></ol>
      <p>Use the server URL and stream key from your working Restream encoder stream. Lightek sends the program feed to Restream, which distributes it to your enabled TikTok and other channels.</p>
      <%= form_with url: dashboard_live_destination_path, method: :post, local: true, data: {turbo: false} do %>
        <%= hidden_field_tag :site_id, @site.id %><%= hidden_field_tag :provider, "restream" %>
        <label>Restream server URL<%= url_field_tag :server_url, nil, required: true, id: "restream_server_url", placeholder: "rtmps://…restream.io/…", autocomplete: "off" %></label>
        <label>Restream stream key<%= password_field_tag :stream_key, nil, id: "restream_stream_key", required: true, autocomplete: "new-password" %></label>
        <%= submit_tag "Save Restream destination in Vault" %>
      <% end %>
    </details>
    <details class="ll-config"><summary>Connect TikTok directly with a TikTok stream key</summary><p>If TikTok supplies a server URL and stream key for your account, you can use them directly. Both destinations are stored separately in Lightek Vault and never returned to the preview.</p>
      <%= form_with url: dashboard_live_destination_path, method: :post, local: true, data: {turbo: false} do %>
        <%= hidden_field_tag :site_id, @site.id %><%= hidden_field_tag :provider, "tiktok" %>
        <label>TikTok server URL<%= url_field_tag :server_url, nil, required: true, placeholder: "rtmps://…", autocomplete: "off" %></label>
        <label>TikTok stream key<%= password_field_tag :stream_key, nil, required: true, autocomplete: "new-password" %></label>
        <%= submit_tag "Save TikTok destination in Vault" %>
      <% end %>
    </details>
  <% end %>
  <%= render 'dashboard/live_broadcasts/audience_desk' %>
  <section class="ll-recent"><h2>Recent sessions</h2><p class="ll-note">Private test recordings are retained for 24 hours when the cleanup task runs.</p>
    <% if @recent.empty? %><p>No sessions yet. Your first test will appear here.</p><% end %>
    <% @recent.each do |operation| %><article><div><strong><%= operation.metadata["title"] %></strong><small><%= {"test" => "Private test", "restream" => "Restream multistream", "simulcast" => "Lightek + Restream", "tiktok" => "TikTok"}.fetch(operation.metadata["destination"], "Broadcast") %> · <%= operation.created_at.strftime("%b %d, %H:%M %Z") %></small></div><span><%= operation.status == "live" ? "Sending" : operation.status.humanize %></span><% if operation.metadata["destination"] == "test" && operation.status == "ended" && Studio::Live::Encoder.recording_path(operation.id).file? %><%= link_to "Download", dashboard_live_recording_path(operation), data: {turbo: false} %><% end %></article><% end %>
  </section>
</main>
