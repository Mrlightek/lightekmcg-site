<section class="panel" id="mail-groups"><h2>Distribution groups</h2><p>One address, a copy in every member’s Lightek mailbox. Members must belong to the same customer; groups cannot contain other groups.</p>
<% @groups.each do |group| %><article class="panel"><h3><%= group.display_name %> · <%= group.address %></h3><p class="muted"><%= group.members.map(&:address).join(", ") %></p><details><summary>Edit group</summary><%= form_with url: dashboard_mail_group_path(group_id: group.id), method: :patch, local: true do %><label>Group name<%= text_field_tag :display_name, group.display_name, id: "group_name_#{group.id}", required: true, maxlength: 120 %></label><label>Members<%= select_tag :member_ids, options_from_collection_for_select(@accounts.where(user_id: group.user_id), :id, :address, group.members.map(&:id)), multiple: true, name: "member_ids[]", id: "group_members_#{group.id}", required: true %></label><%= submit_tag "Save group" %><% end %><%= form_with url: dashboard_mail_group_path(group_id: group.id), method: :delete, local: true do %><label>Type <%= group.address %> to delete the group<%= text_field_tag :confirmation, nil, id: "group_delete_#{group.id}", required: true, autocomplete: "off" %></label><%= submit_tag "Delete group", class: "dd-button dd-button-danger" %><% end %></details></article><% end %>
<details><summary>Create a group</summary><%= form_with url: dashboard_mail_groups_path, local: true do %><label>Group name<%= text_field_tag :display_name, nil, id: "new_group_name", required: true, placeholder: "IT team", maxlength: 120 %></label><label>Domain<%= select_tag :domain_id, options_from_collection_for_select(@domains, :id, :name), id: "new_group_domain", required: true %></label><label>Address before @<%= text_field_tag :local_part, nil, id: "new_group_address", required: true, placeholder: "it" %></label><label>Member mailboxes<%= select_tag :member_ids, options_from_collection_for_select(@accounts, :id, :address), multiple: true, name: "member_ids[]", id: "new_group_members", required: true %></label><small>Choose mailboxes belonging to the selected domain’s customer. Sending to the group delivers to their individual inboxes.</small><%= submit_tag "Create distribution group" %><% end %></details></section>
