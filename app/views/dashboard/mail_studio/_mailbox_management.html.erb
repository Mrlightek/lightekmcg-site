<section class="panel"><h2>Mailbox name</h2><p class="muted"><%= @account.address %></p><%= form_with url: dashboard_mail_account_path(account_id: @account.id), method: :patch, local: true do %><label>Display name<%= text_field_tag :display_name, @account.display_name, required: true, maxlength: 120 %></label><%= hidden_field_tag :auto_reply_enabled, @account.auto_reply_enabled? ? "1" : "0" %><%= hidden_field_tag :auto_template_id, @account.auto_template_id %><% if current_user.role == "super_admin" %><%= hidden_field_tag :enabled, @account.enabled? ? "1" : "0" %><%= hidden_field_tag :daily_limit, @account.daily_limit %><%= hidden_field_tag :storage_limit, @account.storage_limit %><% end %><%= submit_tag "Save mailbox name" %><% end %>
<details><summary>Delete mailbox</summary><p>Removes this mailbox from Mail, stops receiving, and revokes application keys. Existing messages are retained separately and will not appear in a new mailbox using this address.</p><%= form_with url: dashboard_mail_account_path(account_id: @account.id), method: :delete, local: true do %><label>Type <%= @account.address %> to confirm<%= text_field_tag :confirmation, nil, required: true, autocomplete: "off" %></label><%= submit_tag "Delete mailbox", class: "danger", data: {turbo_confirm: "Delete this mailbox and disable its application keys?"} %><% end %></details></section>
