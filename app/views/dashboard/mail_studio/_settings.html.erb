<% if @account %>
<section class="panel receiving-panel"><div><span class="eyebrow">MAILBOX HEALTH</span><h2>Incoming & outgoing mail</h2><p><span class="status-badge"><%= @account.sending_ready? && LightekMail::SendingPolicy.current.sending_enabled? ? "Sending enabled" : "Sending paused" %></span> <span class="status-badge"><%= @account.enabled? && @account.domain.verified_at ? "Receiving eligible" : "Receiving paused" %></span></p><p class="muted"><%= @last_received_at ? "Last received: #{@last_received_at.strftime('%b %d, %Y · %H:%M')}" : "No incoming messages recorded yet." %> Eligibility does not verify live delivery.</p><small class="muted">Incoming mail needs the domain’s MX record, a reachable SMTP listener and a route into this inbox.</small></div><%= button_to "Check receiving DNS", check_receiving_dashboard_mail_path(account_id: @account.id), method: :post, class: "secondary" %></section>
<% if @account.suspended? %><p class="notice danger">This customer’s sending is suspended pending administrator review.</p><% end %>
<section class="panel" id="mail-designs"><h2>Email designs</h2><%= link_to "+ New email design", new_dashboard_mail_template_path(account_id: @account.id), class: "button secondary" %><p>Make reusable HTML and plain-text templates. Use them when composing or as an automatic reply.</p><% @templates.each do |template| %><p><%= link_to template.name, edit_dashboard_mail_template_path(account_id: @account.id, id: template.id) %> <small><%= template.subject %></small></p><% end %></section>
<details class="panel"><summary>Automatic replies & mailbox settings</summary><p>Choose an acknowledgment or vacation template. A sender receives at most one automatic reply per 24 hours. Automated, list and bounce messages are skipped. Enable only after inbound spam filtering is configured.</p><%= form_with url: dashboard_mail_account_path(account_id: @account.id), method: :patch, local: true do %><label><%= check_box_tag :auto_reply_enabled, "1", @account.auto_reply_enabled? %> Enable automatic replies</label><label>Reply template<%= select_tag :auto_template_id, options_from_collection_for_select(@templates, :id, :name, @account.auto_template_id), include_blank: "Choose a template" %></label><% if current_user.role == "super_admin" %><p class="muted">Administrator: enable after SMTP, MX, SPF, DKIM, DMARC and reverse DNS have been tested. Domain ownership alone is not delivery readiness.</p><label><%= check_box_tag :enabled, "1", @account.enabled? %> Enable mailbox sending and receiving</label><label>Recipients per minute<%= number_field_tag :minute_limit, @account.minute_limit, min: 1, max: 5000 %></label><label>Recipients per hour<%= number_field_tag :hour_limit, @account.hour_limit, min: 1, max: 5000 %></label><label>Recipients per rolling 24 hours<%= number_field_tag :daily_limit, @account.daily_limit, min: 1, max: 5000 %></label><label>Storage limit (bytes)<%= number_field_tag :storage_limit, @account.storage_limit, min: 1 %></label><% end %><%= submit_tag "Save mailbox settings" %><% end %></details>
<details class="panel"><summary>Connect an application over HTTPS</summary><p>Use a mailbox-scoped key to submit messages from client servers over HTTPS, including instances with SMTP ports blocked. A new key immediately invalidates the old one. Keep it in the client instance’s Vault.</p><small>Current key: <%= @account.token_hint ? "ending #{@account.token_hint}" : "none issued" %></small><%= button_to "Issue / rotate sending key", dashboard_mail_token_path(account_id: @account.id), method: :post, data: {turbo_confirm: "Replace this mailbox’s current API key? Applications using the old key will stop sending."} %></details>
<% end %>
<details class="panel" <%= 'open' if @accounts.empty? %>><summary>Domains & mailboxes</summary><p>Verify ownership before sending as a domain. Mailbox addresses are provisioned in Lightek; incoming SMTP routing must also be configured on the central mail server.</p>
<%= form_with url: dashboard_mail_domains_path, method: :post, local: true do %><label>Add your domain<%= text_field_tag :name, nil, required: true, placeholder: "yourcompany.com" %></label><%= submit_tag "Add domain" %><% end %>
<% @domains.each do |domain| %><article class="panel"><h3><%= domain.name %></h3><p><%= domain.verified_at ? "Ownership verified" : "Ownership pending" %></p><small>TXT name</small><code>_lightek-mail.<%= domain.name %></code><small>TXT value</small><code><%= domain.verification_value %></code><%= button_to "Verify ownership", verify_dashboard_mail_domain_path(id: domain.id), method: :post %><%= form_with url: dashboard_mail_accounts_path, method: :post, local: true do %><%= hidden_field_tag :domain_id, domain.id %><div class="toolbar"><label>Mailbox name<%= text_field_tag :display_name, nil, required: true, placeholder: "Tiff · Customer care" %></label><label>Address before @<%= text_field_tag :local_part, nil, required: true, placeholder: "hello" %></label><span>@<%= domain.name %></span></div><%= submit_tag "Create mailbox" %><% end %></article><% end %></details>
