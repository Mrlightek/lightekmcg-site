<%= render "style" %>
<main class="lm lm-compose <%= 'has-original' if @reply %>">
  <%= link_to "← Back to inbox", dashboard_mail_path(account_id: @account.id), class: "back-link" %>
  <header class="mail-header">
    <div><span class="eyebrow">LIGHTEK / MAIL</span><h1><%= @reply ? (@compose_mode == 'forward' ? 'Forward message' : 'Reply to conversation') : 'New message' %></h1><p class="muted">From <strong><%= @account.display_name %></strong> · <%= @account.address %></p></div>
    <span class="composer-label">✦ Formatted email</span>
  </header>
  <div class="compose-layout">
    <section class="panel compose-panel">
      <%= form_with url: dashboard_mail_messages_path(account_id: @account.id), method: :post, local: true, multipart: true, data: {turbo: false, mail_compose: true} do %>
        <%= hidden_field_tag :idempotency_key, @idempotency_key %>
        <%= hidden_field_tag :rich_text_enabled, "0", data: {mail_rich_enabled: true} %>
        <%= hidden_field_tag :reply_id, @reply&.id %>
        <%= hidden_field_tag :mode, @compose_mode %>
        <%= hidden_field_tag :in_reply_to, @draft&.in_reply_to %>
        <label>To<%= text_field_tag :to, @draft ? @draft.to_addresses.join(', ') : @reply_recipients&.fetch(:to)&.join(', '), placeholder: 'name@company.com, another@company.com', autocomplete: 'off' %></label>
        <details class="recipient-options" <%= 'open' if (@draft && (@draft.cc_addresses.any? || @draft.bcc_addresses.any?)) || @reply_recipients&.fetch(:cc)&.any? %>>
          <summary>Add Cc / Bcc</summary>
          <div class="form-grid"><label>Cc<%= text_field_tag :cc, @draft ? @draft.cc_addresses.join(', ') : @reply_recipients&.fetch(:cc)&.join(', '), placeholder: 'Copy recipients' %></label><label>Bcc<%= text_field_tag :bcc, @draft&.bcc_addresses&.join(', '), placeholder: 'Hidden recipients' %></label></div>
          <small class="muted">Separate addresses with commas. Up to 20 unique recipients.</small>
        </details>
        <label>Subject<%= text_field_tag :subject, @draft&.subject || (@reply && LightekMail::ComposeMessage.subject(@reply, @compose_mode)), required: true, maxlength: 200, placeholder: 'Give your message a subject' %></label>
        <div class="rich-composer" data-rich-composer hidden>
          <div class="format-toolbar" role="toolbar" aria-label="Message formatting">
            <% [['bold','Bold','B'], ['italic','Italic','I'], ['underline','Underline','U'], ['insertUnorderedList','Bulleted list','• List'], ['insertOrderedList','Numbered list','1. List']].each do |command, label, text| %><button type="button" data-mail-command="<%= command %>" aria-label="<%= label %>" title="<%= label %>"><%= text %></button><% end %>
            <span class="toolbar-divider"></span><button type="button" data-mail-link>Link ↗</button><button type="button" data-mail-command="removeFormat">Clear formatting</button>
          </div>
          <div class="link-toolbar" data-mail-link-row hidden><label>Link address<input type="url" data-mail-link-url placeholder="https://example.com"></label><button type="button" data-mail-link-apply>Add link</button><button type="button" class="secondary" data-mail-link-cancel>Cancel</button></div>
          <span id="mail-editor-label" class="editor-label">Your message</span>
          <div id="mail-rich-body" class="rich-body" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="mail-editor-label" spellcheck="true" data-mail-editor data-placeholder="Write something worth opening…"></div>
        </div>
        <label data-mail-fallback>Message<%= text_area_tag :text, @draft&.text_body, rows: 12, placeholder: 'Write your message…', data: {mail_text: true} %></label>
        <%= text_area_tag :html, @initial_html, hidden: true, data: {mail_html: true}, aria: {label: 'Formatted message source'} %>
        <% if @reply %><label class="include-original"><%= check_box_tag :include_original, '1', @include_original %><span>Include the original message in this <%= @compose_mode == 'forward' ? 'forward' : 'reply' %></span></label><% end %>
        <% if @reply && @compose_mode == 'forward' && @reply.attachments.any? %><label class="include-original"><%= check_box_tag :include_attachments, '1', params[:include_attachments] == '1' || (request.get? && @draft.nil?) %><span>Forward <%= pluralize(@reply.attachments.count, 'original attachment') %></span></label><% end %>
        <details class="compose-options"><summary>Use a saved email design</summary><label>Saved template<%= select_tag :template_id, options_from_collection_for_select(@templates, :id, :name, params[:template_id]), include_blank: 'Use the message above' %></label><small class="muted">A design supplies the subject and message. Your original conversation can still be included.</small><div class="form-grid"><% {'name'=>'Recipient name', 'email'=>'Recipient email', 'company'=>'Company', 'subject'=>'Related subject'}.each do |key,label| %><label><%= label %><%= text_field_tag "variables[#{key}]", params.dig(:variables, key).presence || (key == 'company' ? @account.display_name : nil) %></label><% end %></div></details>
        <label class="attachment-drop">+ Attach files<small class="muted">Up to 10 files · 10 MB total message size<%= ' · Attach files again when copying a draft' if @draft %></small><%= file_field_tag 'attachments[]', multiple: true, data: {mail_attachments: true} %><span class="attachment-selection" data-mail-file-list></span></label>
        <footer class="compose-footer"><button type="submit" name="commit_action" value="send">Send message ↗</button><button type="submit" name="commit_action" value="draft" class="secondary">Save draft</button><%= link_to 'Cancel', dashboard_mail_path(account_id: @account.id) %><small class="muted">HTML + plain-text delivery</small></footer>
      <% end %>
    </section>
    <% if @reply %>
      <details class="original-context panel" open data-mail-original>
        <summary class="context-heading"><span class="eyebrow">ORIGINAL MESSAGE</span><h2><%= @reply.subject.presence || '(no subject)' %></h2><strong><%= @reply_content.sender_name %></strong><% if @reply_content.sender_name != @reply.from_address %><small class="muted"><%= @reply.from_address %></small><% end %><small class="muted"><%= @reply.created_at.strftime('%b %d, %Y · %H:%M') %></small></summary>
        <%= render 'email_body', message: @reply, content: @reply_content %>
        <%= link_to 'Open full conversation ↗', dashboard_mail_message_path(account_id: @account.id, id: @reply.id), class: 'context-link', target: '_blank', rel: 'noopener' %>
      </details>
    <% end %>
  </div>
</main>
