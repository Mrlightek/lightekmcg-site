<%= render "style" %><main class="lm"><%= link_to "← Mail", dashboard_mail_path(account_id: @account.id) %><h1>Compose</h1><p>From <strong><%= @account.address %></strong></p><%= form_with url: dashboard_mail_messages_path(account_id: @account.id), method: :post, local: true, multipart: true, data: {turbo: false} do %>
<label>To (comma-separated addresses)<%= text_field_tag :to, @draft ? @draft.to_addresses.join(", ") : @reply&.from_address, required: true %></label><label>Subject<%= text_field_tag :subject, @draft&.subject || (@reply ? "Re: #{@reply.subject}".slice(0,200) : nil), required: true, maxlength: 200 %></label><%= hidden_field_tag :in_reply_to, @reply ? "<#{@reply.message_id}>" : @draft&.in_reply_to %>
<label>Message<%= text_area_tag :text, @draft&.text_body, rows: 12 %></label><label>Or use a saved template<%= select_tag :template_id, options_from_collection_for_select(@templates, :id, :name), include_blank: "Write a message above" %></label><p class="muted">A selected template supplies the subject and both message bodies. A draft opened here is copied into a new message; the original draft stays in Drafts.</p><details><summary>Template fields</summary><% {"name"=>"Recipient name", "email"=>"Recipient email", "company"=>"Company", "subject"=>"Related subject"}.each do |key,label| %><label><%= label %><%= text_field_tag "variables[#{key}]", key == "company" ? @account.display_name : nil %></label><% end %></details><label>Attachments (up to 10, total message up to 10 MB)<%= file_field_tag "attachments[]", multiple: true %></label><button type="submit" name="commit_action" value="draft">Save draft</button><button type="submit" name="commit_action" value="send" data-turbo-confirm="Send this message to the listed recipients?">Send message</button><% end %></main>
