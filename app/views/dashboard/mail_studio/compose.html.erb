<%= render "style" %>
<main class="lm lm-compose">
  <%= link_to "← Back to inbox", dashboard_mail_path(account_id: @account.id), class: "back-link" %>
  <header class="mail-header"><div><span class="eyebrow">LIGHTEK / MAIL</span><h1><%= @reply ? "Reply to conversation" : "New message" %></h1><p class="muted">From <strong><%= @account.display_name %></strong> · <%= @account.address %></p></div></header>
  <section class="panel compose-panel">
  <%= form_with url: dashboard_mail_messages_path(account_id: @account.id), method: :post, local: true, multipart: true, data: {turbo: false} do %>
    <%= hidden_field_tag :idempotency_key, @idempotency_key %>
    <label>To<%= text_field_tag :to, @draft ? @draft.to_addresses.join(", ") : @reply&.from_address, placeholder: "name@company.com, another@company.com" %></label>
    <details <%= "open" if @draft && (@draft.cc_addresses.any? || @draft.bcc_addresses.any?) %>><summary>Add Cc / Bcc</summary><div class="form-grid"><label>Cc<%= text_field_tag :cc, @draft&.cc_addresses&.join(", "), placeholder: "Copy recipients" %></label><label>Bcc<%= text_field_tag :bcc, @draft&.bcc_addresses&.join(", "), placeholder: "Hidden recipients" %></label></div><small class="muted">Separate addresses with commas. Up to 20 unique recipients across To, Cc and Bcc.</small></details>
    <label>Subject<%= text_field_tag :subject, @draft&.subject || (@reply ? "Re: #{@reply.subject}".slice(0,200) : nil), required: true, maxlength: 200, placeholder: "Give your message a subject" %></label>
    <%= hidden_field_tag :in_reply_to, @reply ? "<#{@reply.message_id}>" : @draft&.in_reply_to %>
    <label>Message<%= text_area_tag :text, @draft&.text_body, rows: 14, placeholder: "Start a conversation…" %></label>
    <details class="compose-options"><summary>Use an email design</summary><label>Saved template<%= select_tag :template_id, options_from_collection_for_select(@templates, :id, :name, params[:template_id]), include_blank: "Write my own message" %></label><p class="muted">A selected template supplies the subject and message. Opening a draft creates a copy; the original stays in Drafts. Add attachments again when copying a draft.</p><div class="form-grid"><% {"name"=>"Recipient name", "email"=>"Recipient email", "company"=>"Company", "subject"=>"Related subject"}.each do |key,label| %><label><%= label %><%= text_field_tag "variables[#{key}]", params.dig(:variables, key).presence || (key == "company" ? @account.display_name : nil) %></label><% end %></div></details>
    <label class="attachment-drop">Attach files<small class="muted">Up to 10 files · 10 MB total message size</small><%= file_field_tag "attachments[]", multiple: true %></label>
    <footer class="compose-footer"><button type="submit" name="commit_action" value="send">Send message ↗</button><button type="submit" name="commit_action" value="draft" class="secondary">Save draft</button><%= link_to "Cancel", dashboard_mail_path(account_id: @account.id) %></footer>
  <% end %>
  </section>
</main>
