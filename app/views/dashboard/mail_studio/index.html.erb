<%= render 'style' %>
<main class="lm mail-app" data-mail-app data-account="<%= @account&.id %>">
  <header class="mail-topbar"><a class="mail-brand" href="<%= dashboard_mail_path(account_id: @account&.id) %>" data-mail-nav><span class="brand-mark" aria-hidden="true">L<span>✦</span></span><span>Lightek <strong>Mail</strong></span></a><span class="mail-topline">A little more connected.</span><button class="secondary icon-button" data-mail-help aria-label="Keyboard shortcuts" title="Keyboard shortcuts (?)">?</button><%= link_to 'Settings', dashboard_mail_path(account_id: @account&.id, view: 'settings'), class: 'button secondary', data: {mail_nav: true} %></header>
  <% unless LightekMail::SendingPolicy.current.sending_enabled? %><p class="notice danger">Outgoing mail is paused across the platform. Reading and saving drafts remain available.</p><% end %>
  <div data-mail-shell>
  <% if flash[:alert] %><p class="notice danger" role="alert" data-mail-notice><%= flash[:alert] %></p><% elsif flash[:notice] && !flash[:mail_undo] %><p class="notice" role="status" data-mail-notice><%= flash[:notice] %></p><% end %>
  <% if @settings || !@account %>
    <header class="mail-header"><div><span class="eyebrow">YOUR WORKSPACE</span><h1>Mail settings</h1><p class="muted">Your identity, designs and connected applications.</p></div><%= link_to 'Back to inbox', dashboard_mail_path(account_id: @account&.id), class: 'button secondary', data: {mail_nav: true} %></header>
    <%= render 'settings' %>
  <% else %>
  <div class="mail-commandbar">
    <%= form_with url: dashboard_mail_path, method: :get, local: true, data: {mail_search: true}, class: 'mail-search' do %><%= hidden_field_tag :account_id, @account.id %><%= hidden_field_tag :folder, params[:q].present? ? @folder : 'all' %><span aria-hidden="true">⌕</span><%= search_field_tag :q, params[:q], maxlength: 240, placeholder: 'Search your mail', aria: {label: 'Search mail'} %><button class="secondary" type="submit">Search</button><% end %>
    <details class="search-help"><summary>Search tips</summary><p>Combine words with <code>from:</code>, <code>to:</code>, <code>subject:</code>, <code>is:unread</code>, <code>is:starred</code>, <code>has:attachment</code>, <code>after:2026-01-01</code> or <code>before:2027-01-01</code>. Put phrases in quotes.</p><p>Example: <code>from:tiff has:attachment</code></p></details>
  </div>
  <div class="mail-desk" data-folder="<%= @folder %>">
    <aside class="mail-rail" aria-label="Mailbox navigation">
      <%= link_to compose_dashboard_mail_path(account_id: @account.id), class: 'button compose-launch', data: {mail_dock: true} do %><%= render "icon", name: "compose" %> Compose<% end %>
      <%= form_with url: dashboard_mail_path, method: :get, local: true, data: {mail_search: true}, class: 'mailbox-picker' do %><label for="account_id">Mailbox</label><%= select_tag :account_id, options_from_collection_for_select(@accounts, :id, :address, @account.id), data: {mail_switch: true} %><noscript><%= submit_tag 'Switch mailbox' %></noscript><% end %>
      <nav class="folder-nav" aria-label="Mail folders"><% {'inbox'=>['▣','Inbox'], 'unread'=>['●','Unread'], 'starred'=>['☆','Starred'], 'sent'=>['↗','Sent'], 'draft'=>['▤','Drafts'], 'outbox'=>['◷','Outbox & issues'], 'archived'=>['▱','Archive'], 'all'=>['≡','All mail'], 'trash'=>['♧','Trash']}.each do |key, pair| %><%= link_to dashboard_mail_path(account_id: @account.id, folder: key), aria: {current: @folder == key ? 'page' : nil}, data: {mail_nav: true} do %><span class="folder-symbol" aria-hidden="true"><%= render "icon", name: key %></span><span><%= pair.last %></span><span class="folder-count"><%= @folder_counts[key] %></span><% end %><% end %></nav>
      <div class="rail-bottom"><span class="eyebrow">MAKE IT YOURS</span><%= link_to '✦ Email designs', dashboard_mail_path(account_id: @account.id, view: 'settings', anchor: 'mail-designs'), data: {mail_nav: true} %><small><%= @account.display_name %></small><progress value="<%= [@storage_used, @account.storage_limit].min %>" max="<%= @account.storage_limit %>" aria-label="Mailbox storage used"></progress><small><%= number_to_human_size(@storage_used) %> of <%= number_to_human_size(@account.storage_limit) %></small></div>
    </aside>
    <section class="mail-list-pane" aria-label="Messages">
      <header class="list-title"><div><span class="eyebrow"><%= params[:q].present? ? 'SEARCH RESULTS' : 'YOUR EVERYDAY, CONNECTED' %></span><h1><%= {'draft'=>'Drafts', 'all'=>'All mail', 'outbox'=>'Outbox & issues'}.fetch(@folder, @folder.humanize) %></h1></div><%= link_to '↻', dashboard_mail_path(account_id: @account.id, folder: @folder, q: params[:q], page: @page), class: 'button secondary icon-button', aria: {label: 'Refresh mail'}, data: {mail_nav: true} %></header>
      <div class="mail-filter-chips"><%= link_to "All · #{@folder_counts[@folder]}", dashboard_mail_path(account_id: @account.id, folder: @folder), data: {mail_nav: true}, class: params[:q].blank? ? 'active' : nil %><%= link_to 'Unread', dashboard_mail_path(account_id: @account.id, folder: @folder, q: 'is:unread'), data: {mail_nav: true} %><%= link_to 'With files', dashboard_mail_path(account_id: @account.id, folder: @folder, q: 'has:attachment'), data: {mail_nav: true} %></div>
      <% if flash[:mail_undo] %><%= form_with url: undo_dashboard_mail_path(account_id: @account.id), local: true, data: {mail_bulk: true}, class: 'undo-bar' do %><span><%= flash[:notice] %></span><%= hidden_field_tag :undo_token, flash[:mail_undo] %><%= hidden_field_tag :folder, @folder %><%= hidden_field_tag :q, params[:q] %><button type="submit" class="secondary">Undo</button><% end %><% end %>
      <%= form_with url: bulk_dashboard_mail_path(account_id: @account.id), local: true, data: {mail_bulk: true}, class: 'mail-bulk-form' do %>
        <%= hidden_field_tag :folder, @folder %><%= hidden_field_tag :q, params[:q] %>
        <div class="selection-bar"><label class="select-all"><input type="checkbox" data-mail-select-all aria-label="Select all messages on this page"><span data-mail-selection-count><%= pluralize(@result_count, 'message') %></span></label><details class="bulk-menu"><summary>Actions</summary><div><% {'read'=>'Mark read','unread'=>'Mark unread','archive'=>'Archive','star'=>'Star','unstar'=>'Remove star','inbox'=>'Move to inbox','trash'=>'Move to Trash'}.each do |key, label| %><button type="submit" name="operation" value="<%= key %>" class="secondary"><%= label %></button><% end %></div></details></div>
        <% if @messages.any? %><div class="message-list"><% @messages.each do |message| %>
          <article class="mail-item <%= 'unread' if message.direction == 'inbound' && !message.read_at %>" data-mail-item="<%= message.id %>"><label class="row-check"><input type="checkbox" name="message_ids[]" value="<%= message.id %>" aria-label="Select <%= message.subject %>"></label><%= link_to dashboard_mail_message_path(account_id: @account.id, id: message.id), class: 'message-row', data: {mail_read: true} do %>
            <span class="message-avatar" aria-hidden="true"><%= (message.direction == 'inbound' ? message.from_address : message.to_addresses.first).to_s.first.to_s.upcase %></span><span class="message-copy"><span class="message-sender"><%= '★ ' if message.starred? %><%= message.direction == 'inbound' ? message.from_address : message.to_addresses.join(', ') %></span><strong class="message-subject"><% if message.direction == 'inbound' && !message.read_at %><span class="unread-dot" aria-label="Unread"></span><% end %><%= message.subject.presence || '(no subject)' %></strong><span class="message-snippet"><%= truncate(message.text_body.to_s.gsub(/\s+/, ' '), length: 110) %></span><% if message.attachments.any? %><span class="file-chip">↧ <%= pluralize(message.attachments.size, 'file') %></span><% end %></span><span class="message-meta"><time datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.to_date == Time.current.to_date ? message.created_at.strftime('%H:%M') : message.created_at.strftime('%b %d') %></time><span class="status-badge <%= 'status-issue' if %w[failed uncertain].include?(message.state) %>"><%= message.direction == 'inbound' ? (message.in_reply_to.present? ? 'Reply' : 'Mail') : message.state.humanize %></span></span>
          <% end %></article><% end %></div>
        <% else %><div class="mail-empty"><span class="empty-orbit" aria-hidden="true">✦</span><h2><%= params[:q].present? ? 'Nothing here just yet.' : 'Room for something good.' %></h2><p><%= params[:q].present? ? 'Try a different phrase or clear your filters.' : 'Your next conversation starts with a hello.' %></p><%= link_to(params[:q].present? ? 'Clear search' : 'Write a message', params[:q].present? ? dashboard_mail_path(account_id: @account.id, folder: @folder) : compose_dashboard_mail_path(account_id: @account.id), class: 'button secondary', data: params[:q].present? ? {mail_nav: true} : {mail_dock: true}) %></div><% end %>
      <% end %>
      <footer class="mail-pagination"><span><%= @result_count.zero? ? '0' : "#{(@page - 1) * 40 + 1}–#{[@page * 40, @result_count].min}" %> of <%= @result_count %></span><div><%= link_to '←', dashboard_mail_path(account_id: @account.id, folder: @folder, q: params[:q], page: @page - 1), aria: {label: 'Previous page'}, data: {mail_nav: true} if @page > 1 %><%= link_to '→', dashboard_mail_path(account_id: @account.id, folder: @folder, q: params[:q], page: @page + 1), aria: {label: 'Next page'}, data: {mail_nav: true} if @page * 40 < @result_count %></div></footer>
    </section>
    <section class="mail-reading-pane" aria-label="Reading pane" data-mail-reader>
      <div class="reader-placeholder" data-mail-reader-empty><span class="empty-orbit" aria-hidden="true">✦</span><span class="eyebrow">SPACE TO CONNECT</span><h2>Good conversations<br>start here.</h2><p>Choose a message and make yourself at home.</p><small><kbd>J</kbd> / <kbd>K</kbd> to move · <kbd>C</kbd> to compose</small></div>
      <div class="reader-pane-toolbar" hidden data-mail-reader-toolbar><button type="button" class="secondary" data-mail-reader-close>← Messages</button><a class="button secondary" data-mail-reader-full target="_blank" rel="noopener">Open full view ↗</a></div><iframe title="Selected conversation" class="workspace-reader-frame" data-mail-reader-frame hidden></iframe>
    </section>
  </div>
  <% end %>
  </div>
  <div role="status" class="mail-live-status" aria-live="polite" data-mail-status></div>
  <section class="mail-compose-dock" data-mail-compose-dock hidden aria-label="Compose message"><header><strong data-mail-dock-title>New message</strong><div><button type="button" data-mail-dock-minimize aria-label="Minimize composer">−</button><button type="button" data-mail-dock-expand aria-label="Expand composer">⤢</button><button type="button" data-mail-dock-close aria-label="Close composer">×</button></div></header><iframe title="Message composer" data-mail-dock-frame></iframe></section>
  <dialog class="mail-modal" data-mail-shortcuts><header><h2>Make yourself fast.</h2><button class="secondary" data-mail-modal-close aria-label="Close shortcuts">×</button></header><p>Shortcuts work while you’re outside a text field.</p><dl><dt><kbd>C</kbd></dt><dd>Compose a message</dd><dt><kbd>/</kbd></dt><dd>Search mail</dd><dt><kbd>J</kbd> / <kbd>K</kbd></dt><dd>Next / previous message</dd><dt><kbd>R</kbd></dt><dd>Reply to selected message</dd><dt><kbd>X</kbd></dt><dd>Select current message</dd><dt><kbd>?</kbd></dt><dd>Show these shortcuts</dd><dt><kbd>Esc</kbd></dt><dd>Return to messages</dd></dl><p>Screen reader controls and browser shortcuts remain available.</p></dialog>
  <dialog class="mail-modal attachment-modal" data-mail-preview-modal><header><h2>Attachment preview</h2><button class="secondary" data-mail-modal-close aria-label="Close attachment preview">×</button></header><iframe title="Attachment preview" sandbox data-mail-preview-frame></iframe><a class="button secondary" data-mail-preview-download>Download file</a></dialog>
</main>
