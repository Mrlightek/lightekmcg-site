<%= render 'style' %>
<main class="lm lm-reader" data-mail-message-id="<%= @message.id %>" data-mail-composed="<%= params[:composed] %>">
  <%= link_to '← Back to inbox', dashboard_mail_path(account_id: @account.id), class: 'back-link' %>
  <header class="mail-header conversation-heading"><div><span class="eyebrow">LIGHTEK / CONVERSATION</span><h1><%= @message.subject.presence || '(no subject)' %></h1><p class="muted"><%= @account.address %> · <%= pluralize(@conversation.size, 'message') %></p></div>
    <div class="reader-actions"><%= link_to 'Reply ↗', compose_dashboard_mail_path(account_id: @account.id, reply_id: @message.id), class: 'button' unless @message.state == 'draft' %><%= link_to 'Reply all', compose_dashboard_mail_path(account_id: @account.id, reply_id: @message.id, mode: 'reply_all'), class: 'button secondary' unless @message.state == 'draft' %><%= link_to 'Forward', compose_dashboard_mail_path(account_id: @account.id, reply_id: @message.id, mode: 'forward'), class: 'button secondary' unless @message.state == 'draft' %></div>
  </header>
  <div class="message-tools">
    <% {'starred'=>(@message.starred? ? '★ Starred' : '☆ Star'), 'archived'=>(@message.archived? ? 'Move to inbox' : 'Archive'), 'trashed'=>(@message.trashed? ? 'Restore' : 'Trash')}.each do |flag,label| %><%= button_to label, flag_dashboard_mail_message_path(account_id: @account.id, id: @message.id), method: :patch, params: {flag: flag, value: @message.public_send(flag) ? '0' : '1', return_to: 'message'}, class: 'secondary' %><% end %>
    <%= button_to 'Mark unread', flag_dashboard_mail_message_path(account_id: @account.id, id: @message.id), method: :patch, params: {flag: 'unread', value: '1'}, class: 'secondary' if @message.direction == 'inbound' %>
    <%= link_to 'Copy draft', compose_dashboard_mail_path(account_id: @account.id, draft_id: @message.id), class: 'button secondary' if @message.state == 'draft' %>
    <%= button_to 'Send draft ↗', send_dashboard_mail_message_path(account_id: @account.id, id: @message.id), method: :post, data: {turbo_confirm: 'Send this draft?' } if @message.state == 'draft' %>
    <%= button_to 'Delete permanently', purge_dashboard_mail_message_path(account_id: @account.id, id: @message.id), method: :delete, class: 'secondary', data: {turbo_confirm: 'Permanently delete this message and its attachments?' } if @message.trashed? %>
  </div>
  <% if @message.error_message.present? %><p class="notice danger"><%= @message.error_message %></p><% end %>
  <section class="conversation-stack" aria-label="Conversation messages">
    <% @conversation.each do |item| %>
      <% selected = item.id == @message.id %>
      <details class="conversation-card <%= 'current-message' if selected %>" <%= 'open' if selected %>>
        <summary class="conversation-summary"><span class="message-avatar" aria-hidden="true"><%= item.from_address.to_s.first.to_s.upcase %></span><span class="summary-copy"><strong><%= selected ? @content.sender_name : item.from_address %></strong><small><%= selected ? "To: #{item.to_addresses.join(', ')}" : truncate(item.text_body.to_s.gsub(/\s+/, ' '), length: 100) %></small></span><span class="message-meta"><time datetime="<%= item.created_at.iso8601 %>"><%= item.created_at.strftime('%b %d, %Y · %H:%M') %></time><span class="status-badge"><%= item.direction == 'inbound' ? 'Received' : (item.state == 'sent' ? 'Sent · SMTP accepted' : item.state.humanize) %></span></span></summary>
        <div class="message-envelope"><span><strong>To</strong> <%= item.to_addresses.join(', ') %></span><% if item.cc_addresses.any? %><span><strong>Cc</strong> <%= item.cc_addresses.join(', ') %></span><% end %><% if item.direction == 'outbound' && item.bcc_addresses.any? %><span><strong>Bcc</strong> <%= item.bcc_addresses.join(', ') %></span><% end %></div>
        <% if selected %>
          <% if @content.remote_images? %><div class="image-controls"><span><%= @images_enabled ? 'Remote images loaded for this message' : 'Remote images are hidden' %></span><%= link_to(@images_enabled ? 'Hide images' : 'Load remote images', dashboard_mail_message_path(account_id: @account.id, id: item.id, images: @images_enabled ? nil : '1')) %></div><% end %>
          <%= render 'email_body', message: item, content: @content, images: @images_enabled %>
        <% else %>
          <div class="plain-email"><%= simple_format(truncate(item.text_body.to_s, length: 1600)) %><%= link_to 'Open this message ↗', dashboard_mail_message_path(account_id: @account.id, id: item.id), class: 'inline-message-link' %></div>
        <% end %>
        <% if item.attachments.any? %><div class="mail-attachments"><span class="eyebrow">ATTACHMENTS</span><div><% item.attachments.each do |file| %><%= link_to dashboard_mail_attachment_path(account_id: @account.id, id: item.id, attachment_id: file.id), class: 'attachment-card' do %><span aria-hidden="true">↧</span><span><strong><%= file.filename %></strong><small><%= number_to_human_size(file.byte_size) %></small></span><% end %><% if %w[image/png image/jpeg image/gif image/webp application/pdf text/plain].include?(file.content_type) %><%= link_to "Preview #{file.filename}", dashboard_mail_attachment_path(account_id: @account.id, id: item.id, attachment_id: file.id, preview: '1'), class: 'attachment-preview', data: {mail_preview: true} %><% end %><% end %></div></div><% end %>
        <footer class="message-card-footer"><%= link_to 'Download original email', dashboard_mail_attachment_path(account_id: @account.id, id: item.id, attachment_id: 'source') if item.source.attached? %><%= link_to 'Reply to this message ↗', compose_dashboard_mail_path(account_id: @account.id, reply_id: item.id) unless item.state == 'draft' %></footer>
        <% if selected %><details class="plain-text-version"><summary>Plain-text version</summary><pre><%= item.text_body %></pre></details><% end %>
      </details>
    <% end %>
  </section>
  <% if @conversation.size >= LightekMail::Conversation::LIMIT %><p class="muted">Showing up to <%= LightekMail::Conversation::LIMIT %> related messages.</p><% end %>
</main>
