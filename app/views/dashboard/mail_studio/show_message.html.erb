<%= render "style" %><main class="lm"><%= link_to "← Mail", dashboard_mail_path(account_id: @account.id) %><h1><%= @message.subject.presence || "(no subject)" %></h1><p><strong>From:</strong> <%= @message.from_address %><br><strong>To:</strong> <%= @message.to_addresses.join(", ") %><br><strong>Status:</strong> <%= @message.state == "sent" ? "Accepted by SMTP; final delivery not confirmed" : @message.state.humanize %></p><% if @message.error_message %><p class="notice danger"><%= @message.error_message %></p><% end %><div class="toolbar"><%= link_to "Reply", compose_dashboard_mail_path(account_id: @account.id, reply_id: @message.id), class: "button" if @message.direction == "inbound" %><%= button_to "Send draft", send_dashboard_mail_message_path(account_id: @account.id, id: @message.id), method: :post, data: {turbo_confirm: "Send this draft?"} if @message.state == "draft" %><%= link_to "Copy draft", compose_dashboard_mail_path(account_id: @account.id, draft_id: @message.id), class: "button secondary" if @message.state == "draft" %><% {"starred"=>"Star / unstar", "archived"=>"Archive / unarchive", "trashed"=>"Trash / restore", "unread"=>"Mark unread"}.each do |flag,label| %><%= button_to label, flag_dashboard_mail_message_path(account_id: @account.id, id: @message.id), method: :patch, params: {flag: flag, value: flag == "unread" || !@message.public_send(flag) ? "1" : "0"} %><% end %><%= button_to "Delete permanently", purge_dashboard_mail_message_path(account_id: @account.id, id: @message.id), method: :delete, data: {turbo_confirm: "Permanently delete this message and its attachments?"} if @message.trashed? %></div>
<section class="panel"><h2>Message</h2><pre><%= @message.text_body %></pre><% if @message.html_body.present? %><details><summary>HTML view · remote images and scripts blocked</summary><iframe title="Email HTML preview" sandbox="" referrerpolicy="no-referrer" srcdoc="<%= '<meta http-equiv="Content-Security-Policy" content="default-src &#39;none&#39;; style-src &#39;unsafe-inline&#39;; img-src data:">' + @message.html_body %>"></iframe></details><% end %><% @message.attachments.each do |file| %><p><%= link_to "Download #{file.filename}", dashboard_mail_attachment_path(account_id: @account.id, id: @message.id, attachment_id: file.id) %> · <%= number_to_human_size(file.byte_size) %></p><% end %><%= link_to "Download original email (.eml)", dashboard_mail_attachment_path(account_id: @account.id, id: @message.id, attachment_id: "source") if @message.source.attached? %></section></main>
