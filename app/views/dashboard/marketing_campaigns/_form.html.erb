<main class="lt-settings"><h1><%= @campaign.persisted? ? "Edit campaign" : "New campaign" %></h1><p>Compose a campaign for <%= @site.name %>. Ready means reviewed; it does not send or publish automatically.</p><% if @campaign.errors.any? %><div role="alert"><%= @campaign.errors.full_messages.to_sentence %></div><% end %><%= form_with model: @campaign, scope: :campaign, url: (@campaign.persisted? ? dashboard_marketing_campaign_path(@campaign, site_id: @site.id) : dashboard_marketing_campaigns_path(site_id: @site.id)) do |f| %><p><%= f.label :name %><%= f.text_field :name, required: true %></p><p><%= f.label :channel %><%= f.select :channel, LightekMarketing::Campaign::CHANNELS.map { |c| [c.humanize, c] } %></p><p><%= f.label :status %><%= f.select :status, LightekMarketing::Campaign::STATUSES.map { |s| [s.humanize, s] } %></p><p><%= f.label :headline %><%= f.text_field :headline %></p><p><%= f.label :message %><%= f.text_area :message, rows: 7 %></p><p><%= f.label :cta_label, "Call to action" %><%= f.text_field :cta_label %></p><p><%= f.label :cta_url, "Call to action URL" %><%= f.url_field :cta_url %></p><p><%= f.label :starts_at %><%= f.datetime_local_field :starts_at %></p><p><%= f.label :ends_at %><%= f.datetime_local_field :ends_at %></p><p><%= f.label :mail_account_id, "Sender mailbox" %><%= f.select :mail_account_id, LightekMail::Account.where(user: current_user).order(:address).pluck(:address, :id), include_blank: true %></p><p><%= f.label :recipient_email, "Recipient (opted-in customer)" %><%= f.email_field :recipient_email %></p><%= f.submit "Save campaign" %><% end %><%= link_to "Back to campaigns", dashboard_marketing_campaigns_path(site_id: @site.id) %></main>