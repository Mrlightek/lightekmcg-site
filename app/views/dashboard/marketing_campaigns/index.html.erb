<main class="lt-settings"><h1>Marketing · Campaigns</h1><p>Manage campaigns for <strong><%= @site.name %></strong>. Each Lightek installation owns its campaign data.</p><p><%= link_to "Agency reports", dashboard_agency_reports_path %> · <%= link_to "Audience", dashboard_marketing_contacts_path(site_id: @site.id) %> · <%= link_to "New campaign", new_dashboard_marketing_campaign_path(site_id: @site.id) %> · <%= link_to "Pages & Sections", dymond_dash.pages_path(site_id: @site.id) %> · <%= link_to "Industry designs", dashboard_commerce_products_path(site_id: @site.id) %></p><table><thead><tr><th>Campaign</th><th>Channel</th><th>Status</th><th>Schedule</th><th>Actions</th></tr></thead><tbody><% @campaigns.each do |campaign| %><tr><td><%= campaign.name %></td><td><%= campaign.channel.humanize %></td><td><%= campaign.status.humanize %></td><td><%= campaign.starts_at&.to_fs(:long) || "Unscheduled" %></td><td><%= link_to "Edit", edit_dashboard_marketing_campaign_path(campaign, site_id: @site.id) %> <% if campaign.channel == "email" && campaign.status == "ready" %><% if campaign.starts_at&.future? %><%= button_to "Schedule audience", schedule_dashboard_marketing_campaign_path(campaign, site_id: @site.id), method: :post %><% end %><%= button_to "Send to subscribed audience", send_dashboard_marketing_audience_path(campaign, site_id: @site.id), method: :post, form: {data: {turbo_confirm: "Queue campaign to subscribed audience?"}} %><%= button_to "Send email", send_dashboard_marketing_campaign_path(campaign, site_id: @site.id), method: :post, form: {data: {turbo_confirm: "Send this campaign to the selected recipient?"}} %><% end %> <%= button_to "Delete", dashboard_marketing_campaign_path(campaign, site_id: @site.id), method: :delete, form: {data: {turbo_confirm: "Delete this campaign?"}} %></td></tr><% end %></tbody></table></main>