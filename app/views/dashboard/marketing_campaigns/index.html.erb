<main class="lt-settings"><h1>Marketing · Campaigns</h1><p>Manage campaigns for <strong><%= @site.name %></strong>. Each Lightek installation owns its campaign data.</p><p><%= link_to "New campaign", new_dashboard_marketing_campaign_path(site_id: @site.id) %> · <%= link_to "Pages & Sections", dymond_dash.pages_path(site_id: @site.id) %> · <%= link_to "Industry designs", dashboard_commerce_products_path(site_id: @site.id) %></p><table><thead><tr><th>Campaign</th><th>Channel</th><th>Status</th><th>Schedule</th><th>Actions</th></tr></thead><tbody><% @campaigns.each do |campaign| %><tr><td><%= campaign.name %></td><td><%= campaign.channel.humanize %></td><td><%= campaign.status.humanize %></td><td><%= campaign.starts_at&.to_fs(:long) || "Unscheduled" %></td><td><%= link_to "Edit", edit_dashboard_marketing_campaign_path(campaign, site_id: @site.id) %> <%= button_to "Delete", dashboard_marketing_campaign_path(campaign, site_id: @site.id), method: :delete, form: {data: {turbo_confirm: "Delete this campaign?"}} %></td></tr><% end %></tbody></table></main>