<main class="lt-settings"><h1>Marketing audience · <%= @site.name %></h1><p>Marketing emails are sent only to contacts with recorded opt-in. Adding an address here does not subscribe it.</p><%= form_with url: dashboard_marketing_contacts_path(site_id: @site.id), method: :post do %><%= email_field_tag :email, nil, required: true %><%= submit_tag "Save contact" %><% end %><table><thead><tr><th>Contact</th><th>Permission</th></tr></thead><tbody><% @contacts.each do |contact| %><tr><td><%= contact.email %></td><td><%= contact.subscribed_at? && !contact.unsubscribed_at? ? "Subscribed" : "Not subscribed" %></td></tr><% end %></tbody></table><%= link_to "Campaigns", dashboard_marketing_campaigns_path(site_id: @site.id) %></main>