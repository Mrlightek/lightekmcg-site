<%= javascript_include_tag '/lightek/demo-screenshot.js?v=1', defer: true if @showcase && @showcase.status == 'completed' && !@showcase.approved_at %>
<% content_for :page_title, 'Nevaeh Marketing copilot' %>
<main class="sales-workspace marketing-copilot">
  <%= stylesheet_link_tag '/lightek/sales-workspace.css?v=4' %>
  <%= stylesheet_link_tag '/lightek/marketing-copilot.css?v=1' %>
  <%= render 'dashboard/shared/business_workspace', active: 'Marketing copilot' %>
  <header class="sales-header"><div><span class="sales-eyebrow">LIGHTEK / NEVAEH MARKETING COPILOT</span><h1>Know your next move.</h1><p>One offer. One audience. A practical week of marketing and follow-through.</p></div>
    <%= form_with url: dashboard_marketing_copilot_path, method: :get, class: 'sales-site' do %><label>Business website<%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @site.id) %></label><%= submit_tag 'Switch', class: 'sales-button secondary' %><% end %>
  </header>
  <% if flash[:alert] %><div class="sales-errors" role="alert"><%= flash[:alert] %></div><% end %>
  <% if flash[:notice] %><p role="status"><%= flash[:notice] %></p><% end %>
  <% sales_destination = sales_inquiry_path if WebsiteTemplateInquiry.sales_form_available?(@site) %>
  <section class="sales-two-col">
    <article class="sales-panel"><span class="sales-eyebrow">START WITH SOMETHING PEOPLE CAN BUY</span><h2>Your offer is the foundation.</h2>
      <% if @brief.complete? %><dl class="marketing-brief"><% {'offering'=>'Offer', 'audience'=>'Customer', 'customer_problem'=>'Problem', 'value_proposition'=>'Value', 'goal'=>'Goal'}.each do |field, label| %><div><dt><%= label %></dt><dd><%= @brief.public_send(field) %></dd></div><% end %></dl><%= link_to 'Refine the business brief', dashboard_growth_path(site_id: @site.id, anchor: 'business-brief'), class: 'sales-button secondary' %>
      <% else %><p>Tell Nevaeh what you sell, who needs it, the problem it solves and the result you want. Start with one specific offering so the campaign has a clear purpose.</p><p class="sales-coach">Start with one product or service for a specific customer group. Enter your actual scope, price and evidence in the brief; Nevaeh will use the facts you review.</p><%= link_to 'Set up my business brief', dashboard_growth_path(site_id: @site.id, anchor: 'business-brief'), class: 'sales-button' %><% end %>
    </article>
    <article class="sales-panel"><span class="sales-eyebrow">A WEEK YOU CAN ACTUALLY MANAGE</span><h2>Prepare a marketing kit</h2><p>Get three editable campaign variations, a tracked placement link, seven daily focus blocks and drafts for a small queue of existing leads.</p>
      <%= form_with url: prepare_dashboard_marketing_kit_path(site_id: @site.id), scope: :kit, class: 'sales-form' do |f| %>
        <%= hidden_field_tag :request_key, SecureRandom.uuid %>
        <div class="sales-form-grid"><label>Time per day<%= f.select :minutes_per_day, [['15 minutes',15], ['30 minutes',30], ['60 minutes',60]], selected: 30 %></label><label>Where will you share it?<%= f.select :source, LightekGrowth::MarketingCopilot::SOURCES.map { |source| [source.humanize, source] }, selected: 'manual' %></label></div>
        <label>Customer destination<%= f.text_field :destination_path, value: sales_destination || '/', required: true, maxlength: 500, placeholder: '/shop' %><small><% if sales_destination %><%= link_to 'Preview the sales inquiry page', sales_inquiry_url(host: @site.host, protocol: 'https') %>. Submissions go to the Sales inquiry inbox.<% else %>Use a live page on <%= @site.host %> where a customer can inquire or buy.<% end %></small></label>
        <label>Call to action<%= f.text_field :cta_label, value: sales_destination ? 'Talk to sales' : 'Learn more', required: true, maxlength: 60, placeholder: 'Book a conversation' %></label>
        <%= f.submit 'Prepare my seven-day kit', class: 'sales-button', disabled: !@brief.complete? %>
      <% end %><p><small>This prepares drafts. Review and publish through the existing campaign tools. Daily blocks are suggested human focus time; rendering and provider processing can take longer.</small></p>
    </article>
  </section>
  <% if @kit %>
    <section class="sales-panel"><div class="sales-panel-title"><div><span class="sales-eyebrow">YOUR SAVED KIT / <%= @kit.starts_on.to_fs(:long) %></span><h2><%= @kit.snapshot.dig('brief', 'offering') %></h2><p><%= @kit.options['minutes_per_day'] %> minutes per day · <%= @kit.options['source'].humanize %> · brief revision <%= @kit.snapshot['brief_revision'] %></p></div><span class="sales-badge"><%= @current ? 'Current brief' : 'Historical kit — prepare a fresh version' %></span></div>
      <div class="sales-actions"><%= link_to 'Review & edit campaign copy', dashboard_campaign_content_path(site_id: @site.id, campaign_id: @kit.campaign_id), class: 'sales-button' %><%= link_to 'Open publishing calendar', dashboard_publication_calendar_path(site_id: @site.id), class: 'sales-button secondary' %><%= link_to 'Check inquiries & payments', dashboard_growth_path(site_id: @site.id), class: 'sales-button secondary' %></div>
      <% if @link %><label class="marketing-link">Tracked placement URL · <%= @link.enabled? ? 'Enabled' : 'Disabled — review in Growth' %><input readonly value="<%= growth_link_url(token: @link.token, host: @site.host, protocol: 'https') %>" aria-label="Marketing kit tracking URL"></label><% end %>
      <details><summary>What needs attention first?</summary><p>Frozen evidence from the plan prepared with this kit. Check current queues before acting.</p><% @kit.snapshot['priorities'].each do |priority| %><h3><%= priority['title'] %></h3><p><%= priority['reason'] %></p><% end %><%= link_to 'Open the evidence-backed daily plan', dashboard_growth_path(site_id: @site.id, plan_id: @kit.snapshot['plan_id'], anchor: 'daily-growth-plan') %></details>
    </section>
    <section class="sales-panel"><span class="sales-eyebrow">PUT NEVAEH TO WORK</span><h2>Execute the supported parts of this plan.</h2><p>Build a native feature-showcase draft with product screenshots and captioned overview videos, then prepare the saved leads’ follow-up tasks. Each step gets its own worker report. The videos explain curated Lightek platform capabilities; they are not recordings of your application.</p>
      <% if @execution %><p><strong>Goal #<%= @execution.goal_id %> · <%= @execution.goal.status %></strong></p><p>Production continues in the background. Refresh to see the saved results.</p><%= link_to 'Refresh execution progress', dashboard_marketing_copilot_path(site_id: @site.id, kit_id: @kit.id), class: 'sales-button secondary' %><% @execution.goal.steps.order(:position).each do |step| %><p><%= step.label %> · <%= step.status %><%= " · #{step.error}" if step.error.present? %></p><% end %><%= link_to 'Open Nevaeh to inspect, pause or resume this goal', dashboard_nevaeh_os_path %>
      <% elsif @current %><%= form_with url: execute_dashboard_marketing_kit_path(@kit, site_id: @site.id), class: 'sales-form' do %><label><%= check_box_tag :confirmed, '1', false, required: true %> Build the draft page and overview videos, then prepare follow-up tasks. I will review the results before publication or customer contact.</label><%= submit_tag 'Execute my marketing plan', class: 'sales-button' %><% end %><% end %>
      <%= render 'dashboard/marketing_copilot/demo_campaign', site: @site, showcase: @showcase, link: @demo_link, funnel: @demo_funnel if @demo_link %>
      <% if @showcase %><h3>Feature showcase · <%= @showcase.status %></h3><p>Saved CMS page #<%= @showcase.page_id %> · <%= @showcase.page.slug %></p><% if @showcase.error.present? %><p class="sales-errors"><%= @showcase.error %></p><% end %><%= link_to 'Open website pages to review the draft', "/dashboard/pages?site_id=#{@site.id}", class: 'sales-button secondary' %>
        <div class="marketing-copy-grid"><% @showcase.clips.each do |clip| %><article><h3><%= clip.title %></h3><p><%= clip.body %></p><%= render 'dashboard/marketing_copilot/screenshots', clip: clip, showcase: @showcase, site: @site %><% if clip.ready? %><video controls preload="none" playsinline style="width:100%;aspect-ratio:16/9" aria-label="<%= clip.title %> private overview"><source src="<%= preview_dashboard_feature_video_path(@showcase, position: clip.position, site_id: @site.id) %>" type="video/mp4"></video><% else %><p>Video not ready.</p><% end %></article><% end %></div>
        <% if @showcase.status == 'completed' && !@showcase.approved_at %><%= form_with url: approve_dashboard_feature_showcase_path(@showcase, site_id: @site.id), class: 'sales-form' do %><label><%= check_box_tag :confirmed, '1', false, required: true %> I reviewed the claims, videos, and screenshots for accuracy and private information.</label><%= submit_tag 'Approve walkthrough media', class: 'sales-button' %><% end %><% end %>
      <% end %>
    </section>
    <section class="sales-panel"><span class="sales-eyebrow">COPY YOU CAN START FROM</span><h2>Three angles, one reviewed offer.</h2><div class="marketing-copy-grid"><% @variants.each do |variant| %><article><h3><%= variant.angle.humanize %></h3><p><span class="sales-badge"><%= variant.status.humanize %></span></p><p class="marketing-copy"><%= variant.message %></p><%= link_to 'Edit and review this copy', dashboard_campaign_content_path(site_id: @site.id, campaign_id: @kit.campaign_id) %></article><% end %></div><p><small>These are authored variations of your business brief. They do not invent customer testimonials, market research or business results.</small></p></section>
    <section class="sales-panel"><span class="sales-eyebrow">SMALL STEPS, EVERY DAY</span><h2>Your seven-day rhythm</h2><p>Check-ins record your account of the work. Publication, customer contact and payment retain their own receipts.</p>
      <% @kit.snapshot['calendar'].each do |day| %><% index = day['day_index']; date = @kit.starts_on + index; check_in = @check_ins[index] %>
        <details class="marketing-day" id="kit-day-<%= index %>" <%= 'open' if date == Date.current %>><summary><strong>Day <%= index + 1 %> · <%= day['title'] %></strong><span><%= date.to_fs(:long) %> · <%= check_in ? check_in.status.humanize : 'Not recorded' %></span></summary><ol><% day['steps'].each do |step| %><li><%= step['text'] %> <small>· <%= step['minutes'] %> min focus</small></li><% end %></ol>
          <% if check_in %><p><strong><%= check_in.status.humanize %></strong> · <%= check_in.note %></p>
          <% elsif date <= Date.current %><%= form_with url: check_in_dashboard_marketing_kit_path(@kit, site_id: @site.id), class: 'sales-form' do %><%= hidden_field_tag :day_index, index %><label>What happened?<%= text_area_tag :note, nil, rows: 2, required: true, maxlength: 1000, placeholder: 'Record what you did or why you skipped this day.' %></label><label>Check-in<%= select_tag :status, options_for_select([['Completed my focus blocks','completed'], ['Skipped this day','skipped']]) %></label><%= submit_tag 'Save check-in', class: 'sales-button secondary' %><% end %><% end %>
        </details>
      <% end %>
    </section>
    <section class="sales-panel"><span class="sales-eyebrow">TURN INTEREST INTO CONVERSATIONS</span><h2>Follow up with people already in your pipeline.</h2><p>Drafts use your saved offer and CRM context. Creating a task records the next action; no message is sent.</p>
      <% if @kit.snapshot['follow_ups'].empty? %><p class="sales-empty">No due or new leads were eligible when this kit was prepared. Review incoming inquiries and add legitimate leads in Sales.</p><% end %>
      <% @kit.snapshot['follow_ups'].each do |follow_up| %><% lead = @follow_up_leads[follow_up['lead_id']]; fresh = @current && lead && lead.lock_version == follow_up['revision'] && %w[new contacted qualified].include?(lead.status) %><article class="marketing-follow-up"><h3><%= follow_up['name'] %> · <%= follow_up['company'] %></h3><p>Saved status: <%= follow_up['status'] %> · Next step: <%= follow_up['next_step'].presence || 'Not recorded' %></p><details><summary>Review the outreach drafts</summary><p class="marketing-copy"><%= follow_up['opening'] %></p><p class="marketing-copy"><%= follow_up['next_step_draft'] %></p></details>
        <% if fresh %><%= button_to 'Prepare or open follow-up task', follow_up_dashboard_marketing_kit_path(@kit, site_id: @site.id), params: {lead_id: follow_up['lead_id']}, class: 'sales-button secondary' %><% else %><p class="sales-errors">This kit or lead changed. Review a fresh kit before using its draft.</p><% end %>
      </article><% end %><%= link_to 'Open Sales and existing tasks', dashboard_sales_path(site_id: @site.id, tab: 'tasks') %>
    </section>
  <% end %>
  <% if @kits.any? %><section class="sales-panel"><h2>Previous kits</h2><div class="sales-actions"><% @kits.each do |kit| %><%= link_to "#{kit.starts_on} · #{kit.snapshot.dig('brief', 'offering')}", dashboard_marketing_copilot_path(site_id: @site.id, kit_id: kit.id) %><% end %></div></section><% end %>
</main>
