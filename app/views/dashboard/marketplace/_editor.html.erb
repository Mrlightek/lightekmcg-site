<%= stylesheet_link_tag "lightek_marketplace", "data-turbo-track": "reload" %>
<%= javascript_include_tag "lightek_marketplace_editor", defer: true, "data-turbo-track": "reload" %>
<% @step ||= 0; labels = DymondCatalog::MarketplaceListing.category_labels; recurring = @product.recurring? %>
<div id="lm-marketplace"><div class="lm-main" data-marketplace-editor>
<div class="lm-admin-top"><%= link_to "← Products & services", main_app.dashboard_marketplace_path, class: "lm-textbutton" %><% if @listing.persisted? %><%= link_to "Preview product ↗", main_app.preview_dashboard_marketplace_listing_path(@listing), class: "lm-textbutton" %><% end %></div>
<div class="lm-title-row"><div><p class="lm-eyebrow">MARKETPLACE</p><h1><%= heading %></h1><p>Choose what you sell, how customers pay, and how it’s delivered.</p></div></div>
<% if @product.errors.any? %><div class="lm-review-note" role="alert"><h2>Review this product</h2><ul><% @product.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
<%= form_with model: @product, scope: :marketplace_product, url: (@listing.persisted? ? main_app.dashboard_marketplace_listing_path(@listing) : main_app.dashboard_marketplace_listings_path), method: (@listing.persisted? ? :patch : :post), html: {novalidate: true}, data: {turbo: false} do |f| %>
<%= hidden_field_tag :editor_step, @step %>
<% step_fields = [%w[name description category position], %w[billing price monthly_price annual_price setup_fee trial_days], %w[delivery service_id welcome], []] %>
<% (@product.attributes.keys - step_fields.fetch(@step)).each do |name| %><%= f.hidden_field name %><% end %>
<div class="lm-steps" aria-label="Product setup"><% %w[Details Pricing Delivery Review].each_with_index do |label, i| %><%= f.button name: :commit_action, value: "step_#{i}", type: :submit, class: (@step == i ? "is-active" : nil), aria: {current: @step == i ? "step" : nil} do %><span><%= i + 1 %></span><%= label %><% end %><% end %></div>
<div class="lm-editorgrid"><div><section class="lm-formpanel" data-current-step="<%= @step %>">
<% if @step == 0 %><div class="lm-fields"><h2>What are you selling?</h2><p>Give your customers a clear name and description.</p><label>Product or service name<%= f.text_field :name, required: true, maxlength: 160, data: {preview_name: true} %></label><label>Product group<%= f.select :category, labels.map { |key, name| [name, key] } %></label><p class="lm-small"><%= link_to "Manage product groups ↗", main_app.dashboard_marketplace_groups_path, target: "_blank", rel: "noopener" %> · <button type="submit" name="commit_action" value="refresh" class="lm-textbutton">Refresh groups</button></p><label>Short description<%= f.text_area :description, required: true, maxlength: 1200, data: {preview_description: true} %></label><label>Display order<%= f.number_field :position, min: 0, required: true %></label></div>
<% elsif @step == 1 %><div class="lm-fields"><h2>How will customers pay?</h2><p>One product can offer monthly and yearly billing. All prices are in USD.</p><label>Billing options<%= f.select :billing, [["Monthly and yearly", "both"], ["Monthly only", "monthly"], ["Yearly only", "annual"], ["One-time purchase", "once"], ["Free", "free"]], {}, data: {billing: true} %></label><button type="submit" name="commit_action" value="refresh" class="lm-textbutton">Apply billing options</button>
<div data-price-field="monthly" <%= 'hidden' unless @product.intervals.include?("monthly") %>><label>Monthly price<%= f.number_field :monthly_price, value: @product.price_for("monthly"), min: 0, step: "0.01" %></label></div><div data-price-field="annual" <%= 'hidden' unless @product.intervals.include?("annual") %>><label>Yearly price<%= f.number_field :annual_price, value: @product.price_for("annual"), min: 0, step: "0.01" %><small>Set your yearly total. It doesn’t have to be twelve times the monthly price.</small></label></div><div data-price-field="once" <%= 'hidden' unless @product.billing == "once" %>><label>One-time price<%= f.number_field :price, min: 0, step: "0.01" %></label></div>
<div data-setup-field <%= 'hidden' if @product.billing == "free" %>><label>Setup fee<%= f.number_field :setup_fee, min: 0, step: "0.01" %><small>A one-time charge added when the customer orders.</small></label></div><div data-trial-field <%= 'hidden' unless recurring %>><label>Free trial<%= f.select :trial_days, [["No trial", 0], ["7 days", 7], ["14 days", 14], ["30 days", 30]] %></label></div><p class="lm-small">New prices apply to new orders. Existing customer subscriptions keep their agreed prices.</p></div>
<% elsif @step == 2 %><div class="lm-fields"><h2>What does the customer receive?</h2><p>Choose a delivery method. Only connected applications appear as access options.</p><label>Delivery method<%= f.select :delivery, [["A website for their business", "website"], ["Access to an application", "access"], ["Work delivered by my team", "manual"]], {}, data: {delivery: true} %></label><button type="submit" name="commit_action" value="refresh" class="lm-textbutton">Apply delivery method</button>
<div data-delivery-panel="website" <%= 'hidden' unless @product.delivery == "website" %> class="lm-review-note"><strong>A website for their business</strong><p>After the order is paid or a free trial starts, Gatekeeper creates a website owned by the customer. Your team still activates its domain and secure connection.</p><p>A monthly or yearly subscription is required.</p></div>
<div data-delivery-panel="manual" <%= 'hidden' unless @product.delivery == "manual" %> class="lm-review-note"><strong>Work delivered by your team</strong><p>After payment, a work request is created with the customer, order and instructions. Your team completes the work.</p></div>
<div data-delivery-panel="access" <%= 'hidden' unless @product.delivery == "access" %>><% services = LightekMarketplace::ProductForm.services.to_a %><label>Application<%= f.select :service_id, services.map { |service| [service.name, service.id, {"data-description" => service.description, "data-path" => service.customer_path}] }, {include_blank: "Choose a connected application"}, data: {service_choice: true} %></label><div class="lm-review-note" data-service-explanation><% if (service = services.find { |item| item.id == @product.service_id }) %><strong><%= service.name %></strong><p><%= service.description %></p><p>Customer opens: <%= service.customer_path %></p><% else %><p>No application selected. Only connections you have reviewed and marked ready are listed.</p><% end %></div><p class="lm-small"><%= link_to "Manage application connections ↗", main_app.dashboard_marketplace_connections_path, target: "_blank", rel: "noopener" %></p></div>
<label>Delivery instructions or welcome message<%= f.text_area :welcome, maxlength: 1200 %><small>Stored with the delivery record or team work request. This does not send an email.</small></label></div>
<% else %><h2>Review your product.</h2><p>Check what the customer will buy before publishing.</p><dl class="lm-review-summary"><dt>Product</dt><dd><%= @product.name %></dd><dt>Group</dt><dd><%= labels[@product.category] %></dd><% if recurring %><% @product.intervals.each do |iv| %><dt><%= iv == "annual" ? "Yearly price" : "Monthly price" %></dt><dd><%= marketplace_money(@product.cents(@product.price_for(iv)), "usd") %></dd><% end %><% else %><dt>Price</dt><dd><%= @product.billing == "free" ? "Free" : marketplace_money(@product.cents(@product.price), "usd") %></dd><% end %><dt>Setup fee</dt><dd><%= marketplace_money(@product.billing == "free" ? 0 : @product.cents(@product.setup_fee), "usd") %></dd><dt>Trial</dt><dd><%= @product.trial_days.to_i.positive? ? "#{@product.trial_days} days" : "None" %></dd><dt>Delivery</dt><dd><%= {"website" => "Customer website", "manual" => "Team work request", "access" => "Application access"}[@product.delivery] %></dd></dl><div class="lm-review-note">Publishing makes this product available for real checkout. Save a draft to keep it private.</div>
<% end %></section>
<div class="lm-editor-actions"><div><% if @step > 0 %><%= f.button "← Back", name: :commit_action, value: "back", class: "lm-action secondary" %><% else %><%= link_to "Cancel", main_app.dashboard_marketplace_path, class: "lm-textbutton" %><% end %></div><div class="lm-hero-actions"><%= f.button "Save draft", name: :commit_action, value: "draft", class: "lm-textbutton" %><% if @step < 3 %><%= f.button "Continue →", name: :commit_action, value: "next", class: "lm-action" %><% else %><%= f.button "Publish product →", name: :commit_action, value: "publish", class: "lm-action" %><% end %></div></div>
</div><aside class="lm-livecard"><div class="lm-live-label">STOREFRONT PREVIEW</div><%= render "marketplace/art", category: @product.category %><div class="lm-productbody"><span class="lm-tag"><%= labels[@product.category] %></span><h3 data-live-name><%= @product.name.presence || "Your product name" %></h3><p data-live-description><%= @product.description.presence || "Your product description" %></p><div class="lm-price"><% if recurring %><% @product.intervals.each do |iv| %><div><%= marketplace_money(@product.cents(@product.price_for(iv)), "usd") rescue "Set a price" %><small>/ <%= iv == "annual" ? "year" : "month" %></small></div><% end %><% else %><%= @product.billing == "free" ? "Free" : (marketplace_money(@product.cents(@product.price), "usd") rescue "Set a price") %><% end %></div></div></aside></div>
<% end %></div></div>
