<%= stylesheet_link_tag "lightek_marketplace", "data-turbo-track": "reload" %>
<div id="lm-marketplace"><div class="lm-main"><div class="lm-admin-top"><span>Workspace / Marketplace</span><%= link_to "View storefront ↗", main_app.marketplace_path, class: "lm-textbutton" %></div><div class="lm-title-row"><div><p class="lm-eyebrow">YOUR BUSINESS, CONNECTED</p><h1>Products & services</h1><p>Create what you sell. Set the price. Choose how it’s delivered.</p></div><%= link_to "+ Add a product", main_app.new_dashboard_marketplace_listing_path, class: "lm-action" %></div>
<% if notice %><p class="lm-review-note" role="status"><%= notice %></p><% end %>
<div class="lm-hero-actions" style="margin-bottom:24px"><%= link_to "Product groups", main_app.dashboard_marketplace_groups_path, class: "lm-action secondary" %><%= link_to "Application connections", main_app.dashboard_marketplace_connections_path, class: "lm-action secondary" %></div><div class="lm-list"><div class="lm-list-head"><span>Product or service</span><span>Price</span><span>Visibility</span><span></span></div><% @listings.each do |listing| %><div class="lm-list-row"><div><strong><%= listing.title %></strong><small><%= DymondCatalog::MarketplaceListing.category_labels.fetch(listing.category) %></small></div><div class="lm-small"><%= marketplace_rate(listing) %></div><div><span class="lm-status"><%= listing.published? && listing.offer.active? ? "Published" : "Draft" %></span></div><%= link_to "Edit ↗", main_app.edit_dashboard_marketplace_listing_path(listing), class: "lm-textbutton" %></div><% end %><% if @listings.empty? %><div class="lm-empty"><h2>Your first product starts here.</h2><p>Add its details, pricing and delivery in one place.</p><%= link_to "Create a service →", main_app.new_dashboard_marketplace_listing_path, class: "lm-action" %></div><% end %></div></div></div>
