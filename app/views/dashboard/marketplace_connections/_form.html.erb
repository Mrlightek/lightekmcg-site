<%= stylesheet_link_tag "lightek_marketplace", "data-turbo-track": "reload" %><div id="lm-marketplace"><div class="lm-main"><%= link_to "← Application connections", main_app.dashboard_marketplace_connections_path, class: "lm-textbutton" %><div class="lm-title-row"><h1><%= @connection.persisted? ? "Edit application connection" : "Connect an application" %></h1></div><% if @connection.errors.any? %><div role="alert" class="lm-review-note"><%= @connection.errors.full_messages.to_sentence %></div><% end %><%= form_with model: @connection, scope: :customer_service, url: (@connection.persisted? ? main_app.dashboard_marketplace_connection_path(@connection) : main_app.dashboard_marketplace_connections_path), class: "lm-fields", html: {novalidate: true} do |f| %><label>Application name<%= f.text_field :name, required: true, maxlength: 100, placeholder: "For example: Creator Studio" %></label><label>What does the customer get?<%= f.text_area :description, required: true, maxlength: 600, placeholder: "Describe the application and what purchasing access enables." %></label><label>Customer entry page<%= f.text_field :customer_path, required: true, placeholder: "/studio" %><small>The page where a customer opens this application after signing in.</small></label><details <%= "open" if @connection.errors[:feature_key].any? %>><summary>Application access configuration</summary><p class="lm-small">This connects the application’s existing access check to a purchase. It does not build or deploy the application.</p><label>Application access key<%= f.text_field :feature_key, required: true, maxlength: 100 %><small>Use the registered feature key that this application checks for customer access. Administrative access keys cannot be sold.</small></label></details><label class="lm-check"><%= f.check_box :active %> I have tested customer access and this connection is ready for products.</label><p class="lm-note">Leave this unchecked while setting up the application. Draft connections never appear in the product editor.</p><%= f.submit "Save connection", class: "lm-action" %><% end %></div></div>
