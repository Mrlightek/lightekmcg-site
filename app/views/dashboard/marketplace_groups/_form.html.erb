<%= stylesheet_link_tag "lightek_marketplace", "data-turbo-track": "reload" %><div id="lm-marketplace"><div class="lm-main"><%= link_to "← Product groups", main_app.dashboard_marketplace_groups_path, class: "lm-textbutton" %><div class="lm-title-row"><h1><%= @group.persisted? ? "Edit product group" : "Add a product group" %></h1></div><% if @group.errors.any? %><div role="alert" class="lm-review-note"><%= @group.errors.full_messages.to_sentence %></div><% end %><%= form_with model: @group, scope: :product_group, url: (@group.persisted? ? main_app.dashboard_marketplace_group_path(@group) : main_app.dashboard_marketplace_groups_path), class: "lm-fields" do |f| %><label>Group name<%= f.text_field :name, required: true, maxlength: 100 %></label><label>Description<%= f.text_area :description, maxlength: 500 %></label><label>Display order<%= f.number_field :position, min: 0 %></label><label class="lm-check"><%= f.check_box :active %> Available for products and storefront navigation</label><p class="lm-muted lm-small">A group can be archived once its products have been moved to another group.</p><%= f.submit "Save group", class: "lm-action" %><% end %></div></div>
