<%= stylesheet_link_tag "lightek_marketplace", "data-turbo-track": "reload" %>
<div id="lm-marketplace"><div class="lm-main"><%= link_to "← Products & services", main_app.dashboard_marketplace_path, class: "lm-textbutton" %><div class="lm-title-row"><div><h1>Product groups</h1><p>Organize what customers see in your storefront.</p></div><%= link_to "+ Add a group", main_app.new_dashboard_marketplace_group_path, class: "lm-action" %></div><% if notice %><p role="status"><%= notice %></p><% end %><div class="lm-list"><div class="lm-list-head"><span>Group</span><span>Products</span><span>Status</span><span></span></div><% @groups.each do |group| %><div class="lm-list-row"><div><strong><%= group.name %></strong><small><%= group.description %></small></div><span><%= @counts.fetch(group.key, 0) %></span><span><%= group.active? ? "Available" : "Archived" %></span><%= link_to "Edit ↗", main_app.edit_dashboard_marketplace_group_path(group), class: "lm-textbutton" %></div><% end %></div></div></div>
