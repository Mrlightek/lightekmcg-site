<%= form_with url: outlet.persisted? ? dashboard_broadcast_application_path(outlet, site_id: @site.id) : dashboard_broadcast_applications_path(site_id: @site.id), scope: :outlet, namespace: "outlet_#{outlet.id || 'new'}", method: outlet.persisted? ? :patch : :post, local: true, class: "ms-form" do |f| %>
  <% if outlet.persisted? %><%= f.hidden_field :lock_version, value: outlet.lock_version %><% end %>
  <label>App name<%= f.text_field :name, value: outlet.name, required: true, maxlength: 120, placeholder: "Octavia" %></label><label>App key<%= f.text_field :slug, value: outlet.slug, required: true, pattern: "[a-z0-9][a-z0-9_-]{0,63}", placeholder: "octavia" %></label>
  <label>Platform<%= f.select :platform, Studio::Broadcasting::Application::PLATFORMS.map { |key| [key.humanize, key] }, selected: outlet.platform %></label><label>Availability<%= f.select :status, [["Draft", "draft"], ["Published", "published"], ["Maintenance / off air", "maintenance"]], selected: outlet.status %></label><label>Minimum app version<%= f.text_field :minimum_client_version, value: outlet.minimum_client_version || "1.0.0", required: true, pattern: "[0-9]+[.][0-9]+[.][0-9]+" %></label>
  <%= f.fields_for :settings do |settings| %><% config = outlet.configuration %>
    <label>Accent color<%= settings.color_field :accent, value: config["accent"] %></label><label>Background<%= settings.color_field :background, value: config["background"] %></label><label>Refresh interval (seconds)<%= settings.number_field :configuration_ttl, value: config["configuration_ttl"], min: 15, max: 3600 %></label><label class="ms-wide">Welcome message<%= settings.text_field :welcome_message, value: config["welcome_message"], maxlength: 300 %></label>
    <label>Media selection<%= settings.select :catalog_source, [["All published OTT titles", "all"], ["Only selected titles", "selected"]], selected: config["catalog_source"] %></label>
    <label>Channel selection<%= settings.select :channel_source, [["All on-air channels", "all"], ["Only selected channels", "selected"]], selected: config["channel_source"] %></label>
    <label>Selected titles<%= settings.select :post_ids, @posts.map { |post| ["##{post.id} · #{post.title}", post.id] }, {selected: config["post_ids"]}, multiple: true, size: 5 %></label>
    <label>Selected channels<%= settings.select :channel_ids, @channels.map { |channel| [channel.name, channel.id] }, {selected: config["channel_ids"]}, multiple: true, size: 5 %></label>
    <% {"catalog"=>"Show media catalog", "live"=>"Live TV & channels", "search"=>"Search", "captions"=>"Captions preference", "autoplay"=>"Autoplay preference"}.each do |key,label| %><label class="ms-toggle"><%= settings.check_box key, checked: config[key] %><span><%= label %></span></label><% end %>
  <% end %><div class="ms-wide"><%= f.submit outlet.persisted? ? "Save app controls" : "Create application", class: "ms-button ms-primary" %></div>
<% end %>
