<%= form_with url: channel.persisted? ? dashboard_broadcast_channel_path(channel, site_id: @site.id) : dashboard_broadcast_channels_path(site_id: @site.id), scope: :channel, method: channel.persisted? ? :patch : :post, local: true, class: "ms-form" do |f| %>
  <% if channel.persisted? %><%= f.hidden_field :lock_version, value: channel.lock_version %><% end %>
  <label>Channel name<%= f.text_field :name, value: channel.name, required: true, maxlength: 120 %></label><label>Availability<%= f.select :status, [["Draft", "draft"], ["On air", "published"], ["Off air", "off_air"]], selected: channel.status %></label><label class="ms-wide">Public playback URL<%= f.url_field :playback_url, value: channel.playback_url, placeholder: "https://your-stream.example/live/index.m3u8" %></label><label>Channel artwork URL<%= f.url_field :image_url, value: channel.image_url %></label><label>Display order<%= f.number_field :position, value: channel.position || 0, min: 0, max: 9999 %></label><label class="ms-wide">Description<%= f.text_area :description, value: channel.description, maxlength: 2000, rows: 2 %></label><div class="ms-wide"><%= f.submit "Save channel", class: "ms-button ms-primary" %></div>
<% end %>
