<%= render "dashboard/shared/business_workspace", active: "Studio" %>
<% content_for :page_title, "Media Studio" %>
<%= stylesheet_link_tag "/lightek/broadcast/control.css?v=1" %>
<%= stylesheet_link_tag "/lightek/media-control.css?v=61" %>
<main class="media-control">
<header class="mc-top"><span class="mc-brand">LIGHTEK / MEDIA STUDIO</span><nav><%= link_to "Live Studio",dashboard_live_path,class:"mc-button" %><% if @site %><%= link_to "Rooms & guests",dashboard_rooms_path(site_id:@site.id),class:"mc-button" %><%= link_to "New production",dashboard_studio_editor_new_path(kind:"video",site_id:@site.id),class:"mc-button mc-primary",data:{turbo:false} %><% end %></nav></header>
<section class="mc-intro"><div><span class="mc-eyebrow">YOUR PRODUCTION DESKTOP</span><h1>Make something worth watching.</h1><p>Picture, color, music, characters and delivery. Open a production and stay in the same workspace from the first cut to the final master.</p></div><%= form_with url:dashboard_media_studio_path,method: :get,local:true,class:"mc-selector" do %><label class="mc-field"><span>Workspace</span><%= select_tag :site_id,options_from_collection_for_select(@sites,:id,:name,@site&.id),include_blank:"Choose application" %></label><%= submit_tag "Switch",class:"mc-button" %><% end %></section>
<% unless @site %><section class="mc-panel"><h2>Choose a workspace</h2><p class="mc-muted">Select your application above to open its production library.</p></section><% else %>
<div class="mc-library-toolbar"><h2>Production library</h2><span><%= @production_projects.size %> productions · <%= @site.host %></span></div>
<section class="mc-project-grid" aria-label="Production library">
<article class="mc-project mc-new"><h3>Photo & graphics</h3><p>Edit images with layers, selections, brushes, text and filters.</p><%= link_to "Create artwork",dashboard_studio_editor_new_path(kind:"photo",site_id:@site.id),class:"mc-button mc-primary",data:{turbo:false} %></article>
<article class="mc-project mc-new"><span>＋</span><h3>New production</h3><p>Import clips, trim, arrange tracks, add titles and export your video.</p><%= link_to "Create production",dashboard_production_workspace_path(site_id:@site.id),class:"mc-button mc-primary",data:{turbo:false} %></article>
<% @production_projects.each do |project| %><% scenes=@production_scenes.fetch(project.id,[]);first_scene=scenes.first; editor_kind=first_scene&.settings&.fetch("editor_kind",nil); open_path=%w[photo video].include?(editor_kind) ? dashboard_studio_editor_path(kind:editor_kind,id:first_scene.id,site_id:@site.id) : dashboard_production_workspace_path(site_id:@site.id,scene_id:first_scene&.id,workspace:"edit") %><article class="mc-project"><%= link_to open_path,class:"mc-project-image",data:{turbo:false} do %><span><%= project.name.split.map{|word|word[0]}.first(2).join.upcase %></span><small><%= project.is_template ? 'SHOW TEMPLATE' : 'PRODUCTION' %></small><% end %><div class="mc-project-info"><h3><%= project.name %></h3><p><%= scenes.size %> scenes · Updated <%= project.updated_at.strftime('%b %d') %></p><%= link_to (editor_kind == "photo" ? "Open Photo Studio" : editor_kind == "video" ? "Open Video Studio" : "Open Media Studio"),open_path,class:"mc-button",data:{turbo:false} %><% if first_scene %><%= link_to "AI Studio",dashboard_production_workspace_path(site_id:@site.id,scene_id:first_scene.id,workspace:"ai"),class:"mc-button",data:{turbo:false} %><% end %></div><% if scenes.size>1 %><details class="mc-project-scenes"><summary>Choose a scene</summary><% scenes.each do |scene| %><%= link_to scene.name,dashboard_production_workspace_path(site_id:@site.id,scene_id:scene.id,workspace:"edit"),data:{turbo:false} %><% end %></details><% end %></article><% end %>
</section><nav class="mc-studio-rail" aria-label="Studio services"><%= link_to dashboard_production_workspace_path(site_id:@site.id,anchor:"/studio/library") do %><strong>Asset library</strong><span>Footage, recordings, characters and Blender sources.</span><% end %><%= link_to dashboard_rooms_path(site_id:@site.id) do %><strong>Live rooms</strong><span>Create a video or audio room, invite guests and bring them on air.</span><% end %><a href="#broadcast-management"><strong>Broadcast & release</strong><span>Manage destinations, channels, publications and your program guide.</span></a></nav>
    <details class="mc-broadcast-settings" id="broadcast-management"><summary>Broadcast management · cast, releases, channels & OTT apps</summary>
    <section class="ms-card" id="cast"><div class="ms-section-heading"><div><p class="ms-eyebrow">RECURRING TALENT</p><h2>Cast library</h2></div></div><p>Open a scene in Studio to add a character and give it a recording. The same character can play independent roles in one scene.</p><div class="ms-pipeline"><% @cast_members.each do |actor| %><div><strong><%= actor.name %></strong><p>Reusable native character</p></div><% end %></div><% if @cast_members.empty? %><p class="ms-muted">Your saved performers will appear here.</p><% end %></section>

    <section class="ms-card"><p class="ms-eyebrow">ASSET WORKSHOP</p><h2>Build your own production assets.</h2><p>Create shapes, sets, stages, lights and effects in Studio. Import and edit native Blender files, save reusable scene assets, then export for your community, channels and live productions.</p><div class="ms-section-heading"><%= link_to "Create in Studio ↗", dashboard_production_workspace_path(site_id:@site.id,anchor:"/studio/workshop"), class: "ms-button ms-primary" %><%= link_to "Blender files & asset library ↗", dashboard_production_workspace_path(site_id:@site.id,anchor:"/studio/library"), class: "ms-button" %></div></section>
    <section class="ms-card" id="releases"><div class="ms-section-heading"><div><p class="ms-eyebrow">DISTRIBUTION</p><h2>Media & releases</h2></div><span class="ms-pill">Lightek · Octavia</span></div>
      <%= form_with url: dashboard_broadcast_publications_path(site_id: @site.id), scope: :publication, local: true, class: "ms-form" do |f| %>
        <%= f.hidden_field :request_key, value: SecureRandom.hex(16) %>
        <label>Exported master<%= f.select :artifact_id, @artifacts.map { |a| ["##{a.id} · #{a.filename} · #{a.kind}", a.id] }, {include_blank: "Choose a completed export"}, required: true %></label>
        <label>Destination<%= f.select :platform, [["Octavia / OTT", "octavia"], ["Lightek Streaming", "lightek_streaming"], ["Lightek Social", "lightek_social"]] %></label>
        <label>Release title<%= f.text_field :title, maxlength: 160 %></label><label>Release time (optional, <%= Time.zone.name %>)<%= f.datetime_local_field :publish_at %></label><%= f.submit "Queue release", class: "ms-button ms-primary" %>
      <% end %>
      <h3>Delivery queue</h3><div class="ms-table-wrap"><table><thead><tr><th>Release</th><th>Destination</th><th>Status</th><th>Scheduled / published</th><th>Action</th></tr></thead><tbody>
      <% @publications.each do |release| %><tr><td>#<%= release.id %> · <%= release.metadata["title"].presence || release.artifact.filename %><% if release.error_message.present? %><small class="ms-error"><%= release.error_message %></small><% end %></td><td><%= release.platform.humanize %></td><td><span class="ms-pill"><%= release.status %></span></td><td><%= (release.published_at || release.scheduled_at)&.strftime("%b %d, %H:%M %Z") || "Queued" %></td><td><% if %w[draft scheduled failed].include?(release.status) %><%= button_to "Cancel", dashboard_broadcast_publication_path(release, site_id: @site.id), method: :delete, class: "ms-button" %><% end %></td></tr><% end %>
      <% if @publications.empty? %><tr><td colspan="5">Your queued and completed releases will appear here.</td></tr><% end %></tbody></table></div>
      <h3>Published catalog</h3><p class="ms-muted">Hide a title to remove it from all audience-facing catalogs and protected playback endpoints.</p>
      <div class="ms-catalog"><% @posts.each do |post| %><%= form_with url: dashboard_broadcast_post_path(post, site_id: @site.id), scope: :post, method: :patch, local: true, class: "ms-catalog-item" do |f| %><span class="ms-pill">#<%= post.id %> / <%= post.kind %></span><label>Title<%= f.text_field :title, value: post.title, maxlength: 160 %></label><label>Visibility<%= f.select :moderation_state, [["Published", "published"], ["Hidden", "hidden"]], selected: post.moderation_state %></label><small><%= post.audience.humanize %> · <%= post.visibility.humanize %></small><%= f.submit "Save title", class: "ms-button" %><% end %><% end %><% if @posts.empty? %><p class="ms-empty">No OTT releases yet. Export a video from Studio, then queue its release above.</p><% end %></div>
    </section>
    <section class="ms-card" id="generation"><h2>AI Studio</h2><p>Open a production and choose AI Studio to generate with your own local engine and installed models. Results save into the same asset library for editing. No hosted generation provider key is required for this workflow.</p></section>
    <section class="ms-card" id="channels"><div class="ms-section-heading"><div><p class="ms-eyebrow">ON AIR</p><h2>Live channels</h2></div><%= link_to "Broadcast from your browser ↗", "https://#{@site.host}/dashboard/live", class: "ms-button" %></div><p class="ms-muted">Use a public HLS feed for a continuous channel, or start a Lightek browser broadcast to appear in the live catalog. RTMP stream keys belong in Live Studio’s private destination settings.</p>
      <% @channels.each do |channel| %><details class="ms-editor"><summary><strong><%= channel.name %></strong><span class="ms-pill"><%= channel.status.humanize %></span></summary><%= render "channel_form", channel: channel %></details><% end %>
      <details class="ms-editor" <%= "open" if @channels.empty? %>><summary>＋ Add a live channel</summary><%= render "channel_form", channel: Studio::Broadcasting::Channel.new %></details>
      <h3>Broadcast activity</h3><% @live.each do |live| %><div class="ms-activity"><div><strong><%= live.metadata["title"].presence || live.studio_project.name %></strong><small><%= live.metadata["destination"] %> · <%= live.created_at.strftime("%b %d, %H:%M %Z") %></small></div><span class="ms-pill"><%= live.status %></span><% if %w[connecting live].include?(live.status) %><%= button_to "End broadcast", stop_dashboard_broadcast_path(live, site_id: @site.id), class: "ms-button" %><% end %></div><% end %><% if @live.empty? %><p class="ms-muted">No broadcasts in this workspace yet.</p><% end %>
    </section>
    <section class="ms-card" id="schedule"><p class="ms-eyebrow">PROGRAMMING</p><h2>On now & up next</h2><p class="ms-muted">Times use <%= Time.zone.name %>. This guide describes the channel feed; your live playout source controls what is actually on air.</p>
      <%= form_with url: dashboard_broadcast_programs_path(site_id: @site.id), scope: :program, local: true, class: "ms-form" do |f| %><label>Channel<%= f.select :channel_id, @channels.map { |c| [c.name, c.id] }, {}, required: true %></label><label>Program<%= f.select :post_id, @posts.map { |p| ["##{p.id} · #{p.title}", p.id] }, {}, required: true %></label><label>Starts at<%= f.datetime_local_field :starts_at, required: true %></label><label>Ends at<%= f.datetime_local_field :ends_at, required: true %></label><%= f.submit "Add to guide", class: "ms-button ms-primary" %><% end %>
      <div class="ms-table-wrap"><table><thead><tr><th>Channel</th><th>Program</th><th>Start</th><th>End</th><th></th></tr></thead><tbody><% @programs.each do |slot| %><tr><td><%= slot.channel.name %></td><td><%= slot.post.title %></td><td><%= slot.starts_at.strftime("%b %d, %H:%M %Z") %></td><td><%= slot.ends_at.strftime("%b %d, %H:%M %Z") %></td><td><%= button_to "Remove", dashboard_broadcast_program_path(slot, site_id: @site.id), method: :delete, class: "ms-button" %></td></tr><% end %><% if @programs.empty? %><tr><td colspan="5">Your program schedule will appear here.</td></tr><% end %></tbody></table></div>
    </section>
    <section class="ms-card" id="applications"><div class="ms-section-heading"><div><p class="ms-eyebrow">EVERY SCREEN</p><h2>OTT applications</h2></div><span class="ms-pill">Gatekeeper controlled</span></div><p class="ms-muted">Each app pulls its branding, navigation, media, live channels and player preferences from Gatekeeper. Publish to enable an app; maintenance takes it off air on its next refresh. Client apps must support the corresponding controls.</p>
      <% @applications.each do |outlet| %><details class="ms-editor"><summary><strong><%= outlet.name %></strong><span><%= outlet.platform.humanize %></span><span class="ms-pill"><%= outlet.status %></span></summary><%= render "application_form", outlet: outlet %><div class="ms-endpoint"><strong>Gatekeeper configuration</strong><code><%= "https://#{@site.host}/gatekeeper/config?platform=#{outlet.platform}&application=#{outlet.slug}" %></code><%= link_to "Preview contract ↗", "https://#{@site.host}/gatekeeper/config?platform=#{outlet.platform}&application=#{outlet.slug}", target: "_blank", rel: "noopener" %></div></details><% end %>
      <details class="ms-editor" <%= "open" if @applications.empty? %>><summary>＋ Create an OTT application</summary><%= render "application_form", outlet: Studio::Broadcasting::Application.new %></details>
    </section>
    </details>
  <% end %>
</main>
