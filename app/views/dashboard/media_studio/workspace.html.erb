<% content_for :page_title, "Lightek Studio" %>
<% content_for :head do %><meta name="turbo-visit-control" content="reload"><% end %>
<%= stylesheet_link_tag "/lightek/studio-visual.css?v=65" %>
<%= stylesheet_link_tag "/lightek/studio-authoring.css?v=66" %>
<%= stylesheet_link_tag "/lightek/studio-music.css?v=65" %>
<%= stylesheet_link_tag "/lightek/studio-dashboard.css?v=65" %>
<main id="lightek-studio-dashboard" class="media-studio-focus" data-turbo="false" data-site-id="<%= @site.id %>" data-user-id="<%= current_user.id %>" data-scene-id="<%= @scene&.id %>" data-workspace="<%= @workspace_mode %>" data-pwa-url="<%= "https://#{@site.host}/lightek/index.html" %>" data-csrf-token="<%= form_authenticity_token %>">
  <%= render "dashboard/shared/business_workspace", active: "Studio", studio: true %>
  <div id="studio-root" role="region" aria-label="Lightek production studio"><p role="status">Opening your studio…</p></div>
</main>
<%= javascript_include_tag "/lightek/nevaeh-client.js?v=65", defer:true %>
<%= javascript_include_tag "/lightek/studio-dashboard.js?v=65", defer:true %>
<% %w[studio-app studio-native studio-authoring studio-media studio-create studio-performance studio-visual].each do |name| %>
  <%= javascript_include_tag "/lightek/#{name}.js?v=66", defer:true %>
<% end %>
<%= javascript_include_tag "/lightek/vendor/tone/Tone-15.1.22.js", defer:true %>
<%= javascript_include_tag "/lightek/vendor/tone/Midi-2.0.28.js", defer:true %>
<% %w[studio-music-core studio-music-audio studio-music].each do |name| %>
  <%= javascript_include_tag "/lightek/#{name}.js?v=65", defer:true %>
<% end %>
<%= javascript_include_tag "/lightek/studio-production.js?v=67", defer:true %>
<%= javascript_include_tag "/lightek/studio-dashboard-context.js?v=1", defer:true %>
<%= javascript_include_tag "/lightek/studio-edit-workbench.js?v=65", defer:true %>
<%= javascript_include_tag "/lightek/studio-ai.js?v=68", defer:true %>
<%= javascript_include_tag "/lightek/studio-shots.js?v=67", defer:true %>
<%= stylesheet_link_tag "/lightek/studio-shots.css?v=67" %>
<%= javascript_include_tag "/lightek/studio-delivery.js?v=65", defer:true %>
<%= stylesheet_link_tag "/lightek/studio-delivery.css?v=65" %>
<%= stylesheet_link_tag "/lightek/studio-edit-workbench.css?v=66" %>
<script type="importmap">{"imports":{"three":"/lightek/vendor/three/three.module.js"}}</script>
<script type="module" src="/lightek/studio-viewport.js?v=66"></script>

<%= stylesheet_link_tag "/lightek/studio-ai.css?v=68" %>
