<% content_for :page_title, "Network & Domains" %>
<main class="dd-workspace dd-network">
  <header class="dd-page-header"><div><span class="dd-eyebrow">Gatekeeper / infrastructure</span><h1>Network & Domains</h1><p>Manage DNS, inspect infrastructure and organize network access from one workspace.</p></div><span class="dd-status">Super admin</span></header>
  <nav class="net-navigation" aria-label="Network sections">
    <% [["Domains & DNS", "dns"], ["Servers & installations", "servers"], ["Devices", "devices"], ["Firewall", "firewall"], ["Scheduled jobs", "schedules"], ["Activity", "activity"]].each do |label, section| %>
      <%= link_to label, "#network-#{section}" %>
    <% end %>
  </nav>
  <section class="net-overview" aria-label="Network overview">
    <% [["Selected zone", @zone.presence || "None"], ["Servers shown", @managed_nodes.size], ["Devices shown", @devices.size], ["Schedules", @cron_jobs.size]].each do |label, value| %>
      <div><span><%= label %></span><strong><%= value %></strong></div>
    <% end %>
  </section>
<% if @dashboard_warnings.present? %>
  <section class="dd-panel net-panel" id="network-warnings" aria-label="Service availability warnings">
    <h2 class="net-title">Service availability</h2>
    <ul><% @dashboard_warnings.each do |warning| %><li><%= warning %></li><% end %></ul>
  </section>
<% end %>

<div class="dd-panel net-panel" id="network-dns">
  <h2 class="net-title">Domains & DNS records</h2><p class="net-description">Manage records for the selected GoDaddy zone.</p>
  <% if @zones.empty? %>
    <div class="dd-empty">No DNS zones are available. Check your provider connection in <%= link_to "Vault", dashboard_vault_path %>.</div>
  <% else %>
    <%= form_with url: dashboard_network_path, method: :get, class: "net-zone-form" do %>
      <label class="dd-field net-field"><span>DNS zone</span><%= select_tag :zone, options_for_select(@zones,@zone), onchange:"this.form.requestSubmit()", id: "network-dns-1" %></label>
    <% end %>
    <div class="dd-table-scroll"><table class="dd-table">
      <thead><tr><th align="left">Type</th><th align="left">Name</th><th align="left">Data</th><th>TTL</th><th></th></tr></thead>
      <tbody>
        <% Array(@records).each do |record| %>
          <% next unless record.is_a?(Hash) %>
          <tr>
            <td><%= record["type"] %></td>
            <td><%= record["name"] %></td>
            <td style="word-break:break-all"><%= record["data"] %></td>
            <td><%= record["ttl"] %></td>
            <td>
              <% if record["recordId"].present? %>
                <details>
                  <summary style="cursor:pointer">Edit</summary>
                  <%= form_with url: dashboard_network_dns_path, method: :put, class: "dd-form-grid net-form" do %>
                    <%= hidden_field_tag :zone, @zone, id: nil %>
                    <%= hidden_field_tag :record_id, record["recordId"], id: nil %>
                    <%= hidden_field_tag "dns_record[type]", record["type"], id: nil %>
                    <label class="dd-field net-field"><span>Record name</span><%= text_field_tag "dns_record[name]", record["name"], required:true, id: "network-dns-2-#{record["recordId"]}" %></label>
                    <label class="dd-field net-field"><span>Record value</span><%= text_field_tag "dns_record[data]", record["data"], required:true, id: "network-dns-3-#{record["recordId"]}" %></label>
                    <label class="dd-field net-field"><span>TTL (seconds)</span><%= number_field_tag "dns_record[ttl]", record["ttl"], min:600, max:86400, id: "network-dns-4-#{record["recordId"]}" %></label>
                    <% %w[priority weight port service protocol flag tag].each do |field| %>
                      <%= hidden_field_tag "dns_record[#{field}]", record[field], id: nil if record[field].present? %>
                    <% end %>
                    <%= submit_tag "Update", class: "dd-button dd-btn-primary" %>
                  <% end %>
                </details>
                <%= button_to "Delete", dashboard_network_dns_path, method: :delete,
                      params:{zone:@zone,record_id:record["recordId"]}, class: "dd-button dd-button-danger",
                      data:{turbo_confirm:"Delete this DNS record?"} %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% if Array(@records).none? { |record| record.is_a?(Hash) } %><tr><td colspan="5" class="dd-empty">No records in this zone.</td></tr><% end %>
    </tbody>
    </table></div>

    <details class="dd-detail"><summary>Create a DNS record</summary>
    <%= form_with url: dashboard_network_dns_path, method: :post, class: "dd-form-grid net-form" do %>
      <%= hidden_field_tag :zone, @zone, id: nil %>
      <label class="dd-field net-field"><span>Record type</span><%= select_tag "dns_record[type]", options_for_select(Godaddy::DnsService::TYPES), id: "network-dns-5" %></label>
      <label class="dd-field net-field"><span>Record name</span><%= text_field_tag "dns_record[name]", nil, placeholder:"Name", required:true, id: "network-dns-6" %></label>
      <label class="dd-field net-field"><span>Record value</span><%= text_field_tag "dns_record[data]", nil, placeholder:"Value", required:true, id: "network-dns-7" %></label>
      <label class="dd-field net-field"><span>TTL (seconds)</span><%= number_field_tag "dns_record[ttl]", 600, min:600, max:86400, id: "network-dns-8" %></label>
      <%= submit_tag "Create DNS record", class: "dd-button dd-btn-primary" %>
    <% end %>
  </details>
  <% end %>
</div>

<section class="dd-panel net-panel" id="network-verification" aria-label="DNS verification">
  <h2 class="net-title">DNS verification</h2>
  <p style="color:var(--dd-text-secondary);font-size:13px">Check public IPv4 resolution against the expected cloud instance without changing DNS records.</p>
  <%= form_with url: dashboard_network_verify_dns_path, method: :post, class: "dd-form-grid net-form" do %>
    <%= hidden_field_tag :zone, @zone, id: nil %>
    <div><label class="dd-field net-field"><span>Hostname</span><%= text_field_tag :hostname, nil, placeholder: "client-1.lightekmcg.com", required: true, id: "network-verification-1" %></label></div>
    <div><label class="dd-field net-field"><span>Expected IPv4 (optional)</span><%= text_field_tag :expected_ipv4, nil, placeholder: "Instance IP (optional)", id: "network-verification-2" %></label></div>
    <%= submit_tag "Verify DNS", class: "dd-button dd-btn-primary" %>
  <% end %>
</section>

<section class="dd-panel net-panel" id="network-servers" aria-label="Managed cloud nodes">
  <h2 class="net-title">Managed cloud nodes</h2>
  <div class="dd-table-scroll"><table class="dd-table">
    <thead><tr><th align="left">Node</th><th align="left">Provider resource</th><th align="left">Public IP</th><th align="left">Status</th><th align="left">Action</th></tr></thead>
    <tbody>
      <% @managed_nodes.each do |node| %>
        <tr><td><%= node.name %></td><td><%= node.provider_resource_id %></td><td><%= node.ip_address %></td><td><%= node.status.humanize %></td><td><%= button_to "Verify server", dashboard_network_verify_node_path(id: node.id), method: :post, class: "dd-button" %></td></tr>
      <% end %>
      <% if @managed_nodes.empty? %><tr><td colspan="5">No managed cloud nodes.</td></tr><% end %>
    </tbody>
  </table></div>
</section>

<section class="dd-panel net-panel" id="network-installations" aria-label="Customer infrastructure">
  <h2 class="net-title">Customer infrastructure</h2>
  <p style="color:var(--dd-text-secondary);font-size:13px">Paid provisioning requests, cloud allocation, deployment state, and DNS targets. Changes are made through audited Gatekeeper workflows.</p>
  <div class="dd-table-scroll">
    <table class="dd-table">
      <thead><tr><th align="left">Request</th><th align="left">Customer</th><th align="left">Provider</th><th align="left">State</th><th align="left">Node / IP</th><th align="left">Recovery</th><th align="left">Action</th></tr></thead>
      <tbody>
        <% @provisioning_requests.each do |request| %>
          <% node = request.gatekeeper_node %>
          <tr>
            <td>#<%= request.id %></td>
            <td><%= request.owner.respond_to?(:email_address) ? request.owner.email_address : request.owner_type %></td>
            <td><%= request.compute_provider&.name || "Unassigned" %></td>
            <td><%= request.execution_status.to_s.humanize %></td>
            <td><%= node ? "#{node.name} / #{node.ip_address}" : "Not allocated" %></td>
            <td><%= Array(request.metadata.to_h["retired_provider_nodes"]).any? ? "Replacement history: #{Array(request.metadata.to_h["retired_provider_nodes"]).size}" : "—" %></td>
            <td>
              <% order = LightekCommerce::Order.find_by(provisioning_request_id: request.id) %>
              <% if order && order.paid_at? && !order.provisioned_at? %>
                <%= button_to "Resume paid installation", dashboard_network_retry_provisioning_path(id: request.id), method: :post,
                  class: "dd-button dd-btn-primary",
                  data: { turbo_confirm: "Queue recovery for paid order ##{order.id}? This can allocate a billable VPS if the previous node was confirmed deleted." } %>
              <% elsif order&.provisioned_at? %>
                Complete
              <% else %>
                No paid installation
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @provisioning_requests.empty? %><tr><td colspan="7">No provisioning requests yet.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="dd-panel net-panel" id="network-devices" aria-label="Device management">
  <h2 class="net-title">Device management</h2>
  <p style="color:var(--dd-text-secondary);font-size:13px">Register and organize phones, tablets, routers, network equipment, and IoT endpoints. Remote commands require a separately enrolled Gatekeeper device agent.</p>
  <% if flash[:device_enrollment_token].present? %>
    <div role="status" style="padding:12px;margin-bottom:12px;border:1px solid var(--dd-border)">
      <strong>One-time device enrollment token</strong>
      <p style="font-size:12px">Copy this secret to the device agent. It is not stored in plaintext.</p>
      <code style="word-break:break-all"><%= flash[:device_enrollment_token] %></code>
    </div>
  <% end %>
  <details class="dd-detail" style="margin-bottom:18px"><summary style="cursor:pointer">Register device</summary>
    <%= form_with url: dashboard_network_devices_path, method: :post, class: "dd-form-grid net-form" do %>
      <label class="dd-field net-field"><span>Device name</span><%= text_field_tag "device[name]", nil, placeholder: "Device name", required: true, id: "network-devices-1" %></label>
      <label class="dd-field net-field"><span>Asset ID / serial</span><%= text_field_tag "device[identifier]", nil, placeholder: "Asset ID / serial", required: true, id: "network-devices-2" %></label>
      <label class="dd-field net-field"><span>Device type</span><%= select_tag "device[device_type]", options_for_select(NetworkManagedDevice::DEVICE_TYPES.map { |type| [type.humanize, type] }), id: "network-devices-3" %></label>
      <label class="dd-field net-field"><span>Management protocol</span><%= select_tag "device[management_protocol]", options_for_select([["Unmanaged", ""]] + NetworkManagedDevice::PROTOCOLS.map { |type| [type.upcase, type] }), id: "network-devices-4" %></label>
      <label class="dd-field net-field"><span>Hostname</span><%= text_field_tag "device[hostname]", nil, placeholder: "Hostname", id: "network-devices-5" %></label>
      <label class="dd-field net-field"><span>IP address</span><%= text_field_tag "device[ip_address]", nil, placeholder: "IP address", id: "network-devices-6" %></label>
      <%= submit_tag "Register device", class: "dd-button dd-btn-primary" %>
    <% end %>
  </details>
  <div class="dd-table-scroll"><table class="dd-table">
    <thead><tr><th align="left">Device</th><th align="left">Type</th><th align="left">Identifier</th><th align="left">Network</th><th align="left">Management</th><th align="left">Status</th><th align="left">Last seen</th><th align="left">Actions</th></tr></thead>
    <tbody>
      <% @devices.each do |device| %>
        <tr>
          <td><%= device.name %></td><td><%= device.device_type.humanize %></td><td><%= device.identifier %></td>
          <td><%= device.hostname.presence || device.ip_address.presence || "Not configured" %></td>
          <td><%= device.management_protocol.presence || "Unmanaged" %></td>
          <td><%= device.status.humanize %></td>
          <td><%= device.last_seen_at ? time_ago_in_words(device.last_seen_at) + " ago" : "Never" %></td>
          <td><details class="net-row-editor"><summary style="cursor:pointer">Edit</summary>
            <%= form_with url: dashboard_network_device_path(id: device.id), method: :patch, class: "dd-form-grid net-form" do %>
              <label class="dd-field net-field"><span>Device name</span><%= text_field_tag "device[name]", device.name, required: true, id: "network-devices-7-#{device.id}" %></label>
              <label class="dd-field net-field"><span>Hostname</span><%= text_field_tag "device[hostname]", device.hostname, placeholder: "Hostname", id: "network-devices-8-#{device.id}" %></label>
              <label class="dd-field net-field"><span>IP address</span><%= text_field_tag "device[ip_address]", device.ip_address, placeholder: "IP address", id: "network-devices-9-#{device.id}" %></label>
              <label class="dd-field net-field"><span>Status</span><%= select_tag "device[status]", options_for_select(NetworkManagedDevice::STATUSES.map { |status| [status.humanize, status] }, device.status), id: "network-devices-10-#{device.id}" %></label>
              <%= submit_tag "Save device", class: "dd-button" %>
            <% end %>
          </details>
          <%= button_to "Rotate enrollment token", dashboard_network_rotate_device_token_path(id: device.id),
            method: :post, class: "dd-button",
            data: { turbo_confirm: "Rotate the enrollment token for #{device.name}? The previous token will stop working." } %>
          </td>
        </tr>
      <% end %>
      <% if @devices.empty? %><tr><td colspan="8">No devices registered.</td></tr><% end %>
    </tbody>
  </table></div>
</section>

<div class="dd-panel net-panel" id="network-firewall">
  <h2 class="net-title">Firewall access</h2><p class="net-description">Allow or close a port on the managed host. SSH, HTTP and HTTPS remain protected from dashboard closure.</p>
  <details class="dd-detail"><summary>Current firewall rules</summary><pre class="net-code"><%= @firewall_status %></pre></details>
  <div class="dd-workspace-grid">
    <%= form_with url: dashboard_network_open_port_path, method: :post, class: "dd-form-grid net-form" do %>
      <label class="dd-field net-field"><span>Port</span><%= number_field_tag :port, nil, min:1, max:65535, placeholder:"Port", required:true, id: "network-firewall-1" %></label>
      <label class="dd-field net-field"><span>Protocol</span><%= select_tag :protocol, options_for_select([["TCP","tcp"],["UDP","udp"]]), id: "network-firewall-2" %></label>
      <%= submit_tag "Open port", class: "dd-button dd-btn-primary" %>
    <% end %>
    <%= form_with url: dashboard_network_close_port_path, method: :post, class: "dd-form-grid net-form" do %>
      <label class="dd-field net-field"><span>Port</span><%= number_field_tag :port, nil, min:1, max:65535, placeholder:"Port", required:true, id: "network-firewall-3" %></label>
      <label class="dd-field net-field"><span>Protocol</span><%= select_tag :protocol, options_for_select([["TCP","tcp"],["UDP","udp"]]), id: "network-firewall-4" %></label>
      <%= submit_tag "Close port", class: "dd-button", data:{turbo_confirm:"Close this port?"} %>
    <% end %>
  </div>
  <p style="font-size:12px;color:var(--dd-text-secondary)">Ports 22, 80 and 443 are protected from dashboard closure.</p>
</div>

<section class="dd-panel net-panel" id="network-schedules" aria-label="Scheduled jobs">
  <h2 class="net-title">Scheduled jobs</h2>
  <p>Manage allowlisted Sidekiq cron tasks. New schedules are stored in Redis.</p>
  <%= form_with url: dashboard_network_cron_jobs_path, method: :post, class: "dd-form-grid net-form" do %>
    <label class="dd-field net-field"><span>Schedule name</span><%= text_field_tag :name, nil, placeholder: "Job name", required: true, id: "network-schedules-1" %></label>
    <label class="dd-field net-field"><span>Worker class</span><%= select_tag :job_class, options_for_select(Gatekeeper::CronManagement::ALLOWED_JOBS), id: "network-schedules-2" %></label>
    <label class="dd-field net-field"><span>Schedule expression</span><%= text_field_tag :cron, nil, placeholder: "*/5 * * * *", required: true, id: "network-schedules-3" %></label>
    <%= submit_tag "Create schedule", class: "dd-button dd-btn-primary" %>
  <% end %>
  <div class="dd-table-scroll"><table class="dd-table"><thead><tr><th align="left">Name</th><th align="left">Class</th><th align="left">Cron</th><th align="left">Status</th><th align="left">Actions</th></tr></thead>
  <tbody>
    <% @cron_jobs.each do |job| %>
      <tr><td><%= job.name %></td><td><%= job.klass %></td><td><%= job.cron %></td><td><%= job.status %></td>
      <td><%= button_to "Run now", dashboard_network_run_cron_job_path(name: job.name), method: :post, class: "dd-button" %>
      <%= button_to(job.status == "enabled" ? "Disable" : "Enable", dashboard_network_toggle_cron_job_path(name: job.name), method: :post, class: "dd-button") %>
      <details class="net-row-editor"><summary>Edit schedule</summary>
        <%= form_with url: dashboard_network_cron_jobs_path, method: :patch do %>
          <%= hidden_field_tag :name, job.name, id: nil %>
          <label class="dd-field net-field"><span>Worker class</span><%= select_tag :job_class, options_for_select(Gatekeeper::CronManagement::ALLOWED_JOBS, job.klass), id: "network-schedules-4-#{job.name.parameterize}" %></label>
          <label class="dd-field net-field"><span>Schedule expression</span><%= text_field_tag :cron, job.cron, required: true, id: "network-schedules-5-#{job.name.parameterize}" %></label>
          <%= submit_tag "Save schedule", class: "dd-button" %>
        <% end %>
      </details>
      <%= button_to "Delete", dashboard_network_cron_jobs_path(name: job.name), method: :delete,
        class: "dd-button", data: { turbo_confirm: "Delete this schedule?" } %></td></tr>
    <% end %>
    <% if @cron_jobs.empty? %><tr><td colspan="5">No dashboard-managed schedules.</td></tr><% end %>
  </tbody></table></div>
</section>

<section class="dd-panel net-panel" id="network-activity" aria-label="Recent network operations">
  <h2 class="net-title">Recent network operations</h2>
  <div class="dd-table-scroll"><table class="dd-table">
    <thead><tr><th align="left">When</th><th align="left">Operation</th><th align="left">Result</th></tr></thead>
    <tbody>
      <% @recent_network_operations.each do |operation| %>
        <tr><td><%= operation.created_at&.strftime("%Y-%m-%d %H:%M UTC") %></td><td><%= operation.capability.humanize %></td><td><%= operation.status.humanize %></td></tr>
      <% end %>
      <% if @recent_network_operations.empty? %><tr><td colspan="3">No recent operations.</td></tr><% end %>
    </tbody>
  </table></div>
</section>
</main>
