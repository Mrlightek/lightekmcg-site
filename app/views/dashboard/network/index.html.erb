<% content_for :page_title, "Network & Domains" %>
<div style="margin-bottom:20px">
  <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--dd-text-muted)">Gatekeeper · Network Control</div>
  <h2 style="font-size:22px;margin:6px 0 0">Network & Domains</h2>
  <p style="color:var(--dd-text-secondary);font-size:13px">Super-admin management for domains, cloud servers, firewall rules, and connected devices.</p>
</div>


<section class="dd-card" style="padding:20px;margin-bottom:18px" aria-label="Device management">
  <h3>Device management</h3>
  <p style="color:var(--dd-text-secondary);font-size:13px">Register and organize phones, tablets, routers, network equipment, and IoT endpoints. Remote commands require a separately enrolled Gatekeeper device agent.</p>
  <% if flash[:device_enrollment_token].present? %>
    <div role="status" style="padding:12px;margin-bottom:12px;border:1px solid var(--dd-border)">
      <strong>One-time device enrollment token</strong>
      <p style="font-size:12px">Copy this secret to the device agent. It is not stored in plaintext.</p>
      <code style="word-break:break-all"><%= flash[:device_enrollment_token] %></code>
    </div>
  <% end %>
  <details style="margin-bottom:16px"><summary style="cursor:pointer">Register device</summary>
    <%= form_with url: dashboard_network_devices_path, method: :post, style: "display:flex;flex-wrap:wrap;gap:10px;margin-top:12px" do %>
      <%= text_field_tag "device[name]", nil, placeholder: "Device name", required: true %>
      <%= text_field_tag "device[identifier]", nil, placeholder: "Asset ID / serial", required: true %>
      <%= select_tag "device[device_type]", options_for_select(NetworkManagedDevice::DEVICE_TYPES.map { |type| [type.humanize, type] }) %>
      <%= select_tag "device[management_protocol]", options_for_select([["Unmanaged", ""]] + NetworkManagedDevice::PROTOCOLS.map { |type| [type.upcase, type] }) %>
      <%= text_field_tag "device[hostname]", nil, placeholder: "Hostname" %>
      <%= text_field_tag "device[ip_address]", nil, placeholder: "IP address" %>
      <%= submit_tag "Register device", class: "dd-topbar-btn dd-btn-primary" %>
    <% end %>
  </details>
  <div style="overflow-x:auto"><table style="width:100%;font-size:12px">
    <thead><tr><th align="left">Device</th><th align="left">Type</th><th align="left">Identifier</th><th align="left">Network</th><th align="left">Management</th><th align="left">Status</th><th align="left">Actions</th></tr></thead>
    <tbody>
      <% @devices.each do |device| %>
        <tr>
          <td><%= device.name %></td><td><%= device.device_type.humanize %></td><td><%= device.identifier %></td>
          <td><%= device.hostname.presence || device.ip_address.presence || "Not configured" %></td>
          <td><%= device.management_protocol.presence || "Unmanaged" %></td>
          <td><%= device.status.humanize %></td>
          <td><details><summary style="cursor:pointer">Edit</summary>
            <%= form_with url: dashboard_network_device_path(id: device.id), method: :patch, style: "display:grid;gap:6px" do %>
              <%= text_field_tag "device[name]", device.name, required: true %>
              <%= text_field_tag "device[hostname]", device.hostname, placeholder: "Hostname" %>
              <%= text_field_tag "device[ip_address]", device.ip_address, placeholder: "IP address" %>
              <%= select_tag "device[status]", options_for_select(NetworkManagedDevice::STATUSES.map { |status| [status.humanize, status] }, device.status) %>
              <%= submit_tag "Save device", class: "dd-topbar-btn" %>
            <% end %>
          </details>
          <%= button_to "Rotate enrollment token", dashboard_network_rotate_device_token_path(id: device.id),
            method: :post, class: "dd-topbar-btn",
            data: { turbo_confirm: "Rotate the enrollment token for #{device.name}? The previous token will stop working." } %>
          </td>
        </tr>
      <% end %>
      <% if @devices.empty? %><tr><td colspan="7">No devices registered.</td></tr><% end %>
    </tbody>
  </table></div>
</section>

<section class="dd-card" style="padding:20px;margin-bottom:18px" aria-label="Customer infrastructure">
  <h3>Customer infrastructure</h3>
  <p style="color:var(--dd-text-secondary);font-size:13px">Paid provisioning requests, cloud allocation, deployment state, and DNS targets. Changes are made through audited Gatekeeper workflows.</p>
  <div style="overflow-x:auto">
    <table style="width:100%;font-size:12px;border-collapse:collapse">
      <thead><tr><th align="left">Request</th><th align="left">Customer</th><th align="left">Provider</th><th align="left">State</th><th align="left">Node / IP</th><th align="left">Recovery</th><th align="left">Action</th></tr></thead>
      <tbody>
        <% @provisioning_requests.each do |request| %>
          <% node = request.gatekeeper_node %>
          <tr>
            <td>#<%= request.id %></td>
            <td><%= request.owner.respond_to?(:email_address) ? request.owner.email_address : request.owner_type %></td>
            <td><%= request.compute_provider&.name || "Unassigned" %></td>
            <td><%= request.execution_status.to_s.humanize %></td>
            <td><%= node ? "#{node.name} / #{node.ip_address}" : "Not allocated" %></td>
            <td><%= Array(request.metadata.to_h["retired_provider_nodes"]).any? ? "Replacement history: #{Array(request.metadata.to_h["retired_provider_nodes"]).size}" : "—" %></td>
            <td>
              <% order = LightekCommerce::Order.find_by(provisioning_request_id: request.id) %>
              <% if order && order.paid_at? && !order.provisioned_at? %>
                <%= button_to "Resume paid installation", dashboard_network_retry_provisioning_path(id: request.id), method: :post,
                  class: "dd-topbar-btn dd-btn-primary",
                  data: { turbo_confirm: "Queue recovery for paid order ##{order.id}? This can allocate a billable VPS if the previous node was confirmed deleted." } %>
              <% elsif order&.provisioned_at? %>
                Complete
              <% else %>
                No paid installation
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @provisioning_requests.empty? %><tr><td colspan="7">No provisioning requests yet.</td></tr><% end %>
      </tbody>
    </table>
  </div>
</section>
<section class="dd-card" style="padding:20px;margin-bottom:18px" aria-label="Managed cloud nodes">
  <h3>Managed cloud nodes</h3>
  <div style="overflow-x:auto"><table style="width:100%;font-size:12px">
    <thead><tr><th align="left">Node</th><th align="left">Provider resource</th><th align="left">Public IP</th><th align="left">Status</th><th align="left">Action</th></tr></thead>
    <tbody>
      <% @managed_nodes.each do |node| %>
        <tr><td><%= node.name %></td><td><%= node.provider_resource_id %></td><td><%= node.ip_address %></td><td><%= node.status.humanize %></td><td><%= button_to "Verify server", dashboard_network_verify_node_path(id: node.id), method: :post, class: "dd-topbar-btn" %></td></tr>
      <% end %>
      <% if @managed_nodes.empty? %><tr><td colspan="5">No managed cloud nodes.</td></tr><% end %>
    </tbody>
  </table></div>
</section>
<section class="dd-card" style="padding:20px;margin-bottom:18px" aria-label="Recent network operations">
  <h3>Recent network operations</h3>
  <div style="overflow-x:auto"><table style="width:100%;font-size:12px">
    <thead><tr><th align="left">When</th><th align="left">Operation</th><th align="left">Result</th></tr></thead>
    <tbody>
      <% @recent_network_operations.each do |operation| %>
        <tr><td><%= operation.created_at&.strftime("%Y-%m-%d %H:%M UTC") %></td><td><%= operation.capability.humanize %></td><td><%= operation.status.humanize %></td></tr>
      <% end %>
      <% if @recent_network_operations.empty? %><tr><td colspan="3">No recent operations.</td></tr><% end %>
    </tbody>
  </table></div>
</section>

<section class="dd-card" style="padding:20px;margin-bottom:18px" aria-label="DNS verification">
  <h3>DNS verification</h3>
  <p style="color:var(--dd-text-secondary);font-size:13px">Check public IPv4 resolution against the expected cloud instance without changing DNS records.</p>
  <%= form_with url: dashboard_network_verify_dns_path, method: :post, style: "display:flex;gap:10px;flex-wrap:wrap;align-items:end" do %>
    <%= hidden_field_tag :zone, @zone %>
    <div><%= label_tag :hostname, "Hostname" %><%= text_field_tag :hostname, nil, placeholder: "client-1.lightekmcg.com", required: true %></div>
    <div><%= label_tag :expected_ipv4, "Expected IPv4" %><%= text_field_tag :expected_ipv4, nil, placeholder: "Instance IP (optional)" %></div>
    <%= submit_tag "Verify DNS", class: "dd-topbar-btn dd-btn-primary" %>
  <% end %>
</section>

<div class="dd-card" style="padding:20px;margin-bottom:18px">
  <h3>Firewall</h3>
  <pre style="white-space:pre-wrap;font-size:12px"><%= @firewall_status %></pre>
  <div style="display:flex;gap:12px;flex-wrap:wrap">
    <%= form_with url: dashboard_network_open_port_path, method: :post do %>
      <%= number_field_tag :port, nil, min:1, max:65535, placeholder:"Port", required:true %>
      <%= select_tag :protocol, options_for_select([["TCP","tcp"],["UDP","udp"]]) %>
      <%= submit_tag "Open", class:"dd-topbar-btn dd-btn-primary" %>
    <% end %>
    <%= form_with url: dashboard_network_close_port_path, method: :post do %>
      <%= number_field_tag :port, nil, min:1, max:65535, placeholder:"Port", required:true %>
      <%= select_tag :protocol, options_for_select([["TCP","tcp"],["UDP","udp"]]) %>
      <%= submit_tag "Close", class:"dd-topbar-btn", data:{turbo_confirm:"Close this port?"} %>
    <% end %>
  </div>
  <p style="font-size:12px;color:var(--dd-text-secondary)">Ports 22, 80 and 443 are protected from dashboard closure.</p>
</div>

<div class="dd-card" style="padding:20px">
  <h3>GoDaddy DNS</h3>
  <% if @zones.empty? %>
    <p>Set GODADDY_PAT and GODADDY_DOMAINS.</p>
  <% else %>
    <%= form_with url: dashboard_network_path, method: :get do %>
      <%= select_tag :zone, options_for_select(@zones,@zone), onchange:"this.form.submit()" %>
    <% end %>
    <table style="width:100%;margin-top:14px;font-size:12px">
      <thead><tr><th align="left">Type</th><th align="left">Name</th><th align="left">Data</th><th>TTL</th><th></th></tr></thead>
      <tbody>
        <% Array(@records).each do |record| %>
          <% next unless record.is_a?(Hash) %>
          <tr>
            <td><%= record["type"] %></td>
            <td><%= record["name"] %></td>
            <td style="word-break:break-all"><%= record["data"] %></td>
            <td><%= record["ttl"] %></td>
            <td>
              <% if record["recordId"].present? %>
                <details>
                  <summary style="cursor:pointer">Edit</summary>
                  <%= form_with url: dashboard_network_dns_path, method: :put, style: "margin-top:8px;display:grid;gap:6px" do %>
                    <%= hidden_field_tag :zone, @zone %>
                    <%= hidden_field_tag :record_id, record["recordId"] %>
                    <%= hidden_field_tag "dns_record[type]", record["type"] %>
                    <%= text_field_tag "dns_record[name]", record["name"], required:true %>
                    <%= text_field_tag "dns_record[data]", record["data"], required:true %>
                    <%= number_field_tag "dns_record[ttl]", record["ttl"], min:600, max:86400 %>
                    <% %w[priority weight port service protocol flag tag].each do |field| %>
                      <%= hidden_field_tag "dns_record[#{field}]", record[field] if record[field].present? %>
                    <% end %>
                    <%= submit_tag "Update", class:"dd-topbar-btn dd-btn-primary" %>
                  <% end %>
                </details>
                <%= button_to "Delete", dashboard_network_dns_path, method: :delete,
                      params:{zone:@zone,record_id:record["recordId"]},
                      data:{turbo_confirm:"Delete this DNS record?"} %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h4 style="margin-top:20px">Create record</h4>
    <%= form_with url: dashboard_network_dns_path, method: :post do %>
      <%= hidden_field_tag :zone, @zone %>
      <%= select_tag "dns_record[type]", options_for_select(Godaddy::DnsService::TYPES) %>
      <%= text_field_tag "dns_record[name]", nil, placeholder:"Name", required:true %>
      <%= text_field_tag "dns_record[data]", nil, placeholder:"Value", required:true %>
      <%= number_field_tag "dns_record[ttl]", 600, min:600, max:86400 %>
      <%= submit_tag "Create DNS record", class:"dd-topbar-btn dd-btn-primary" %>
    <% end %>
  <% end %>
</div>
