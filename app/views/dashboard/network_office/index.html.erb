<% content_for :page_title, "Shared files" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<main class="network-collaboration" data-turbo="false">
  <%= link_to "← Network channel", dashboard_network_team_path(key: params[:key]) %>
  <h1>Shared files</h1>
  <p>Files follow the network channel’s membership.</p>
  <div class="network-columns">
    <aside class="network-pane">
      <%= link_to "New file", dashboard_network_office_path(params[:key]) %>
      <ul>
        <% @files.each do |file| %>
          <li><%= link_to file.fetch("title"), dashboard_network_office_path(params[:key], file_key: file.fetch("key")) %>
            <small><%= file.fetch("kind").humanize %></small></li>
        <% end %>
      </ul>
    </aside>
    <section class="network-pane">
      <% if @file %>
        <h2><%= @file.fetch("title") %></h2>
        <p><small>Edited by <%= @file.fetch("editor") %> · <%= @file.fetch("organization") %></small></p>
        <%= link_to "Download", export_dashboard_network_office_path(params[:key], @file.fetch("key")) %>
        <% if @rows %>
          <div class="office-sheet">
            <table aria-label="Calculated spreadsheet">
              <thead><tr><th></th><% (@rows.map(&:size).max || 0).times do |column| %><th scope="col"><%= ('A'.ord + column).chr %></th><% end %></tr></thead>
              <tbody><% @rows.each_with_index do |row, index| %><tr>
                <th scope="row"><%= index + 1 %></th><% row.each do |cell| %><td><%= cell %></td><% end %>
              </tr><% end %></tbody>
            </table>
          </div>
        <% elsif @slide %>
          <article class="office-slide"><h3><%= @slide.first %></h3><p class="network-text"><%= @slide.last %></p></article>
          <nav aria-label="Slides">
            <% if @slide_number > 1 %><%= link_to "Previous slide", dashboard_network_office_path(params[:key], file_key: @file.fetch("key"), slide: @slide_number - 1) %><% end %>
            <span>Slide <%= @slide_number %> of <%= @slides.size %></span>
            <% if @slide_number < @slides.size %><%= link_to "Next slide", dashboard_network_office_path(params[:key], file_key: @file.fetch("key"), slide: @slide_number + 1) %><% end %>
          </nav>
        <% elsif @file.fetch("kind") == "document" %>
          <article class="network-text"><%= @file.fetch("content") %></article>
        <% end %>
      <% end %>
      <% if @draft %>
        <details open><summary>Your unsaved changes</summary><pre class="network-text"><%= @draft["content"] %></pre></details>
        <%= link_to "Reload shared file", dashboard_network_office_path(params[:key], file_key: (@draft["file_key"] if @draft["lock_version"].present?)) %>
      <% elsif !@read_only && @file_key %>
        <%= form_with scope: :network_office_file, url: dashboard_network_office_path(params[:key]) do |form| %>
          <%= form.hidden_field :file_key, value: @file_key %>
          <% if @file %><%= form.hidden_field :lock_version, value: @file.fetch("lock_version") %>
          <% else %><%= form.label :kind, "File type" %><%= form.select :kind, LightekOffice::SharedFile::KINDS.invert.to_a %><% end %>
          <%= form.label :title %><%= form.text_field :title, value: @file&.fetch("title"), required: true, maxlength: 160 %>
          <%= form.label :content, "Contents" %><%= form.text_area :content, value: @file&.fetch("content"), required: true, rows: 12 %>
          <p><small>Use CSV rows for spreadsheets and three dashes on a separate line between slides.</small></p>
          <%= form.submit "Save shared file", class: "dd-topbar-btn dd-btn-primary" %>
        <% end %>
      <% end %>
    </section>
  </div>
</main>
<link rel="stylesheet" href="/lightek/network-collaboration.css?v=2">
