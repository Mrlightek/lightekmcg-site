<div data-office-live data-read-url="<%= read_url %>" data-write-url="<%= write_url %>" data-write-method="<%= write_method %>">
  <p data-office-status role="status">Connecting to live editing…</p>
  <button type="button" data-office-latest hidden>Use latest saved version</button>
  <p data-office-draft-label hidden>Your unsaved draft is available to copy below.</p>
  <textarea data-office-draft aria-label="Your unsaved draft" rows="6" readonly hidden></textarea>
</div>
