<%= form_with scope: :benefit, url: dashboard_people_benefits_path(employer_id: @employer.id, tab: 'benefits'), class: 'lp-form' do |form| %><%= hidden_field_tag :record_id, plan.id %><label>Plan name<%= form.text_field :name, value: plan.name, required: true %></label><div class="lp-grid"><label>Category<%= form.select :category, %w[health dental vision retirement life disability other].map { |v| [v.humanize,v] }, selected: plan.category %></label><label>Deduction treatment<%= form.select :deduction_treatment, [['Post-tax','post_tax'],['Pre-tax (review required)','pre_tax']], selected: plan.deduction_treatment %></label><label>Employee contribution (USD)<%= form.number_field :employee_amount, value: format('%.2f',plan.employee_cents / 100.0), min: 0, step: '0.01', required: true %></label><label>Employer contribution (USD)<%= form.number_field :employer_amount, value: format('%.2f',plan.employer_cents / 100.0), min: 0, step: '0.01', required: true %></label></div><label class="lp-check"><%= form.check_box :published, checked: plan.published? %> Open for employee enrollment</label><%= form.submit 'Save benefit plan', class: 'lp-button' %><% end %>
