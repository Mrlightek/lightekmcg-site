<section class="lp-card"><h2>Benefit plans</h2><p>Plan amounts are applied per pay statement. Pre-tax treatment is recorded for your payroll reviewer; this screen does not determine tax eligibility or enroll employees with an insurance carrier.</p><div class="lp-table-wrap"><table><thead><tr><th>Plan</th><th>Employee / employer contribution</th><th>Tax treatment</th><th>Availability</th></tr></thead><tbody><% @plans.select { |plan| @access.payroll? || plan.published? }.each do |plan| %><tr><td><strong><%= plan.name %></strong><small><%= plan.category.humanize %></small></td><td><%= number_to_currency(plan.employee_cents / 100.0) %> / <%= number_to_currency(plan.employer_cents / 100.0) %> per statement</td><td><%= plan.deduction_treatment.humanize %></td><td><%= plan.published? ? 'Open for enrollment' : 'Draft / closed' %></td></tr><% end %></tbody></table></div></section>
<% if @access.payroll?(:prepare) %><section class="lp-card"><h2>Manage benefit plans</h2><details><summary>Add benefit plan</summary><%= render 'benefit_form', plan: LightekPeople::BenefitPlan.new(employee_cents: 0, employer_cents: 0, category: 'health', deduction_treatment: 'post_tax') %></details><% @plans.each do |plan| %><details><summary>Edit <%= plan.name %></summary><%= render 'benefit_form', plan: plan %></details><% end %></section><% end %>
