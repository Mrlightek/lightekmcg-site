<%= form_with scope: :department, url: dashboard_people_departments_path(employer_id: @employer.id), class: 'lp-form' do |form| %>
<%= hidden_field_tag :record_id, department.id %><label>Name<%= form.text_field :name, value: department.name, required: true, maxlength: 100 %></label><label>Department code<%= form.text_field :code, value: department.code, required: true, maxlength: 100, placeholder: 'ACCOUNTING' %></label><label>Parent department<%= form.select :parent_id, @departments.reject { |d| d.id == department.id }.map { |d| [d.name,d.id] }, {include_blank: 'Top-level department', selected: department.parent_id} %></label><label class="lp-check"><%= form.check_box :active, checked: department.active? %> Active department</label><%= form.submit 'Save department', class: 'lp-button' %><% end %>
