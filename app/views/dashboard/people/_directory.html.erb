<section class="lp-card"><div class="lp-section"><div><h2>Corporate directory</h2><p><%= @access.people_admin? ? 'All departments and reporting relationships in this employer.' : 'Your profile and the team members in your reporting chain.' %> Job level and financial authority are separate.</p></div><span class="lp-badge"><%= pluralize(@people.size, 'person') %></span></div>
<div class="lp-table-wrap"><table><thead><tr><th>Person</th><th>Department / role</th><th>Level</th><th>Reports to</th><th>Status</th></tr></thead><tbody><% @people.each do |person| %><tr><td><strong><%= person.worker.full_name %></strong><small><%= person.worker.email_address %></small></td><td><%= person.department&.name || 'Unassigned' %><small><%= person.title %> · <%= person.worker_kind.humanize %></small></td><td><span class="lp-badge"><%= person.level.humanize %></span></td><td><%= person.manager&.worker&.full_name || 'Employer leadership' %></td><td><%= person.active_on?(Date.current) ? 'Active' : 'Inactive' %></td></tr><% end %></tbody></table></div><% if @people.empty? %><p>Add your first team member to begin the corporate directory.</p><% end %></section>
<section class="lp-card"><h2>Department structure</h2><div class="lp-departments"><% @departments.each do |department| %><article><span class="lp-eyebrow"><%= department.code %></span><h3><%= department.name %></h3><p><%= department.parent ? "Part of #{department.parent.name}" : 'Top-level department' %> · <%= department.active? ? 'Active' : 'Archived' %></p></article><% end %></div><% if @departments.empty? %><p>Create departments such as IT, Customer Service and Accounting, then add teams beneath them.</p><% end %></section>
<% if @access.people_admin? %>
<section class="lp-card"><h2>Manage departments</h2><details><summary>Add department</summary><%= render 'department_form', department: LightekPeople::Department.new(active: true) %></details><% @departments.each do |department| %><details><summary>Edit <%= department.name %></summary><%= render 'department_form', department: department %></details><% end %></section>
<section class="lp-card"><h2>Manage team members</h2><p>Use an existing Lightek account. A person can belong to different employer organizations without changing their platform account role.</p><details><summary>Add team member</summary><%= render 'employment_form', person: LightekPeople::Employment.new(active: true, level: 'individual_contributor', worker_kind: 'employee', starts_on: Date.current, payroll_access: 'none') %></details><% @people.each do |person| %><details><summary>Edit <%= person.worker.full_name %></summary><%= render 'employment_form', person: person %></details><% end %></section>
<% end %>
