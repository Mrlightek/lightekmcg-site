<%= form_with scope: :employment, url: dashboard_people_employments_path(employer_id: @employer.id), class: 'lp-form' do |form| %>
<%= hidden_field_tag :record_id, person.id %><% unless person.persisted? %><label>Lightek account email<%= email_field_tag :worker_email, nil, required: true, autocomplete: 'off' %></label><% end %><label>Job title<%= form.text_field :title, value: person.title, required: true, maxlength: 160 %></label><div class="lp-grid"><label>Department<%= form.select :department_id, @departments.map { |d| [d.name,d.id] }, {include_blank: 'Unassigned', selected: person.department_id} %></label><label>Job level<%= form.select :level, LightekPeople::Employment::LEVELS.map { |v| [v.humanize,v] }, selected: person.level %></label><label>Worker type<%= form.select :worker_kind, LightekPeople::Employment::KINDS.map { |v| [v.humanize,v] }, selected: person.worker_kind %></label><label>Reports to<%= form.select :manager_id, @people.select { |p| p.id != person.id && p.level != 'individual_contributor' }.map { |p| ["#{p.worker.full_name} · #{p.title}",p.id] }, {include_blank: 'Employer leadership', selected: person.manager_id} %></label><label>Start date<%= form.date_field :starts_on, value: person.starts_on, required: true %></label><label>End date<%= form.date_field :ends_on, value: person.ends_on %></label></div><% if @access.owner? %><fieldset><legend>Employer-assigned access</legend><p>These grants apply only to this employer. A management title does not grant payroll or infrastructure access.</p><label class="lp-check"><%= form.check_box :people_admin, checked: person.people_admin? %> Manage this employer’s people and departments</label><label>Payroll responsibility<%= form.select :payroll_access, [['No payroll access','none'],['Prepare payroll','preparer'],['Approve and release payroll','approver'],['Payroll administrator','administrator']], selected: person.payroll_access %></label></fieldset><% end %><label class="lp-check"><%= form.check_box :active, checked: person.active? %> Active membership</label><%= form.submit 'Save team member', class: 'lp-button' %><% end %>
