<section class="lp-card"><div class="lp-section"><div><h2>Payroll</h2><p>Prepare gross-to-net statements, get independent approval, review fees and release net pay. Taxes, benefits and deductions remain separate employer liabilities; bank payouts do not file or remit them.</p></div><span class="lp-badge"><%= @sender_configured ? 'Payout sender connected' : 'Sender setup required' %></span></div>
<% if @access.owner? %><details><summary>Configure employer payout sender</summary><p>Use this employer’s enabled Stripe Global Payouts / Treasury account and restricted API key. Credentials are stored in Vault; sender funds and recipients are isolated by employer.</p><%= form_with url: dashboard_people_sender_path(employer_id: @employer.id), scope: :sender, class: 'lp-form', data: {turbo: false} do |form| %><label>Financial account ID<%= form.text_field :financial_account_ref, required: true, autocomplete: 'off' %></label><label>Restricted API key<%= form.password_field :secret_key, required: true, autocomplete: 'new-password' %></label><%= form.submit 'Verify & save in Vault', class: 'lp-button' %><% end %></details><% end %>
<% if @access.payroll?(:prepare) %><details><summary>Create pay run</summary><%= form_with url: dashboard_people_pay_runs_path(employer_id: @employer.id), scope: :pay_run, class: 'lp-form' do |form| %><div class="lp-grid"><label>Period starts<%= form.date_field :period_start, required: true %></label><label>Period ends<%= form.date_field :period_end, required: true %></label><label>Pay date<%= form.date_field :pay_date, required: true %></label></div><%= form.submit 'Create draft run', class: 'lp-button' %><% end %></details><% end %>
<nav class="lp-runs" aria-label="Pay runs"><% @runs.each do |run| %><%= link_to "##{run.id} · #{run.pay_date} · #{run.status.humanize}", dashboard_people_path(employer_id: @employer.id, tab: 'payroll', run_id: run.id) %><% end %></nav></section>
<% if @run %><section class="lp-card"><div class="lp-section"><div><h2>Pay run #<%= @run.id %> <span class="lp-badge"><%= @run.status.humanize %></span></h2><p><%= @run.period_start %> – <%= @run.period_end %> · Pay date <%= @run.pay_date %> · USD</p></div><%= link_to 'Export register (CSV)', export_dashboard_people_pay_run_path(@run, employer_id: @employer.id), class: 'lp-button secondary' %></div>
<div class="lp-table-wrap"><table><thead><tr><th>Payee</th><th>Gross</th><th>Taxes / other / benefits</th><th>Net</th><th>Employer taxes / benefits</th><th>Payout</th></tr></thead><tbody><% @lines.each do |line| %><tr><td><strong><%= line.snapshot['name'] %></strong><small><%= line.snapshot['title'] %> · <%= line.snapshot['worker_kind'] %></small></td><td><%= number_to_currency(line.gross_cents / 100.0) %></td><td><%= [line.tax_cents,line.other_deductions_cents,line.benefit_cents].map { |v| number_to_currency(v / 100.0) }.join(' / ') %><small>Review: <%= line.tax_reference %></small></td><td><strong><%= number_to_currency(line.net_cents / 100.0) %></strong></td><td><%= number_to_currency(line.employer_tax_cents / 100.0) %> / <%= number_to_currency(line.employer_benefit_cents / 100.0) %></td><td><span class="lp-badge"><%= line.status.humanize %></span><small><%= line.provider_ref %></small><% if line.error_code.present? %><p role="alert">Provider action needs review (<%= line.error_code %>).</p><% end %>
<% if @run.approved? && @access.payroll?(:release) && line.net_cents.positive? %><%= button_to(line.provider_ref.present? ? 'Refresh status' : 'Prepare payout', dashboard_people_payout_path(line, employer_id: @employer.id, operation: line.provider_ref.present? ? 'refresh' : 'prepare'), class: 'lp-button secondary') %><% if line.status == 'review' %><details><summary>Review fees & release</summary><%= render 'quote', value: line.quote, label: 'Payout estimate' %><%= form_with url: dashboard_people_payout_path(line, employer_id: @employer.id, operation: 'confirm') do %><%= hidden_field_tag :review_digest, LightekPeople::Disbursements.quote_digest(line.quote) %><label class="lp-check"><%= check_box_tag :fees_reviewed, '1', false, required: true %> I reviewed the provider fees and authorize this net pay disbursement.</label><%= submit_tag 'Release net pay', class: 'lp-button' %><% end %></details><% end %><% end %></td></tr><% end %></tbody></table></div>
<% if @run.draft? && @access.payroll?(:prepare) %><details><summary>Add / recalculate a pay statement</summary><p>Enter reviewed amounts for this pay period. Benefit elections are snapshotted when you save. Saving the same worker replaces their draft statement.</p><%= form_with url: dashboard_people_pay_statement_path(@run, employer_id: @employer.id), scope: :statement, class: 'lp-form' do |form| %><label>Payee<%= form.select :employment_id, @payees.map { |p| ["#{p.worker.full_name} · #{p.title}",p.id] }, {}, required: true %></label><div class="lp-grid"><% [['gross','Gross pay'],['tax','Employee taxes'],['other_deductions','Other deductions'],['employer_tax','Employer taxes']].each do |field,label| %><label><%= label %> (USD)<%= form.number_field "#{field}_amount", min: 0, step: '0.01', required: true, value: field == 'gross' ? nil : '0.00' %></label><% end %></div><label>Tax calculation / review reference<%= form.text_field :tax_reference, required: true, maxlength: 300, placeholder: 'Payroll reviewer and calculation reference' %></label><label class="lp-check"><%= check_box_tag :tax_reviewed, '1', false, required: true %> Taxes, benefit treatment and deductions were reviewed for this worker and pay period.</label><%= form.submit 'Calculate & save statement', class: 'lp-button' %><% end %></details><% end %>
<% if @access.payroll?(:approve) && @run.status != 'canceled' %><div class="lp-actions"><% if @run.draft? %><%= button_to 'Approve pay run', approve_dashboard_people_pay_run_path(@run, employer_id: @employer.id), class: 'lp-button' %><p>A different authorized person must approve the preparer’s run. Posted payouts mean funds left the sender; bank receipt can take longer. Refresh to reconcile later returns.</p><% end %><%= button_to 'Cancel before any payout attempt', cancel_dashboard_people_pay_run_path(@run, employer_id: @employer.id), class: 'lp-button secondary' unless @run.pay_statements.where.not(attempted_at: nil).exists? %></div><% end %></section><% end %>

<section class="lp-card"><h2>Employer audit trail</h2><div class="lp-table-wrap"><table><thead><tr><th>When</th><th>Person</th><th>Action</th><th>Record</th></tr></thead><tbody><% @audit_events.each do |event| %><tr><td><%= event.created_at.strftime('%b %-d, %Y %H:%M %Z') %></td><td><%= event.actor.full_name %></td><td><%= event.action.humanize %></td><td><%= event.record_type.demodulize.humanize %> #<%= event.record_id %></td></tr><% end %></tbody></table></div></section>

<% if @run&.approved? && @access.payroll?(:release) %><section class="lp-card"><h2>Scheduled payout preparation</h2><p>Prepare fee quotes at 9:00 a.m. America/New_York on the pay date, or shortly after scheduling if that time has passed. The worker rechecks current permissions and MFA enrollment. It does not confirm a transfer or bypass fee review.</p><p><%= @run.preparation_state&.humanize || 'Not scheduled' %> · <%= @run.preparation_scheduled_at&.in_time_zone('America/New_York') %> · <%= @run.preparation_error_code %></p><%= button_to 'Schedule approved payout preparation',schedule_dashboard_people_pay_run_path(@run,employer_id: @employer.id),class: 'lp-button secondary' %></section><% end %>
