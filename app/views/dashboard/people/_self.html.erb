<% if @self_employment %><section class="lp-card"><h2>My employment</h2><p><strong><%= @self_employment.title %></strong> · <%= @self_employment.level.humanize %> · <%= @self_employment.department&.name || 'Unassigned department' %></p><p>Reports to <%= @self_employment.manager&.worker&.full_name || 'Employer leadership' %>.</p><h3>Bank payout details</h3><p>Enter or update your routing and account information on the payment provider’s secure form. Lightek stores provider references and eligibility status.</p><span class="lp-badge">ACH capability: <%= @self_employment.payout_destination&.capability_status.presence || 'Not set up' %></span><%= button_to 'Set up / update bank details', dashboard_people_bank_setup_path(employer_id: @employer.id), class: 'lp-button', data: {turbo: false} %></section>
<% if @self_employment.worker_kind == 'employee' %><section class="lp-card"><h2>My benefits</h2><% @plans.select { |p| p.published? || @enrollments.any? { |e| e.benefit_plan_id == p.id && e.ends_on.nil? } }.each do |plan| %><% election = @enrollments.select { |e| e.benefit_plan_id == plan.id }.max_by(&:id) %><article class="lp-election"><div><strong><%= plan.name %></strong><p><%= number_to_currency(plan.employee_cents / 100.0) %> deducted per pay statement · <%= election && election.covers?(Date.current) ? 'Enrolled' : 'Not enrolled' %></p></div><%= button_to(election && election.ends_on.nil? ? 'End enrollment' : 'Enroll', dashboard_people_enrollments_path(employer_id: @employer.id, employment_id: @self_employment.id, benefit_plan_id: plan.id, end: (election && election.ends_on.nil? ? '1' : '0')), class: 'lp-button secondary') %></article><% end %><% if @plans.none?(&:published?) %><p>Your employer has not opened any benefit plans.</p><% end %></section><% end %>
<% else %><section class="lp-card"><h2>Your employer account</h2><p>You manage this employer. To receive employee or contractor payments, an employment membership must explicitly name your individual Lightek account.</p></section><% end %>
<section class="lp-card"><h2>My pay statements</h2><% @statements.each do |line| %><article class="lp-election"><div><strong><%= line.pay_run.period_start %> – <%= line.pay_run.period_end %></strong><p>Gross <%= number_to_currency(line.gross_cents / 100.0) %> · Taxes <%= number_to_currency(line.tax_cents / 100.0) %> · Benefits <%= number_to_currency(line.benefit_cents / 100.0) %> · Other deductions <%= number_to_currency(line.other_deductions_cents / 100.0) %></p></div><div><strong>Net <%= number_to_currency(line.net_cents / 100.0) %></strong><small><%= line.status.humanize %></small></div></article><% end %><% if @statements.empty? %><p>Your approved pay statements will appear here.</p><% end %></section>
