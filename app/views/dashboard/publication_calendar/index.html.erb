<% content_for :page_title, 'Publishing calendar' %>
<main class="sales-workspace growth-workspace"><%= stylesheet_link_tag '/lightek/sales-workspace.css?v=4' %><%= stylesheet_link_tag '/lightek/growth-workspace.css?v=4' %><%= render 'dashboard/shared/business_workspace', active: 'Publishing' %>
<header class="sales-header"><div><span class="sales-eyebrow">LIGHTEK / FINISH · REVIEW · RELEASE</span><h1>Publishing calendar</h1><p>A reviewed version, a connected account, and a deliberate release time.</p></div><%= form_with url: dashboard_publication_calendar_path, method: :get, class: 'sales-site' do %><label>Business website<%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @site.id) %></label><%= submit_tag 'Switch', class: 'sales-button secondary' %><% end %></header>
<% if flash[:alert] %><div class="sales-errors" role="alert"><%= flash[:alert] %></div><% end %><% if flash[:notice] %><p role="status"><%= flash[:notice] %></p><% end %>
<section class="sales-two-col growth-editors"><article class="sales-panel"><h2>Schedule reviewed content</h2><p>Calendar execution uses the operator who scheduled it. It rechecks access, approval, media and the connection before submitting.</p>
<% if @operator && @campaigns.any? && @connections.any? %><%= form_with url: dashboard_publication_calendar_path(site_id: @site.id), class: 'sales-form' do %><%= hidden_field_tag :request_key, SecureRandom.uuid %><label>Reviewed social campaign<%= select_tag :campaign_id, options_from_collection_for_select(@campaigns, :id, :name), required: true %></label><label>Connected account<%= select_tag :connection_id, options_for_select(@connections.map { |c| ["#{c.provider.humanize} · #{c.account_label}", c.id] }), required: true %></label><label>Local release time<%= datetime_field_tag :scheduled_local, nil, required: true %></label><%= label_tag :time_zone, 'Time zone' %><%= select_tag :time_zone, options_for_select(['UTC', 'America/New_York', 'America/Chicago', 'America/Denver', 'America/Los_Angeles', 'Europe/London'].map { |zone| [zone, zone] }, Time.zone&.tzinfo&.identifier || 'UTC'), required: true %><p><small>Up to 90 days ahead. Missing or ambiguous local times during clock changes must be replaced with another time. TikTok submission goes to the account’s inbox for review; it is not automatic public posting.</small></p><%= submit_tag 'Schedule this reviewed version', class: 'sales-button' %><% end %><% else %><p class="sales-empty"><%= @operator ? 'Approve a social campaign and configure a supported connected account before scheduling.' : 'An authorized publishing operator schedules releases. You can prepare and review the campaign here.' %></p><% end %>
<p><%= link_to 'Campaigns and content review', dashboard_marketing_campaigns_path(site_id: @site.id) %></p></article>
<article class="sales-panel"><h2>Attach a finished Studio export</h2><%= form_with url: dashboard_publication_calendar_path, method: :get, class: 'sales-form' do %><%= hidden_field_tag :site_id, @site.id %><label>Campaign<%= select_tag :campaign_id, options_from_collection_for_select(LightekMarketing::Campaign.where(site: @site, channel: 'social').order(:name), :id, :name, @campaign&.id) %></label><%= submit_tag 'Choose campaign', class: 'sales-button secondary' %><% end %>
<% if @campaign %><p><strong><%= @campaign.name %></strong></p><% if @media_locked %><p>This campaign has delivery/publication history. Use a separate campaign to attach new media.</p><% elsif @artifacts.any? %><%= form_with url: attach_campaign_media_path(site_id: @site.id, campaign_id: @campaign.id), class: 'sales-form' do %><label>Completed full export<%= select_tag :artifact_id, options_for_select(@artifacts.map { |artifact| ["##{artifact.id} · #{artifact.filename}", artifact.id] }), required: true %></label><p><small>JPEG, PNG or MP4, up to 1 GB. Attaching exposes the selected export through a public media link and resets content approval. Review again before scheduling.</small></p><%= submit_tag 'Attach export for campaign review', class: 'sales-button' %><% end %><% else %><p>No eligible completed export is available in your authorized Studio projects. Finish and export the production first.</p><% end %><p><%= link_to 'Open campaign / Studio', edit_dashboard_marketing_campaign_path(@campaign, site_id: @site.id) %> · <%= link_to 'Review final campaign payload', dashboard_campaign_content_path(site_id: @site.id, campaign_id: @campaign.id) %></p>
<% @media.each do |media| %><article class="growth-link"><strong>Export #<%= media.source_snapshot['artifact_id'] %></strong> · <%= media.revoked_at ? 'Revoked' : 'Available' %><p><small>Bound file: <%= media.source_snapshot['content_type'] %> · <%= number_to_human_size(media.source_snapshot['byte_size']) %></small></p><% unless media.revoked_at %><%= button_to 'Revoke public media link', revoke_campaign_media_path(site_id: @site.id, id: media.id), method: :patch, form: {data: {turbo_confirm: 'Block future requests? Existing storage URLs and downloaded copies may remain usable.'}}, class: 'sales-button secondary' %><% end %></article><% end %><% end %>
</article></section>
<section class="sales-panel"><h2>Release agenda</h2><%= form_with url: dashboard_publication_calendar_path, method: :get, class: 'sales-filters' do %><%= hidden_field_tag :site_id, @site.id %><label>Starting date<%= date_field_tag :from, @from, required: true %></label><%= submit_tag 'Show 31 days', class: 'sales-button secondary' %><% end %><p><small><%= @from %>–<%= @through %> in the application timezone; each release also shows its chosen timezone. First 200 matching slots.</small></p>
<% if @slots.empty? %><p class="sales-empty">No releases scheduled in this window.</p><% end %><% @slots.each do |slot| %><article class="growth-calendar-slot"><div class="sales-task-heading"><div><span class="sales-eyebrow"><%= slot.status.humanize %></span><h3><%= slot.campaign.name %></h3><p><%= slot.scheduled_at.in_time_zone(slot.time_zone).strftime('%b %-d, %Y · %H:%M %Z') %> · <%= slot.time_zone %></p><p><%= slot.connection.provider.humanize %> · <%= slot.connection.account_label %> · scheduled by <%= slot.scheduled_by.email_address %></p></div></div><% if slot.error_message.present? %><p class="sales-errors"><%= slot.error_message %></p><% end %>
<% if slot.social_post&.remote_id.present? %><p>Provider reference: <%= slot.social_post.remote_id %> · <%= slot.social_post.status.humanize %></p><% elsif slot.queue_requested_at %><p>Execution requested <%= slot.queue_requested_at.to_fs(:long) %>. A queued request is not a publication confirmation.</p><% end %>
<% if @operator && slot.status.in?(%w[scheduled blocked]) && !slot.started_at %><%= button_to 'Cancel calendar slot', cancel_publication_slot_path(site_id: @site.id, id: slot.id), method: :patch, params: {lock_version: slot.lock_version}, class: 'sales-button secondary' %><% end %><%= link_to 'Review campaign', dashboard_campaign_content_path(site_id: @site.id, campaign_id: slot.campaign_id) %></article><% end %>
</section><% if @operator %><p><%= link_to 'Inspect connected accounts and provider publication records', dashboard_social_connections_path(site_id: @site.id) %></p><% end %><aside class="sales-coach"><h2>When a release needs attention</h2><p>Blocked means no provider submission began. Cancel the slot, fix the reason and schedule the reviewed version again. Needs review means a submission may have happened: inspect the provider reference and existing publication tools before any manual retry. Media delivery may redirect to storage; verify your real provider can fetch it before launch.</p></aside>
</main>
