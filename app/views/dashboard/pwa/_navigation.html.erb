<%= form_with scope: :application, skip_default_ids: false, url: dashboard_pwa_path(site_id: @site.id, section: "navigation"), method: :patch do |f| %><%= f.hidden_field :lock_version, value: @application.lock_version %><section class="pa-card"><h2>Application navigation</h2><p class="pa-muted">Choose labels, links, placement and order for this app. Disabled surfaces are removed from navigation automatically.</p>
<% items = @navigation.map(&:bootstrap_payload).index_by { |item| item[:key] }; @application.settings.fetch("navigation", {}).each { |key, value| items[key] = items.fetch(key, {key: key}).merge(value.symbolize_keys) }; new_key = "custom-#{SecureRandom.hex(4)}"; items[new_key] = {key: new_key, label: "", href: "", surface_id: "", placement: "primary", position: 100, enabled: true} %>
<% items.each do |key, item| %><% prefix = "application[navigation][#{key}]" %><details class="pa-module" open><summary><%= item[:label].presence || "Add a custom link" %></summary><div class="pa-fields"><div><label>Label<input name="<%= prefix %>[label]" value="<%= item[:label] %>" maxlength="80"></label></div><div><label>Link<input name="<%= prefix %>[href]" value="<%= item[:href] %>" maxlength="1000" placeholder="#/home or https://…"></label></div><div><label>Surface<select name="<%= prefix %>[surface_id]"><%= options_for_select([["Custom destination", ""]] + LightekPwa::Application::SURFACES.map { |s| [s.humanize, s] }, item[:surface_id]) %></select></label></div><div><label>Placement<select name="<%= prefix %>[placement]"><%= options_for_select(%w[primary tools footer].map { |s| [s.humanize, s] }, item[:placement]) %></select></label></div><div><label>Position<input type="number" name="<%= prefix %>[position]" value="<%= item[:position] %>"></label></div><div><input type="hidden" name="<%= prefix %>[enabled]" value="0"><label class="pa-check"><input type="checkbox" name="<%= prefix %>[enabled]" value="1" <%= "checked" if item.fetch(:enabled, true) %>> Visible</label></div></div></details><% end %><div class="pa-actions"><%= f.submit "Save navigation" %></div></section><% end %>
