<section class="pa-card"><div class="pa-row"><h2><%= @section.humanize %></h2><% if %w[content communities].include?(@section) %><%= link_to "Create #{@section == 'content' ? 'content' : 'community'} ↗", "https://#{@site.host}/lightek/index.html#/create#{@section == 'communities' ? '/community' : ''}", class: "pa-button", target: "_blank", rel: "noopener" %><% end %></div>
<%= form_with url: dashboard_pwa_path, method: :get do %><%= hidden_field_tag :site_id, @site.id %><%= hidden_field_tag :section, @section %><%= hidden_field_tag :resource, @studio_resource %><div class="pa-fields"><div><label>Find by name, text or record number<%= search_field_tag :q, @query, maxlength: 160 %></label></div><div class="pa-actions"><%= submit_tag "Search records" %></div></div><% end %>
<% if @section == "people" %><p class="pa-muted">Application roles and suspensions are scoped to this website. Your owner account and platform super admins retain authority. Private gender settings and global account roles are not edited here.</p><%= form_with url: dashboard_pwa_people_path(site_id: @site.id, section: "people"), method: :post do %><div class="pa-fields"><div><label>Existing account email<%= email_field_tag :email, nil, required: true %></label></div><div><label>Application role<%= select_tag :role, options_for_select(LightekPwa::Membership::ROLES.map { |r| [r.humanize, r] }) %></label></div></div><div class="pa-actions"><%= submit_tag "Add application member" %></div><% end %><% end %>
<% if @section == "studio" %><div class="pa-actions"><% %w[projects assets operations publications].each do |key| %><%= link_to key.humanize, dashboard_pwa_path(site_id: @site.id, section: "studio", resource: key), class: "pa-button #{'alt' unless @studio_resource == key}" %><% end %></div><% end %>
<% @records.each do |record| %>
  <% if @section == "content" %>
    <details class="pa-module"><summary>#<%= record.id %> · <%= record.title.presence || record.content.to_s.truncate(90) %> <span class="pa-pill"><%= record.kind %> · <%= record.moderation_state %> · <%= record.audience %></span></summary><p class="pa-muted">By <%= record.user.profile&.public_display_name || "Member" %> · <%= record.created_at.strftime("%b %d, %Y") %><% if record.community %> · <%= record.community.name %><% end %></p>
    <%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_#{record.class.name.demodulize.underscore}_#{record.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "post", id: record.id), method: :patch do |f| %><%= f.label :title %><%= f.text_field :title, value: record.title, maxlength: 160 %><%= f.label :content %><%= f.text_area :content, value: record.content, maxlength: 50000 %><div class="pa-fields"><div><%= f.label :moderation_state, "Moderation" %><%= f.select :moderation_state, [["Published", "published"], ["Hidden from the application", "hidden"]], selected: record.moderation_state %></div><div><%= f.label :visibility %><%= f.select :visibility, %w[public followers community private].map { |v| [v.humanize, v] }, selected: record.visibility %></div><div><%= f.label :audience %><%= f.select :audience, [["Everyone", "everyone"], ["Women", "women"], ["Men", "men"]], selected: record.audience %></div></div><div class="pa-actions"><%= f.submit "Save post" %><%= link_to "Open in PWA ↗", "https://#{@site.host}/lightek/index.html#/post/#{record.id}", class: "pa-button alt", target: "_blank", rel: "noopener" %></div><% end %>
    <% record.media.each do |attachment| %><p><%= link_to attachment.filename, dashboard_pwa_media_path(site_id: @site.id, kind: "post", id: record.id, attachment_id: attachment.id), target: "_blank", rel: "noopener" %></p><%= form_with scope: :record, url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "attachment", id: record.id), method: :patch do |f| %><%= f.hidden_field :attachment_id, value: attachment.id %><%= f.submit "Remove attachment", data: {turbo_confirm: "Remove this attachment from the post?"} %><% end %><% end %><%= form_with scope: :record, url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "delete_post", id: record.id), method: :patch do |f| %><%= f.hidden_field :status, value: "deleted" %><div class="pa-actions"><%= f.submit "Delete post and replies", data: {turbo_confirm: "Permanently delete this post and its replies?"} %></div><% end %></details>
  <% elsif @section == "communities" %>
    <details class="pa-module"><summary><%= record.name %> <span class="pa-pill"><%= record.moderation_state %> · <%= record.audience %> · <%= record.memberships.size %> members</span></summary><%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_#{record.class.name.demodulize.underscore}_#{record.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "community", id: record.id), method: :patch do |f| %><%= f.label :name %><%= f.text_field :name, value: record.name, required: true, maxlength: 120 %><%= f.label :description %><%= f.text_area :description, value: record.description, maxlength: 10000 %><div class="pa-fields"><div><%= f.label :moderation_state, "Availability" %><%= f.select :moderation_state, [["Active", "active"], ["Suspended", "suspended"]], selected: record.moderation_state %></div><div><%= f.label :visibility %><%= f.select :visibility, [["Public", "public"], ["Private — invitation only", "private"]], selected: record.visibility %></div><div><%= f.label :audience %><%= f.select :audience, [["Everyone", "everyone"], ["Women", "women"], ["Men", "men"]], selected: record.audience %></div></div><%= f.label :sections, "Community sections" %><%= f.select :sections, Community::SECTIONS.map { |key| [key.humanize, key] }, {selected: record.sections}, multiple: true, size: 6 %><div class="pa-actions"><%= f.submit "Save community" %></div><% end %><% if @policy.role == "admin" %><%= form_with scope: :record, url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "delete_community", id: record.id), method: :patch do |f| %><%= f.hidden_field :status, value: "deleted" %><div class="pa-actions"><%= f.submit "Delete community", data: {turbo_confirm: "Permanently delete this community, its posts and memberships?"} %></div><% end %><% end %><h3>Community members</h3><%= form_with url: dashboard_pwa_community_members_path(site_id: @site.id, section: "communities", id: record.id), method: :post do %><label>Existing account email<%= email_field_tag :email, nil, required: true, id: "community_email_#{record.id}" %></label><label>Community role<%= select_tag :role, options_for_select(%w[member admin].map { |key| [key.humanize, key] }), id: "community_role_#{record.id}" %></label><div class="pa-actions"><%= submit_tag "Add community member" %></div><% end %><% record.memberships.includes(:profile).each do |membership| %><p><%= membership.profile.public_display_name %> · <%= membership.role %></p><% unless membership.role == "owner" %><%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_membership_#{membership.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "community_member", id: membership.id), method: :patch do |f| %><div class="pa-fields"><%= f.select :role, %w[member admin remove].map { |key| [key.humanize, key] }, selected: membership.role %><%= f.submit "Update community role" %></div><% end %><% end %><% end %></details>
  <% elsif @section == "people" %>
    <% membership = @memberships[record.id] %><div class="pa-module"><h3><%= record.public_display_name %> <small class="pa-muted"><%= record.display_handle %></small></h3><% if record.user == @site.tenant || record.user.role == "super_admin" %><span class="pa-pill">Protected administrator</span><% else %><%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_#{record.class.name.demodulize.underscore}_#{record.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "membership", id: record.id), method: :patch do |f| %><div class="pa-fields"><div><%= f.label :role, "Application role" %><%= f.select :role, LightekPwa::Membership::ROLES.map { |key| [key.humanize, key] }, selected: LightekPwa::Policy.new(user: record.user, site: @site).role %></div><div><%= f.label :status, "Application access" %><%= f.select :status, [["Active", "active"], ["Suspended", "suspended"]], selected: membership&.status || "active" %></div></div><div class="pa-actions"><%= f.submit "Save application access" %></div><% end %><% end %></div>
  <% elsif @section == "live" %>
    <div class="pa-module"><h3>#<%= record.id %> · <%= record.metadata["title"].presence || "Broadcast" %></h3><p><span class="pa-pill"><%= record.status %></span> · <%= record.platform %></p><% if %w[draft connecting live ending].include?(record.status) %><%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_#{record.class.name.demodulize.underscore}_#{record.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "live", id: record.id), method: :patch do |f| %><%= f.hidden_field :status, value: "ending" %><%= f.submit "End broadcast and hide playback", data: {turbo_confirm: "End this broadcast?"} %><% end %><% end %></div>
  <% elsif @section == "conversations" %>
    <div class="pa-module"><h3><%= record.title.presence || record.kind.humanize %></h3><p class="pa-muted">Community and watch-party conversation controls. Personal direct messages are not exposed here.</p><%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_#{record.class.name.demodulize.underscore}_#{record.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "conversation", id: record.id), method: :patch do |f| %><%= f.hidden_field :closed, value: record.metadata["administratively_closed"] ? "0" : "1" %><%= f.submit record.metadata["administratively_closed"] ? "Reopen conversation" : "Close conversation to new messages" %><% end %></div>
  <% elsif @section == "audit" %>
    <div class="pa-module"><strong><%= record.action.tr(".", " ").humanize %></strong><p class="pa-muted"><%= record.created_at.strftime("%b %d, %Y %H:%M %Z") %> · <%= record.actor.profile&.public_display_name || "Administrator" %> · <%= record.record_type.to_s.demodulize.underscore.humanize %> #<%= record.record_id %></p><small><%= Array(record.details["fields"]).map(&:humanize).join(", ") %></small></div>
  <% elsif @section == "studio" %>
    <% if @studio_resource == "projects" %><div class="pa-module"><h3><%= record.name %></h3><p class="pa-muted">Production #<%= record.id %> · Creator #<%= record.owner_id %></p><%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_#{record.class.name.demodulize.underscore}_#{record.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: "studio", kind: "project", id: record.id), method: :patch do |f| %><%= f.label :name %><%= f.text_field :name, value: record.name, required: true %><%= f.label :description %><%= f.text_area :description, value: record.description %><div class="pa-actions"><%= f.submit "Save production" %></div><% end %><%= link_to "Open Studio ↗", "https://#{@site.host}/lightek/index.html#/studio/#{record.studio_scenes.first&.id}", class: "pa-button alt", target: "_blank", rel: "noopener" %></div>
    <% elsif @studio_resource == "assets" %><div class="pa-module"><h3><%= record.name %></h3><p><span class="pa-pill"><%= record.kind %> · <%= record.status %></span></p><% if record.error_message.present? %><p class="pa-errors"><%= record.error_message %></p><% end %><% if record.status == "failed" %><%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_#{record.class.name.demodulize.underscore}_#{record.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: "studio", kind: "asset", id: record.id), method: :patch do |f| %><%= f.hidden_field :status, value: "uploaded" %><%= f.submit "Retry import" %><% end %><% end %><% if record.file.attached? %><%= link_to "Open asset", dashboard_pwa_media_path(site_id: @site.id, kind: "asset", id: record.id), class: "pa-button alt", target: "_blank", rel: "noopener" %><% end %><% unless %w[uploaded processing].include?(record.status) %><%= form_with scope: :record, url: dashboard_pwa_record_path(site_id: @site.id, section: "studio", kind: "delete_asset", id: record.id), method: :patch do |f| %><%= f.hidden_field :status, value: "deleted" %><div class="pa-actions"><%= f.submit "Delete unused asset", data: {turbo_confirm: "Permanently delete this unused asset?"} %></div><% end %><% end %></div>
    <% elsif @studio_resource == "operations" %><div class="pa-module"><h3>#<%= record.id %> · <%= record.operation_type.humanize %></h3><p><span class="pa-pill"><%= record.status %></span></p><% if record.error_message.present? %><p class="pa-errors"><%= record.error_message %></p><% end %><% record.artifacts.each do |artifact| %><% if artifact.file.attached? %><p><%= link_to artifact.filename, dashboard_pwa_media_path(site_id: @site.id, kind: "artifact", id: artifact.id), target: "_blank", rel: "noopener" %></p><% end %><% end %><% if %w[awaiting_planning awaiting_approval awaiting_payment pending running].include?(record.status) %><%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_#{record.class.name.demodulize.underscore}_#{record.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "operation", id: record.id), method: :patch do |f| %><%= f.hidden_field :status, value: "cancelled" %><%= f.submit "Cancel operation" %><% end %><% end %></div>
    <% else %><div class="pa-module"><h3>Publication #<%= record.id %> · <%= record.platform %></h3><p><span class="pa-pill"><%= record.status %></span><% if record.scheduled_at %> · <%= record.scheduled_at.strftime("%b %d %H:%M %Z") %><% end %></p><% if record.error_message.present? %><p class="pa-errors"><%= record.error_message %></p><% end %><% if %w[draft scheduled].include?(record.status) %><%= form_with scope: :record, skip_default_ids: false, namespace: "pwa_#{record.class.name.demodulize.underscore}_#{record.id}", url: dashboard_pwa_record_path(site_id: @site.id, section: @section, kind: "publication", id: record.id), method: :patch do |f| %><%= f.hidden_field :status, value: "cancelled" %><%= f.submit "Cancel scheduled publication" %><% end %><% end %></div><% end %>
  <% end %>
<% end %>
<% if @records.empty? %><div class="pa-empty">No <%= @section == "studio" ? @studio_resource : @section %> on this page.</div><% end %>
<div class="pa-pager"><% if @page > 1 %><%= link_to "← Previous", dashboard_pwa_path(site_id: @site.id, section: @section, resource: @studio_resource, page: @page - 1, q: @query), class: "pa-button alt" %><% end %><span class="pa-muted">Page <%= @page %> · Up to 50 records</span><% if @records.size == 50 %><%= link_to "Next →", dashboard_pwa_path(site_id: @site.id, section: @section, resource: @studio_resource, page: @page + 1, q: @query), class: "pa-button alt" %><% end %></div>
</section>
