<%= form_with scope: :application, skip_default_ids: false, url: dashboard_pwa_path(site_id: @site.id, section: "settings"), method: :patch, multipart: true do |f| %>
<%= f.hidden_field :lock_version, value: @application.lock_version %>
<div class="pa-grid"><section class="pa-card"><h2>Identity & installation</h2><%= f.label :name, "Application name" %><%= f.text_field :name, value: @application.display_name, maxlength: 100, required: true, data: {preview_name: true} %><%= f.label :short_name, "Home-screen name" %><%= f.text_field :short_name, value: @application.short_name, maxlength: 24 %><%= f.label :description %><%= f.text_area :description, value: @application.description, maxlength: 3000 %><%= f.label :logo, "Application logo" %><%= f.file_field :logo, accept: "image/png,image/jpeg,image/webp" %><% if @application.logo.attached? %><label class="pa-check"><%= f.check_box :remove_logo %> Remove current logo</label><% end %><%= f.label :icon, "Install icon · use a square 512 × 512 PNG" %><%= f.file_field :icon, accept: "image/png,image/jpeg,image/webp" %><% if @application.icon.attached? %><label class="pa-check"><%= f.check_box :remove_icon %> Remove current install icon</label><% end %><p class="pa-muted">PNG, JPEG or WebP, up to 2 MB. The app name, colors and icon are used by this hostname's install manifest.</p></section>
<section class="pa-card"><h2>Look & welcome</h2><div class="pa-fields"><div><%= f.label :theme_color, "Accent color" %><%= f.color_field :theme_color, value: @application.theme_color %></div><div><%= f.label :background_color %><%= f.color_field :background_color, value: @application.background_color %></div></div><%= f.label :welcome_message %><%= f.text_area :welcome_message, value: @application.welcome_message, maxlength: 3000 %><%= f.label :support_email %><%= f.email_field :support_email, value: @application.support_email %><%= f.label :start_surface, "Open the application on" %><%= f.select :start_surface, LightekPwa::Application::SURFACES.map { |key| [key.humanize, key] }, selected: @application.start_surface %><%= f.label :status, "Availability" %><%= f.select :status, [["Published", "published"], ["Maintenance — public app paused", "maintenance"]], selected: @application.status %></section></div>
<section class="pa-card"><h2>Features & page layout</h2><p class="pa-muted">Enable surfaces, set headings and arrange their sections. Existing service permissions and entitlements remain in force.</p>
<% @surfaces.each do |surface| %><% setting = @application.settings.fetch("surfaces", {}).fetch(surface.key, {}); prefix = "application[surfaces][#{surface.key}]" %><details class="pa-module"><summary><%= surface.label %></summary><div class="pa-fields"><div><input type="hidden" name="<%= prefix %>[enabled]" value="0"><label class="pa-check"><input type="checkbox" name="<%= prefix %>[enabled]" value="1" <%= "checked" if setting.fetch("enabled", surface.enabled) %>> Enable <%= surface.label %></label></div><div><label>Page label<input name="<%= prefix %>[label]" value="<%= setting["label"].presence || surface.label %>" maxlength="100"></label></div><div><label>Position<input type="number" name="<%= prefix %>[position]" value="<%= setting.fetch("position", surface.position) %>"></label></div></div><label>Page heading<input name="<%= prefix %>[heading]" value="<%= setting["heading"] %>" maxlength="160"></label><label>Introduction<textarea name="<%= prefix %>[intro]" maxlength="3000"><%= setting["intro"] %></textarea></label>
<% surface.modules.each do |mod| %><% next unless LightekPwa::Configuration::CONFIGURABLE_MODULES.fetch(surface.key, []).include?(mod.key) %><% value = setting.fetch("modules", {}).fetch(mod.key, {}); mod_prefix = "#{prefix}[modules][#{mod.key}]" %><div class="pa-fields pa-module"><div><input type="hidden" name="<%= mod_prefix %>[enabled]" value="0"><label class="pa-check"><input type="checkbox" name="<%= mod_prefix %>[enabled]" value="1" <%= "checked" if value.fetch("enabled", mod.enabled) %>> <%= mod.label %></label></div><div><label>Section label<input name="<%= mod_prefix %>[label]" value="<%= value["label"].presence || mod.label %>" maxlength="100"></label></div><div><label>Position<input type="number" name="<%= mod_prefix %>[position]" value="<%= value.fetch("position", mod.position) %>"></label></div><% if %w[home watch].include?(surface.key) && mod.module_type != "community_grid" && mod.module_type != "creator_grid" %><div><label>Content record numbers (optional)<input name="<%= mod_prefix %>[post_ids]" value="<%= Array(value["post_ids"]).join(", ") %>" placeholder="12, 25, 41"></label></div><% end %></div><% end %></details><% end %></section><%= f.submit "Save PWA settings" %><% end %>
