<style>
.pwa-admin{--pa-bg:var(--dd-bg-elevated,#171924);--pa-line:var(--dd-border,#353847);--pa-text:var(--dd-text-primary,#eeeef5);--pa-muted:var(--dd-text-secondary,#a3a7bb);--pa-accent:var(--dd-accent,#8575ff);max-width:1440px;margin:auto;padding:28px;color:var(--pa-text);background:var(--dd-bg,#10121b);min-height:100vh;border-radius:16px;font-family:var(--dd-font-family,ui-sans-serif,system-ui,sans-serif)}.pwa-admin *{box-sizing:border-box}.pa-top,.pa-row{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.pa-eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:11px;color:var(--pa-accent)}.pwa-admin h1{font-size:clamp(28px,4vw,44px);letter-spacing:-.04em;margin:6px 0}.pwa-admin h2{font-size:22px;margin:0 0 15px}.pwa-admin h3{font-size:16px}.pa-sub,.pa-muted{color:var(--pa-muted);line-height:1.6}.pa-tabs{display:flex;gap:6px;overflow-x:auto;border-bottom:1px solid var(--pa-line);margin:26px 0}.pa-tabs a{white-space:nowrap;padding:13px 15px;text-decoration:none;color:var(--pa-muted);border-bottom:3px solid transparent}.pa-tabs a.active{color:var(--pa-text);border-color:var(--pa-accent)}.pa-button,.pwa-admin input[type=submit]{display:inline-block;border:1px solid var(--pa-line);border-radius:9px;background:var(--pa-accent);color:#fff;padding:10px 15px;font-size:13px;font-weight:650;text-decoration:none;cursor:pointer}.pa-button.alt{background:transparent;color:var(--pa-text)}.pa-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:18px}.pa-card{background:var(--pa-bg);border:1px solid var(--pa-line);border-radius:16px;padding:24px;margin-bottom:18px;min-width:0}.pa-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin:24px 0}.pa-metric{border:1px solid var(--pa-line);background:var(--pa-bg);border-radius:12px;padding:19px}.pa-metric span{display:block;color:var(--pa-muted);font-size:12px}.pa-metric strong{display:block;font-size:32px;margin:8px 0 0}.pwa-admin label{display:block;font-size:12px;letter-spacing:.02em;margin:14px 0 6px}.pwa-admin input:not([type=checkbox]):not([type=submit]),.pwa-admin select,.pwa-admin textarea{width:100%;padding:11px 12px;border:1px solid var(--pa-line);border-radius:9px;background:var(--dd-bg,#10121b);color:var(--pa-text);font:inherit;min-width:0}.pwa-admin textarea{min-height:100px;resize:vertical}.pwa-admin input[type=color]{height:46px}.pa-check{display:flex!important;align-items:center;gap:10px}.pa-check input{accent-color:var(--pa-accent)}.pa-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}.pa-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.pa-table{width:100%;border-collapse:collapse;font-size:13px}.pa-table td,.pa-table th{text-align:left;padding:12px 8px;border-bottom:1px solid var(--pa-line);vertical-align:top}.pa-scroll{overflow-x:auto}.pa-pill{display:inline-block;padding:4px 9px;border:1px solid var(--pa-line);border-radius:20px;font-size:11px}.pa-errors{padding:16px;border:1px solid #b45867;border-radius:10px;background:#b4586715;margin-bottom:18px}.pa-phone{max-width:290px;min-height:370px;border:7px solid #383a49;border-radius:36px;background:var(--phone-bg,#07070a);color:white;margin:12px auto;padding:32px 20px}.pa-phone img{max-width:100%;max-height:72px;object-fit:contain}.pa-phone h2{color:var(--phone-accent,#c9a34b);margin:28px 0 12px}.pa-preview-bar{height:8px;width:40%;border-radius:8px;background:var(--phone-accent);margin:30px 0}.pa-chart{display:flex;align-items:end;gap:12px;height:180px;border-bottom:1px solid var(--pa-line);margin:30px 0 34px}.pa-chart>div{height:100%;flex:1;display:flex;flex-direction:column;justify-content:end;align-items:center;gap:8px}.pa-chart i{display:block;width:80%;max-width:54px;background:linear-gradient(var(--pa-accent),#423676);border-radius:7px 7px 0 0;min-height:3px}.pa-chart small{font-size:10px;color:var(--pa-muted)}.pwa-admin details>summary{cursor:pointer;padding:8px 0;font-weight:650}.pa-module{overflow-wrap:anywhere;padding:12px;border-top:1px solid var(--pa-line)}.pa-pager{display:flex;justify-content:space-between;gap:15px;margin:20px 0}.pa-empty{padding:32px;text-align:center;border:1px dashed var(--pa-line);border-radius:12px;color:var(--pa-muted)}@media(max-width:650px){.pwa-admin{padding:16px}.pa-card{padding:17px}.pa-tabs a{padding:12px 10px}.pa-top form{width:100%}}
</style>
