<% content_for :page_title, "PWA Administration" %>
<%= render "style" %>
<main class="pwa-admin" data-pwa-admin>
  <header class="pa-top"><div><span class="pa-eyebrow">Client experience</span><h1>PWA Administration</h1><p class="pa-sub">Shape the application your community calls home.</p></div>
    <%= form_with url: dashboard_pwa_path, method: :get do %><label for="pwa-site">Application / website</label><%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :host, @site&.id), prompt: "Choose an application", id: "pwa-site" %><div class="pa-actions"><%= submit_tag "Manage application" %></div><% end %>
  </header>
  <% if @remote_installations.present? %><section class="pa-card"><h2>Installed applications</h2><div class="pa-grid"><% @remote_installations.each do |installation| %><article><h3><%= installation.domain %></h3><%= link_to "Open PWA Administration ↗", "https://#{installation.domain}/dashboard/pwa", class: "pa-button alt", target: "_blank", rel: "noopener" %></article><% end %></div></section><% end %>
  <% if @site %>
    <div class="pa-row"><p><strong><%= @site.name %></strong> <span class="pa-muted">· <%= @site.host %></span> <span class="pa-pill"><%= @application.status.humanize %></span></p><% if pwa_link %><%= link_to "Open PWA ↗", pwa_link, class: "pa-button alt", target: "_blank", rel: "noopener" %><% end %></div>
    <nav class="pa-tabs" aria-label="PWA administration sections"><% LightekPwa::Administration::SECTIONS.each do |key| %><% next if key == "people" && @policy.role != "admin" %><% next if %w[settings navigation studio].include?(key) && @policy.role == "moderator" %><%= link_to key.humanize, dashboard_pwa_path(site_id: @site.id, section: key), class: (@section == key ? "active" : nil), aria: {current: (@section == key ? "page" : nil)} %><% end %></nav>
    <% unless pwa_link %><div class="pa-errors" role="alert"><strong>This website points to a private network address: <%= @site.host %>.</strong> Choose the website for <%= request.host %> or the client's public domain in the application selector. Its saved hostname must be corrected before opening its PWA from production.
<% if @policy.super_admin? && LightekSettings::SiteDomain.public_hostname?(request.host) %>
<%= form_with url: dashboard_pwa_hostname_path(site_id: @site.id), method: :post do %>
<%= hidden_field_tag :expected_host, @site.host %>
<p>Keep this website and its content, and bind it to <strong><%= request.host %></strong>.</p>
<%= submit_tag "Use #{request.host} for this website", class: "pa-button" %>
<% end %>
<% end %></div><% end %>
    <% if flash[:notice] %><p class="pa-card" role="status"><%= flash[:notice] %></p><% end %>
    <% if @errors.present? %><div class="pa-errors" role="alert"><%= @errors.join(". ") %></div><% end %>
    <% if @section == "overview" %>
      <div class="pa-metrics"><% @stats.each do |label, value| %><div class="pa-metric"><span><%= label %></span><strong><%= number_with_delimiter(value) %></strong></div><% end %></div>
      <div class="pa-grid"><section class="pa-card"><h2>Your network this week</h2><p class="pa-muted">Posts published per day, from this application's records.</p><% maximum = [1, *@activity.values].max %><div class="pa-chart" role="img" aria-label="Daily posts for the past seven days"><% 6.downto(0) do |offset| %><% day = offset.days.ago.to_date; value = @activity[day.to_s] || @activity[day] || 0 %><div><small><%= value %></small><i style="height:<%= [2, value * 120.0 / maximum].max %>px"></i><small><%= day.strftime("%a") %></small></div><% end %></div><div class="pa-actions"><%= link_to "Moderate content", dashboard_pwa_path(site_id: @site.id, section: "content"), class: "pa-button" %><%= link_to "Manage communities", dashboard_pwa_path(site_id: @site.id, section: "communities"), class: "pa-button alt" %></div></section>
      <section class="pa-card"><h2>Your application</h2><div class="pa-phone" style="--phone-bg:<%= @application.background_color %>;--phone-accent:<%= @application.theme_color %>"><% if @application.logo.attached? %><%= image_tag @application.logo, alt: "Application logo" %><% end %><h2><%= @application.display_name %></h2><p><%= @application.welcome_message.presence || "A place for your people, stories and productions." %></p><div class="pa-preview-bar"></div><p class="pa-muted"><%= @configuration.navigation.map { |item| item[:label] }.join(" · ") %></p></div></section></div>
      <section class="pa-card"><h2>One application, your control</h2><p class="pa-muted">Branding, navigation and feature settings apply to this hostname. Community access rules still govern participation. Application administration lets your trusted team moderate this application's content; platform super admins retain full authority.</p><%= link_to "View administration history", dashboard_pwa_path(site_id: @site.id, section: "audit"), class: "pa-button alt" %></section>
    <% elsif @section == "settings" %><%= render "settings" %>
    <% elsif @section == "navigation" %><%= render "navigation" %>
    <% elsif @section == "integrations" %>
      <section class="pa-card"><h2>Connected workspaces</h2><p class="pa-muted">Use the existing application workspaces to manage services. Enabling a PWA surface does not grant a paid service entitlement.</p><div class="pa-grid"><% [["Website & design", dashboard_website_settings_path(site_id: @site.id)], ["Sign-in & account branding", "/dashboard/website/account-branding?site_id=#{@site.id}"], ["Storefront & orders", dashboard_commerce_products_path(site_id: @site.id)], ["Mail", "/dashboard/mail"], ["Live destinations", "/dashboard/live"], ["Billing & subscriptions", "/billing"], ["Application installation", "/my/installations"], ["Network & domains", "/dashboard/network"]].each do |label, href| %><div class="pa-card"><h3><%= label %></h3><%= link_to "Open workspace", href, class: "pa-button alt" %></div><% end %></div></section>
    <% else %><%= render "records" %><% end %>
  <% else %><div class="pa-empty"><h2><%= @sites.empty? ? "No applications assigned" : "Choose your application" %></h2><p><%= @sites.empty? ? "Your installed application appears here when its website is assigned to your account." : "Select a website above to open its PWA controls." %></p><%= link_to "My Applications", installations_path, class: "pa-button" %></div><% end %>
</main>
