<%= stylesheet_link_tag "/lightek/people-workspace.css" %>
<main class="lp-workspace">
  <nav aria-label="Breadcrumb"><%= link_to "Remote support", dashboard_remote_support_sessions_path %> / Request #<%= @room.it_service_request_id %></nav>
  <h1>Screen sharing</h1>
  <p>Technician <%= [@room.technician.first_name, @room.technician.last_name].compact_blank.join(" ") %> · View only</p>
  <% if @room.display_reported_at? %>
    <p>The technician’s browser reported video displayed at <%= l(@room.display_reported_at, format: :short) %>.</p>
  <% end %>
  <% if @room.ended_at? %>
    <p><%= @room.end_reason.humanize %> at <%= l(@room.ended_at, format: :short) %>.</p>
  <% elsif @room.expires_at.past? %>
    <p>This authorization has expired.</p>
  <% elsif @room.state == "requested" && @role == :customer %>
    <p>Allow your assigned technician to see the screen or window you choose. You can stop sharing at any time.</p>
    <div class="lp-actions">
      <%= button_to "Allow viewing", approve_dashboard_remote_support_session_path(@room), class: "lp-button" %>
      <%= button_to "Decline", end_session_dashboard_remote_support_session_path(@room), method: :delete, class: "lp-button secondary" %>
    </div>
  <% elsif @room.state == "requested" %>
    <p>Waiting for your customer to approve screen viewing.</p>
    <p><%= link_to "Check approval", dashboard_remote_support_session_path(@room) %></p>
    <%= button_to "Cancel request", end_session_dashboard_remote_support_session_path(@room), method: :delete, class: "lp-button secondary" %>
  <% elsif @bound %>
    <section data-controller="remote-screen remote-recording"
      data-action="remote-screen:recording-state->remote-recording#update"
      data-remote-screen-role-value="<%= @role %>"
      data-remote-recording-role-value="<%= @role %>"
      data-remote-recording-consent-value="<%= recording_consent_dashboard_remote_support_session_path(@room) %>"
      data-remote-recording-start-value="<%= recording_start_dashboard_remote_support_session_path(@room) %>"
      data-remote-recording-upload-value="<%= recording_upload_dashboard_remote_support_session_path(@room) %>"
      data-remote-recording-revoke-value="<%= recording_revoke_dashboard_remote_support_session_path(@room) %>"
      data-remote-screen-exchange-value="<%= exchange_dashboard_remote_support_session_path(@room) %>"
      data-remote-screen-end-value="<%= end_session_dashboard_remote_support_session_path(@room) %>">
      <p role="status" data-remote-screen-target="status">Authorized until <%= l(@room.expires_at, format: :short) %>.</p>
      <div class="lp-actions">
        <button class="lp-button" type="button" data-remote-screen-target="start" data-action="remote-screen#start">
          <%= @role == :customer ? "Choose screen to share" : "Connect to customer screen" %>
        </button>
        <%= button_to "End session", end_session_dashboard_remote_support_session_path(@room), method: :delete,
          class: "lp-button secondary", form: { data: { action: "submit->remote-screen#end" } } %>
        <button class="lp-button secondary" type="button" hidden data-remote-screen-target="fullscreen"
          data-action="remote-screen#fullscreen">Fullscreen</button>
      </div>
      <video autoplay playsinline muted hidden data-remote-screen-target="video" style="width: 100%; max-height: 75vh; background: #151515"></video>
      <%= render "recording_controls" %>
    </section>
  <% else %>
    <p>Open this page in the browser session used to request or approve screen sharing.</p>
    <%= button_to "End session", end_session_dashboard_remote_support_session_path(@room), method: :delete, class: "lp-button secondary" %>
  <% end %>
  <% if @recording_available && (@room.ended_at? || !@bound || @room.expires_at.past?) %>
    <section class="lp-card" aria-label="Session recording">
      <p><%= link_to "Play session recording", recording_playback_dashboard_remote_support_session_path(@room), target: "_blank", rel: "noopener" %></p>
      <%= button_to "Withdraw recording permission", recording_revoke_dashboard_remote_support_session_path(@room),
        method: :delete, class: "lp-button secondary" %>
    </section>
  <% end %>
  <%= render "files" if @bound || @room.ended_at? %>
</main>
