<%= form_with url: offer_network_dashboard_reservations_path(site_id: @site.id), scope: :offer, class: 'lr-form', style: 'margin-top:18px' do |form| %><%= form.hidden_field :id, value: offer['id'] if offer['id'] %><label>Your package name<%= form.text_field :name, value: offer['name'], required: true, maxlength: 160 %></label><label>Description<%= form.text_area :description, value: offer['description'], rows: 3, maxlength: 3000 %></label><label>Approved infrastructure<%= form.select :source_id, @network.fetch('approved').map { |source| ["#{source['name']} · minimum selling price #{number_to_currency(source['minimum_price_cents']/100.0)} / #{source['billing_interval']}", source['id']] }, {selected: offer['source_id'], include_blank: 'Choose a package'}, required: true %></label><label>Your selling price (cents)<%= form.number_field :price_cents, value: offer['price_cents'], min: 1, required: true %></label><label>Industry experience<%= form.select :template_key, @network.fetch('templates').map { |template| ["#{template['industry'].to_s.humanize} · #{template['name']}", template['key']] }, {selected: offer['template_key'], include_blank: 'Standard Lightek workspace'} %></label><p class="lr-muted">The platform protects infrastructure and its margin before your earnings are released. Your price must cover the displayed floor.</p><label><span><%= form.check_box :published, checked: offer['published'] %> Publish on my booking page</span></label><%= form.submit 'Save server experience', class: 'lr-button' %><% end %>
