<%= stylesheet_link_tag 'reservations', 'data-turbo-track': 'reload' %>
<main class="lr-admin"><header class="lr-hero"><div><span class="lr-eyebrow">YOUR RESORT, YOUR RULES</span><h1>Reservations & experiences</h1><p>Welcome guests. Make space. Keep everything moving.</p></div><%= link_to 'View booking page ↗', reservations_catalog_path(site_id: @site.id), class: 'lr-button' %></header>
<%= form_with url: dashboard_reservations_path, method: :get, class: 'lr-form', style: 'margin-top:18px' do %><label>Website<%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @site.id) %></label><%= submit_tag 'Switch website', class: 'lr-button secondary' %><% end %>
<div class="lr-stats"><% @metrics.each do |key,value| %><article class="lr-stat"><strong><%= value %></strong><span><%= key.to_s.humanize %></span></article><% end %></div>
<div class="lr-admin-grid"><section><article class="lr-card"><div class="lr-section-heading" style="margin-top:0"><h2>Your booking day</h2><%= form_with url: dashboard_reservations_path, method: :get do %><%= hidden_field_tag :site_id, @site.id %><%= date_field_tag :date, @day, aria: {label: 'Calendar date'} %><%= submit_tag 'View day', class: 'lr-button secondary' %><% end %></div><div class="lr-table-wrap"><table class="lr-table"><thead><tr><th>Time</th><th>Guest & experience</th><th>Status</th><th>Manage</th></tr></thead><tbody><% @reservations.each do |reservation| %><tr><td><%= reservation.starts_at.in_time_zone(reservation.resource.timezone).strftime('%-I:%M %p %Z') %></td><td><strong><%= reservation.customer.full_name %></strong><br><%= reservation.package_snapshot['name'] %><br><small><%= reservation.reference %></small></td><td><span class="lr-badge"><%= reservation.status.humanize %></span><% if reservation.notes.present? %><details><summary>Guest notes</summary><p><%= reservation.notes %></p></details><% end %></td><td><% if reservation.status == 'confirmed' && !reservation.server? %><%= button_to 'Check in', transition_dashboard_reservation_path(reservation, site_id: @site.id, status: 'checked_in'), class: 'lr-button secondary' %><% elsif reservation.status == 'checked_in' && !reservation.server? %><%= button_to 'Complete', transition_dashboard_reservation_path(reservation, site_id: @site.id, status: 'completed'), class: 'lr-button' %><% end %><% if %w[confirmed checked_in].include?(reservation.status) %><%= button_to 'Cancel', transition_dashboard_reservation_path(reservation, site_id: @site.id, status: 'canceled'), class: 'lr-button secondary' %><% end %><% if reservation.order %><%= link_to 'Order / refund', dashboard_commerce_orders_path(site_id: @site.id), class: 'lr-link' %><% end %></td></tr><% end %></tbody></table></div><% if @reservations.empty? %><p class="lr-muted">A little room to breathe. No reservations on this date.</p><% end %></article>
<article class="lr-card" style="margin-top:20px"><h2>Your experiences</h2><div class="lr-table-wrap"><table class="lr-table"><thead><tr><th>Experience</th><th>Rate</th><th>Visibility</th><th></th></tr></thead><tbody><% @resources.each do |resource| %><tr><td><strong><%= resource.name %></strong><br><%= resource.kind.humanize %> · <%= resource.capacity %> places</td><td><%= number_to_currency(resource.price_cents / 100.0) %><br><small><%= resource.server? ? resource.billing_interval : "#{resource.duration_minutes} min" %></small></td><td><%= resource.published? ? 'Published' : 'Draft' %></td><td><%= link_to 'Edit', dashboard_reservations_path(site_id: @site.id, resource_id: resource.id), class: 'lr-link' %></td></tr><% end %></tbody></table></div><%= link_to '+ New experience', dashboard_reservations_path(site_id: @site.id), class: 'lr-link' %></article>
<article class="lr-card" style="margin-top:20px"><h2>Front desk · book for a guest</h2><%= form_with url: book_dashboard_reservations_path(site_id: @site.id), class: 'lr-form' do %><%= hidden_field_tag :checkout_key, SecureRandom.uuid %><label>Guest account email<%= email_field_tag :customer_email, nil, required: true %></label><label>Experience<%= select_tag :resource_id, options_from_collection_for_select(@resources.select(&:published?), :id, :name), required: true %></label><label>Starts · experience's time zone<%= datetime_local_field_tag :starts_at, nil, required: true %></label><label>Participants<%= number_field_tag :quantity, 1, min: 1, required: true %></label><label>Notes<%= text_area_tag :notes, nil, rows: 2, maxlength: 3000 %></label><%= submit_tag 'Create guest reservation', class: 'lr-button' %><% end %><h2>Time off & maintenance</h2><%= form_with url: blackout_dashboard_reservations_path(site_id: @site.id), class: 'lr-form' do %><label>Experience<%= select_tag :resource_id, options_from_collection_for_select(@resources, :id, :name), required: true %></label><p class="lr-muted">Times use the selected experience's time zone.</p><div class="lr-inline"><label>Starts<%= datetime_local_field_tag :starts_at, nil, required: true %></label><label>Ends<%= datetime_local_field_tag :ends_at, nil, required: true %></label></div><label>Reason<%= text_field_tag :reason, nil, maxlength: 300 %></label><%= submit_tag 'Block this time', class: 'lr-button secondary' %><% end %><% @blackouts.each do |blackout| %><p><%= blackout.resource.name %> · <%= blackout.starts_at.in_time_zone(blackout.resource.timezone).strftime('%b %-d, %-I:%M %p') %> · <%= blackout.reason %></p><%= button_to 'Remove block', remove_blackout_dashboard_reservations_path(site_id: @site.id, id: blackout.id), method: :delete, class: 'lr-button secondary' %><% end %></article>
<% if @changes.any? %><article class="lr-card" style="margin-top:20px"><h2>Package changes</h2><% @changes.each do |change| %><p><strong><%= change.reservation.reference %></strong> · <%= change.target_resource.name %> · <%= change.status.humanize %></p><% if change.error.present? %><p class="lr-alert"><%= change.error %></p><% end %><% if change.status == 'failed' %><%= button_to 'Resume paid change', retry_change_dashboard_reservation_path(change, site_id: @site.id), class: 'lr-button secondary' %><% end %><% end %></article><% end %></section><aside class="lr-card"><span class="lr-eyebrow">DESIGN THE STAY</span><h2><%= @resource.persisted? ? 'Edit experience' : 'Create an experience' %></h2><%= form_with scope: :resource, url: save_resource_dashboard_reservations_path(site_id: @site.id, id: @resource.id), class: 'lr-form' do |form| %><label>Name<%= form.text_field :name, value: @resource.name, required: true, maxlength: 160 %></label><label>Description<%= form.text_area :description, value: @resource.description, rows: 3, maxlength: 3000 %></label><div class="lr-inline"><label>Experience type<%= form.select :kind, LightekReservations::Resource::KINDS.map { |kind| [kind.humanize, kind] }, selected: @resource.kind %></label><label>Time zone<%= form.select :timezone, ActiveSupport::TimeZone.all.map { |zone| [zone.tzinfo.name, zone.tzinfo.name] }.uniq, selected: @resource.timezone %></label></div><label>Priced product<%= form.select :product_id, @products.map { |product| ["#{product.name} · #{number_to_currency(product.price_cents / 100.0)}", product.id] }, {include_blank: 'Complimentary / no payment', selected: @resource.product_id} %></label><p class="lr-muted">Use a digital product for appointments or a server product with a subscription plan for server reservations. Prices and stock come from Commerce.</p><fieldset><legend>Time & availability</legend><div class="lr-inline"><label>Duration (minutes)<%= form.number_field :duration_minutes, value: @resource.duration_minutes, min: 5, max: 10080 %></label><label>Capacity<%= form.number_field :capacity, value: @resource.capacity, min: 1 %></label><label>Buffer (minutes)<%= form.number_field :buffer_minutes, value: @resource.buffer_minutes, min: 0 %></label><label>Advance notice (minutes)<%= form.number_field :notice_minutes, value: @resource.notice_minutes, min: 0 %></label></div><label>Changes / cancellation notice (hours)<%= form.number_field :cancellation_hours, value: @resource.cancellation_hours, min: 0 %></label><p class="lr-muted">Leave all days blank for flexible availability. Server terms use monthly or annual dates.</p><% Date::DAYNAMES.each_with_index do |day,index| %><div class="lr-hours"><span><%= day.first(3) %></span><%= time_field_tag "resource[opening_hours][#{index}][open]", @resource.hours.dig(index.to_s, 0, 0), aria: {label: "#{day} opens"} %><%= time_field_tag "resource[opening_hours][#{index}][close]", @resource.hours.dig(index.to_s, 0, 1), aria: {label: "#{day} closes"} %></div><% end %></fieldset><label>Location<%= form.text_field :location, value: @resource.location %></label><label>Voice / video / live session link<%= form.url_field :join_url, value: @resource.join_url, placeholder: 'https://…' %></label><p class="lr-muted">Session links are shown to the guest after confirmation.</p><label>Included accommodations · one per line<%= form.text_area :accommodations_text, value: @resource.accommodations.join("\n"), rows: 4 %></label><fieldset><legend>Server resort packages</legend><label>Industry experience<%= form.select :template_key, LightekDesign::StarterLibrary.designs.map { |key,design| ["#{design['industry'].to_s.humanize} · #{design['name']}", key] }, {include_blank: 'Standard Lightek workspace', selected: @resource.template_key} %></label><% if current_user.role == 'super_admin' %><label>Paid term<%= form.select :billing_interval, [['Monthly','monthly'],['Annual','annual']], selected: @resource.billing_interval %></label><label>Protected cost + margin per term (cents)<%= form.number_field :cost_floor_cents, value: @resource.cost_floor_cents, min: 0 %></label><p class="lr-muted">Reserves this amount for infrastructure and Lightek's margin before merchant earnings are released.</p><% {'region'=>'Region','plan'=>'Server plan','image'=>'Operating system image','monthly_cost_cents'=>'Monthly infrastructure cost (cents)'}.each do |key,label| %><label><%= label %><%= text_field_tag "resource[compute][#{key}]", @resource.compute[key], placeholder: (key == 'monthly_cost_cents' ? '600' : nil) %></label><% end %><% else %><label>Approved infrastructure package<%= select_tag :approved_server_id, options_from_collection_for_select(@server_packages, :id, :name, @resource.source_resource_id), include_blank: 'Choose a server package' %></label><p class="lr-muted">Infrastructure, subscription plan and the platform cost floor come from this approved package. Set your selling price in Commerce.</p><% end %></fieldset><label><span><%= form.check_box :published, checked: @resource.published? %> Publish this experience</span></label><%= form.submit 'Save experience ↗', class: 'lr-button' %><% end %></aside></div></main>
