<%= stylesheet_link_tag 'reservations' %><main class="lr-admin"><header class="lr-hero"><div><span class="lr-eyebrow">YOUR WHITE-LABEL SERVER RESORT</span><h1>Open your doors.</h1><p>Your brand. Approved Lightek infrastructure. One connected booking and payout workflow.</p></div><%= link_to 'View my booking page ↗', reservations_catalog_path(site_id: @site.id), class: 'lr-button' %></header><div class="lr-admin-grid" style="margin-top:24px"><section><article class="lr-card"><h2>Your server experiences</h2><% @network.fetch('offers').each do |offer| %><details><summary><%= offer['name'] %> · <%= number_to_currency(offer['price_cents'] / 100.0) %> · <%= offer['published'] ? 'Published' : 'Draft' %></summary><%= render 'dashboard/reservations/network_offer_form', offer: offer %></details><% end %><% if @network['offers'].empty? %><p>Your published server experiences will appear on your website's reservation page.</p><% end %></article><article class="lr-card" style="margin-top:20px"><h2>Your central payout account</h2><p><%= @network_payouts['connect_ready'] ? 'Your payout account is connected.' : 'Connect your bank account to receive your earnings.' %></p><%= link_to 'Manage payout account & earnings ↗', @network_payouts.fetch('merchant_url'), class: 'lr-button', rel: 'noopener' %><%= form_with url: payouts_network_dashboard_reservations_path(site_id: @site.id), method: :patch, class: 'lr-form', style: 'margin-top:20px' do %><label>Earnings release schedule<%= select_tag :cadence, options_for_select([['Every two weeks','biweekly'],['Every week','weekly']], @network_payouts['cadence']) %></label><label><span><%= check_box_tag :enabled, '1', @network_payouts['enabled'] %> Automatic earnings releases</span></label><%= submit_tag 'Save payout preference', class: 'lr-button secondary' %><% end %><p class="lr-muted">Stripe controls bank arrival after release. Bank-account changes require your central Lightek account.</p></article></section><aside class="lr-card"><h2>Create a server experience</h2><%= render 'dashboard/reservations/network_offer_form', offer: {} %></aside></div></main>
