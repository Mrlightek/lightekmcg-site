<%= stylesheet_link_tag '/lightek/sales-workspace.css?v=3' %>
<%= render 'dashboard/shared/business_workspace', active: 'Sales' %>
<header class="sales-header">
  <div><span class="sales-eyebrow">LIGHTEK / RELATIONSHIPS TO REVENUE</span><h1>Sales & CRM</h1><p>Build relationships. Keep your next move clear.</p></div>
  <%= form_with url: dashboard_sales_path, method: :get, class: 'sales-site' do %>
    <%= label_tag :site_id, 'Business website' %><%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @site.id) %><%= submit_tag 'Switch', class: 'sales-button secondary' %>
  <% end %>
</header>
<p><%= link_to 'Growth & attribution', dashboard_growth_path(site_id: @site.id) %></p>
<%= render 'dashboard/sales/tabs', active_tab: @tab, manage_routing: @manage_routing %>
