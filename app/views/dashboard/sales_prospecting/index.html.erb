<% content_for :page_title, 'Prospecting · Sales & CRM' %>
<%= javascript_include_tag '/lightek/sales-prospecting.js?v=2', type: 'module' %>
<main class="sales-workspace">
  <%= stylesheet_link_tag '/lightek/sales-workspace.css?v=4' %>
  <%= render 'dashboard/shared/business_workspace', active: 'Sales' %>
  <header class="sales-header">
    <div><h1>Prospecting</h1><p>Find buyers, save the source, and schedule your next conversation.</p></div>
    <%= form_with url: dashboard_sales_prospecting_path, method: :get, class: 'sales-site' do %>
      <label>Business website<%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @site.id) %></label>
      <%= submit_tag 'Switch', class: 'sales-button secondary' %>
    <% end %>
  </header>
  <%= render 'dashboard/sales/tabs', active_tab: 'prospecting', manage_routing: @manage_connection %>
  <% if flash[:alert] %><p class="sales-errors" role="alert"><%= flash[:alert] %></p><% end %>
  <% if flash[:notice] %><p role="status"><%= flash[:notice] %></p><% end %>

  <section class="sales-panel">
    <h2>Search X on the web</h2>
    <%= form_tag 'https://x.com/search', method: :get, enforce_utf8: false, target: '_blank',
      rel: 'noopener noreferrer', data: {turbo: false}, class: 'sales-filters' do %>
      <label>Keywords or phrase<%= search_field_tag :q, @keywords, required: true, minlength: 2, maxlength: 200,
        id: 'x_web_search_query', placeholder: '"looking for a web designer"' %></label>
      <button type="submit" class="sales-button secondary">Search on X</button>
    <% end %>
    <%= form_with url: save_web_dashboard_sales_prospecting_path(site_id: @site.id), class: 'sales-filters sales-editor' do %>
      <label>X post link<%= url_field_tag :post_url, nil, required: true, maxlength: 2048, autocomplete: 'off',
        placeholder: 'https://x.com/username/status/123456789' %></label>
      <button type="submit" class="sales-button">Save prospect</button>
    <% end %>
  </section>

  <section class="sales-panel">
    <h2>Other prospecting sources</h2>
    <% LightekSales::WebProspecting::SOURCES.each do |provider, source| %>
      <% if provider == 'google_maps' %>
        <%= render 'dashboard/sales_prospecting/maps_source', source: source %>
      <% else %>
        <%= render 'dashboard/sales_prospecting/web_source', provider: provider, source: source %>
      <% end %>
    <% end %>
  </section>

  <section class="sales-panel" id="cadences">
    <h2>Outreach cadences</h2>
    <p>Save a follow-up plan and reuse it on a prospect. Each step creates a Sales task.</p>
    <% @cadences.each do |cadence| %>
      <details>
        <summary><%= cadence.name %> · <%= pluralize(cadence.steps.length, 'step') %></summary>
        <ol>
          <% cadence.steps.each do |step| %><li>Day <%= step.fetch('days') %> · <%= step.fetch('title') %></li><% end %>
        </ol>
      </details>
    <% end %>
    <details>
      <summary>Create cadence</summary>
      <%= form_with url: cadences_dashboard_sales_prospecting_path(site_id: @site.id), scope: :cadence,
        class: 'sales-form sales-editor' do |form| %>
        <label>Cadence name<%= form.text_field :name, required: true, maxlength: 120 %></label>
        <fieldset>
          <legend>Follow-up steps</legend>
          <div data-cadence-steps class="sales-form">
            <%= render 'dashboard/sales_prospecting/cadence_step', days: 0, removable: false %>
          </div>
          <template data-cadence-step-template>
            <%= render 'dashboard/sales_prospecting/cadence_step', days: nil, removable: true %>
          </template>
        </fieldset>
        <div class="sales-actions">
          <button type="button" class="sales-button secondary" data-add-cadence-step>Add step</button>
          <%= form.submit 'Save cadence', class: 'sales-button' %>
        </div>
      <% end %>
    </details>
  </section>

  <section class="sales-panel">
    <h2>X account</h2>
    <% if @account %>
      <p>Connected as <strong>@<%= @account.fetch('username') %></strong></p>
      <% if @manage_connection %><%= button_to 'Disconnect X', disconnect_dashboard_sales_prospecting_path(site_id: @site.id), class: 'sales-button secondary' %><% end %>
      <%= form_with url: search_dashboard_sales_prospecting_path(site_id: @site.id), class: 'sales-form' do %>
        <label>Keywords or phrase<%= text_field_tag :keywords, @keywords, required: true, minlength: 2, maxlength: 200, placeholder: '"looking for a web designer"' %></label>
        <%= submit_tag 'Search recent posts', class: 'sales-button' %>
      <% end %>
    <% end %>
    <% if @manage_connection %>
      <details <%= 'open' unless @account %>>
        <summary><%= @account ? 'Reconnect X' : 'Connect X' %></summary>
        <p>Register this callback URL in your X Web App before connecting. X API access and credits are required.</p>
        <label>Callback URL<input type="text" value="<%= x_callback_dashboard_sales_prospecting_url %>" readonly></label>
        <%= form_with url: authorize_x_dashboard_sales_prospecting_path(site_id: @site.id), class: 'sales-form', data: {turbo: false}, local: true do %>
          <label>OAuth 2.0 client ID<%= text_field_tag :x_client_id, nil, autocomplete: 'off', required: true, maxlength: 4096 %></label>
          <label>OAuth 2.0 client secret<%= password_field_tag :x_client_secret, nil, autocomplete: 'off', required: true, maxlength: 4096 %></label>
          <%= submit_tag 'Continue to X', class: 'sales-button' %>
        <% end %>
      </details>
      <details>
        <summary>Use an existing access token</summary>
        <p>Use an OAuth 2.0 user access token from your X developer app with <code>tweet.read</code>, <code>users.read</code> and <code>dm.write</code>. X API access and credits are required.</p>
        <%= form_with url: connect_dashboard_sales_prospecting_path(site_id: @site.id), class: 'sales-form' do %>
          <label>X user access token<%= password_field_tag :x_access_token, nil, autocomplete: 'off', required: true, maxlength: 4096 %></label>
          <%= submit_tag 'Verify and save in Vault', class: 'sales-button' %>
        <% end %>
      </details>
    <% elsif !@account %>
      <p>Ask the website owner or account manager to connect an X account.</p>
    <% end %>
  </section>

  <% if @results %>
    <section class="sales-panel">
      <h2>Matching posts</h2>
      <% if @results.empty? %><p>No recent posts matched. Try another phrase.</p><% end %>
      <% @results.each do |result| %>
        <article class="sales-follow-up">
          <div>
            <strong><%= result[:name] %> · @<%= result[:username] %></strong>
            <p><%= result[:text] %></p>
            <%= link_to 'Read the post on X', "https://x.com/i/web/status/#{result[:post_id]}", rel: 'noreferrer' %>
          </div>
          <%= button_to 'Save prospect', save_dashboard_sales_prospecting_path(site_id: @site.id),
            params: {selection: result[:selection]}, class: 'sales-button secondary' %>
        </article>
      <% end %>
    </section>
  <% end %>

  <section class="sales-panel">
    <div class="sales-panel-title">
      <h2><%= @selected_prospect ? 'Saved prospect' : 'Saved prospects' %></h2>
      <div class="sales-actions">
        <% if @selected_prospect %>
          <%= link_to 'All saved prospects', dashboard_sales_prospecting_path(site_id: @site.id), class: 'sales-button secondary' %>
        <% end %>
        <%= link_to 'Sales tasks', dashboard_sales_path(site_id: @site.id, tab: 'tasks'), class: 'sales-button secondary' %>
      </div>
    </div>
    <% if @prospects.empty? %><p>Save a promising result to review their account and follow up.</p><% end %>
    <% @prospects.each do |prospect| %>
      <article class="sales-panel">
        <small><%= prospect.provider_label %></small>
        <h3><%= link_to prospect.name, prospect.profile_url, rel: 'noreferrer' %></h3>
        <div class="sales-actions">
          <%= link_to (prospect.maps? ? 'View Maps listing' : 'View source post'), prospect.source_url, rel: 'noreferrer' %>
          <% if prospect.maps? && prospect.business_website_url.present? %>
            <%= link_to 'Review business website', prospect.business_website_url, target: '_blank', rel: 'noopener noreferrer' %>
          <% end %>
          <% unless @selected_prospect %>
            <%= link_to 'Open prospect', dashboard_sales_prospecting_path(site_id: @site.id, prospect_id: prospect.id) %>
          <% end %>
          <% if !prospect.web_only? && !prospect.contact_blocked_at? && prospect.outreach_status != 'ready' %>
            <%= link_to 'Open conversation on X', prospect.thread_url, target: '_blank', rel: 'noopener noreferrer' %>
          <% end %>
          <% if prospect.lead %><%= link_to prospect.lead.name, dashboard_sales_record_path(kind: 'lead', id: prospect.lead.id, site_id: @site.id) %><% end %>
        </div>
        <% if prospect.website_finding.present? %><p><strong>Website finding:</strong> <%= prospect.website_finding %></p><% end %>
        <% if prospect.contact_blocked_at? %>
          <p><strong>Do not contact</strong></p>
        <% else %>
          <% if @owners.any? %>
            <%= render 'dashboard/sales_prospecting/follow_up_form', prospect: prospect %>
            <% if @selected_prospect && @cadences.any? %>
              <%= render 'dashboard/sales_prospecting/cadence_form', prospect: prospect %>
            <% end %>
          <% end %>
          <% unless prospect.web_only? %>
            <p><%= {'ready' => 'No message sent', 'sending' => 'Send started. Check the conversation on X before contacting again.',
              'uncertain' => 'Delivery unconfirmed. Check the conversation on X before contacting again.',
              'sent' => "X accepted message #{prospect.provider_message_id}"}[prospect.outreach_status] %></p>
          <% end %>
          <% if prospect.outreach_status == 'ready' %>
            <details>
              <summary><%= prospect.maps? ? 'Draft outreach' : "Draft a DM for #{prospect.provider_label}" %></summary>
              <div class="sales-form" data-prospect-draft>
                <label>Message<%= text_area_tag "prospect_dm_#{prospect.id}", nil, rows: 4, maxlength: 2000,
                  autocomplete: 'off', data: {prospect_draft_text: true} %></label>
                <div class="sales-actions">
                  <button type="button" class="sales-button secondary" data-copy-prospect-draft>Copy draft</button>
                  <% if prospect.maps? %>
                    <%= link_to 'Open business contact source', prospect.business_website_url.presence || prospect.profile_url,
                      class: 'sales-button secondary', target: '_blank', rel: 'noopener noreferrer' %>
                  <% else %>
                    <% message_label = prospect.web_only? ? "Open #{prospect.provider_label} profile" : 'Open DM on X' %>
                    <%= link_to message_label, (prospect.thread_url || prospect.profile_url), class: 'sales-button secondary',
                      target: '_blank', rel: 'noopener noreferrer' %>
                  <% end %>
                </div>
                <% if prospect.web_only? && !prospect.maps? %><small>Open the profile and choose the message option if available.</small><% end %>
                <small role="status" data-prospect-draft-status><%= prospect.maps? ? 'Use the business’s published contact channel to review and send your draft.' :
                  "Paste your draft into #{prospect.provider_label} to review and send it." %></small>
              </div>
            </details>
          <% end %>
          <% if @account && !prospect.web_only? && prospect.outreach_status == 'ready' %>
            <details>
              <summary>Write a direct message</summary>
              <%= form_with url: message_dashboard_sales_prospect_path(prospect, site_id: @site.id), class: 'sales-form' do %>
                <label>How did this person invite your account to DM them?<%= text_field_tag :contact_permission, nil, required: true, maxlength: 250, id: "contact_permission_#{prospect.id}" %></label>
                <label>Message<%= text_area_tag :outreach_text, nil, rows: 4, required: true, maxlength: 2000, id: "outreach_text_#{prospect.id}" %></label>
                <label><%= check_box_tag :confirmed, '1', false, required: true, id: "message_confirmed_#{prospect.id}" %> Send this message to this X account now.</label>
                <%= submit_tag 'Send direct message', class: 'sales-button' %>
              <% end %>
            </details>
          <% end %>
          <%= button_to 'Mark do not contact', block_contact_dashboard_sales_prospect_path(prospect, site_id: @site.id), class: 'sales-button secondary' %>
        <% end %>
        <% unless prospect.lead || prospect.contact_blocked_at? %>
          <details>
            <summary>Create or link a CRM lead</summary>
            <%= form_with url: lead_dashboard_sales_prospect_path(prospect, site_id: @site.id), scope: :lead, namespace: "prospect_#{prospect.id}", class: 'sales-form' do |f| %>
              <label>Name<%= f.text_field :name, required: true, maxlength: 160 %></label>
              <label>Email they shared<%= f.email_field :email, required: true, maxlength: 254 %></label>
              <label>Company (optional)<%= f.text_field :company, maxlength: 160 %></label>
              <label><%= check_box_tag :confirmed, '1', false, required: true, id: "lead_confirmed_#{prospect.id}" %> This person shared their email and agreed to link it to this prospect record.</label>
              <%= f.submit 'Save CRM lead', class: 'sales-button' %>
            <% end %>
          </details>
        <% end %>
        <% if @selected_prospect %>
          <%= render 'dashboard/sales_prospecting/history', prospect: prospect %>
        <% end %>
      </article>
    <% end %>
  </section>
</main>
