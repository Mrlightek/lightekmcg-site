<section class="sales-panel"><span class="sales-eyebrow"><%= quote.status.humanize %> / REVISION <%= quote.revision %></span><h2><%= quote.title %></h2><p>Prepared for <%= quote.customer_email %> · valid through <%= quote.expires_on %> (<%= Time.zone.name %>)</p><div class="sales-table-scroll"><table><thead><tr><th>Item</th><th>Quantity</th><th>Price</th><th>Interval</th></tr></thead><tbody><% quote.lines.each do |line| %><tr><td><%= line['name'] %></td><td><%= line['quantity'] %></td><td>USD <%= number_with_precision(line['unit_price_cents'] / 100.0, precision: 2, delimiter: ',') %></td><td><%= line['billing_interval'].humanize %></td></tr><% end %></tbody></table></div><h3>Quoted subtotal · USD <%= number_with_precision(quote.total_cents / 100.0, precision: 2, delimiter: ',') %></h3><p>Applicable taxes are calculated at checkout before payment. Monthly/yearly offers recur at the interval shown.</p><p style="white-space:pre-wrap;overflow-wrap:anywhere"><%= quote.terms %></p></section>
<% if quote.order %><section class="sales-panel" style="margin-top:20px"><span class="sales-eyebrow">ORDER / PAYMENT / DELIVERY</span><h2>Order #<%= quote.order.id %> · <%= quote.order.status.humanize %></h2><p>Payment: <%= quote.order.paid_at ? "Confirmed #{quote.order.paid_at.to_fs(:long)}" : 'Awaiting verified processor confirmation' %></p><p>Delivery: <%= quote.order.fulfilled_at ? "Fulfilled #{quote.order.fulfilled_at.to_fs(:long)}" : quote.order.provisioned_at ? "Installation provisioned #{quote.order.provisioned_at.to_fs(:long)}" : 'Not yet completed' %></p><% if quote.order.fulfillment_reference.present? %><p>Delivery reference: <%= quote.order.fulfillment_reference %></p><% end %></section><% end %>
