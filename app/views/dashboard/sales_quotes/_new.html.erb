<section class="sales-panel" style="margin:20px 0"><h2><%= local_assigns[:previous] ? 'Create a revised quote' : 'Prepare a catalog quote' %></h2><p>Choose the products and quantities agreed with the customer. Issued terms remain fixed; a revision uses current catalog prices.</p><%= form_with url: dashboard_sales_quotes_path(site_id: @site.id), scope: :quote, class: 'sales-form' do |f| %><%= hidden_field_tag :opportunity_id, opportunity.id %><%= hidden_field_tag :previous_id, previous.id if local_assigns[:previous] %><div class="sales-form-grid"><label>Quote title<%= f.text_field :title, value: opportunity.name, required: true, maxlength: 160 %></label><label>Customer email<%= f.email_field :customer_email, value: opportunity.contact&.email, required: true %></label><label>Valid through<%= f.date_field :expires_on, value: Date.current + 14, required: true %></label><label class="full">Scope and delivery terms<%= f.text_area :terms, rows: 4, maxlength: 20000, placeholder: 'Describe the scope, responsibilities and delivery expectations.' %></label></div><div class="sales-table-scroll"><table><thead><tr><th>Catalog offer</th><th>USD price</th><th>Quantity</th></tr></thead><tbody><% @products.each do |product| %><tr><td><%= product.name %> · <%= product.billing_interval.humanize %></td><td><%= number_with_precision(product.price_cents / 100.0, precision: 2) %></td><td><%= number_field_tag "quantities[#{product.id}]", 0, min: 0, max: 100, step: 1, style: 'width:90px', aria: {label: "Quantity for #{product.name}"} %></td></tr><% end %></tbody></table></div><small>Services, digital products and managed installations. Subscriptions/installations require one item, quantity one. Catalog prices are used; no hidden price override.</small><%= f.submit 'Save draft quote', class: 'sales-button' %><% end %></section>
