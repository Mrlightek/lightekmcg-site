<% content_for :page_title, 'Quote · Sales & CRM' %><main class="sales-workspace"><%= render 'dashboard/sales/header' %><p><%= link_to 'Back to deal', record_url('opportunity', @quote.opportunity) %></p><%= render 'details', quote: @quote %>
<% if @quote.status == 'draft' %><section class="sales-panel" style="margin-top:20px"><h2>Ready for the customer?</h2><p>Issuing fixes this revision's prices and terms. Changed catalog items require a new revision.</p><%= button_to 'Issue quote', issue_dashboard_sales_quote_path(site_id: @site.id, id: @quote.id), params: {lock_version: @quote.lock_version}, class: 'sales-button' %></section><% end %>
<% if @quote.status.in?(%w[issued accepted]) %><section class="sales-panel" style="margin-top:20px"><h2>Customer link</h2><% token = @quote.signed_id(purpose: 'sales_quote', expires_at: @quote.expires_on.end_of_day) %><% customer_url = public_sales_quote_url(token: token, host: @quote.portal_host, protocol: 'https') %><p><%= link_to 'Open customer quote', customer_url, rel: 'noreferrer' %></p><label>Copy this private customer link<%= text_field_tag :customer_link, customer_url, readonly: true, style: 'width:100%' %></label><p>Anyone with this signed link can review and acknowledge this quote before it expires. Share it with the intended customer.</p></section><% end %>
<% if @quote.status == 'issued' %><section class="sales-panel" style="margin-top:20px"><h2>Record approval received elsewhere</h2><%= form_with url: accept_dashboard_sales_quote_path(site_id: @site.id, id: @quote.id), class: 'sales-form' do %><label>Customer name<%= text_field_tag :accepted_name, nil, required: true, maxlength: 160 %></label><label>Approval evidence / reference<%= text_field_tag :acceptance_reference, nil, required: true, maxlength: 300, placeholder: 'Email reference, agreement or call date' %></label><label><%= check_box_tag :confirmed, '1', false, required: true %> The customer approved this exact revision. Record the deal as won and create an unpaid order.</label><%= submit_tag 'Record approval & create pending order', class: 'sales-button' %><% end %></section><% end %>
<% if @quote.order && @commerce_access %><p><%= link_to 'Manage payment and delivery in Commerce', dashboard_commerce_orders_path(site_id: @site.id), class: 'sales-button secondary' %></p><% end %>
<% unless @quote.status == 'accepted' %><%= render 'new', opportunity: @quote.opportunity, previous: @quote %><% end %></main>
