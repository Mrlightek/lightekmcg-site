<% content_for :page_title, "Hosting services" %>
<%= render "dashboard/infrastructure/styles" %><div class="infra"><%= link_to "← Servers & applications", dashboard_servers_path, class: "infra-back" %>
<header class="infra-hero"><div><span class="infra-eyebrow">Infrastructure / Hosting services</span><h1>Hosting services</h1><p>Create a managed server with an application, or add an application to a server you already own.</p></div></header>
<section class="infra-panel"><div class="infra-shortcuts">
<% if Gatekeeper::Hosting::Access.super_admin?(current_user) %><%= link_to new_dashboard_application_launch_path, class: "infra-shortcut" do %><i class="ti ti-server"></i><strong>Create server with application</strong><small>Select a provider, server size and Rails or Docker template.</small><% end %><%= link_to dashboard_infrastructure_catalog_path, class: "infra-shortcut" do %><i class="ti ti-settings"></i><strong>Hosting profiles & policies</strong><small>Manage compute requirements and provider policies.</small><% end %><% end %>
<%= link_to dashboard_servers_path, class: "infra-shortcut" do %><i class="ti ti-apps"></i><strong>Applications on your servers</strong><small>Select an instance to add a website or review installed applications.</small><% end %></div></section>
<% if @listings.any? %><section class="infra-panel"><h2>Available hosting plans</h2><div class="infra-shortcuts"><% @listings.each do |listing| %><div class="infra-shortcut"><strong><%= listing.title %></strong><%= link_to "View hosting plan", "/marketplace/#{listing.id}" %></div><% end %></div></section><% end %></div>
