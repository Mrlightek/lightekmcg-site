<% content_for :page_title, "Hosting services" %>
<%= render "dashboard/infrastructure/styles" %><div class="infra"><%= link_to "← Servers & applications", dashboard_servers_path, class: "infra-back" %>
<header class="infra-hero"><div><span class="infra-eyebrow">Infrastructure / Hosting services</span><h1>Hosting services</h1><p>Create a managed server with an application, or add an application to a server you already own.</p></div></header>
<section class="infra-panel"><div class="infra-shortcuts">
<% if Gatekeeper::Hosting::Access.super_admin?(current_user) %><%= link_to new_dashboard_application_launch_path, class: "infra-shortcut" do %><i class="ti ti-server"></i><strong>Create server with application</strong><small>Select a provider, server size and Rails or Docker template.</small><% end %><%= link_to dashboard_infrastructure_catalog_path, class: "infra-shortcut" do %><i class="ti ti-settings"></i><strong>Hosting profiles & policies</strong><small>Manage compute requirements and provider policies.</small><% end %><% end %>
<%= link_to dashboard_servers_path, class: "infra-shortcut" do %><i class="ti ti-apps"></i><strong>Applications on your servers</strong><small>Select an instance to add a website or review installed applications.</small><% end %></div></section>
<section class="infra-panel"><h2>Managed hosting plans</h2><p>Choose a plan, pay securely and follow installation from My Applications.</p><div class="infra-shortcuts"><% @packages.each do |package| %><article class="infra-shortcut"><strong><%= package.product.name %></strong><span><%= number_to_currency(package.product.price_cents / 100.0) %>/month</span><p><%= package.product.short_description %></p><%= form_with url: dashboard_hosting_purchase_path do |f| %><%= f.hidden_field :package_id, value: package.id %><%= f.hidden_field :checkout_key, value: SecureRandom.uuid %><div class="infra-field"><%= f.label :domain, "Website hostname (optional)", for: "package_domain_#{package.id}" %><%= f.text_field :domain, id: "package_domain_#{package.id}", placeholder: "client.example.com" %><small>Leave blank for an included Lightek subdomain.</small></div><% if @hosting_owners.size > 1 %><div class="infra-field"><%= f.label :hosting_owner_id, "Hosting account", for: "package_owner_#{package.id}" %><%= f.collection_select :hosting_owner_id, @hosting_owners, :id, :email_address, {selected: current_user.id}, id: "package_owner_#{package.id}" %><small>Your agency pays for the plan; this account owns its instance.</small></div><% end %><%= f.submit "Subscribe & launch", class: "infra-button infra-button-primary" %><% end %></article><% end %></div><% if @packages.empty? %><p>No hosting plans are available yet.</p><% end %></section>
<% if current_user.role == "super_admin" %><%= link_to "Configure retail hosting packages", dashboard_hosting_packages_path, class: "infra-button" %><% end %></div>
