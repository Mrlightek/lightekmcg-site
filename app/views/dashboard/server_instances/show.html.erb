<% content_for :page_title, @node.name %>
<%= link_to "← Servers & Applications", dashboard_servers_path %>
<h1><%= @node.name %></h1><p><%= @node.display_host %> · <strong><%= @node.status.humanize %></strong></p>
<p>Account website allowance: <%= @limit.infinite? ? "Unlimited (super admin)" : "#{@usage} of #{@limit}" %></p>
<div class="dd-card" style="padding:24px;margin-bottom:24px"><h2>Installed runtimes</h2>
<% @projects.each do |project| %><p><strong><%= project.name %></strong> · <%= project.domain %> · <%= project.status %></p><% end %>
<% if @projects.empty? %><p>No application runtime has been registered on this server.</p><% end %>
<% if Gatekeeper::Hosting::Access.super_admin?(current_user) %><p><%= link_to "Register an existing runtime", main_app.new_gatekeeper_project_path(gatekeeper_node_id: @node.id) %></p><% end %>
</div>
<div class="dd-card" style="padding:24px;margin-bottom:24px"><h2>Managed services</h2>
<% @installations.each do |installation| %><p><%= installation.component %> · <%= installation.domain %> · <%= installation.adapter %></p><% end %>
<% if @installations.empty? %><p>No additional service registrations.</p><% end %>
</div>
<div class="dd-card" style="padding:24px;margin-bottom:24px"><h2>Applications on this instance</h2>
<p>Each website has its own hostname, content, design and account ownership. These websites share the selected native Rails runtime and its software releases.</p>
<% @applications.each do |app| %><div style="padding:16px 0;border-bottom:1px solid var(--dd-border-color)">
  <strong><%= app.name %></strong> · <%= app.domain %> · <%= app.status.humanize %>
  <% if app.status == "ready" %> · <%= link_to "Open website", "https://#{app.domain}", target: "_blank", rel: "noopener" %> · <%= link_to "Manage website", "https://#{app.domain}/dashboard/pages", target: "_blank", rel: "noopener" %><% end %>
  <% if app.error_message.present? %><p><%= app.error_message %></p><% end %>
  <% if app.status == "failed" %><%= button_to "Retry setup", retry_application_dashboard_server_path(@node), params: {application_id: app.id}, class: "dd-btn dd-btn-secondary" %><% end %>
</div><% end %>
<% if @applications.empty? %><p>No additional website applications have been created here.</p><% end %>
</div>
<% unless @projects.empty? || %w[deleting delete_failed decommissioned].include?(@node.status) %>
<div class="dd-card" style="padding:24px;margin-bottom:24px"><h2>Add an application to this server</h2>
<%= form_with url: create_application_dashboard_server_path(@node), scope: :application do |f| %>
  <p><label>Name <%= f.text_field :name, required: true, maxlength: 120 %></label></p>
  <p><label>Hostname <%= f.text_field :domain, required: true, placeholder: "business.example.com" %></label></p>
  <p><label>Existing runtime <%= f.select :gatekeeper_project_id, @projects.map { |project| [project.name, project.id] }, {}, required: true %></label></p>
  <% if @owners %><p><label>Application owner <%= f.select :owner_id, @owners.map { |owner| [owner.email_address, owner.id] }, selected: current_user.id %></label></p><% end %>
  <p>Your DNS must point to this instance. Connected DNS zones are configured automatically when available.</p>
  <%= f.submit "Create application on this server", class: "dd-btn dd-btn-primary" %>
<% end %>
</div>
<% end %>
<% if @request&.metadata.to_h["delete_error"].present? %><p><%= @request.metadata["delete_error"] %></p><% end %>
<% unless %w[deleting decommissioned].include?(@node.status) %>
<details class="dd-card" style="padding:24px;border:1px solid #b94a48"><summary>Delete this server instance</summary>
  <p>This permanently deletes the provider instance, its local data and every application hosted on it. The server record and operation history remain for audit. Account subscriptions are managed separately.</p>
  <p>Review the runtimes and applications above, then type <strong><%= @node.name %></strong> to confirm.</p>
  <%= form_with url: dashboard_server_path(@node), method: :delete do |f| %>
    <label>Server name <%= f.text_field :confirmation, required: true, autocomplete: "off" %></label>
    <%= f.submit "Permanently delete server", class: "dd-btn dd-btn-secondary" %>
  <% end %>
</details>
<% end %>
