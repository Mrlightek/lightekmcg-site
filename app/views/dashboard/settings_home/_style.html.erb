<style>
.lt-settings{max-width:1100px;margin:0 auto;padding:24px;color:var(--dd-text-primary,inherit)}
.lt-settings h1{font-size:28px;margin:12px 0}.lt-settings .intro{color:var(--dd-text-secondary,inherit);margin-bottom:26px}
.lt-settings .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:18px}
.lt-settings .card{padding:22px;border:1px solid var(--dd-border,#777);border-radius:12px;background:var(--dd-card-bg,transparent)}
.lt-settings h2{font-size:18px;margin:0 0 10px}.lt-settings p{line-height:1.6}.lt-settings a{color:var(--dd-accent,#c794ff)}
.lt-settings .setting-link{display:block;padding:12px 0;border-top:1px solid var(--dd-border,#777);text-decoration:none}
.lt-settings small{display:block;color:var(--dd-text-secondary,inherit);line-height:1.5;margin-top:4px}
.lt-settings label{display:block;font-weight:600;margin:18px 0 8px}.lt-settings input[type=text],.lt-settings select{width:100%;box-sizing:border-box;padding:12px;border:1px solid var(--dd-border,#777);border-radius:7px;background:var(--dd-card-bg,#20212a);color:inherit}
.lt-settings button,.lt-settings input[type=submit]{padding:11px 18px;background:var(--dd-accent,#7452aa);color:white;border:0;border-radius:7px;cursor:pointer;margin-top:18px}
.lt-settings .errors{padding:14px;border:1px solid #df7878;border-radius:7px}.lt-settings .field-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:20px}
</style>
