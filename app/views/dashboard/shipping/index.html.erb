<% content_for :page_title, "Shipping & fulfillment" %><%= render "dashboard/infrastructure/styles" %>
<main class="infra"><header class="infra-hero"><div><span class="infra-eyebrow">Commerce / Shipping</span><h1>From checkout to delivery.</h1><p>Quote shipments, buy labels and track delivery through your business account.</p></div><%= link_to "Commerce", dashboard_commerce_path(site_id: @site.id), class: "infra-button" %></header>
<%= form_with url: dashboard_shipping_path, method: :get, class: "infra-form" do |f| %><div class="infra-field"><%= f.label :site_id, "Business" %><%= f.collection_select :site_id, @sites, :id, :name, selected: @site.id %></div><%= f.submit "Open business", class: "infra-button" %><% end %>
<section class="infra-panel"><h2>Shipping origin & packaging</h2><p>Domestic U.S. parcels. Each physical item uses its product dimensions or the default package below.</p><%= form_with url: dashboard_shipping_profile_path(site_id: @site.id), scope: :profile, class: "infra-form" do |f| %><div class="infra-fields"><%= f.fields_for :origin do |address| %><% {name: "Sender name", phone: "Phone", street: "Street", city: "City", state: "State (NY)", postal_code: "ZIP", country: "Country (US)"}.each do |key, label| %><div class="infra-field"><%= address.label key, label %><%= address.text_field key, value: @profile.origin.to_h[key.to_s].presence || (key == :country ? "US" : nil), required: true %></div><% end %><%= address.hidden_field :residential, value: false %><% end %><%= f.fields_for :default_package do |package| %><% {weight_lb: "Weight per item (lb)", length_in: "Length (in)", width_in: "Width (in)", height_in: "Height (in)"}.each do |key, label| %><div class="infra-field"><%= package.label key, label %><%= package.number_field key, value: @profile.default_package.to_h[key.to_s], min: 0.001, step: key == :weight_lb ? 0.001 : 1, required: true %></div><% end %><% end %><div class="infra-field"><%= f.label :customer_markup_bps, "Your additional customer shipping markup (basis points; 500 = 5%)" %><%= f.number_field :customer_markup_bps, value: @profile.customer_markup_bps, min: 0, max: 10000 %></div></div><%= f.submit "Save shipping profile", class: "infra-button infra-button-primary" %><% end %></section>
<section class="infra-panel"><h2>Send a package</h2><p>Get service options at your account's retail price. Sandbox quotes require Stripe test mode and produce test labels.</p><%= form_with url: dashboard_shipping_quotes_path(site_id: @site.id), scope: :recipient, class: "infra-form" do |f| %><div class="infra-fields"><% {name: "Recipient", phone: "Phone", street: "Street", city: "City", state: "State", postal_code: "ZIP", country: "Country"}.each do |key, label| %><div class="infra-field"><%= f.label key, label %><%= f.text_field key, value: key == :country ? "US" : nil, required: true %></div><% end %></div><%= f.submit "Get shipping rates", class: "infra-button" %><% end %></section>
<section class="infra-panel"><h2>Rates, labels & tracking</h2><% @quotes.each do |quote| %><article class="infra-list-row"><div><strong><%= quote.service_name %> · <%= number_to_currency(quote.platform_price_cents / 100.0) %><%= " · TEST" if quote.sandbox? %></strong><small><%= quote.shipment&.status&.humanize || "Quote" %> · <%= quote.shipment&.tracking_number %> · <%= quote.shipment&.carrier_status %></small><% if quote.shipment&.error_message.present? %><p role="alert"><%= quote.shipment.error_message %></p><% end %><% if current_user.role == "super_admin" && quote.carrier_cost_cents %><small>Operator: estimated carrier cost <%= number_to_currency(quote.carrier_cost_cents / 100.0) %> · retail spread <%= number_to_currency((quote.platform_price_cents - quote.carrier_cost_cents) / 100.0) %></small><% end %></div><div class="infra-actions"><% if quote.shipment&.status == "ready" %><%= link_to "Download label", label_dashboard_shipping_path(key: quote.public_key, index: 0, site_id: @site.id), class: "infra-button" %><%= button_to "Cancel unused label", cancel_dashboard_shipping_path(key: quote.public_key, site_id: @site.id), class: "infra-button", data: {turbo_confirm: "Ask FedEx to cancel this unused shipment?"} %><% elsif !quote.shipment && quote.expires_at > Time.current %><%= button_to "Buy label", purchase_dashboard_shipping_path(key: quote.public_key, site_id: @site.id), class: "infra-button infra-button-primary", data: {turbo: false} %><% end %><%= button_to "Refresh tracking", refresh_dashboard_shipping_path(key: quote.public_key, site_id: @site.id), class: "infra-button" %></div></article><% end %><% if @quotes.empty? %><p>Your quotes and shipments will appear here.</p><% end %></section>
<% if @carrier %><section class="infra-panel"><h2>Platform carrier account & pricing</h2><p>Only the Lightek operator can change this account. Rates and labels stay in sandbox until your production integration is approved and enabled.</p><%= form_with url: dashboard_shipping_carrier_path(site_id: @site.id), class: "infra-form" do |f| %><%= f.fields_for :carrier do |carrier| %><div class="infra-fields"><div class="infra-field"><label><%= carrier.check_box :sandbox, checked: @carrier.sandbox? %> Sandbox</label></div><div class="infra-field"><label><%= carrier.check_box :enabled, checked: @carrier.enabled? %> Enable carrier</label></div><div class="infra-field"><label><%= carrier.check_box :production_approved, checked: @carrier.production_approved? %> FedEx production approval has been received</label></div><% {markup_bps: "Markup (basis points)", fixed_markup_cents: "Fixed markup (cents)", minimum_margin_cents: "Minimum margin after processing reserve (cents)"}.each do |key, label| %><div class="infra-field"><%= carrier.label key, label %><%= carrier.number_field key, value: @carrier.public_send(key), min: key == :minimum_margin_cents ? 1 : 0, required: true %></div><% end %></div><% end %><h3>FedEx connection</h3><p>Leave credentials blank to keep the saved connection. To replace it, supply all three primary fields together.</p><%= f.fields_for :credentials do |credentials| %><div class="infra-fields"><% {client_id: "API key", client_secret: "API secret", account_number: "Lightek billing account", child_key: "Integrator child key (if applicable)", child_secret: "Integrator child secret (if applicable)"}.each do |key, label| %><div class="infra-field"><%= credentials.label key, label %><%= credentials.password_field key, autocomplete: "new-password" %></div><% end %><div class="infra-field"><%= credentials.label :grant_type, "Authorization type" %><%= credentials.select :grant_type, [["Standard", "client_credentials"], ["Integrator", "csp_credentials"], ["Parent / child", "client_pc_credentials"]], include_blank: "Keep existing" %></div></div><% end %><%= f.submit "Save carrier connection & retail pricing", class: "infra-button" %><% end %></section><% end %>
</main>
