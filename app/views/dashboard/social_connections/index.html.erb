<main class="lt-settings"><h1>Social Publishing · <%= @site.name %></h1><p>Publish approved social campaigns through your configured Lightek social gateway. Provider account authorization must be configured at the gateway.</p><%= form_with url: dashboard_social_connections_path(site_id: @site.id), method: :post do %><%= select_tag :provider, options_for_select([["Facebook Page", "facebook"], ["Instagram Business", "instagram"], ["TikTok (credential only)", "tiktok"]]) %><%= label_tag :account_label, "Connected account label" %><%= text_field_tag :account_label, nil, required: true %><%= label_tag "credentials_page_id", "Facebook Page ID" %><%= text_field_tag "credentials[page_id]" %><%= label_tag "credentials_instagram_user_id", "Instagram professional account ID" %><%= text_field_tag "credentials[instagram_user_id]" %><%= label_tag "credentials_access_token", "Provider access token" %><%= password_field_tag "credentials[access_token]" %><%= submit_tag "Save credentials to Vault and connect" %><% end %><p><%= link_to "Connect TikTok account", start_dashboard_tiktok_connection_path(site_id: @site.id) %></p><p><%= link_to "Connect Facebook and Instagram", start_dashboard_meta_connection_path(site_id: @site.id) %></p><section aria-label="Publishing overview" style="display:flex;gap:14px;flex-wrap:wrap;margin:18px 0">
<% [["Connected accounts", @connections.count(&:enabled?)], ["Published", @posts.count { |p| p.status == "published" }], ["Awaiting provider", @posts.count { |p| p.status == "pending" && p.remote_id.present? }], ["Failed", @posts.count { |p| p.status == "failed" }]].each do |label, count| %>
<div class="dd-card" style="min-width:145px;flex:1;padding:16px"><small><%= label %></small><div style="font-size:28px;font-weight:700"><%= count %></div></div>
<% end %></section>
<h2>Publishing destinations</h2><% @connections.each do |connection| %><section><h3><%= connection.account_label %> · <%= connection.provider.humanize %></h3><% if %w[facebook instagram].include?(connection.provider) && connection.enabled? %><%= button_to "Check connection", test_dashboard_social_connection_path(site_id: @site.id, connection_id: connection.id), method: :post %><% end %><% if connection.enabled? %><%= button_to "Disconnect and revoke credentials", disable_dashboard_social_connection_path(site_id: @site.id, connection_id: connection.id), method: :post, form: {data: {turbo_confirm: "Revoke this connection?"}} %><% else %><p>Disconnected</p><% end %><% @campaigns.each do |campaign| %><%= button_to "Publish: #{campaign.name}", publish_dashboard_social_connection_path(site_id: @site.id, connection_id: connection.id, campaign_id: campaign.id), method: :post %><% end %></section><% end %><h2>Publication history</h2><table><thead><tr><th>Campaign</th><th>Destination</th><th>Status</th><th>Remote ID</th><th>Submission</th></tr></thead><tbody><% @posts.each do |post| %><tr><td><%= post.campaign.name %></td><td><%= post.connection.account_label %></td><td><%= post.status.humanize %></td><td><%= post.remote_id.presence || "—" %></td><td><%= post.submission_status.presence || "—" %><% if post.status == "failed" %><%= button_to "Retry", retry_dashboard_social_publication_path(site_id: @site.id, post_id: post.id), method: :post %><% end %><% if post.connection.provider == "tiktok" && post.remote_id.present? && post.status == "pending" %><%= button_to "Refresh status", refresh_dashboard_social_submission_path(site_id: @site.id, post_id: post.id), method: :post %><% end %></td></tr><% end %></tbody></table><%= link_to "Business Command Center", dashboard_business_hub_path(site_id: @site.id) %></main>