<main class="lt-settings"><h1>Social Publishing · <%= @site.name %></h1><p>Publish approved social campaigns through your configured Lightek social gateway. Provider account authorization must be configured at the gateway.</p><%= form_with url: dashboard_social_connections_path(site_id: @site.id), method: :post do %><%= select_tag :provider, options_for_select([["Facebook Page", "facebook"], ["Instagram Business", "instagram"], ["TikTok (credential only)", "tiktok"]]) %><%= label_tag :account_label, "Connected account label" %><%= text_field_tag :account_label, nil, required: true %><%= label_tag "credentials_page_id", "Facebook Page ID" %><%= text_field_tag "credentials[page_id]" %><%= label_tag "credentials_instagram_user_id", "Instagram professional account ID" %><%= text_field_tag "credentials[instagram_user_id]" %><%= label_tag "credentials_access_token", "Provider access token" %><%= password_field_tag "credentials[access_token]" %><%= submit_tag "Save credentials to Vault and connect" %><% end %><h2>Publishing destinations</h2><% @connections.each do |connection| %><section><h3><%= connection.account_label %> · <%= connection.provider.humanize %></h3><% if connection.enabled? %><%= button_to "Disconnect and revoke credentials", disable_dashboard_social_connection_path(site_id: @site.id, connection_id: connection.id), method: :post, form: {data: {turbo_confirm: "Revoke this connection?"}} %><% else %><p>Disconnected</p><% end %><% @campaigns.each do |campaign| %><%= button_to "Publish: #{campaign.name}", publish_dashboard_social_connection_path(site_id: @site.id, connection_id: connection.id, campaign_id: campaign.id), method: :post %><% end %></section><% end %><h2>Publication history</h2><table><thead><tr><th>Campaign</th><th>Destination</th><th>Status</th><th>Remote ID</th></tr></thead><tbody><% @posts.each do |post| %><tr><td><%= post.campaign.name %></td><td><%= post.connection.account_label %></td><td><%= post.status.humanize %></td><td><%= post.remote_id.presence || "—" %></td></tr><% end %></tbody></table><%= link_to "Business Command Center", dashboard_business_hub_path(site_id: @site.id) %></main>