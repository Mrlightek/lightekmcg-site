<% content_for :page_title, "#{@scene.studio_project.name} · Studio" %>
<% content_for :head do %><meta name="turbo-visit-control" content="reload"><% end %>
<%= stylesheet_link_tag "/lightek/studio-editors.css?v=1" %>
<% if @kind == "video" %><%= stylesheet_link_tag "/lightek/editors/video/editor.css?v=1" %><% end %>
<main id="lightek-studio-dashboard" data-turbo="false" class="lightek-editor" data-editor-kind="<%= @kind %>" data-editor-base="<%= dashboard_studio_editor_path(kind: @kind, id: @scene.id, site_id: @site.id).split('?').first %>" data-site-id="<%= @site.id %>" data-lock-version="<%= @scene.lock_version %>" data-csrf-token="<%= form_authenticity_token %>">
  <%= render "dashboard/shared/business_workspace", active: "Studio", studio: true %>
  <header class="studio-editor-toolbar"><div><span>LIGHTEK <%= @kind.upcase %> STUDIO</span><h1><%= @scene.studio_project.name %></h1></div><nav aria-label="Project actions"><button type="button" data-editor-action="import">＋ Import media</button><button type="button" data-editor-action="save">Save project</button><button type="button" data-editor-action="backup">Download project backup</button><button type="button" data-editor-action="export">Export <%= @kind == "photo" ? "PNG" : "MP4" %></button><%= link_to "Productions", dashboard_media_studio_path(site_id: @site.id) %></nav></header>
  <p data-editor-status role="status">Opening your editor…</p>
  <label class="studio-editor-restore">Restore project backup <input type="file" accept="application/json,.json" data-editor-restore aria-label="Restore project backup"></label>
  <% if @scene.settings["campaign_id"] %><details class="studio-editor-library"><summary>Campaign brief</summary><p style="white-space:pre-wrap"><%= @scene.settings.dig("workspace", "story", "scriptDraft") %></p><%= link_to "Back to campaign", edit_dashboard_marketing_campaign_path(@scene.settings["campaign_id"], site_id: @site.id) %></details><% end %>
  <details class="studio-editor-library"><summary>Your media library · choose a file to add it</summary><div><input type="file" data-editor-import accept="<%= @kind == 'photo' ? 'image/*' : 'image/*,video/*,audio/*' %>" multiple aria-label="Import media files"><% @media.each do |asset| %><button type="button" data-editor-asset="<%= asset.id %>" data-name="<%= asset.name %>" data-type="<%= asset.kind %>" data-url="<%= "/dashboard/studio-broadcasting/assets/#{asset.id}/original?site_id=#{@site.id}" %>"><%= asset.name %> · <%= asset.kind %></button><% end %></div></details>
  <% if @kind == "photo" %><iframe id="lightek-photo-editor" title="Lightek Photo Studio — layers, tools and canvas" src="/lightek/editors/photo/index.html" allow="clipboard-write"></iframe><% else %><div id="lightek-video-editor" class="moviemasher" aria-label="Video editing workspace"></div><% end %>
  <section class="studio-editor-exports" aria-label="Exports"><h2>Exports</h2><p>Completed exports are also saved to your Lightek media library.</p><div data-editor-exports><% @exports.each do |operation| %><article data-operation="<%= operation.id %>"><strong>Export #<%= operation.id %> · <%= operation.status %></strong><% if operation.error_message.present? %><p role="alert"><%= operation.error_message %></p><% end %><% operation.artifacts.each do |artifact| %><%= link_to "Download #{artifact.filename}", Rails.application.routes.url_helpers.rails_blob_path(artifact.file, only_path: true), target: "_blank", rel: "noopener" %><% end %></article><% end %></div></section>
  <p class="studio-editor-restore"><a href="/lightek/editors/THIRD_PARTY_NOTICES.txt" target="_blank" rel="noopener">Open-source editor credits & licenses</a></p>
  <script type="application/json" data-editor-document><%= raw(json_escape(({document: @document, width: @scene.settings.dig("timeline", "width") || 1920, height: @scene.settings.dig("timeline", "height") || 1080}).to_json)) %></script>
</main>
<% if @kind == "video" %><%= javascript_include_tag "/lightek/editors/video/editor.js?v=1", defer: true %><% end %>
<%= javascript_include_tag "/lightek/studio-editors.js?v=1", defer: true %>
<%= javascript_include_tag "/lightek/studio-dashboard-context.js?v=1", defer: true %>
