<div class="p-6 max-w-7xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h1 class="text-2xl font-bold text-white">System Error & Activity Logs</h1>
      <p class="text-sm text-gray-400">Real-time log tail for debugging 500 errors and platform activity.</p>
    </div>
    <button onclick="window.location.reload();" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-lg shadow transition">
      Refresh Logs
    </button>
  </div>

  <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 shadow-2xl font-mono text-xs text-green-400 overflow-x-auto h-[600px] leading-relaxed">
    <pre><code><%= @logs %></code></pre>
  </div>
</div>
