<% content_for :page_title, "Vault" %>
<main class="dd-workspace">
  <header class="dd-page-header"><div><span class="dd-eyebrow">Gatekeeper / Secure control plane</span><h1>Vault</h1><p>Credentials, keys, and certificates. Encrypted at rest, with audited access and explicit service permissions.</p></div><span class="dd-status"><%= @active_count %> active secrets</span></header>
  <section class="dd-panel">
    <header class="dd-panel-header"><div><h2>Vault access</h2><p role="status"><%= @vault_readiness[:message] %></p></div></header>
    <% unless @vault_readiness[:ready] %>
      <p class="dd-note">Saved credentials remain encrypted. Restore the original master key if this environment does not have it; a new key cannot unlock existing credentials.</p>
      <%= form_with url: repair_access_dashboard_vault_path, method: :post do |form| %><div class="dd-form-actions"><div class="dd-field"><%= label_tag :master_key, "Original master key (only if restoring)" %><%= password_field_tag :master_key, nil, autocomplete: "new-password" %></div><%= form.submit "Repair & verify access" %></div><% end %>
    <% end %>
  </section>
  <div class="dd-workspace-grid">
    <section class="dd-panel">
      <header class="dd-panel-header"><div><h2>Store a credential</h2><p>Use a template or configure a service credential. Secret values are never redisplayed.</p></div></header>
      <div class="dd-field"><label for="vault-template">Credential template</label><select id="vault-template"><option value="">Custom credential</option><option value="godaddy">GoDaddy DNS · Personal Access Token</option><option value="github">GitHub · Repository access token</option><option value="github_app">GitHub App · App credentials</option></select><small id="vault-template-note" role="status">A template suggests field names and access policies. Review everything before saving.</small></div>
      <%= form_with url: dashboard_vault_path, method: :post do |form| %>
        <div class="dd-form-grid" style="margin-top:18px">
          <div class="dd-field"><%= label_tag "vault_secret_name", "Display name" %><%= text_field_tag "vault_secret[name]", nil, placeholder: "Production mail", required: true %></div>
          <div class="dd-field"><%= label_tag "vault_secret_slug", "Lookup slug" %><%= text_field_tag "vault_secret[slug]", nil, placeholder: "production-mail", required: true %></div>
          <div class="dd-field"><%= label_tag "vault_secret_secret_type", "Secret type" %><%= select_tag "vault_secret[secret_type]", options_for_select(LightekVault::Secret::TYPES.map { |type| [type.humanize, type] }) %></div>
          <div class="dd-field"><%= label_tag "vault_secret_provider", "Provider" %><%= text_field_tag "vault_secret[provider]", nil, placeholder: "e.g. GoDaddy" %></div>
          <div class="dd-field"><%= label_tag "vault_secret_environment", "Environment" %><%= select_tag "vault_secret[environment]", options_for_select([["Production", "production"], ["Development", "development"], ["Test", "test"]], "production") %></div>
          <div class="dd-field"><%= label_tag "vault_secret_purpose", "Purpose" %><%= text_field_tag "vault_secret[purpose]", nil, placeholder: "e.g. dns_management" %></div>
          <div class="dd-field dd-field-wide"><%= label_tag "vault_secret_payload", "Single secret value" %><%= password_field_tag "vault_secret[payload]", nil, autocomplete: "new-password" %><small>Stored as the field <code>value</code>. For named credentials, leave this empty and use structured fields below.</small></div>
        </div>
        <details class="dd-detail"><summary>Structured fields</summary><p style="font-size:12px;color:var(--dd-text-secondary);margin-bottom:12px">For credentials such as <code>token</code>, or <code>app_id</code> and <code>private_key</code>.</p>
          <% 6.times do |index| %><div class="dd-form-grid" style="margin-bottom:10px"><div class="dd-field"><%= label_tag "vault_key_#{index}", "Field #{index + 1} name" %><%= text_field_tag "vault_secret[payload_keys][]", nil, id: "vault_key_#{index}", placeholder: "Field name", autocomplete: "off" %></div><div class="dd-field"><%= label_tag "vault_value_#{index}", "Field #{index + 1} value" %><%= password_field_tag "vault_secret[payload_values][]", nil, id: "vault_value_#{index}", placeholder: "Secret value", autocomplete: "new-password" %></div></div><% end %>
        </details>
        <details class="dd-detail" open><summary>Access policy</summary><div class="dd-form-stack"><div class="dd-field"><%= label_tag "vault_secret_allowed_consumers", "Allowed consumers" %><%= text_field_tag "vault_secret[allowed_consumers]", nil, placeholder: "Service class names, comma-separated" %></div><div class="dd-field"><%= label_tag "vault_secret_allowed_purposes", "Allowed purposes" %><%= text_field_tag "vault_secret[allowed_purposes]", nil, placeholder: "Purposes, comma-separated" %></div></div></details>
        <div class="dd-form-actions"><%= form.submit "Store encrypted secret" %></div>
      <% end %>
    </section>
    <section class="dd-panel">
      <header class="dd-panel-header"><div><h2>Stored secrets</h2><p>Manage credential availability without exposing secret values.</p></div><span class="dd-status"><%= @expiring_count %> expiring soon</span></header>
      <% if @secrets.empty? %><p class="dd-empty">No credentials stored yet.</p><% else %><div class="dd-table-scroll"><table class="dd-table"><thead><tr><th>Credential</th><th>Status</th><th>Access</th></tr></thead><tbody>
        <% @secrets.each do |secret| %><tr><td><strong><%= secret.name %></strong><small><%= secret.display_provider %> · <%= secret.environment %></small><small><code><%= secret.slug %></code></small><% if secret.last_used_at %><small>Used <%= time_ago_in_words(secret.last_used_at) %> ago</small><% end %></td><td><span class="dd-status" data-tone="<%= secret.status == 'active' ? 'success' : 'neutral' %>"><%= secret.status.humanize %></span></td><td><%= button_to "Disable", dashboard_vault_disable_path, method: :post, params: {slug: secret.slug}, class: "dd-button dd-button-danger", data: {turbo_confirm: "Disable this secret?"} if secret.status == "active" %></td></tr><% end %>
      </tbody></table></div><% end %>
    </section>
  </div>
  <section class="dd-panel"><header class="dd-panel-header"><div><h2>Recent access</h2><p>Service credential activity and policy decisions.</p></div></header>
    <% if @audit_events.empty? %><p class="dd-empty">No access events recorded yet.</p><% else %><div class="dd-table-scroll"><table class="dd-table"><thead><tr><th>Action</th><th>Credential</th><th>Consumer / purpose</th><th>Decision</th></tr></thead><tbody><% @audit_events.each do |event| %><tr><td><%= event.action.humanize %></td><td><%= event.secret.name %></td><td><%= event.consumer.presence || "—" %><small><%= event.purpose.presence || "—" %></small></td><td><span class="dd-status" data-tone="<%= event.allowed? ? 'success' : 'warning' %>"><%= event.allowed? ? "Allowed" : "Denied" %></span></td></tr><% end %></tbody></table></div><% end %>
  </section>
</main>
<script>
(function() {
  function setupVaultHelp() {
    const selector = document.getElementById("vault-template");
    if (!selector || selector.dataset.ready) return;
    selector.dataset.ready = "true";
    selector.addEventListener("change", function() {
      if (!["godaddy", "github", "github_app"].includes(selector.value)) return;
      const form = document.querySelector('form[action$="/dashboard/vault"]');
      if (!form) return;
      const suggested = selector.value === "godaddy" ? {
        name: "GoDaddy DNS",
        slug: "godaddy-dns",
        provider: "godaddy",
        purpose: "dns_management",
        allowed_consumers: "Godaddy::DnsService",
        allowed_purposes: "dns_management"
      } : {name: selector.value === "github_app" ? "GitHub CI App" : "GitHub build connection",
        slug: selector.value === "github_app" ? "github-ci-app" : "github-actions", provider: "github",
        purpose: "image_build_setup", allowed_consumers: "Gatekeeper::Hosting::BuildSetup", allowed_purposes: "image_build_setup"};
      Object.entries(suggested).forEach(function(entry) {
        const input = form.elements["vault_secret[" + entry[0] + "]"];
        if (input && !input.value.trim()) input.value = entry[1];
      });
      const structured = document.getElementById("vault_key_0")?.closest("details");
      if (structured) structured.open = true;
      const keys = form.querySelectorAll('input[name="vault_secret[payload_keys][]"]');
      const fields = selector.value === "github_app" ? ["app_id", "private_key"] : ["token"];
      fields.forEach(function(field, index) { if (keys[index] && !keys[index].value.trim()) keys[index].value = field; });
      const note = document.getElementById("vault-template-note");
      if (note) note.textContent = selector.value === "godaddy" ? "GoDaddy fields suggested. Paste the PAT next to token under Structured fields; leave Single secret value empty. Review everything before saving." : "GitHub field names and access policy filled. Add the existing authorized credential once; image-build setup reuses it automatically. App access tokens are generated as needed from app credentials.";
    });
  }
  document.addEventListener("turbo:load", setupVaultHelp);
  document.addEventListener("DOMContentLoaded", setupVaultHelp);
  setupVaultHelp();
})();
</script>