<% content_for :page_title, 'Website growth audit' %>
<main class="sales-workspace growth-workspace"><%= stylesheet_link_tag '/lightek/sales-workspace.css?v=4' %><%= stylesheet_link_tag '/lightek/growth-workspace.css?v=5' %><%= render 'dashboard/shared/business_workspace', active: 'Website audit' %>
<header class="sales-header"><div><span class="sales-eyebrow">LIGHTEK / OBSERVE · REVIEW · IMPROVE</span><h1>Website growth audit</h1><p>Evidence from published native CMS output. Changes stay reviewable.</p></div><%= form_with url: dashboard_website_audits_path, method: :get, class: 'sales-site' do %><%= label_tag :site_id, 'Business website' %><%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @site.id) %><%= submit_tag 'Switch', class: 'sales-button secondary' %><% end %></header>
<% if flash[:alert] %><div class="sales-errors" role="alert"><%= flash[:alert] %></div><% end %><% if flash[:notice] %><p role="status"><%= flash[:notice] %></p><% end %>
<% if (sitemap = LightekGrowth::SearchDiscovery.sitemap_url(@site)) %>
  <section class="sales-panel">
    <h2>Search discovery</h2>
    <p>Submit the website’s sitemap in its verified search property. It lists published CMS pages and public blog articles.</p>
    <%= link_to "Open XML sitemap", sitemap, class: "sales-button secondary" %>
  </section>
<% end %>
<section class="sales-panel"><h2>Check the website you publish</h2><p>Page titles, search descriptions, heading structure, image descriptions, placeholder actions and links to published CMS pages. This reads native output without making network requests or running page scripts.</p><%= button_to 'Run native website audit', dashboard_website_audits_path(site_id: @site.id), params: {request_key: SecureRandom.uuid}, class: 'sales-button' %><p><small>Up to 50 published pages and 200 findings. Unsupported layouts and failed renders are unassessed. This does not test live HTTP delivery, external links, search rankings, app-store listings or conversion causality.</small></p></section>
<% if @audit %><section class="sales-coach"><span class="sales-eyebrow"><%= @audit.status.humanize %> / <%= @audit.rules_version %></span><h2>Audit #<%= @audit.id %></h2><p><%= @audit.summary['assessed_pages'] %> assessed of <%= @audit.summary['published_pages'] %> published pages · <%= @audit.summary['finding_count'] %> recorded findings · <%= @audit.created_at.to_fs(:long) %></p><p>High items identify broken native targets; other findings are review prompts. Dismissal records a decision, not a verified fix or a passing SEO score.</p></section>
<% @audit.page_results.each do |result| %><% if result['status'] == 'unassessed' %><p class="sales-errors"><strong><%= result['path'] %> · Unassessed:</strong> <%= result['reason'] %></p><% end %><% end %>
<% if @findings.empty? %><p class="sales-empty">No findings recorded within this run’s assessed scope. Check its coverage before interpreting this result.</p><% end %>
<% @findings.each do |finding| %><article class="sales-panel growth-audit-finding"><span class="sales-eyebrow"><%= finding.severity.upcase %> / <%= finding.status.humanize %> / <%= finding.evidence['page_path'] %></span><h2><%= finding.title %></h2><details class="growth-plan-evidence"><summary>Evidence and source</summary><pre><%= JSON.pretty_generate(finding.evidence.except('fingerprint')) %></pre><p><small>Page #<%= finding.page_id %> · <%= finding.rule %> · <%= finding.locator %></small></p></details>
<% if finding.resolution_note.present? %><p><%= finding.resolution_note %></p><% end %>
<% if finding.status == 'open' %><% if @can_write && finding.fix_target.present? %><%= form_with url: prepare_website_audit_fix_path(site_id: @site.id, finding_id: finding.id), class: 'sales-form' do %><label>Proposed <%= finding.fix_target['field'].humanize %><%= text_area_tag :value, nil, required: true, rows: 2, maxlength: 1000 %></label><p><small>This prepares a preview only. It does not publish the change.</small></p><%= submit_tag 'Preview supported CMS change', class: 'sales-button secondary' %><% end %><% else %><p>Review this source in <%= link_to 'Design & Content', dashboard_website_designs_path(site_id: @site.id) %>. Automatic editing is not supported for this finding or your current CMS permission.</p><% end %>
<%= form_with url: dismiss_website_audit_finding_path(site_id: @site.id, id: finding.id), method: :patch, class: 'sales-form growth-step-resolution' do %><%= hidden_field_tag :lock_version, finding.lock_version %><label>Why is no change needed?<%= text_area_tag :note, nil, required: true, maxlength: 1000, rows: 2 %></label><%= submit_tag 'Record review decision', class: 'sales-button secondary' %><% end %><% end %></article><% end %><% end %>
<section id="review-changes" class="sales-panel"><h2>Review changes and recovery</h2><p>Latest 20 previews. Existing CMS operators can apply or roll back a saved change. Stale source is rejected rather than overwriting later edits.</p>
<% @fixes.each do |fix| %><article class="growth-link"><h3>Change #<%= fix.id %> · <%= fix.status.humanize %></h3><p><%= fix.finding.title %> · page #<%= fix.finding.page_id %></p><div class="sales-two-col"><div><h4>Before</h4><pre><%= JSON.pretty_generate(fix.before_values.slice('exists', fix.finding.fix_target['field'])) %></pre></div><div><h4>After</h4><pre><%= JSON.pretty_generate(fix.after_values.slice('exists', fix.finding.fix_target['field'])) %></pre></div></div><p>Prepared by <%= fix.created_by.email_address %> · <%= fix.created_at.to_fs(:long) %></p><p><strong>Verification:</strong> <%= fix.verification['status'].presence || 'Not applied' %><% if fix.verification['audit_id'] %> · <%= link_to "Audit ##{fix.verification['audit_id']}", dashboard_website_audits_path(site_id: @site.id, audit_id: fix.verification['audit_id']) %><% end %></p>
<% if @can_write && fix.status.in?(%w[prepared applied]) %><%= form_with url: (fix.status == 'prepared' ? apply_website_audit_fix_path(site_id: @site.id, id: fix.id) : rollback_website_audit_fix_path(site_id: @site.id, id: fix.id)), class: 'sales-form' do %><%= hidden_field_tag :lock_version, fix.lock_version %><label><%= check_box_tag :confirmed, '1', false, required: true %> I reviewed this saved change and approve <%= fix.status == 'prepared' ? 'applying it to the published CMS source' : 'restoring its prior source' %>.</label><%= submit_tag(fix.status == 'prepared' ? 'Apply saved change & recheck' : 'Roll back saved change & recheck', class: 'sales-button') %><% end %><% end %><% unless fix.status == 'prepared' %><%= button_to 'Recheck current result', recheck_website_audit_fix_path(site_id: @site.id, id: fix.id), class: 'sales-button secondary' %><% end %></article><% end %></section>
<nav class="growth-plan-history" aria-label="Website audit history"><strong>Recent audits:</strong><% @runs.each do |audit| %><%= link_to "##{audit.id} · #{audit.status}", dashboard_website_audits_path(site_id: @site.id, audit_id: audit.id) %><% end %></nav>
</main>
