<%= render "dashboard/shared/business_workspace", active: "Design & Content" %>
<% content_for :page_title, "Design & Content" %>
<%= render "dashboard/settings_home/style" %>
<%= stylesheet_link_tag "/lightek/site-content.css?v=20261120" %>
<%= javascript_include_tag "/lightek/site-content.js?v=1",defer:true %>
<main class="lt-settings content-hub" data-tour-page="website"><div class="tl-page-heading" data-tour-step="website" data-tour-title="Design and content" data-tour-body="Choose the website you want to edit before changing its design or pages."><h1>Design & Content</h1></div>

<p class="intro">Choose a website, preview a design, then apply its appearance or add an editable starter page.</p>
<%= form_with url: dashboard_website_designs_path, method: :get, local: true, class: "tl-site-picker" do %>
  <div>
  <%= label_tag :site_id, "Website" %>
  <%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @site&.id), include_blank: "Choose a website", required: true %>
  </div>
  <%= submit_tag "Choose website",class:"content-button" %>
<% end %>
<% if @site %>
<nav class="content-actions" data-tour-step="website" data-tour-title="Edit your website" data-tour-body="Open Pages &amp; Sections for content or Design Studio to work on the layout." aria-label="Website editing"><%= link_to "Open Pages & Sections",dymond_dash.pages_path(site_id:@site.id),class:"content-button primary" %><%= link_to "Open Design Studio",dashboard_design_studio_index_path(site_id:@site.id),class:"content-button" %><%= link_to "Write & manage articles",dashboard_blog_index_path(site_id:@site.id),class:"content-button" %><%= link_to "Manage store",dashboard_commerce_path(site_id:@site.id),class:"content-button" %></nav>
<%= render "nevaeh_website" if @site.tenant == current_user || current_user.role == 'super_admin' %>
<% if current_user.role != "client" || @site.tenant == current_user %>
<section class="card">
  <h2>Portfolio & case studies</h2>
  <% portfolio_page = LightekDesign::AgencyPortfolio.index_page(site: @site, draft: true) %>
  <% if portfolio_page %>
    <p>Edit project pages in Pages & Sections. Published projects automatically appear in the portfolio.</p>
    <%= link_to "Preview portfolio", preview_dashboard_agency_portfolio_path(site_id: @site.id, slug: portfolio_page.slug), class: "content-button primary" %>
  <% else %>
    <p>Create a portfolio and three editable concept case studies as private drafts.</p>
    <%= button_to "Create portfolio drafts", dashboard_agency_portfolio_path(site_id: @site.id), method: :post, class: "content-button primary" %>
  <% end %>
</section>
<% end %>
<%= render "site_themes" %>
<p><%= link_to "Sign-in & account branding →", dashboard_authentication_branding_path(site_id: @site.id) %></p>
<p>Editing <strong><%= @site.name %></strong> · <%= @site.host %></p>
<details class="content-library"><summary data-tour-step="website" data-tour-title="Browse starter designs" data-tour-body="Preview a design before applying it or using it as the starting point for a page.">Browse page designs & starter layouts</summary>
<%= render "template_library", designs: LightekDesign::Catalog.selectable_designs(user: current_user, active: LightekDesign::Catalog.design_for(@site)) %>
</details>
<details class="tl-upload" <%= "open" if params[:import_id].present? %>><summary>Import your own HTML, CSS & JavaScript</summary><%= render "html_upload" %></details>
<details class="tl-commerce"><summary>Shop templates with live checkout</summary><%= render "industry_designs" %></details>
<%= render "template_branding" %>
<%= render "template_inquiries" %>
<% if LightekDesign::Catalog.active?(@site) %>
<section class="card" style="margin-top:24px"><h2>Typography for <%= @site.name %></h2>
<%= form_with url: fonts_dashboard_website_designs_path(site_id: @site.id), method: :patch, local: true do %>
  <% LightekDesign::WebsiteDesigns::FONT_KEYS.each do |key| %>
    <%= render "lightek_design/font_picker", template: @site.active_template, field: {name: key} %>
  <% end %>
  <%= submit_tag "Save website fonts" %>
<% end %></section>
<% end %>

<% end %></main>
