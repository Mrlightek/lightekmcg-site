<% content_for :page_title, "Website designs" %>
<%= render "dashboard/settings_home/style" %>
<main class="lt-settings"><div class="tl-page-heading"><h1>Website designs & fonts</h1></div>
<p><%= link_to "Open Design Studio →", dashboard_design_studio_index_path %></p>
<p class="intro">Choose a website, preview a design, then apply its appearance or add an editable starter page.</p>
<%= form_with url: dashboard_website_designs_path, method: :get, local: true, class: "tl-site-picker" do %>
  <div>
  <%= label_tag :site_id, "Website" %>
  <%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :name, @site&.id), include_blank: "Choose a website", required: true %>
  </div>
  <%= submit_tag "Choose website" %>
<% end %>
<% if @site %>
<p><%= link_to "Sign-in & account branding →", dashboard_authentication_branding_path(site_id: @site.id) %></p>
<p>Editing <strong><%= @site.name %></strong> · <%= @site.host %></p>
<%= render "template_library", designs: LightekDesign::Catalog.selectable_designs(user: current_user, active: LightekDesign::Catalog.design_for(@site)) %>
<details class="tl-upload"><summary>Import your own HTML & CSS</summary><%= render "html_upload" %></details>
<details class="tl-commerce"><summary>Shop templates with live checkout</summary><%= render "industry_designs" %></details>
<%= render "template_branding" %>
<%= render "template_inquiries" %>
<% if LightekDesign::Catalog.active?(@site) %>
<section class="card" style="margin-top:24px"><h2>Typography for <%= @site.name %></h2>
<%= form_with url: fonts_dashboard_website_designs_path(site_id: @site.id), method: :patch, local: true do %>
  <% LightekDesign::WebsiteDesigns::FONT_KEYS.each do |key| %>
    <%= render "lightek_design/font_picker", template: @site.active_template, field: {name: key} %>
  <% end %>
  <%= submit_tag "Save website fonts" %>
<% end %></section>
<% end %>
<% if current_user.role.to_s == "super_admin" || DymondSite::Site.count == 1 %>
  <p><%= link_to "Open Pages & Sections", dymond_dash.pages_path(site_id: @site.id) %></p>
<% end %>
<% end %></main>
