<p style="padding:12px 24px"><%= link_to "PWA Administration", dashboard_pwa_path(site_id: params[:site_id]) %></p>
<% content_for :page_title, "Website Settings" %>
<%= render "dashboard/settings_home/style" %>
<main class="lt-settings"><%= link_to "← Settings", dashboard_settings_home_path %>
<h1>Website Settings</h1><p class="intro">Change your website’s display name.</p>
<% if @sites.many? %>
<%= form_with url: dashboard_website_settings_path, method: :get do %>
<%= label_tag :site_id, "Website" %>
<%= select_tag :site_id, options_from_collection_for_select(@sites, :id, :host, @site&.id), prompt: "Choose a website" %>
<%= submit_tag "Open website settings" %>
<% end %>
<% end %>
<% if @site %>
<section class="card">
<h2><%= @site.host %></h2>
<% if @errors.present? %><div class="errors" role="alert"><%= @errors.join(". ") %></div><% end %>
<%= form_with scope: :website, url: dashboard_website_settings_path(site_id: @site.id), method: :patch do |f| %>
<%= f.label :name, "Website name" %>
<%= f.text_field :name, value: @site.name, required: true, autocomplete: "organization", aria: { describedby: "website-name-help" } %>
<small id="website-name-help">Used wherever your website displays its name. Matching hero labels update with it; custom hero labels keep their wording.</small>
<%= f.submit "Save website name" %>
<% end %>
<p><small>Website address: <%= @site.host %></small></p>
</section>
<% if current_user.role == "super_admin" %>
  <section class="card" aria-labelledby="website-workspace-management">
    <h2 id="website-workspace-management">Workspace management</h2>
    <% if LightekSettings::WebsiteIdentity.primary?(@site, request.host) %>
      <p>The primary website is protected.</p>
    <% else %>
      <% hidden = LightekSettings::WebsiteIdentity.overview_hidden?(@site) %>
      <p><%= hidden ? "This website is hidden from the super admin Overview." : "Hide this website from the super admin Overview while keeping it available in Website Settings." %></p>
      <%= button_to(hidden ? "Restore to Overview" : "Hide from Overview", dashboard_website_overview_path(site_id: @site.id),
        method: :patch, params: {visibility: hidden ? "visible" : "hidden"}) %>
      <% if (reason = LightekSettings::WebsiteIdentity.deletion_blocker(@site)) %>
        <p><%= reason %></p>
      <% else %>
        <details>
          <summary>Delete website</summary>
          <p>This permanently deletes the website and its website content. Enter <strong><%= @site.host %></strong> to confirm.</p>
          <%= form_with url: dashboard_website_settings_path(site_id: @site.id), method: :delete do %>
            <%= label_tag :confirmation, "Website hostname" %>
            <%= text_field_tag :confirmation, nil, required: true, autocomplete: "off" %>
            <%= submit_tag "Permanently delete website" %>
          <% end %>
        </details>
      <% end %>
    <% end %>
  </section>
<% end %>
<% elsif @sites.empty? %><p>No website is assigned to this account.</p>
<% else %><p>Choose a website above to edit its settings.</p><% end %>
</main>
