<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:page_title) ? yield(:page_title) + " — " : content_for?(:title) ? yield(:title) + " — " : "" %><%= agency_branding&.brand_name || dymond_app_name %></title>
  <%= csrf_meta_tags %>

  <%# Tabler icons — outline only %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.0.0/dist/tabler-icons.min.css">

  <%# Theme CSS variables from DB — overrides anything below %>
  

  <style>
    /* ── Base reset ─────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      /* Fallback values — overridden by theme CSS variables above */
      --dd-sidebar-bg:     #111318;
      --dd-topbar-bg:      #111318;
      --dd-accent:         #2563eb;
      --dd-accent-hover:   #1d4ed8;
      --dd-text-primary:   #F0EEE8;
      --dd-text-secondary: #9A9890;
      --dd-text-muted:     #4E4E5A;
      --dd-border:         rgba(255,255,255,0.07);
      --dd-card-bg:        #181B22;
      --dd-danger:         #CD4D3D;
      --dd-success:        #3DAE82;
      --dd-sidebar-w:      220px;
      --dd-topbar-h:       52px;
      --dd-radius:         9px;
    }

    body {
      background: var(--dd-page-bg, var(--dd-card-bg));
      color: var(--dd-text-primary);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
    }

    /* ── Layout shell ────────────────────────────────────────────────── */
    .dd-shell      { display: flex; min-height: 100vh; }
    .dd-sidebar    { width: var(--dd-sidebar-w); background: var(--dd-sidebar-bg);
                     border-right: 1px solid var(--dd-border); display: flex;
                     flex-direction: column; position: fixed; top: 0; left: 0;
                     height: 100vh; overflow-y: auto; z-index: 100; }
    .dd-body       { flex: 1; margin-left: var(--dd-sidebar-w);
                     display: flex; flex-direction: column; min-width: 0; }
    .dd-topbar     { min-height: var(--dd-topbar-h); height: auto; flex: 0 0 auto; gap: 12px; flex-wrap: wrap; background: var(--dd-topbar-bg);
                     border-bottom: 1px solid var(--dd-border);
                     display: flex; align-items: center; justify-content: space-between;
                     padding: 12px 20px; position: sticky; top: 0; z-index: 90; }
    .dd-content    { padding: 24px; flex: 1; }

    /* ── Sidebar brand ───────────────────────────────────────────────── */
    .dd-brand      { padding: 18px 18px 14px; border-bottom: 1px solid var(--dd-border); }
    .dd-brand-name { font-size: 17px; font-weight: 700; letter-spacing: 0.12em;
                     color: var(--dd-accent); display: block; text-decoration: none; }
    .dd-brand-sub  { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
                     color: var(--dd-text-muted); margin-top: 2px; }

    /* ── Sidebar user ────────────────────────────────────────────────── */
    .dd-user       { padding: 12px 14px; border-bottom: 1px solid var(--dd-border);
                     display: flex; align-items: center; gap: 9px; }
    .dd-avatar     { width: 30px; height: 30px; border-radius: 7px;
                     background: var(--dd-accent);
                     display: flex; align-items: center; justify-content: center;
                     font-size: 11px; font-weight: 700; color: #fff; flex-shrink: 0; }
    .dd-user-name  { font-size: 12px; font-weight: 500; color: var(--dd-text-primary);
                     white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dd-plan-badge { font-size: 9px; font-weight: 600; letter-spacing: 0.08em;
                     text-transform: uppercase; padding: 2px 6px; border-radius: 4px;
                     background: color-mix(in srgb, var(--dd-accent) 12%, transparent); color: var(--dd-accent);
                     border: 1px solid color-mix(in srgb, var(--dd-accent) 25%, transparent); display: inline-block;
                     margin-top: 2px; }

    /* ── Nav ─────────────────────────────────────────────────────────── */
      .dd-nav-group  { margin-bottom: 2px; }
      .dd-nav-group summary { cursor: pointer; list-style: none; display: flex;
                       align-items: center; justify-content: space-between; }
      .dd-nav-group summary::-webkit-details-marker { display: none; }
      .dd-nav-group summary::after { content: '›'; transform: rotate(90deg);
                       transition: transform 0.15s; color: var(--dd-text-muted); font-size: 11px; }
      .dd-nav-group[open] summary::after { transform: rotate(-90deg); }
    .dd-nav        { padding: 8px; flex: 1; }
    .dd-nav-label  { font-size: 9px; font-weight: 600; letter-spacing: 0.12em;
                     text-transform: uppercase; color: var(--dd-text-muted);
                     padding: 8px 8px 3px; }
    .dd-nav-item   { display: flex; align-items: center; gap: 8px; padding: 7px 8px;
                     border-radius: 6px; color: var(--dd-text-secondary);
                     text-decoration: none; transition: all 0.12s; font-size: 12px;
                     cursor: pointer; }
    .dd-nav-item:hover  { background: rgba(255,255,255,0.05); color: var(--dd-text-primary); }
    .dd-nav-item.active { background: color-mix(in srgb, var(--dd-accent) 12%, transparent); color: var(--dd-accent);
                          font-weight: 500; }
    .dd-nav-item i { font-size: 15px; flex-shrink: 0; }
    .dd-badge      { margin-left: auto; background: var(--dd-accent); color: #000;
                     font-size: 9px; font-weight: 700; padding: 1px 5px;
                     border-radius: 8px; min-width: 16px; text-align: center; }

    /* ── Topbar ──────────────────────────────────────────────────────── */
    .dd-breadcrumbs { display:flex;align-items:center;flex-wrap:wrap;gap:9px;list-style:none;font-size:12px;min-width:0; }
    .dd-breadcrumbs a { color:var(--dd-text-secondary);text-decoration:none; }
    .dd-breadcrumbs a:hover { color:var(--dd-accent);text-decoration:underline; }
    .dd-breadcrumbs li+li::before { content:"›";margin-right:9px;color:var(--dd-text-muted); }
    .dd-breadcrumbs [aria-current=page] { color:var(--dd-text-primary);overflow-wrap:anywhere; }
    .dd-topbar-title { font-size: 14px; font-weight: 600; }
    .dd-topbar-right { display: flex; align-items: center; gap: 8px; }
    .dd-topbar-btn   { display: flex; align-items: center; gap: 5px; padding: 6px 12px;
                       border-radius: 7px; font-size: 12px; font-weight: 500;
                       cursor: pointer; border: none; font-family: inherit;
                       transition: all 0.12s; text-decoration: none; }
    .dd-notif { position: relative; }
.dd-notif summary { list-style: none; }
.dd-notif summary::-webkit-details-marker { display: none; }
.dd-notif[open] summary { color: var(--dd-text-primary); }
.dd-notif-panel { position: absolute; right: 0; top: calc(100% + 8px); width: 300px;
                   background: var(--dd-sidebar-bg); border: 1px solid var(--dd-border);
                   border-radius: var(--dd-radius); box-shadow: 0 8px 24px rgba(0,0,0,0.3);
                   z-index: 200; padding: 6px; }
.dd-notif-item  { display: block; padding: 8px; border-radius: 6px; text-decoration: none;
                   color: var(--dd-text-primary); }
.dd-notif-item:hover { background: rgba(255,255,255,0.05); }
.dd-notif-title { font-size: 12px; font-weight: 600; }
.dd-notif-body  { font-size: 11px; color: var(--dd-text-secondary); margin-top: 2px; }
.dd-notif-empty { padding: 12px 8px; font-size: 12px; color: var(--dd-text-secondary); }
.dd-notif-mark-all, .dd-notif-viewall { display: block; width: 100%; text-align: center;
                   font-size: 11px; padding: 8px; border: none; background: none;
                   color: var(--dd-accent); cursor: pointer; text-decoration: none; }
.dd-btn-primary  { background: var(--dd-accent); color: #000; }
    .dd-btn-primary:hover { background: var(--dd-accent-hover); }
    .dd-btn-ghost    { background: rgba(255,255,255,0.05); color: var(--dd-text-secondary);
                       border: 1px solid var(--dd-border); }
    .dd-btn-ghost:hover { color: var(--dd-text-primary); }

    /* ── Cards ───────────────────────────────────────────────────────── */
    .dd-card       { background: var(--dd-sidebar-bg); border: 1px solid var(--dd-border);
                     border-radius: var(--dd-radius); padding: 16px; }
    .dd-card-title { font-size: 13px; font-weight: 600; margin-bottom: 12px; }

    /* ── Flash messages ──────────────────────────────────────────────── */
    .dd-flash      { padding: 10px 16px; border-radius: var(--dd-radius); margin-bottom: 16px;
                     font-size: 13px; display: flex; align-items: center; gap: 8px; }
    .dd-flash.notice { background: rgba(61,174,130,0.12); color: var(--dd-success);
                       border: 1px solid rgba(61,174,130,0.25); }
    .dd-flash.alert  { background: rgba(205,77,61,0.12); color: var(--dd-danger);
                       border: 1px solid rgba(205,77,61,0.25); }

    /* ── Responsive ──────────────────────────────────────────────────── */
    @media (max-width: 768px) {
      .dd-sidebar { transform: translateX(-100%); transition: transform 0.2s; }
      .dd-sidebar.open { transform: translateX(0); }
      .dd-body { margin-left: 0; }
    }
  </style>

  <%= dymond_theme_styles %>
  
  <%# Dashboard colors come from its admin theme; client website branding is separate. %>
  <%= yield :head %>
  <%= render "dymond_dash/shared/theme_forms" %>
  <link rel="stylesheet" href="/lightek/dashboard.css?v=20261113">
  <script src="/lightek/dashboard.js?v=20261113" defer></script>
</head>
<body class="dd-dashboard">
<div class="dd-shell">

  <%# Sidebar %>
  <%= render "dymond_dash/shared/sidebar" %>

  <button type="button" class="dd-nav-scrim" data-dashboard-menu-close aria-label="Close navigation" hidden></button>

  <%# Main body %>
  <div class="dd-body">

    <%# Topbar %>
    <div class="dd-topbar">
      <div class="dd-topbar-title" style="display:flex;align-items:center;gap:12px;min-width:0;flex-wrap:wrap">
        <button type="button" class="dd-nav-toggle" data-dashboard-menu aria-controls="dd-primary-navigation" aria-expanded="false" aria-label="Open navigation"><i class="ti ti-menu-2" aria-hidden="true"></i></button>
        <%= render 'dymond_dash/shared/breadcrumbs', page_label: (content_for?(:page_title) ? yield(:page_title) : controller.controller_name.humanize) %>
      </div>
      <div class="dd-topbar-right">
  <% unread = DymondDash::Notification.for_recipient(current_user).unread.recent %>
  <details class="dd-notif">
    <summary class="dd-topbar-btn dd-btn-ghost" aria-label="Notifications">
      <i class="ti ti-bell"></i>
      <% if unread.any? %><span class="dd-badge"><%= unread.count %></span><% end %>
    </summary>
    <div class="dd-notif-panel">
      <% if unread.any? %>
        <% unread.limit(8).each do |n| %>
          <%= link_to dymond_dash.read_notification_path(n), method: :patch, class: "dd-notif-item" do %>
            <div class="dd-notif-title"><%= n.title %></div>
            <% if n.body.present? %><div class="dd-notif-body"><%= n.body %></div><% end %>
          <% end %>
        <% end %>
        <%= button_to "Mark all read", dymond_dash.read_all_notifications_path, method: :patch, class: "dd-notif-mark-all" %>
      <% else %>
        <div class="dd-notif-empty">No new notifications.</div>
      <% end %>
      <%= link_to "View all", dymond_dash.notifications_path, class: "dd-notif-viewall" %>
    </div>
  </details>
  <details class="dd-notif" style="margin-right:2px;">
    <summary class="dd-topbar-btn dd-btn-ghost" aria-label="Settings">
      <i class="ti ti-settings"></i>
    </summary>
    <div class="dd-notif-panel" style="width:180px;">
      <%= link_to main_app.dashboard_settings_home_path, class: "dd-notif-item" do %>
        <i class="ti ti-settings"></i> Settings
      <% end %>
      <%= link_to main_app.identity_security_path, class: "dd-notif-item" do %>
        <i class="ti ti-shield-lock"></i> Sign-in security
      <% end %>
      <% if current_user.role == "super_admin" %>
      <%= link_to main_app.dashboard_appearance_colors_path, class: "dd-notif-item" do %>
        <i class="ti ti-palette"></i> Appearance
      <% end %>
      <% end %>

      <%= button_to main_app.sign_out_path,
            method: :delete,
            class: "dd-notif-item",
            form: { style: "margin:0" },
            style: "width:100%;border:0;background:none;text-align:left;font:inherit;cursor:pointer;" do %>
        <i class="ti ti-logout"></i> Sign out
      <% end %>
    </div>
  </details>
  <%= yield :topbar_actions %>
</div>
    </div>

    <%# Flash messages %>
    <% if notice.present? || alert.present? %>
      <div style="padding: 16px 20px 0;">
        <% if notice.present? %>
          <div class="dd-flash notice"><i class="ti ti-circle-check"></i> <%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="dd-flash alert"><i class="ti ti-alert-circle"></i> <%= alert %></div>
        <% end %>
      </div>
    <% end %>

    <%# Page content %>
    <div class="dd-content">
<%= yield %>
    </div>

  </div>
</div>
<script>
document.querySelectorAll('.dd-nav-group[data-nav-section]').forEach(function(details){
  var key = 'dd-nav-collapsed:' + details.dataset.navSection;
  if (localStorage.getItem(key) === '1') { details.removeAttribute('open'); }
  details.addEventListener('toggle', function(){
    localStorage.setItem(key, details.open ? '0' : '1');
  });
});
</script>
<%= render "shared/nevaeh_contextual_help" %>
</body>
</html>
