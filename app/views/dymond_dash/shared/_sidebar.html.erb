<aside id="dd-primary-navigation" class="dd-sidebar" aria-label="Main application navigation">
  <div class="dd-brand"><% if agency_branding&.logo_url.present? %><%= image_tag agency_branding.logo_url, alt: agency_branding.brand_name, style: "max-width:160px;max-height:50px" %><% end %><%= link_to(agency_branding&.brand_name || "LIGHTEK", dymond_dash.root_path, class: "dd-brand-name") %><div class="dd-brand-sub">Business operating system</div></div>
  <div class="dd-user"><div class="dd-avatar"><%= current_user.email_address.to_s.first.upcase %></div><div><div class="dd-user-name"><%= current_user.email_address %></div><small class="dd-brand-sub"><%= current_user.role.to_s.humanize %></small></div></div>
  <% if agency_branding&.support_email.present? %><div class="dd-user"><%= mail_to agency_branding.support_email, "Contact support", class: "dd-nav-item" %></div><% end %>
  <nav class="dd-nav" aria-label="Workspaces">
    <% previous_group = nil %>
    <% nevaeh_sidebar_entries.reject { |entry| entry['hidden'] }.each do |entry| %>
      <% if entry['group'] != previous_group %><div class="dd-nav-label"><%= entry['group'] %></div><% previous_group = entry['group'] %><% end %>
      <% active = request.path == entry['path'] || (entry['path'] != dymond_dash.root_path && request.path.start_with?("#{entry['path']}/")) %>
      <%= link_to entry['path'], class: "dd-nav-item#{' active' if active}", aria: {current: active ? 'page' : nil} do %><i class="ti <%= entry['icon'] %>"></i><%= entry['label'] %><% end %>
    <% end %>
    <% if current_user.employee? && can?(:read, Marlon::Ticket) %>
      <%= link_to main_app.employee_nevaeh_control_center_path(tab: 'navigation'), class: "dd-nav-item" do %><i class="ti ti-adjustments-horizontal"></i> Customize sidebar<% end %>
    <% end %>
  </nav>
</aside>
