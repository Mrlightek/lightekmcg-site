<%= stylesheet_link_tag "/lightek/site-content.css?v=1" %><section class="journal"><header><span class="content-eyebrow"><%= @site.name %> / JOURNAL</span><h1><%= section.data["heading"].presence || "Journal" %></h1><p><%= section.data["intro"] %></p></header><div class="journal-grid"><% LightekBlog::Entry.publicly_visible.where(site:@site).includes(:post).order(published_at: :desc).limit(6).each do |entry| %><article class="journal-card"><span class="content-eyebrow"><%= entry.category %></span><h2><%= link_to entry.post.title,"/blog/#{entry.slug}" %></h2><p><%= entry.excerpt.presence || strip_tags(entry.post.content).truncate(220) %></p><%= link_to "Read story →","/blog/#{entry.slug}",class:"content-button" %></article><% end %></div><p><%= link_to "Explore all stories →","/blog",class:"content-button" %></p></section>
