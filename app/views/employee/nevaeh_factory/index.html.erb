<% content_for :title, 'Nevaeh Digital Factory' %>
<% content_for :head do %><link rel="stylesheet" href="/lightek/nevaeh/control-center.css"><link rel="stylesheet" href="/lightek/nevaeh/factory.css"><script src="/lightek/nevaeh/factory.js" defer></script><% end %>
<section class="nc" data-factory data-help-scope="<%= @tab == 'training' ? 'training' : @tab == 'conversation' ? 'conversation' : 'factory' %>">
  <header class="nc-hero"><div><span class="nc-eyebrow">LIGHTEK OS / NEVAEH</span><h1>Build the ability.</h1><p>Digital Factory <%= nevaeh_help_button('factory') %></p><p class="nc-muted">Construct → verify → connect → execute. Teach → train → evaluate → converse.</p></div></header>
  <nav class="nc-tabs" aria-label="Factory workspaces"><% {'construction'=>'Construction factory', 'training'=>'Neural training', 'conversation'=>'Conversation'}.each do |key,label| %><%= link_to label, employee_nevaeh_factory_path(tab: key), class: @tab == key ? 'active' : nil %><% end %><%= link_to 'Software Library', employee_software_library_path %><%= link_to 'Control Center', employee_nevaeh_control_center_path %></nav>
  <% if @tab == 'construction' %>
    <div class="nc-heading"><div><h2>From specification to working service.</h2><p>Generate Ruby, test expected behavior, connect a capability and create its worker.</p></div><%= link_to '+ New construction', employee_nevaeh_factory_path, class: 'nc-button' %></div>
    <div class="nc-split"><aside class="nc-panel"><h3>Construction library</h3><% @constructions.each do |record| %><article class="nc-worker"><%= link_to record.name, employee_nevaeh_factory_path(construction_id: record.id) %><p><code><%= record.capability_key %></code></p><span class="nc-pill"><%= record.status %> <%= "· v#{record.active_release.version}" if record.active_release %></span></article><% end %><% if @constructions.empty? %><p>Start with the greeting construction on the right, or define your own transformation.</p><% end %></aside>
      <article class="nc-panel"><h3><%= @construction.persisted? ? "Edit #{@construction.name}" : 'Create a construction' %> <%= nevaeh_help_button('factory') %></h3>
        <%= form_with url: @construction.persisted? ? employee_nevaeh_factory_construction_path(@construction) : employee_nevaeh_factory_constructions_path, method: @construction.persisted? ? :patch : :post, data: {construction_form: true} do %>
          <input type="hidden" name="construction[lock_version]" value="<%= @construction.lock_version || 0 %>">
          <div class="nc-grid2"><label>Service name<input name="construction[name]" value="<%= @construction.name %>" required maxlength="160" placeholder="Welcome message"></label><label>Capability key suffix<input name="construction[key]" value="<%= @construction.key %>" required pattern="[a-z][a-z0-9_]{0,60}" placeholder="welcome_message"></label></div>
          <label>Purpose<textarea name="construction[description]" rows="2"><%= @construction.description %></textarea></label>
          <p class="nc-muted">Factory primitives: select fields, rename fields, normalize text, add defaults, compose text and require output fields. Add primitives in Ruby to extend the factory's construction vocabulary.</p>
          <div class="nc-heading"><h3>Implementation steps</h3><button type="button" class="nc-button secondary" data-factory-add-step>+ Add operation</button></div><div data-factory-steps></div>
          <details open><summary>Input contract and advanced definition</summary><label>Construction definition (JSON)<textarea name="definition_json" rows="15" data-factory-definition><%= JSON.pretty_generate(@construction.definition) %></textarea></label><button type="button" class="nc-button secondary" data-factory-import>Load JSON into step editor</button></details>
          <label>Sample tests with exact expected output (JSON)<textarea name="tests_json" rows="10"><%= JSON.pretty_generate(@construction.sample_tests) %></textarea></label>
          <p class="nc-muted">Expected output is your acceptance specification. A release cannot activate when its samples fail.</p><p role="alert" data-factory-error class="nc-error" hidden></p><button class="nc-button">Save construction</button>
        <% end %>
        <% if @construction.persisted? %><div class="nc-links"><%= button_to 'Build Ruby implementation & verify', employee_nevaeh_factory_build_construction_path(@construction), class: 'nc-button' %><%= button_to 'Pause construction', employee_nevaeh_factory_pause_construction_path(@construction), class: 'nc-button secondary' if @construction.status == 'active' %></div>
          <% @construction.releases.order(version: :desc).limit(10).each do |release| %><section class="nc-step"><div class="nc-heading"><h3>Release v<%= release.version %></h3><span class="nc-pill"><%= release.status %></span></div><p><code><%= @construction.capability_key %></code> → FactoryWorker → generated service → generated verifier</p><details><summary>Generated Ruby and test evidence</summary><% release.artifacts.each do |file, source| %><h4><%= file %></h4><pre><%= source %></pre><% end %><h4>Verification</h4><pre><%= JSON.pretty_generate(release.verification) %></pre></details><div class="nc-links"><%= link_to 'Download source package', employee_nevaeh_factory_release_artifacts_path(release), class: 'nc-button secondary' %><%= button_to 'Activate capability connection', employee_nevaeh_factory_activate_release_path(release), class: 'nc-button' if %w[verified active].include?(release.status) %></div>
            <% if release.status == 'active' && @construction.status == 'active' %><%= form_with url: employee_nevaeh_factory_release_worker_path(release) do %><h4>Create this service's worker</h4><label>Worker name<input name="worker_name" value="<%= @construction.name %>" required maxlength="160"></label><label>Run inputs (JSON)<textarea name="inputs_json" rows="4"><%= JSON.pretty_generate(release.sample_tests.first.fetch('inputs')) %></textarea></label><label>Repeat every minutes (empty = manual)<input name="interval_minutes" type="number" min="5" max="525600"></label><label class="nc-check"><input type="checkbox" name="run_now" value="1"> Run once after saving</label><button class="nc-button">Create worker</button><% end %><% end %>
          </section><% end %>
        <% end %>
      </article>
    </div>
  <% elsif @tab == 'training' %>
    <div class="nc-heading"><div><h2>Teach, then train the weights.</h2><p>Native neural language models with reviewed corpora, measured loss and versioned checkpoints.</p></div><%= nevaeh_help_button('training') %></div>
    <div class="nc-grid2"><article class="nc-panel"><h3>Generate a dataset</h3><%= form_with url: employee_nevaeh_factory_generate_dataset_path do %><label>Dataset name<input name="name" maxlength="160" placeholder="Studio conversations"></label><label>Fictional scenario topic<input name="topic" value="Studio" maxlength="100"></label><label>Example count<input type="number" name="count" value="40" min="10" max="200"></label><label>Or use an internal document<select name="document_id"><option value="">Generate coherent synthetic conversations</option><%= options_for_select(@documents.map { |doc| [doc[:path], doc[:id]] }) %></select></label><button class="nc-button">Generate for review</button><% end %><p class="nc-muted">Faker supplies names and scenario variation. Dialogue structures remain coherent. Document imports retain source identity.</p></article>
      <article class="nc-panel"><h3>Review & approve</h3><div class="nc-links"><% @datasets.each do |dataset| %><%= link_to "#{dataset.name} · #{dataset.status}", employee_nevaeh_factory_path(tab: 'training', dataset_id: dataset.id, language_model_id: @language_model.id) %><% end %><%= link_to '+ Manual dataset', employee_nevaeh_factory_path(tab: 'training') %></div><%= form_with url: @dataset.persisted? ? employee_nevaeh_factory_dataset_path(@dataset) : employee_nevaeh_factory_datasets_path, method: @dataset.persisted? ? :patch : :post do %><input type="hidden" name="dataset[lock_version]" value="<%= @dataset.lock_version || 0 %>"><label>Name<input name="dataset[name]" value="<%= @dataset.name %>" required maxlength="160"></label><label>Prompt / response pairs (JSON)<textarea name="examples_json" rows="12"><%= JSON.pretty_generate(@dataset.examples) %></textarea></label><button class="nc-button secondary">Save reviewed text</button><% end %><% if @dataset.persisted? %><details><summary>Provenance</summary><pre><%= JSON.pretty_generate(@dataset.provenance) %></pre></details><%= button_to 'Approve dataset for training', employee_nevaeh_factory_approve_dataset_path(@dataset), class: 'nc-button' %><% end %><p class="nc-muted">Editing examples returns the dataset to Draft. Approval and training are explicit actions.</p></article></div>
    <div class="nc-grid2"><article class="nc-panel"><h3>Language model</h3><div class="nc-links"><% @models.each do |model| %><%= link_to model.name, employee_nevaeh_factory_path(tab: 'training', language_model_id: model.id, dataset_id: @dataset.id) %><% end %><%= link_to '+ New model', employee_nevaeh_factory_path(tab: 'training', dataset_id: @dataset.id) %></div>
      <%= form_with url: @language_model.persisted? ? employee_nevaeh_factory_language_model_path(@language_model) : employee_nevaeh_factory_language_models_path, method: @language_model.persisted? ? :patch : :post do %><input type="hidden" name="language_model[lock_version]" value="<%= @language_model.lock_version || 0 %>"><label>Name<input name="language_model[name]" value="<%= @language_model.name %>" required maxlength="160" placeholder="Nevaeh Conversation"></label><label>Purpose<textarea name="language_model[description]" rows="2"><%= @language_model.description %></textarea></label><div class="nc-grid2"><label>Hidden units<select name="language_model[hidden_size]"><%= options_for_select([8,16,24,32], @language_model.hidden_size) %></select></label><label>Vocabulary limit<input type="number" name="language_model[vocabulary_limit]" min="32" max="512" value="<%= @language_model.vocabulary_limit %>"></label></div><label>Availability<select name="language_model[visibility]"><%= options_for_select([['Internal administrators', 'internal'], ['Available to Studio users', 'shared']], @language_model.visibility) %></select></label><p class="nc-muted">Shared models may reproduce material from their training examples. Use a corpus intended for that audience.</p><label class="nc-check"><input type="hidden" name="language_model[enabled]" value="0"><input type="checkbox" name="language_model[enabled]" value="1" <%= 'checked' if @language_model.enabled %>> Enabled</label><button class="nc-button">Save model</button><% end %>
      <% if @language_model.persisted? %><hr class="nf-rule"><%= form_with url: employee_nevaeh_factory_train_model_path(@language_model) do %><input type="hidden" name="request_key" value="<%= SecureRandom.uuid %>"><label>Approved dataset<select name="dataset_id" required><option value="">Choose a reviewed corpus</option><%= options_for_select(@datasets.select { |d| d.status == 'approved' }.map { |d| [d.name,d.id] }, @dataset.id) %></select></label><label>Training epochs<input type="number" name="epochs" min="1" max="50" value="10"></label><button class="nc-button">Queue neural training</button><% end %><% end %>
    </article><article class="nc-panel"><h3>Training & checkpoints</h3><p class="nc-muted">One training worker runs per instance. Training reports its actual epochs and loss; the run budget is 90 seconds plus evaluation. Refresh to inspect progress.</p><%= link_to 'Refresh progress', employee_nevaeh_factory_path(tab: 'training', language_model_id: @language_model.id, dataset_id: @dataset.id), class: 'nc-button secondary' %>
      <% @training_runs.each do |run| %><section class="nc-step"><h4>#<%= run.id %> · <%= run.nevaeh_language_model.name %></h4><span class="nc-pill"><%= run.status %></span><p><%= run.nevaeh_training_dataset.name %></p><% if run.error %><p class="nc-error"><%= run.error %></p><% end %><dl class="nf-metrics"><dt>Epochs completed</dt><dd><%= run.metrics['epochs_completed'] || 0 %> / <%= run.epochs %></dd><dt>Initial loss</dt><dd><%= run.metrics['initial_loss']&.round(4) %></dd><dt>Training loss</dt><dd><%= run.metrics['training_loss']&.round(4) %></dd><dt>Held-out loss</dt><dd><%= run.metrics['validation_loss']&.round(4) %></dd></dl><%= nevaeh_loss_plot(run.metrics['loss_history']) %><details><summary>Training evidence</summary><pre><%= JSON.pretty_generate(run.metrics) %></pre></details>
        <% if run.status.in?(%w[queued running]) %><%= button_to 'Cancel training', employee_nevaeh_factory_cancel_training_path(run), class: 'nc-button secondary' %><% end %>
        <% if run.checkpoint %><p>Checkpoint #<%= run.checkpoint.id %> · <%= run.checkpoint.status %></p><% if run.checkpoint.status.in?(%w[verified active]) %><%= button_to 'Activate these weights', employee_nevaeh_factory_activate_checkpoint_path(run.checkpoint), class: 'nc-button' %><% else %><p class="nc-muted">This candidate did not pass loss acceptance. Revise the corpus or training configuration and train again.</p><% end %><% end %>
      </section><% end %>
    </article></div>
  <% else %>
    <div class="nc-heading"><div><h2>Talk with the model you built.</h2><p>Replies come from your active neural checkpoint and recent conversation context.</p></div><%= nevaeh_help_button('conversation') %></div>
    <div class="nc-split"><aside class="nc-panel"><h3>Conversations</h3><%= form_with url: employee_nevaeh_factory_conversations_path do %><label>Model<select name="language_model_id" required><option value="">Choose an active model</option><%= options_for_select(@models.select { |m| m.enabled? && m.active_checkpoint_id }.map { |m| [m.name,m.id] }) %></select></label><label>Conversation title<input name="title" maxlength="160" placeholder="A new conversation"></label><button class="nc-button">Start conversation</button><% end %><% @conversations.each do |conversation| %><p><%= link_to conversation.title, employee_nevaeh_factory_path(tab: 'conversation', conversation_id: conversation.id) %></p><% end %></aside>
      <article class="nc-panel nf-conversation" aria-label="Conversation"><% if @conversation %><h3><%= @conversation.title %></h3><p class="nc-muted"><%= @conversation.nevaeh_language_model.name %> · native neural generation</p><div role="log"><% @conversation.turns.order(:id).last(50).each do |turn| %><section class="nf-turn user"><span>You</span><p><%= turn.prompt %></p></section><section class="nf-turn assistant"><span>Nevaeh</span><p><%= turn.response %></p><small>Checkpoint #<%= turn.checkpoint_id %> · <%= turn.evidence['tokens'] %> tokens</small></section><% end %></div><%= form_with url: employee_nevaeh_factory_reply_path(@conversation) do %><input type="hidden" name="request_key" value="<%= SecureRandom.uuid %>"><label>Your message<textarea name="prompt" rows="4" required maxlength="4000" placeholder="Talk to Nevaeh…"></textarea></label><button class="nc-button">Send message</button><% end %><p class="nc-muted">This small model is trained on your examples. Its replies are drafts and may be incomplete or incorrect. Chat text does not execute capabilities; use constructed workers for actions.</p><% else %><h3>Start with a trained checkpoint.</h3><p>Create a corpus, approve it, train a model and activate a passing checkpoint. Then select that model to begin a conversation.</p><% end %></article>
    </div>
  <% end %>
</section>
