<% content_for :title, 'Software Library' %>
<% content_for :head do %><link rel="stylesheet" href="/lightek/nevaeh/control-center.css"><link rel="stylesheet" href="/lightek/nevaeh/factory.css"><% end %>
<section class="nc sl" data-help-scope="library">
  <header class="nc-hero"><div><span class="nc-eyebrow">LIGHTEK OS / INTERNAL KNOWLEDGE</span><h1>The software, explained.</h1><p>Software Library <%= nevaeh_help_button('library') %></p><p class="nc-muted">Documentation from your installed version. Search it here, beside the work.</p></div></header>
  <nav class="nc-links"><%= link_to 'Nevaeh Control Center', employee_nevaeh_control_center_path %><%= link_to 'Digital Factory', employee_nevaeh_factory_path %></nav>
  <%= form_with url: employee_software_library_path, method: :get, class: 'nc-panel' do %><div class="nc-grid2"><label>Search documentation<input name="q" value="<%= params[:q] %>" placeholder="Capabilities, deployment, mail, Blender…"></label><label>Collection<select name="section"><option value="">All collections</option><%= options_for_select(@sections, params[:section]) %></select></label></div><button class="nc-button">Search library</button><span class="nc-muted"><%= @documents.size %> documents found</span><% end %>
  <div class="sl-layout"><aside class="nc-panel sl-results" aria-label="Document results"><% @documents.each do |doc| %><%= link_to employee_software_library_path(id: doc[:id], q: params[:q], section: params[:section]), class: "sl-result #{'selected' if @document&.dig(:id) == doc[:id]}" do %><strong><%= doc[:title] %></strong><small><%= doc[:path] %></small><% end %><% end %><% if @documents.empty? %><p>No matching documents. Try a shorter search or another collection.</p><% end %></aside>
    <article class="nc-panel sl-document" aria-label="Document reader"><% if @document %><span class="nc-eyebrow"><%= @document[:section] %></span><p><code><%= @document[:path] %></code></p><div class="sl-markdown"><%= nevaeh_document_html(@document[:body]) %></div><details><summary>Document identity</summary><p>Source SHA-256: <code><%= @document[:sha256] %></code></p><p>Installed file modified: <%= @document[:modified_at].utc.strftime('%Y-%m-%d %H:%M UTC') %></p></details><% else %><h2>Choose a document.</h2><p>Architecture, tutorials, deployment instructions and engineering contracts are collected from the installed source. Changes to those documents appear here with the software update.</p><p class="nc-muted">Access is restricted to application administrators. Source text is escaped before rendering.</p><% end %></article>
  </div>
</section>
