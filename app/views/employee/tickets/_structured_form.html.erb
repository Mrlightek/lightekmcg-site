    <% structured = @structured_values || {} %>
    <fieldset data-controller="structured-ticket" style="border:1px solid var(--dd-border);border-radius:12px;padding:18px">
      <legend>Nevaeh · Supported requests</legend>
      <p>Choose procedures Nevaeh has learned in this instance’s Knowledge Base. Each procedure defines its inputs and acceptance checks.</p>
      <%= hidden_field_tag 'structured_ticket[enabled]', '1' %>
      <% if NevaehIntelligences::KnowledgeProcedures.available.empty? %>
        <p role="alert">No request procedures are available. An operator must add a supported procedure to this instance’s Knowledge Base before work can be requested.</p>
      <% end %>
      <% if can?(:execute_nevaeh, Marlon::Ticket) %>
      <label style="display:block;margin:12px 0"><%= check_box_tag 'structured_ticket[automatic]', '1', structured['automatic'] == '1' %> Authorize Nevaeh to run these saved sections automatically</label>
      <% end %>
      <p style="font-size:12px">Without automatic authorization, the ticket waits for your Execute Work Order action. Pages stay drafts; generated code is tested and committed on the engineering branch.</p>
      <div data-structured-ticket-target="list">
        <% rows = structured.fetch('sections', {}).presence || {'1' => {'id' => 'page', 'action' => 'site.page.create'}} %>
        <% rows.each do |index, values| %><%= render 'structured_step', index: index, values: values %><% end %>
      </div>
      <template data-structured-ticket-target="template"><%= render 'structured_step', index: 'NEW_STEP', values: {} %></template>
      <button type="button" data-action="structured-ticket#add" class="dd-topbar-btn">+ Add action section</button>
      <p style="font-size:12px">For example, name a page section <code>page</code>, then set the next section's page ID to <code>@page.page_id</code>. Dependencies and acceptance checks are generated from these typed actions.</p>
    </fieldset>
