<% values ||= {} %>
<% procedures = NevaehIntelligences::KnowledgeProcedures.available %>
<% selected = values['action'] || procedures.keys.first %>
<section data-step style="padding:16px;border:1px solid var(--dd-border);border-radius:10px;margin:12px 0">
  <div style="display:flex;gap:12px;align-items:center">
    <label>Section ID <%= text_field_tag "structured_ticket[sections][#{index}][id]", values['id'] || "step_#{index}", class: 'fg-input', required: false %></label>
    <button type="button" data-action="structured-ticket#remove" class="dd-topbar-btn">Remove section</button>
  </div>
  <label>Action
    <%= select_tag "structured_ticket[sections][#{index}][action]", options_for_select(procedures.map { |key, definition| [definition['label'], key] }, selected), class: 'fg-input', data: { action_select: true, action: 'change->structured-ticket#change' } %>
  </label>
  <% procedures.each do |key, definition| %>
    <div data-action-fields="<%= key %>" <%= 'hidden' unless key == selected %>>
      <% binding = values['action'] == key && values['procedure'] ? values['procedure'] : definition.fetch('procedure') %>
      <%= hidden_field_tag "structured_ticket[sections][#{index}][procedure][article_id]", binding.fetch('article_id'), disabled: key != selected %>
      <%= hidden_field_tag "structured_ticket[sections][#{index}][procedure][sha256]", binding.fetch('sha256'), disabled: key != selected %>
      <p>KB procedure #<%= binding.fetch('article_id') %> · <%= link_to 'Knowledge Base', '/kb' %></p>
      <p>Backend worker: <code><%= definition.fetch('worker') %></code></p>
      <ul><% definition.fetch('acceptance_criteria').each do |check| %><li><%= check %></li><% end %></ul>
      <% definition['fields'].each do |field| %>
        <% value = values.fetch('inputs', {}).fetch(field, definition.fetch('defaults', {})[field]) %>
        <div style="display:block;margin:10px 0"><%= field == "data" ? "Section content" : label_tag("structured_ticket[sections][#{index}][inputs][#{field}]", definition.fetch('inputs').fetch(field).fetch('label')) %>
          <% if field == 'site_id' %>
            <%= select_tag "structured_ticket[sections][#{index}][inputs][#{field}]", options_for_select(Array(@structured_sites).map { |site| [site.name, site.id] }, value), prompt: 'Choose a website', class: 'fg-input', disabled: key != selected %>
          <% elsif field == 'kind' %>
            <%= select_tag "structured_ticket[sections][#{index}][inputs][#{field}]", options_for_select(LightekDesign::Catalog.section_definitions.map { |definition| [definition['kind'].humanize, definition['kind']] }.uniq, value), prompt: 'Choose a section type', class: 'fg-input', disabled: key != selected, data: { section_kind_select: true, action: 'change->structured-ticket#change' } %>
          <% elsif definition.fetch('inputs').fetch(field)['options'] %>
            <%= select_tag "structured_ticket[sections][#{index}][inputs][#{field}]", options_for_select(definition.fetch('inputs').fetch(field).fetch('options'), value), class: 'fg-input', disabled: key != selected %>
          <% elsif field == 'data' && definition.fetch('inputs').fetch(field)['properties'] %>
            <% definition.fetch('inputs').fetch(field).fetch('properties').each do |name, setting| %>
              <label><%= setting.fetch('label') %>
                <%= number_field_tag "structured_ticket[sections][#{index}][inputs][data][#{name}]", value.to_h[name], min: setting['minimum'], max: setting['maximum'], step: 'any', class: 'fg-input', disabled: key != selected %>
              </label>
            <% end %>
          <% elsif field == 'data' %>
            <% LightekDesign::Catalog.section_definitions.uniq { |entry| entry['kind'] }.each do |definition| %>
              <% active_kind = values.fetch('inputs', {})['kind'] == definition['kind'] %>
              <div data-section-kind="<%= definition['kind'] %>" <%= 'hidden' unless active_kind %>>
                <% definition.fetch('fields').each do |content_field| %>
                  <% name = content_field.fetch('name'); content = value.is_a?(Hash) ? value[name] : nil %>
                  <% default = definition.fetch('data', {})[name].to_s; default = '' if default.bytesize > 1000 %>
                  <label style="display:block;margin:8px 0"><%= content_field.fetch('label') %>
                    <%= text_area_tag "structured_ticket[sections][#{index}][inputs][data][#{name}]", content || default, class: 'fg-input', rows: content_field['type'] == 'text' ? 3 : 1, disabled: key != selected || !active_kind %>
                  </label>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <%= text_field_tag "structured_ticket[sections][#{index}][inputs][#{field}]", value, class: 'fg-input', disabled: key != selected, placeholder: field == 'page_id' ? '@page.page_id or an existing page ID' : nil %>
          <% end %>
        </div>
      <% end %>
      <p style="font-size:12px">Verified outputs: <code><%= definition['outputs'].join(', ') %></code></p>
    </div>
  <% end %>
  <label>Depends on section IDs (comma separated)
    <%= text_field_tag "structured_ticket[sections][#{index}][depends_on]", Array(values['depends_on']).join(', '), class: 'fg-input' %>
  </label>
</section>
