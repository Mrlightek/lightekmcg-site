<% content_for :page_title, "New Ticket" %>
<%= form_with model: @ticket, url: employee_tickets_path do |f| %>
  <div class="dd-card" style="display:flex; flex-direction:column; gap:12px; max-width:600px;">
    <label>Category
      <%= f.select :category, Marlon::TicketCategories.ids.map { |id| [Marlon::TicketCategories.label_for(id), id] }, {}, class: "fg-input" %>
    </label>
    <label>Title <%= f.text_field :title, class: "fg-input" %></label>
    <label>Description <%= f.text_area :description, class: "fg-input" %></label>
    <label>Priority
      <%= f.select :priority, Marlon::Ticket::PRIORITIES.map { |p| [p.humanize, p] }, {}, class: "fg-input" %>
    </label>
    <label>Urgency (1-10) <%= f.number_field :urgency, min: 1, max: 10, class: "fg-input" %></label>
    <label>Organization <%= f.text_field :organization_name, class: "fg-input" %></label>
    <% if @ticket.errors.any? %>
      <div role="alert" class="dd-card" style="color:#ef4444;">
        <%= @ticket.errors.full_messages.join(", ") %>
      </div>
    <% end %>
    <% wo = @work_order_values || {} %>
    <fieldset style="border:1px solid currentColor; border-radius:8px; padding:14px; display:flex; flex-direction:column; gap:10px;">
      <legend>Nevaeh Work Order (optional)</legend>
      <label><%= check_box_tag 'work_order[enabled]', '1', wo['enabled'] == '1' %> Assign structured instructions to Nevaeh</label>
      <p style="margin:0; opacity:.8;">Creating the ticket does not automatically execute it. Gatekeeper authorization and the Work Order dispatch policy still apply.</p>
      <label>Work type
        <%= select_tag 'work_order[work_type]', options_for_select(NevaehIntelligences::WorkOrder::TYPES.map { |t| [t.upcase, t] }, wo['work_type'] || 'create'), class: 'fg-input' %>
      </label>
      <label>Capability / intent key
        <%= text_field_tag 'work_order[intent_key]', wo['intent_key'] || 'studio.project.create', class: 'fg-input' %>
      </label>
      <label>Objective
        <%= text_area_tag 'work_order[objective]', wo['objective'], class: 'fg-input', rows: 3 %>
      </label>
      <label>Inputs (JSON object)
        <%= text_area_tag 'work_order[inputs_json]', wo['inputs_json'] || '{"name":"New Studio Project","intent_key":"production","start_mode_key":"blank"}', class: 'fg-input', rows: 4 %>
      </label>
      <label>Acceptance criteria (one per line)
        <%= text_area_tag 'work_order[acceptance_criteria]', wo['acceptance_criteria'] || 'Project, production, and scene exist', class: 'fg-input', rows: 3 %>
      </label>
      <label>Target environment
        <%= select_tag 'work_order[environment]', options_for_select(%w[development test staging production], wo['environment'] || 'development'), class: 'fg-input' %>
      </label>
      <label>Execution approval
        <%= select_tag 'work_order[approval]', options_for_select([['Gatekeeper review', 'gatekeeper'], ['Explicitly approved', 'approved']], wo['approval'] || 'gatekeeper'), class: 'fg-input' %>
      </label>
    </fieldset>
    <%= f.submit "Create Ticket", class: "dd-topbar-btn dd-btn-primary" %>
  </div>
<% end %>
