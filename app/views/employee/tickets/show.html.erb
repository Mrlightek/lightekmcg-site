<% content_for :page_title, "#{@ticket.number} — #{@ticket.title}" %>
<% content_for :topbar_actions do %>
  <% if @ticket.status != "resolved" %>
    <%= button_to "Mark Resolved", resolve_employee_ticket_path(@ticket), method: :patch, class: "dd-topbar-btn dd-btn-primary" %>
  <% end %>
  <%= link_to "All Tickets", employee_tickets_path, class: "dd-topbar-btn dd-btn-ghost" %>
<% end %>

<div class="dd-card" style="margin-bottom:16px;">
  <div class="dd-card-title">Overview</div>
  <p style="font-size:13px;"><%= @ticket.category_meta&.dig(:icon) %> <%= Marlon::TicketCategories.label_for(@ticket.category) %> · Priority: <%= @ticket.priority.upcase %> · Urgency: <%= @ticket.urgency %>/10</p>
  <p style="font-size:13px;">Status: <%= @ticket.status.humanize %> · Assigned: <%= @ticket.assigned_team %> (<%= @ticket.assigned_rep %>)</p>
  <p style="font-size:13px; color:var(--dd-text-secondary);"><%= @ticket.description %></p>
  <% if @ticket.related_type == "ItServiceRequest" && ItRemoteSupportSession.available? %>
    <% work = @ticket.related %>
    <% if work&.technician_id == current_user.id && work.status == "in_progress" && work.delivery_mode == "remote" %>
      <%= button_to "Request screen sharing", dashboard_remote_support_sessions_path,
        params: { request_id: work.id }, class: "dd-topbar-btn dd-btn-primary" %>
    <% end %>
  <% end %>
  <% if @ticket.related %>
    <p style="font-size:13px;">Related: <%= @ticket.related_type %> ##<%= @ticket.related_id %></p>
  <% end %>
</div>

<%= render "nevaeh_execution", ticket: @ticket %>

<% customer_state = @ticket.extra_fields.to_h["customer_service"] %>
<% if customer_state && customer_state["topic"] == "refund_request" %>
  <section class="dd-card">
    <div class="dd-card-title">Refund request</div>
    <% if (approval = customer_state["refund"]) %>
      <p><%= approval.fetch("phase").humanize %> · <%= approval.fetch("amount_cents") %> cents</p>
    <% elsif @ticket.status != "resolved" && current_user.admin? %>
      <%= form_with url: approve_refund_employee_ticket_path(@ticket) do |form| %>
        <label>Approved amount in cents <%= form.number_field :amount_cents, min: 1, step: 1, required: true %></label>
        <%= form.submit "Approve refund", class: "dd-topbar-btn dd-btn-primary",
          data: {turbo_confirm: "Approve this refund to the original payment method?"} %>
      <% end %>
    <% end %>
  </section>
<% end %>


<div class="dd-card" style="margin-bottom:16px;">
  <div class="dd-card-title">Timeline</div>
  <% @events.each do |e| %>
    <div style="padding:8px 0; border-bottom:1px solid var(--dd-border); font-size:13px;">
      <strong><%= e.action %></strong> · <%= e.created_at.strftime("%b %-d, %l:%M %p") %>
      <% if e.detail.present? %><div style="color:var(--dd-text-secondary); margin-top:2px;"><%= e.detail %></div><% end %>
    </div>
  <% end %>
</div>

<div class="dd-card">
  <div class="dd-card-title">Reply</div>
  <%= form_with url: reply_employee_ticket_path(@ticket), method: :patch do %>
    <%= text_area_tag(NevaehCustomerService::Cases.customer_case?(@ticket) ? :support_reply : :detail,
      nil, rows: 3, class: "fg-input", placeholder: "Add a reply to this ticket's timeline...", style: "width:100%;") %>
    <div style="margin-top:8px;">
      <% if NevaehCustomerService::Cases.customer_case?(@ticket) %>
        <label><%= check_box_tag :customer_visible, "1" %> Show this reply to the customer</label>
      <% end %>
      <%= submit_tag "Send Reply", class: "dd-topbar-btn dd-btn-primary" %>
    </div>
  <% end %>
</div>
