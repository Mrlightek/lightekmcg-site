<div id="<%= dom_id episode %>">
  <p>
    <strong>Title:</strong>
    <%= episode.title %>
  </p>

  <p>
    <strong>Subtitle:</strong>
    <%= episode.subtitle %>
  </p>

  <p>
    <strong>Url:</strong>
    <%= episode.url %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= episode.description %>
  </p>

  <p>
    <strong>Show title:</strong>
    <%= episode.show_title %>
  </p>

  <p>
    <strong>Show description:</strong>
    <%= episode.show_description %>
  </p>

</div>
