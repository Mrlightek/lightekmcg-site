<main class="auth-shell"><section class="auth-panel"><div class="auth-card"><h1>Verify your sign-in</h1><p>Enter a six-digit authenticator code or an unused recovery code.</p><% if flash[:alert] %><p role="alert"><%= flash[:alert] %></p><% end %><%= form_with url: identity_challenge_path, class: 'auth-form' do |f| %><%= f.label :otp, 'Verification code' %><%= f.text_field :otp, required: true, autocomplete: 'one-time-code', autofocus: true %><%= f.submit 'Verify & continue' %><% end %><%= link_to 'Start a new sign-in', new_session_path %></div></section></main>
