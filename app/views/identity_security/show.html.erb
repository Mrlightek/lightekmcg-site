<% content_for :page_title, 'Sign-in security' %><%= stylesheet_link_tag '/lightek/people-workspace.css' %><main class="lp-workspace"><header class="lp-heading"><div><span class="lp-eyebrow">ACCOUNT / SECURITY</span><h1>Sign-in security</h1><p>Protect your account with an authenticator and organization sign-in.</p></div></header><section class="lp-card"><h2>Authenticator</h2><% if @required %><p>Your staff role or an employer policy requires MFA. Access remains restricted until enrollment is verified.</p><% end %><p><%= @enabled ? 'Two-step verification is enabled. Recovery codes can each be used once.' : 'Set up an authenticator before accessing accounting records or changing directory permissions.' %></p><% unless @enabled && @required %><%= form_with url: (@enabled ? disable_identity_security_path : enroll_identity_security_path), class: 'lp-form', data: {turbo: false} do |f| %><label>Current password<%= f.password_field :password, required: true, autocomplete: 'current-password' %></label><% if @enabled %><label>Authenticator or recovery code<%= f.text_field :otp, required: true, autocomplete: 'one-time-code' %></label><% end %><%= f.submit(@enabled ? 'Disable authenticator' : 'Set up authenticator', class: 'lp-button') %><% end %><% end %></section><section class="lp-card"><h2>Link organization sign-in</h2><p>Sign in to your organization provider to link its verified identity to this account. A matching email address alone never links accounts.</p><%= form_with url: identity_sso_path, class: 'lp-form', data: {turbo: false} do |f| %><%= hidden_field_tag :link, '1' %><label>Organization code<%= f.text_field :organization, required: true %></label><label>Current Lightek password<%= f.password_field :password, required: true, autocomplete: 'current-password' %></label><%= f.submit 'Link organization identity', class: 'lp-button secondary' %><% end %></section></main>
