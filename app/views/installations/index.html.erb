<p><%= link_to "Explore server resort experiences ↗", reservations_catalog_path, class: "li-button" %></p>
<% content_for :title, "My Applications · Lightek" %>
<div class="li-heading"><span class="li-eyebrow">YOUR LIGHTEK WORKSPACE</span><h1>My Applications</h1><p>Follow your installation, set your password, and open your application.</p></div>
<section aria-label="Your installations" class="li-grid">
<% @orders.each do |order| %><% state = LightekCommerce::Installations.summary(order) %>
<article class="li-card"><span class="li-badge <%= state[:ready] ? 'li-ready' : '' %>"><%= state[:state].humanize %></span><h2><%= state[:hostname] %></h2><p>Order #<%= order.id %> · <%= order.items.map { |item| item.product.name }.join(', ') %></p><%= link_to state[:ready] ? "Set up & open application" : "View installation", installation_path(order), class: "li-button" %></article>
<% end %>
<% if @orders.empty? %><article class="li-card"><h2>Your applications will appear here</h2><p>After payment is confirmed, installation starts automatically. You can return here at any time.</p></article><% end %>
</section>
<% if @products.any? %><section class="li-plans"><div class="li-heading"><span class="li-eyebrow">BUILD WITH LIGHTEK</span><h2>Start an application</h2><p>Choose a plan and continue to secure payment. Installation begins after payment confirmation.</p></div><div class="li-grid"><% @products.each do |product| %><article class="li-card"><h3><%= product.name %></h3><p><%= product.short_description.presence || "Your own Lightek application and dashboard." %></p><p class="li-price"><%= number_to_currency(product.price_cents / 100.0) %><% if product.billing_interval != "one_time" %>/<%= product.billing_interval %><% end %></p><%= form_with url: installations_path, method: :post, data: {turbo: false} do %><%= hidden_field_tag :product_id, product.id %><%= hidden_field_tag :checkout_key, SecureRandom.uuid %><%= submit_tag "Continue to secure payment", class: "li-button", data: {disable_with: "Opening secure payment…"} %><% end %></article><% end %></div></section><% end %>
<% if @full_packages.any? %>
  <section class="li-plans" aria-label="CMS, phone and mobile data">
    <div class="li-heading"><h2>CMS + Phone + Mobile Data</h2></div>
    <div class="li-grid">
      <% @full_packages.each do |product, offer| %>
        <article class="li-card">
          <h3><%= product.name %></h3>
          <p>CMS workspace, one phone line, and <%= number_with_delimiter(offer.fetch("data_limit_mb")) %> MB of mobile data per month.</p>
          <p class="li-price"><%= number_to_currency(product.price_cents / 100.0) %>/month</p>
          <%= link_to "Set up your package", full_package_installations_path(product_id: product.id), class: "li-button" %>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
