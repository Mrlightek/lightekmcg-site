<% content_for :title, "Application ##{@order.id} · Lightek" %>
<%= link_to "← My Applications", installations_path, class: "li-back" %>
<div class="li-heading"><span class="li-eyebrow">ORDER #<%= @order.id %></span><h1><%= @installation[:ready] ? "Your application is ready" : "Your application installation" %></h1><p><%= @installation[:hostname] %></p></div>
<section class="li-card li-installation" data-installation-status-url="<%= installation_path(@order, format: :json) %>" data-installation-state="<%= @installation[:state] %>">
<span class="li-badge <%= @installation[:ready] ? 'li-ready' : '' %>" role="status"><%= @installation[:state].humanize %></span>
<ol class="li-progress"><li class="<%= @order.paid_at? ? 'complete' : '' %>"><strong>Payment confirmation</strong><span><%= @order.paid_at? ? "Confirmed" : "Waiting for secure payment confirmation" %></span></li><li class="<%= @installation[:allocated] ? 'complete' : '' %>"><strong>Application server</strong><span><%= @installation[:allocated] ? "Registered to your installation" : "Allocated after payment confirmation" %></span></li><li class="<%= @installation[:ready] ? 'complete' : '' %>"><strong>Installation & verification</strong><span><%= @installation[:ready] ? "HTTPS, sign-in and dashboard verified" : "Lightek installs and verifies your application" %></span></li><li class="<%= @installation[:ready] ? 'complete' : '' %>"><strong>Your account</strong><span><%= @installation[:ready] ? "Choose your password below" : "Password setup becomes available when your application is ready" %></span></li></ol>
<% if @installation[:ready] %>
<div class="li-access"><h2>Choose your application password</h2><p>Your sign-in email is <strong><%= @order.customer_email %></strong>. The button below opens your application's password form. You do not need a temporary password or a setup email.</p><div class="li-actions"><%= button_to "Set or reset my password", access_installation_path(@order), method: :post, class: "li-button", data: {turbo: false, disable_with: "Opening password setup…"} %><%= link_to "Open application", "#{@installation[:url]}/session/new?return_to=%2Fdashboard%2Fpages", class: "li-button li-secondary", target: "_blank", rel: "noopener" %></div><p class="li-muted">Sign in here with the Lightek account that purchased the application before opening password setup. Setup links expire after 20 minutes.</p></div>
<% elsif @installation[:retryable] %><div class="li-access"><h2>Installation needs attention</h2><p>Resume uses this paid order and its existing allocation.</p><%= button_to "Resume installation", retry_installation_installation_path(@order), method: :post, class: "li-button", data: {turbo: false} %></div>
<% elsif !@order.paid_at? && @order.status == "pending_payment" && @order.client_checkout_key.present? %><div class="li-access"><h2>Complete secure payment</h2><p>Payment confirmation starts your installation automatically. Returning here does not create another order.</p><%= form_with url: installations_path, method: :post, data: {turbo: false} do %><%= hidden_field_tag :product_id, @order.items.first.product_id %><%= hidden_field_tag :checkout_key, @order.client_checkout_key %><%= submit_tag "Continue to secure payment", class: "li-button" %><% end %></div>
<% else %><p class="li-muted" data-installation-poll-message>This page updates while your installation is in progress. You can leave and return from My Applications.</p><% end %>
</section>
