<!DOCTYPE html>
<html lang="en"><head><title><%= content_for?(:title) ? yield(:title) : "My Applications · Lightek" %></title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag "installations", "data-turbo-track": "reload" %><%= javascript_include_tag "installations", defer: true %></head>
<body class="li-body"><header class="li-top"><a class="li-brand" href="/lightek/index.html#/home">LIGHTEK<span>YOUR APPLICATIONS</span></a><nav><a href="/lightek/index.html#/space">My Space</a><%= link_to "My Applications", installations_path %><% if current_user&.role.in?(%w[admin super_admin]) %><%= link_to "Manage installations", dashboard_installations_path %><% end %></nav></header>
<main class="li-main"><% if flash[:notice] %><p class="li-notice" role="status"><%= flash[:notice] %></p><% end %><% if flash[:alert] %><p class="li-alert" role="alert"><%= flash[:alert] %></p><% end %><%= yield %></main></body></html>
