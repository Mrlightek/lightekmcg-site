<%
  design_key = @design_key || LightekDesign::Catalog.design_for(@site)
  definition = @studio_preview_definition || LightekDesign::Catalog.fetch(design_key)
  base_style = definition["base_design"] || design_key
  navigation_style = base_style == "plain" ? "vinylctrl" : base_style
  tokens = definition.fetch("tokens").merge(definition.fetch("fonts"))
  tokens.merge!(@site.active_template.tokens) unless @preview
  stacks = %w[font_sans font_heading font_mono].each_with_object({}) do |key, result|
    result[key] = LightekDesign::Fonts.css_stack(tokens[key].presence || definition.fetch("fonts")[key], fallback: key == "font_mono" ? "monospace" : "sans-serif")
  end
  google_url = LightekDesign::Fonts.stylesheet(tokens.values_at("font_sans", "font_heading", "font_mono"))
%>
<!doctype html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= @page.title %> · <%= @site.name %></title>
<% if !@preview && @site.respond_to?(:manifest) && @site.manifest.to_h["hosted_application_key"].present? %><meta name="lightek-application-key" content="<%= @site.manifest["hosted_application_key"] %>"><% end %>
<%= csrf_meta_tags %>
<% if @preview %><meta name="robots" content="noindex,nofollow"><% end %>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<% if google_url %><%= stylesheet_link_tag google_url %><% end %>
<% %w[vinylctrl ybnc].each do |key| %><%= stylesheet_link_tag "/lightek/designs/#{key}.css" %><% end %>
<%= stylesheet_link_tag "/lightek/designs/shared.css" %>
<%= stylesheet_link_tag "/lightek/designer/website.css" %>
<% unless @preview %><%= theme_styles(@page.theme || @site.theme) %><% end %>
<style id="lightek-website-typography">
:root {--lt-body:<%= stacks["font_sans"].html_safe %>;--lt-heading:<%= stacks["font_heading"].html_safe %>;--lt-mono:<%= stacks["font_mono"].html_safe %>;}
<% definition.fetch("tokens").merge(tokens).each do |key, value| %>
<% if %w[color_bg color_text color_primary color_text_muted].include?(key) && value.to_s.match?(/\A#[0-9a-f]{3,8}\z/i) %>
:root {--<%= key.tr("_", "-") %>:<%= value %>;}
<% end %><% end %>
body {font-family:var(--lt-body);background:var(--color-bg);color:var(--color-text);}
</style>
<%= javascript_include_tag "/lightek/designs/website.js", defer: true %>
</head><body class="lt-website-<%= base_style %>" data-lightek-website>
<a class="lt-skip" href="#main-content">Skip to content</a>
<% if @preview && !@studio_preview_definition %><aside class="lt-preview-banner">Design preview · <%= link_to "Back to website designs", dashboard_website_designs_path(site_id: @site.id) %></aside><% end %>
<header class="lt-design-<%= navigation_style %>">
<% if !@preview && @site.nav_menu && @site.nav_menu.roots.any? %>
  <%= render "lightek_design/site_navigation", design_key: navigation_style %>
<% elsif definition["designer"] %>
  <%= render "lightek_design/designer/navigation", definition: definition %>
<% else %>
  <%= render "lightek_design/#{design_key}/navigation", section: definition.fetch("navigation").fetch("data") %>
<% end %>
</header>
<main id="main-content"><%= yield %></main>
<% unless @preview || @page.sections.any? { |section| %w[vinylctrl_waitlist ybnc_footer].include?(section.kind) || LightekDesign::Catalog.section_definition(section.kind)&.fetch("chrome_footer", false) } %>
  <div class="lt-design-<%= navigation_style %>">
  <% if @site.footer %>
    <%= render "dymond_site/themes/default/chrome/chrome_styles" %>
    <%= render "dymond_site/themes/default/chrome/footer", site: @site, footer: @site.footer %>
  <% elsif definition["designer"] %>
    <footer class="ld-default-footer">© <%= Time.current.year %> <%= @site.name %></footer>
  <% else %>
    <%= render "lightek_design/#{design_key}/footer", section: definition.fetch("footer").fetch("data") %>
  <% end %>
  </div>
<% end %>
</body></html>
