<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reservations · <%= @site&.name || 'Lightek' %></title><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag 'reservations', 'data-turbo-track': 'reload' %><% if controller_name == 'reservations' && action_name.in?(%w[index show]) %><%= render 'dymond_dash/shared/theme_forms' if defined?(DymondDash::AppConfig) %><%= stylesheet_link_tag '/lightek/reservations-workspace.css?v=20261114' %><% end %><%= javascript_include_tag "reservations", defer: true %></head><body class="lr-body<%= " lr-customer-workspace" if controller_name == 'reservations' && action_name.in?(%w[index show]) %><%= " lr-session-body" if defined?(@room) && @room %>"><header class="lr-top"><a class="lr-brand" href="<%= reservations_catalog_path(site_id: @site&.id) %>"><%= @site&.name || 'LIGHTEK' %><small>EXPERIENCES & RESERVATIONS</small></a><nav><% if current_user && @site && LightekSettings::WebsiteIdentity.sites_for(current_user).exists?(id: @site.id) %><%= link_to "Dashboard", dashboard_reservations_path(site_id: @site.id) %><%= link_to "Rooms & guests", dashboard_rooms_path(site_id: @site.id) %><% end %><%= link_to 'Explore experiences', reservations_catalog_path(site_id: @site&.id) %><%= link_to 'My reservations', my_reservations_path, aria: {current: (controller_name == 'reservations' && action_name.in?(%w[index show]) ? 'page' : nil)} %><%= link_to 'My applications', installations_path %></nav></header><main class="lr-shell"><% if flash[:notice] %><p class="lr-notice" role="status"><%= flash[:notice] %></p><% end %><% if flash[:alert] %><p class="lr-alert" role="alert"><%= flash[:alert] %></p><% end %><%= yield %></main><footer class="lr-shell lr-footer">Your next chapter, reserved. <span>Powered by Lightek</span></footer></body></html>
