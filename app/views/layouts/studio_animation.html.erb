<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Scene Animation · Lightek Studio</title>
  <%= csrf_meta_tags %>
  <%= yield :animation_head %>
  <%= stylesheet_link_tag "/lightek/pipeline-hub.css" %>
</head>
<body>
<main class="pipeline">
  <header class="pipeline-header">
    <div>
      <%= link_to "Lightek Studio", studio_pipeline_path(site_id: @site.id), class: "pipeline-brand" %>
      <h1>Scene Animation</h1>
      <p><%= @site.name %></p>
    </div>
    <nav aria-label="Animation tools">
      <%= link_to "Scenes", studio_animation_scenes_path(site_id: @site.id) %>
      <%= link_to "Assets", studio_animation_assets_path(site_id: @site.id) %>
    </nav>
  </header>
  <% if flash[:alert] %><p class="notice" role="alert"><%= flash[:alert] %></p><% end %>
  <%= yield %>
</main>
</body>
</html>
