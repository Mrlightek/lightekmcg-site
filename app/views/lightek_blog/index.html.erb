<%= stylesheet_link_tag "/lightek/site-content.css?v=1" %><% content_for :website_meta do %><%= tag.link rel:"alternate",type:"application/rss+xml",title:"#{@site.name} Journal",href:website_blog_feed_path %><% end %>
<main class="journal"><header><span class="content-eyebrow"><%= @site.name %> / JOURNAL</span><h1>Ideas. Stories. What's next.</h1><p>From <%= @site.name %>.</p></header><%= form_with url:website_blog_index_path,method: :get,local:true,class:"journal-search" do %><label>Search articles<%= search_field_tag :q,@query,placeholder:"Find a story" %></label><label>Category<%= select_tag :category,options_for_select(@categories,@category),include_blank:"All categories" %></label><%= submit_tag "Find stories",class:"content-button" %><% end %>
<div class="journal-grid"><% @entries.each do |entry| %><article class="journal-card"><span class="content-eyebrow"><%= entry.category.presence || "Journal" %></span><h2><%= link_to entry.post.title,website_blog_path(slug:entry.slug) %></h2><time datetime="<%= entry.published_at.iso8601 %>"><%= entry.published_at.strftime("%B %-d, %Y") %></time><p><%= entry.excerpt.presence || strip_tags(entry.post.content).truncate(220) %></p><%= link_to "Read story →",website_blog_path(slug:entry.slug),class:"content-button" %></article><% end %></div><% if @entries.empty? %><section class="content-card"><h2><%= @query.present? || @category.present? ? "No matching stories" : "Our next chapter is coming." %></h2><p>Published stories will appear here.</p></section><% end %><nav class="journal-pagination" aria-label="Journal pages"><%= link_to "← Previous",website_blog_index_path(page:@page_number-1,q:@query,category:@category) if @page_number>1 %><%= link_to "More stories →",website_blog_index_path(page:@page_number+1,q:@query,category:@category) if @more %><%= link_to "RSS feed",website_blog_feed_path %></nav></main>
