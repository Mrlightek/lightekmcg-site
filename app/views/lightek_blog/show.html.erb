<%= stylesheet_link_tag "/lightek/site-content.css?v=1" %><% content_for :website_meta do %><%= tag.meta name:"description",content:(@entry.excerpt.presence || strip_tags(@entry.post.content).truncate(160)) %><%= tag.link rel:"canonical",href:"https://#{@site.host}/blog/#{@entry.slug}" %><% if @article_preview %><%= tag.meta name:"robots",content:"noindex,nofollow" %><% end %><% end %>
<article class="journal journal-story"><%= link_to "← Journal",website_blog_index_path %><% if @article_preview %><p class="content-preview">Private preview · <%= @entry.status %></p><% end %><header><span class="content-eyebrow"><%= @entry.category.presence || "Journal" %></span><h1><%= @entry.post.title %></h1><p><%= @entry.excerpt %></p><small><%= @entry.post.user.respond_to?(:full_name) ? @entry.post.user.full_name : @site.name %><% if @entry.published_at %> · <time datetime="<%= @entry.published_at.iso8601 %>"><%= @entry.published_at.strftime("%B %-d, %Y") %></time><% end %></small></header><div class="journal-body"><% body=sanitize(@entry.post.content,tags:%w[p br h2 h3 strong em ul ol li blockquote a],attributes:%w[href title]) %><%= @entry.post.content.match?(/<(?:p|h[23]|ul|ol|blockquote)\b/i) ? body : simple_format(body,{},sanitize:false) %></div></article>
