<h1>Payment confirmed</h1><p>Your order <strong>#<%= @order.id %></strong> has been paid.</p><ul><% @order.items.each do |item| %><li><%= item.quantity %> × <%= item.name %> — <%= number_to_currency(item.line_total_cents / 100.0) %></li><% end %></ul><p><% if @order.discount_amount.positive? %>Merchandise discount: <%= number_to_currency(@order.discount_amount / 100.0) %><br><% end %>Subtotal: <%= number_to_currency(@order.subtotal_cents / 100.0) %><% if @order.buyer_fee_cents.positive? %><br>Lightek checkout fee: <%= number_to_currency(@order.buyer_fee_cents / 100.0) %><% end %><br>Shipping: <%= number_to_currency(@order.shipping_cents / 100.0) %><br>Tax: <%= number_to_currency(@order.tax_cents / 100.0) %><br><strong>Total: <%= number_to_currency(@order.total_cents / 100.0) %></strong></p>
<% if @order.managed_gift_delivery? && @order.status == 'fulfilled' %>
  <p>Your gift card will be emailed to <%= @order.gift_recipient_email %><% if @order.gift_deliver_at %> on <%= l(@order.gift_deliver_at.in_time_zone.to_date, format: :long) %><% end %>.</p>
<% end %>
<% if @gift_code %><h2>Your store gift card</h2><p>Enter <strong><%= @gift_code %></strong> at this store's checkout. You can share the code with your recipient.</p><% end %>
<% if @order.gift_applied.positive? %><p>Paid with gift card: <%= number_to_currency(@order.gift_applied / 100.0) %><br>Paid by card: <%= number_to_currency(@order.cash_paid_cents / 100.0) %></p><% end %>
