<h1>Payment confirmed</h1><p>Your order <strong>#<%= @order.id %></strong> has been paid.</p><ul><% @order.items.each do |item| %><li><%= item.quantity %> × <%= item.name %> — <%= number_to_currency(item.line_total_cents / 100.0) %></li><% end %></ul><p>Subtotal: <%= number_to_currency(@order.subtotal_cents / 100.0) %><br>Shipping: <%= number_to_currency(@order.shipping_cents / 100.0) %><br>Tax: <%= number_to_currency(@order.tax_cents / 100.0) %><br><strong>Total: <%= number_to_currency(@order.total_cents / 100.0) %></strong></p>