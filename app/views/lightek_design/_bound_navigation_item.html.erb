<li><% visible=item.children.select{|child|!child.page_id || site.pages.where(id:child.page_id,published:true).exists?} %><% if visible.any? %><details><summary><%= item.label %></summary><ul class="lt-nav-panel"><li><%= link_to "View #{item.label}",studio_navigation_href(item) %></li><% visible.each do |child| %><%= render "lightek_design/bound_navigation_item",item:child,site:site %><% end %></ul></details><% else %><% href=studio_navigation_href(item); active=studio_navigation_current?(href) %><%= link_to item.label,href,class:(active ? "on nav__link" : "nav__link"),aria:{current:active ? "page" : nil} %><% end %></li>
