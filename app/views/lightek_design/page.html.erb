<% @page.sections.order(:position, :id).each do |record| %>
  <% entry = LightekDesign::Catalog.section_definition(record.kind) %>
  <% if entry && entry["designer"] %>
    <%= studio_render_section(entry, record.data) %>
  <% elsif entry %>
    <%= render "lightek_design/sections/#{record.kind}", section: record.presenter %>
  <% else %>
    <div class="lt-design-<%= LightekDesign::Catalog.design_for(@site) %>">
    <%= render "dymond_site/themes/default/sections/#{record.template_partial}", section: record.presenter %>
    </div>
  <% end %>
<% end %>
