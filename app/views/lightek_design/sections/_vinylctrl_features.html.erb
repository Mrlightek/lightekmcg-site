<div class="lt-design-vinylctrl" data-design-section="vinylctrl_features">
<section class="features section" id="features">
<div class="container">
<div class="features__header">
<div>
<div class="section-label reveal"><%= LightekDesign::Catalog.value(section, "text_1", "Platform Features") %></div>
<h2 class="section-title reveal d1"><%= LightekDesign::Catalog.value(section, "text_2", "Everything") %><br/><em><%= LightekDesign::Catalog.value(section, "text_3", "in one place.") %></em>
</h2>
</div>
<p class="reveal d2" style="max-width:360px;font-size:0.95rem;font-weight:300;color:var(--text-secondary);line-height:1.75;"><%= LightekDesign::Catalog.value(section, "text_4", "No more juggling emails, DMs, spreadsheets, and invoices. VinylCTRL handles the business so you can focus on the music.") %></p>
</div>
<div class="features__grid">
<div class="feature-tile feature-tile--large reveal">
<div class="feature-tile__num"><%= LightekDesign::Catalog.value(section, "text_5", "01 — Booking Management") %></div>
<div class="feature-tile__icon"><%= LightekDesign::Catalog.value(section, "text_6", "📅") %></div>
<div class="feature-tile__title"><%= LightekDesign::Catalog.value(section, "text_7", "Booking & Calendar Management") %></div>
<p class="feature-tile__desc"><%= LightekDesign::Catalog.value(section, "text_8", "Effortlessly manage all your bookings in one centralized platform. Avoid double-bookings, track upcoming gigs, and stay organized across every event.") %></p>
</div>
<div class="feature-tile feature-tile--accent reveal d1">
<div class="feature-tile__num" style="color:rgba(0,0,0,0.4);"><%= LightekDesign::Catalog.value(section, "text_9", "02 — Matchmaking") %></div>
<div class="feature-tile__icon"><%= LightekDesign::Catalog.value(section, "text_10", "🎯") %></div>
<div class="feature-tile__title"><%= LightekDesign::Catalog.value(section, "text_11", "Smart Gig Matchmaking") %></div>
<p class="feature-tile__desc"><%= LightekDesign::Catalog.value(section, "text_12", "Create your profile and get connected to the right gigs. Filter by genre, location, budget, and availability.") %></p>
</div>
<div class="feature-tile reveal d1">
<div class="feature-tile__num"><%= LightekDesign::Catalog.value(section, "text_13", "03 — Marketing") %></div>
<div class="feature-tile__icon"><%= LightekDesign::Catalog.value(section, "text_14", "📢") %></div>
<div class="feature-tile__title"><%= LightekDesign::Catalog.value(section, "text_15", "Auto-Marketing Features") %></div>
<p class="feature-tile__desc"><%= LightekDesign::Catalog.value(section, "text_16", "Auto-generated marketing assets to boost your event and talent visibility. Promote without a marketing team.") %></p>
</div>
<div class="feature-tile reveal d2">
<div class="feature-tile__num"><%= LightekDesign::Catalog.value(section, "text_17", "04 — Contracts") %></div>
<div class="feature-tile__icon"><%= LightekDesign::Catalog.value(section, "text_18", "📄") %></div>
<div class="feature-tile__title"><%= LightekDesign::Catalog.value(section, "text_19", "Contract & Invoice Management") %></div>
<p class="feature-tile__desc"><%= LightekDesign::Catalog.value(section, "text_20", "Generate professional contracts and invoices automatically. Protect yourself legally and get paid properly.") %></p>
</div>
<div class="feature-tile reveal d2">
<div class="feature-tile__num"><%= LightekDesign::Catalog.value(section, "text_21", "05 — Communication") %></div>
<div class="feature-tile__icon"><%= LightekDesign::Catalog.value(section, "text_22", "💬") %></div>
<div class="feature-tile__title"><%= LightekDesign::Catalog.value(section, "text_23", "In-App Messaging") %></div>
<p class="feature-tile__desc"><%= LightekDesign::Catalog.value(section, "text_24", "All booking communication stays on platform. No lost DMs, no missed emails. Every conversation tracked and searchable.") %></p>
</div>
<div class="feature-tile reveal d3">
<div class="feature-tile__num"><%= LightekDesign::Catalog.value(section, "text_25", "06 — Analytics") %></div>
<div class="feature-tile__icon"><%= LightekDesign::Catalog.value(section, "text_26", "📊") %></div>
<div class="feature-tile__title"><%= LightekDesign::Catalog.value(section, "text_27", "Business Analytics") %></div>
<p class="feature-tile__desc"><%= LightekDesign::Catalog.value(section, "text_28", "Track your earnings, gig history, and growth over time. Make smarter decisions with real data behind your hustle.") %></p>
</div>
</div>
</div>
</section>
</div>
