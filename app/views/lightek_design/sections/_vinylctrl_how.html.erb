<div class="lt-design-vinylctrl" data-design-section="vinylctrl_how">
<section class="how section" id="how">
<div class="container">
<div class="how__grid">
<div>
<div class="section-label reveal"><%= LightekDesign::Catalog.value(section, "text_1", "Process") %></div>
<h2 class="section-title reveal d1"><%= LightekDesign::Catalog.value(section, "text_2", "How") %><br/><em><%= LightekDesign::Catalog.value(section, "text_3", "it works.") %></em>
</h2>
</div>
<div>
<div class="how__steps">
<div class="how__step reveal">
<span class="how__step-num"><%= LightekDesign::Catalog.value(section, "text_4", "01") %></span>
<div>
<div class="how__step-title"><%= LightekDesign::Catalog.value(section, "text_5", "Create Your Profile") %></div>
<div class="how__step-desc"><%= LightekDesign::Catalog.value(section, "text_6", "Sign up as a DJ, artist, venue, or event organizer. Build your profile, set your rates, and showcase your work. Your profile is your brand.") %></div>
</div>
</div>
<div class="how__step reveal d1">
<span class="how__step-num"><%= LightekDesign::Catalog.value(section, "text_7", "02") %></span>
<div>
<div class="how__step-title"><%= LightekDesign::Catalog.value(section, "text_8", "Get Matched") %></div>
<div class="how__step-desc"><%= LightekDesign::Catalog.value(section, "text_9", "Our matchmaking engine connects the right talent to the right gig. Search by genre, availability, location, and budget — or let us do it for you.") %></div>
</div>
</div>
<div class="how__step reveal d2">
<span class="how__step-num"><%= LightekDesign::Catalog.value(section, "text_10", "03") %></span>
<div>
<div class="how__step-title"><%= LightekDesign::Catalog.value(section, "text_11", "Book & Confirm") %></div>
<div class="how__step-desc"><%= LightekDesign::Catalog.value(section, "text_12", "Send and receive booking requests. Negotiate terms, confirm availability, and lock it in — all through the platform. No back-and-forth emails.") %></div>
</div>
</div>
<div class="how__step reveal d3">
<span class="how__step-num"><%= LightekDesign::Catalog.value(section, "text_13", "04") %></span>
<div>
<div class="how__step-title"><%= LightekDesign::Catalog.value(section, "text_14", "Contracts & Invoices") %></div>
<div class="how__step-desc"><%= LightekDesign::Catalog.value(section, "text_15", "Auto-generate professional contracts and invoices. Get paid, stay organized, and keep your business running clean.") %></div>
</div>
</div>
</div>
</div>
</div>

