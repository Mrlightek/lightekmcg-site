<div class="lt-design-vinylctrl" data-design-section="vinylctrl_quotes">
<section class="quotes section">
<div class="container">
<div style="margin-bottom:var(--sp-8);">
<div class="section-label reveal"><%= LightekDesign::Catalog.value(section, "text_1", "From The Community") %></div>
<h2 class="section-title reveal d1"><%= LightekDesign::Catalog.value(section, "text_2", "Real talk,") %><br/><em><%= LightekDesign::Catalog.value(section, "text_3", "real results.") %></em></h2>
</div>
<div class="quotes__grid">
<div class="quote-card reveal">
<div class="quote-card__mark"><%= LightekDesign::Catalog.value(section, "text_4", "\"") %></div>
<p class="quote-card__text"><%= LightekDesign::Catalog.value(section, "text_5", "VinylCTRL changed how I run my business. I used to miss gigs because of scheduling conflicts. Now my whole calendar is automated. I'm booking more and stressing less.") %></p>
<div class="quote-card__author">
<div class="quote-card__avatar"><%= LightekDesign::Catalog.value(section, "text_6", "DJ") %></div>
<div>
<div class="quote-card__name"><%= LightekDesign::Catalog.value(section, "text_7", "DJ Marcus Webb") %></div>
<div class="quote-card__role"><%= LightekDesign::Catalog.value(section, "text_8", "DJ · Chicago, IL") %></div>
</div>
</div>
</div>
<div class="quote-card reveal d1">
<div class="quote-card__mark"><%= LightekDesign::Catalog.value(section, "text_9", "\"") %></div>
<p class="quote-card__text"><%= LightekDesign::Catalog.value(section, "text_10", "Finding reliable DJ talent used to take days of back-and-forth. Now I post a gig, get matched in minutes, and the contract is handled automatically. This is exactly what venues needed.") %></p>
<div class="quote-card__author">
<div class="quote-card__avatar"><%= LightekDesign::Catalog.value(section, "text_11", "VN") %></div>
<div>
<div class="quote-card__name"><%= LightekDesign::Catalog.value(section, "text_12", "Maya Torres") %></div>
<div class="quote-card__role"><%= LightekDesign::Catalog.value(section, "text_13", "Venue Manager · Miami, FL") %></div>
</div>
</div>
</div>
<div class="quote-card reveal d2">
<div class="quote-card__mark"><%= LightekDesign::Catalog.value(section, "text_14", "\"") %></div>
<p class="quote-card__text"><%= LightekDesign::Catalog.value(section, "text_15", "As an independent artist I always felt invisible. VinylCTRL gave me the same professional tools the big names have. My bookings have tripled and I finally feel like I'm running a real business.") %></p>
<div class="quote-card__author">
<div class="quote-card__avatar"><%= LightekDesign::Catalog.value(section, "text_16", "KA") %></div>
<div>
<div class="quote-card__name"><%= LightekDesign::Catalog.value(section, "text_17", "Kezia Amara") %></div>
<div class="quote-card__role"><%= LightekDesign::Catalog.value(section, "text_18", "Artist · Atlanta, GA") %></div>
</div>
</div>
</div>
</div>
</div>
</section>
</div>
