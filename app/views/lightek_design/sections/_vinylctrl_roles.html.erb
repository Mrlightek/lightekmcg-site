<div class="role-card__icon"><%= LightekDesign::Catalog.value(section, "text_13", "🎤") %></div>
<div class="role-card__title"><%= LightekDesign::Catalog.value(section, "text_14", "Artists") %></div>
<p class="role-card__desc"><%= LightekDesign::Catalog.value(section, "text_15", "Promote your talent, find performance opportunities, and grow your audience. VinylCTRL gives independent artists a professional platform to compete.") %></p>
<div class="role-card__features">
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_16", "Talent profile & portfolio") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_17", "Event performance booking") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_18", "Auto-marketing features") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_19", "Collaboration network") %></div>
</div>
</div>
<div class="role-card reveal d2">
<span class="role-card__num"><%= LightekDesign::Catalog.value(section, "text_20", "03 / VENUE") %></span>
<div class="role-card__icon"><%= LightekDesign::Catalog.value(section, "text_21", "🏟️") %></div>
<div class="role-card__title"><%= LightekDesign::Catalog.value(section, "text_22", "Venues") %></div>
<p class="role-card__desc"><%= LightekDesign::Catalog.value(section, "text_23", "Find the right talent for every night. Browse verified DJs and artists, manage bookings, and keep your entertainment calendar filled and organized.") %></p>
<div class="role-card__features">
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_24", "Talent discovery & search") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_25", "Event calendar management") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_26", "Verified profiles only") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_27", "Centralized communication") %></div>
</div>
</div>
<div class="role-card reveal d3">
<span class="role-card__num"><%= LightekDesign::Catalog.value(section, "text_28", "04 / ORGANIZER") %></span>
<div class="role-card__icon"><%= LightekDesign::Catalog.value(section, "text_29", "📋") %></div>
<div class="role-card__title"><%= LightekDesign::Catalog.value(section, "text_30", "Event Organizers") %></div>
<p class="role-card__desc"><%= LightekDesign::Catalog.value(section, "text_31", "Plan and execute events at scale. Source talent, coordinate logistics, manage multiple bookings, and promote events — without spreadsheets.") %></p>
<div class="role-card__features">
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_32", "Multi-event management") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_33", "Talent sourcing at scale") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_34", "Event promotion tools") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_35", "Budget & invoice tracking") %></div>
