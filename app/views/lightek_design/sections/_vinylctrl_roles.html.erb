<div class="lt-design-vinylctrl" data-design-section="vinylctrl_roles">
<section class="roles section" id="roles">
<div class="container" style="padding:0;">
<div style="padding: var(--sp-8) var(--sp-8) var(--sp-4);">
<div class="section-label reveal"><%= LightekDesign::Catalog.value(section, "text_1", "Built For") %></div>
<h2 class="section-title reveal d1"><%= LightekDesign::Catalog.value(section, "text_2", "Who takes") %><br/><em><%= LightekDesign::Catalog.value(section, "text_3", "the stage.") %></em></h2>
</div>
<div class="roles__grid">
<div class="role-card reveal">
<span class="role-card__num"><%= LightekDesign::Catalog.value(section, "text_4", "01 / DJ") %></span>
<div class="role-card__icon"><%= LightekDesign::Catalog.value(section, "text_5", "🎧") %></div>
<div class="role-card__title"><%= LightekDesign::Catalog.value(section, "text_6", "DJs") %></div>
<p class="role-card__desc"><%= LightekDesign::Catalog.value(section, "text_7", "Build your profile, set your rates, and get matched to the gigs you actually want. Manage bookings, contracts, and payments without the chaos.") %></p>
<div class="role-card__features">
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_8", "Smart gig matchmaking") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_9", "Calendar management") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_10", "Auto-generated contracts") %></div>
<div class="role-card__feature"><%= LightekDesign::Catalog.value(section, "text_11", "Invoice & payment tracking") %></div>
</div>
</div>
