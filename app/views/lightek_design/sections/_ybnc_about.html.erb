<div class="lt-design-ybnc" data-design-section="ybnc_about">
<section class="about section" id="about">
<div class="container" style="padding: 0;">
<div class="about__grid">
<div class="about__image-col reveal">
<div class="about__photo-bg"></div>
<div class="about__photo-frame">
<div class="about__photo-corner about__photo-corner--tl"></div>
<div class="about__photo-corner about__photo-corner--tr"></div>
<div class="about__photo-corner about__photo-corner--bl"></div>
<div class="about__photo-corner about__photo-corner--br"></div>
</div>
<div aria-hidden="true" class="about__photo-placeholder"><%= LightekDesign::Catalog.value(section, "text_3", "✊🏾") %></div>

<div class="about__award">
<div aria-hidden="true" class="about__award-icon"><%= LightekDesign::Catalog.value(section, "text_4", "🏆") %></div>
<div>
<div class="about__award-title"><%= LightekDesign::Catalog.value(section, "text_5", "Recipient") %></div>
<div class="about__award-name"><%= LightekDesign::Catalog.value(section, "text_6", "Community Hero Award · Ashley Dorelus") %></div>
</div>
</div>
</div>
<div class="about__content">
<div class="mono-label reveal"><%= LightekDesign::Catalog.value(section, "text_7", "Meet the Founder") %></div>
<h2 class="about__title reveal d1"><%= LightekDesign::Catalog.value(section, "text_8", "Ashley") %><br/><em><%= LightekDesign::Catalog.value(section, "text_9", "\"Aesthetics\"") %></em><br/><%= LightekDesign::Catalog.value(section, "text_10", "Dorelus") %></h2>
<p class="about__body reveal d2"><%= LightekDesign::Catalog.value(section, "text_11", "Ashley Dorelus is a documentary filmmaker, social justice advocate, and community organizer based in Vallejo, California. She has been on the frontlines since May 29, 2020 — traveling to over 20 states and dozens of cities to document the uprising at the intersection of two pandemics: COVID-19 and the ongoing genocide of Black people at the hands of police.") %></p>
<p class="about__body reveal d2"><%= LightekDesign::Catalog.value(section, "text_12", "From Oakland to Minneapolis, Philadelphia to Atlanta — Ashley's lens captured what mainstream media refused to show. Her work, shared widely after Amanda Seals amplified her documentation of the Daunte Wright shooting, helped galvanize national attention to frontline journalism by community members.") %></p>
<p class="about__body reveal d2"><%= LightekDesign::Catalog.value(section, "text_13", "A 🇭🇹 Haitian-American, Ashley received a Community Hero Award for her work and founded YBNC as a vehicle for turning documentation into organized, sustained action. She believes community-driven change begins with showing up.") %></p>
<div class="about__tags reveal d3">
<span class="about__tag"><%= LightekDesign::Catalog.value(section, "text_14", "Documentary Filmmaker") %></span>
<span class="about__tag"><%= LightekDesign::Catalog.value(section, "text_15", "Community Organizer") %></span>
<span class="about__tag"><%= LightekDesign::Catalog.value(section, "text_16", "Social Justice Advocate") %></span>
<span class="about__tag"><%= LightekDesign::Catalog.value(section, "text_17", "Frontline Journalist") %></span>
<span class="about__tag"><%= LightekDesign::Catalog.value(section, "text_18", "Haitian-American") %></span>
<span class="about__tag"><%= LightekDesign::Catalog.value(section, "text_19", "Community Hero Awardee") %></span>
<span class="about__tag"><%= LightekDesign::Catalog.value(section, "text_20", "Pro-Black Liberation") %></span>
</div>
<div class="about__links reveal d4">
<a class="btn btn--outline" href="<%= LightekDesign::Catalog.safe_url(LightekDesign::Catalog.value(section, "link_1", "https://www.instagram.com/aestheticsconash/"), image: false) %>" rel="noopener noreferrer" target="_blank"><%= LightekDesign::Catalog.value(section, "text_21", "📸 @aestheticsconash") %></a>
<a class="btn btn--red" href="<%= LightekDesign::Catalog.safe_url(LightekDesign::Catalog.value(section, "link_2", "#involved"), image: false) %>"><%= LightekDesign::Catalog.value(section, "text_22", "Support the Work →") %></a>
</div>
</div>
</div>
</div>
</section>
</div>
