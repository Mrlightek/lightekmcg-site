<div class="lt-design-ybnc" data-design-section="ybnc_events">
<section class="events section" id="events">
<div class="container">
<div class="events__header">
<div>
<div class="mono-label reveal"><%= LightekDesign::Catalog.value(section, "text_2", "On the Ground") %></div>
<h2 class="headline reveal d1" style="font-size: clamp(2.5rem, 5vw, 4.5rem); color: var(--cream); margin-top: var(--sp-3);"><%= LightekDesign::Catalog.value(section, "text_3", "Upcoming") %><br/><span style="color: var(--gold);"><%= LightekDesign::Catalog.value(section, "text_4", "Actions & Events.") %></span>
</h2>
</div>
<a class="btn btn--outline reveal d2" href="<%= LightekDesign::Catalog.safe_url(LightekDesign::Catalog.value(section, "link_1", "#"), image: false) %>"><%= LightekDesign::Catalog.value(section, "text_5", "View All Events →") %></a>
</div>
<div class="events__list" role="list">
<div class="event-row reveal" role="listitem">
<div aria-label="April 19" class="event-row__date">
<div class="event-row__date-day"><%= LightekDesign::Catalog.value(section, "text_6", "19") %></div>
<div class="event-row__date-month"><%= LightekDesign::Catalog.value(section, "text_7", "Apr") %></div>
</div>
<div class="event-row__info">
<div class="event-row__title"><%= LightekDesign::Catalog.value(section, "text_8", "Community Town Hall — Vallejo") %></div>
<div class="event-row__meta">
<span><%= LightekDesign::Catalog.value(section, "text_9", "6:00 PM · Vallejo City Hall") %></span>
<span><%= LightekDesign::Catalog.value(section, "text_10", "Open to all") %></span>
</div>
</div>
<span class="event-type--advocacy event-row__type"><%= LightekDesign::Catalog.value(section, "text_11", "Advocacy") %></span>
</div>
<div class="event-row reveal d1" role="listitem">
<div aria-label="April 26" class="event-row__date">
<div class="event-row__date-day"><%= LightekDesign::Catalog.value(section, "text_12", "26") %></div>
<div class="event-row__date-month"><%= LightekDesign::Catalog.value(section, "text_13", "Apr") %></div>
</div>
<div class="event-row__info">
<div class="event-row__title"><%= LightekDesign::Catalog.value(section, "text_14", "Youth Empowerment Workshop") %></div>
<div class="event-row__meta">
<span><%= LightekDesign::Catalog.value(section, "text_15", "2:00 PM · TBD · Vallejo") %></span>
<span><%= LightekDesign::Catalog.value(section, "text_16", "Ages 16–25") %></span>
</div>
</div>
<span class="event-type--community event-row__type"><%= LightekDesign::Catalog.value(section, "text_17", "Community") %></span>
</div>
<div class="event-row reveal d2" role="listitem">
<div aria-label="May 3" class="event-row__date">
<div class="event-row__date-day"><%= LightekDesign::Catalog.value(section, "text_18", "03") %></div>
<div class="event-row__date-month"><%= LightekDesign::Catalog.value(section, "text_19", "May") %></div>
</div>
<div class="event-row__info">
<div class="event-row__title"><%= LightekDesign::Catalog.value(section, "text_20", "Know Your Rights — Community Training") %></div>
<div class="event-row__meta">
<span><%= LightekDesign::Catalog.value(section, "text_21", "4:00 PM · Online & In-Person") %></span>
<span><%= LightekDesign::Catalog.value(section, "text_22", "Free · RSVP required") %></span>
</div>
</div>
<span class="event-type--education event-row__type"><%= LightekDesign::Catalog.value(section, "text_23", "Education") %></span>
</div>
<div class="event-row reveal d2" role="listitem">
<div aria-label="May 17" class="event-row__date">
<div class="event-row__date-day"><%= LightekDesign::Catalog.value(section, "text_24", "17") %></div>
<div class="event-row__date-month"><%= LightekDesign::Catalog.value(section, "text_25", "May") %></div>
</div>
<div class="event-row__info">
<div class="event-row__title"><%= LightekDesign::Catalog.value(section, "text_26", "Documentary Screening — The Uprising") %></div>
<div class="event-row__meta">
<span><%= LightekDesign::Catalog.value(section, "text_27", "7:00 PM · Vallejo") %></span>
<span><%= LightekDesign::Catalog.value(section, "text_28", "Free · Community Discussion to follow") %></span>
</div>
</div>
<span class="event-type--community event-row__type"><%= LightekDesign::Catalog.value(section, "text_29", "Community") %></span>
</div>
<div class="event-row reveal d3" role="listitem">
