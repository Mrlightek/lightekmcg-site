<div class="event-row__meta">
<span><%= LightekDesign::Catalog.value(section, "text_33", "All Day · Multiple Locations") %></span>
<span><%= LightekDesign::Catalog.value(section, "text_34", "5 Years since the uprising began ·") %><strong style="color:var(--red);"><%= LightekDesign::Catalog.value(section, "text_35", "Mark your calendar") %></strong></span>
</div>
</div>
<span class="event-type--advocacy event-row__type"><%= LightekDesign::Catalog.value(section, "text_36", "Advocacy") %></span>
</div>
</div>
</div>
</section>
</div>
