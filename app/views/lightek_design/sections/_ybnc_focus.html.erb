<div class="lt-design-ybnc" data-design-section="ybnc_focus">
<section class="focus section" id="focus">
<div class="container" style="padding: 0;">
<div style="padding: var(--sp-8);">
<div class="mono-label reveal"><%= LightekDesign::Catalog.value(section, "text_1", "Focus Areas") %></div>
<h2 class="headline reveal d1" style="font-size: clamp(2.5rem, 6vw, 5rem); color: var(--cream); margin-top: var(--sp-3);"><%= LightekDesign::Catalog.value(section, "text_2", "What We") %><br/><span style="color: var(--red);"><%= LightekDesign::Catalog.value(section, "text_3", "Fight For.") %></span>
</h2>
</div>
<div class="focus__grid" role="list">
<div class="focus-card focus-card--1 focus-card--accent reveal" data-bg="VOTE" role="listitem">
<div class="focus-card__num"><%= LightekDesign::Catalog.value(section, "text_4", "01 · Political Advocacy") %></div>
<div aria-hidden="true" class="focus-card__icon"><%= LightekDesign::Catalog.value(section, "text_5", "🗳️") %></div>
<h3 class="focus-card__title"><%= LightekDesign::Catalog.value(section, "text_6", "Political Advocacy & Voting Rights") %></h3>
<p class="focus-card__desc"><%= LightekDesign::Catalog.value(section, "text_7", "Engaging in civic action, voter registration drives, policy advocacy, and holding elected officials accountable to Black communities.") %></p>
</div>
<div class="focus-card focus-card--2 reveal d1" data-bg="BUILD" role="listitem">
<div class="focus-card__num"><%= LightekDesign::Catalog.value(section, "text_8", "02 · Community Action") %></div>
<div aria-hidden="true" class="focus-card__icon"><%= LightekDesign::Catalog.value(section, "text_9", "✊") %></div>
<h3 class="focus-card__title"><%= LightekDesign::Catalog.value(section, "text_10", "Community Organizing & Action") %></h3>
<p class="focus-card__desc"><%= LightekDesign::Catalog.value(section, "text_11", "Grassroots organizing, mutual aid, community events, and building solidarity networks that create lasting change from the ground up.") %></p>
</div>
<div class="focus-card focus-card--3 focus-card--gold-accent reveal d2" data-bg="FREE" role="listitem">
<div class="focus-card__num"><%= LightekDesign::Catalog.value(section, "text_12", "03 · Liberation") %></div>
<div aria-hidden="true" class="focus-card__icon"><%= LightekDesign::Catalog.value(section, "text_13", "✨") %></div>
<h3 class="focus-card__title"><%= LightekDesign::Catalog.value(section, "text_14", "Black Liberation & Freedom") %></h3>
<p class="focus-card__desc"><%= LightekDesign::Catalog.value(section, "text_15", "Centering Black liberation as the foundational goal. Everything we do serves the larger arc of dismantling oppression.") %></p>
</div>
<div class="focus-card focus-card--4 reveal d1" data-bg="RISE" role="listitem">
<div class="focus-card__num"><%= LightekDesign::Catalog.value(section, "text_16", "04 · Empowerment") %></div>
<div aria-hidden="true" class="focus-card__icon"><%= LightekDesign::Catalog.value(section, "text_17", "🌱") %></div>
<h3 class="focus-card__title"><%= LightekDesign::Catalog.value(section, "text_18", "Youth Empowerment & Development") %></h3>
<p class="focus-card__desc"><%= LightekDesign::Catalog.value(section, "text_19", "Investing in young Black leaders through mentorship, resources, leadership training, and creating pathways to opportunity.") %></p>
</div>
<div class="focus-card focus-card--5 reveal d2" data-bg="TRUTH" role="listitem">
<div class="focus-card__num"><%= LightekDesign::Catalog.value(section, "text_20", "05 · Documentation") %></div>
<div aria-hidden="true" class="focus-card__icon"><%= LightekDesign::Catalog.value(section, "text_21", "🎥") %></div>
<h3 class="focus-card__title"><%= LightekDesign::Catalog.value(section, "text_22", "Documentary & Media Justice") %></h3>
<p class="focus-card__desc"><%= LightekDesign::Catalog.value(section, "text_23", "On-the-ground documentation of social injustice. Telling the correct narrative across 20+ states and dozens of cities — frontline media as resistance.") %></p>
</div>
<div class="focus-card focus-card--6 reveal d3" data-bg="BREAK" role="listitem">
<div class="focus-card__num"><%= LightekDesign::Catalog.value(section, "text_24", "06 · Systemic Change") %></div>
<div aria-hidden="true" class="focus-card__icon"><%= LightekDesign::Catalog.value(section, "text_25", "⚖️") %></div>
<h3 class="focus-card__title"><%= LightekDesign::Catalog.value(section, "text_26", "Dismantling Systemic Barriers") %></h3>
<p class="focus-card__desc"><%= LightekDesign::Catalog.value(section, "text_27", "Challenging structural racism in policy, criminal justice, education, and economics — because individual uplift without systemic change is incomplete.") %></p>
</div>
</div>
</div>
</section>
</div>
