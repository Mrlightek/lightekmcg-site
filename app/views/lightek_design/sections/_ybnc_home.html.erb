<div class="lt-design-ybnc" data-design-section="ybnc_home">
<section class="hero" id="home">
<div aria-hidden="true" class="hero__stripe"></div>
<div aria-hidden="true" class="hero__stripe-gold"></div>
<div aria-hidden="true" class="hero__glow"></div>
<div class="hero__content">
<div class="hero__mono-label mono-label"><%= LightekDesign::Catalog.value(section, "text_3", "Vallejo, California · Est. 2020 · Black Liberation") %></div>
<h1 class="hero__title">
<span class="hero__title-line">
<span class="hero__title-word"><%= LightekDesign::Catalog.value(section, "text_4", "The") %></span>
</span>
<span class="hero__title-line">
<span class="hero__title-word"><%= LightekDesign::Catalog.value(section, "text_5", "Movement") %></span>
</span>
<span class="hero__title-line">
<span class="hero__title-word"><%= LightekDesign::Catalog.value(section, "text_6", "Has a") %></span>
</span>
<span class="hero__title-line">
<span class="hero__title-word"><em><%= LightekDesign::Catalog.value(section, "text_7", "Name.") %></em></span>
</span>
</h1>
<div class="hero__bottom">
<p class="hero__desc">
<strong><%= LightekDesign::Catalog.value(section, "text_8", "Young Black Nameless Coalition") %></strong><%= LightekDesign::Catalog.value(section, "text_9", "— empowering young Black individuals, dismantling systemic barriers, and amplifying Black voices. Community-driven. Unapologetic. Built for liberation.") %></p>
<div class="hero__actions">
<a class="btn btn--red btn--xl" href="<%= LightekDesign::Catalog.safe_url(LightekDesign::Catalog.value(section, "link_1", "#involved"), image: false) %>"><%= LightekDesign::Catalog.value(section, "text_10", "Join the Coalition") %><span class="btn__arr"><%= LightekDesign::Catalog.value(section, "text_11", "→") %></span>
</a>
<a class="btn btn--outline btn--xl" href="<%= LightekDesign::Catalog.safe_url(LightekDesign::Catalog.value(section, "link_2", "#mission"), image: false) %>"><%= LightekDesign::Catalog.value(section, "text_12", "Our Mission") %></a>
</div>
</div>
</div>
<div class="hero__footer-bar" role="complementary">
<span class="hero__footer-bar-text"><%= LightekDesign::Catalog.value(section, "text_13", "Founded by") %><strong><%= LightekDesign::Catalog.value(section, "text_14", "Ashley Dorelus") %></strong><%= LightekDesign::Catalog.value(section, "text_15", "· Documentary Filmmaker · Social Justice Advocate · Community Hero Award Recipient") %></span>
<span class="hero__footer-bar-text"><%= LightekDesign::Catalog.value(section, "text_16", "🇭🇹 Vallejo, CA · Active since") %><strong><%= LightekDesign::Catalog.value(section, "text_17", "May 29, 2020") %></strong>
</span>
</div>
</section>
</div>
