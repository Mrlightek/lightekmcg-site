<div class="lt-design-ybnc" data-design-section="ybnc_involved">
<section class="involved section" id="involved">
<div class="container">
<div class="involved__header reveal">
<div class="mono-label" style="justify-content: center; margin-bottom: var(--sp-3);"><%= LightekDesign::Catalog.value(section, "text_5", "Take Action") %></div>
<h2 class="headline" style="font-size: clamp(2.5rem, 6vw, 5.5rem); color: var(--cream);"><%= LightekDesign::Catalog.value(section, "text_6", "How You") %><span style="color: var(--red);"><%= LightekDesign::Catalog.value(section, "text_7", "Show Up.") %></span>
</h2>
<p style="margin-top: var(--sp-4); font-style: italic; color: var(--text-secondary); font-size: 1rem;"><%= LightekDesign::Catalog.value(section, "text_8", "The comments section is not the same as showing up. Here's how to make it tangible.") %></p>
</div>
<div class="involved__grid">
<div class="involve-card reveal">
<div class="involve-card__num"><%= LightekDesign::Catalog.value(section, "text_9", "01 / Join") %></div>
<div aria-hidden="true" class="involve-card__icon"><%= LightekDesign::Catalog.value(section, "text_10", "✊") %></div>
<h3 class="involve-card__title"><%= LightekDesign::Catalog.value(section, "text_11", "Join the Coalition") %></h3>
<p class="involve-card__desc"><%= LightekDesign::Catalog.value(section, "text_12", "Become a member of YBNC. Show up to meetings, events, and actions. Be part of the organizing infrastructure that makes sustained change possible.") %></p>
<a class="btn btn--red" href="<%= LightekDesign::Catalog.safe_url(LightekDesign::Catalog.value(section, "link_1", "#newsletter"), image: false) %>"><%= LightekDesign::Catalog.value(section, "text_13", "Become a Member →") %></a>
</div>
<div class="involve-card involve-card--donate reveal d1">
<div class="involve-card__num"><%= LightekDesign::Catalog.value(section, "text_14", "02 / Donate") %></div>
<div aria-hidden="true" class="involve-card__icon"><%= LightekDesign::Catalog.value(section, "text_15", "💛") %></div>
<h3 class="involve-card__title"><%= LightekDesign::Catalog.value(section, "text_16", "Fund the Work") %></h3>
<p class="involve-card__desc"><%= LightekDesign::Catalog.value(section, "text_17", "Tangible support — financial contributions, sponsorships, and partnerships — fuel everything. Frontline documentation, events, resources, advocacy all require investment.") %></p>
<a class="btn btn--gold" href="<%= LightekDesign::Catalog.safe_url(LightekDesign::Catalog.value(section, "link_2", "#"), image: false) %>"><%= LightekDesign::Catalog.value(section, "text_18", "Donate Now →") %></a>
</div>
<div class="involve-card reveal d2">
<div class="involve-card__num"><%= LightekDesign::Catalog.value(section, "text_19", "03 / Volunteer") %></div>
<div aria-hidden="true" class="involve-card__icon"><%= LightekDesign::Catalog.value(section, "text_20", "🌱") %></div>
<h3 class="involve-card__title"><%= LightekDesign::Catalog.value(section, "text_21", "Volunteer Your Skills") %></h3>
<p class="involve-card__desc"><%= LightekDesign::Catalog.value(section, "text_22", "Legal support, graphic design, event organizing, social media, outreach, translation, journalism — bring what you have and put it in service of the community.") %></p>
<a class="btn btn--outline" href="<%= LightekDesign::Catalog.safe_url(LightekDesign::Catalog.value(section, "link_3", "#newsletter"), image: false) %>"><%= LightekDesign::Catalog.value(section, "text_23", "Get Involved →") %></a>
</div>
</div>

<div class="reveal" style="margin-top: 2rem; padding: 2.5rem; background: var(--dark); border: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 3rem; flex-wrap: wrap;">
<div>
<div class="mono-label" style="margin-bottom: var(--sp-3);"><%= LightekDesign::Catalog.value(section, "text_24", "Partnerships & Collaborations") %></div>
<p style="font-size: 0.95rem; font-weight: 300; color: var(--text-secondary); max-width: 500px; line-height: 1.7;"><%= LightekDesign::Catalog.value(section, "text_25", "Organizations, media outlets, lawyers, funders, and community groups — reach out to discuss how we can build together. Coalition work requires coalition.") %></p>
</div>
<a class="btn btn--outline btn--lg" href="<%= LightekDesign::Catalog.safe_url(LightekDesign::Catalog.value(section, "link_4", "#newsletter"), image: false) %>"><%= LightekDesign::Catalog.value(section, "text_26", "Get In Touch →") %></a>
</div>
</div>
</section>
</div>
