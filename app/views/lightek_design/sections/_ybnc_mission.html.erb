<div class="lt-design-ybnc" data-design-section="ybnc_mission">
<section class="mission section" id="mission">
<div class="container">
<div class="mission__grid">
<div class="mission__label-col reveal">
<div aria-hidden="true" class="mission__counter"><%= LightekDesign::Catalog.value(section, "text_1", "01") %></div>
<div class="mono-label" style="writing-mode: horizontal-tb; margin-bottom: var(--sp-4);"><%= LightekDesign::Catalog.value(section, "text_2", "Our Mission") %></div>
<div aria-hidden="true" class="mission__side-text"><%= LightekDesign::Catalog.value(section, "text_3", "YBNC · VALLEJO, CA · BLACK LIBERATION") %></div>
</div>
<div>
<div class="mono-label reveal"><%= LightekDesign::Catalog.value(section, "text_4", "Mission Statement") %></div>
<h2 class="mission__statement reveal d1"><%= LightekDesign::Catalog.value(section, "text_5", "Fostering unity and empowerment —") %><em><%= LightekDesign::Catalog.value(section, "text_6", "helping Black individuals thrive") %></em><%= LightekDesign::Catalog.value(section, "text_7", "and contribute to a more equitable society.") %></h2>
<p class="mission__body reveal d2"><%= LightekDesign::Catalog.value(section, "text_8", "The Young Black Nameless Coalition was born from a simple, radical idea: that the people historically erased from power deserve a platform built in their name. We organize, advocate, document, and amplify — because representation without action is just performance.") %></p>
<p class="mission__body reveal d2"><%= LightekDesign::Catalog.value(section, "text_9", "We center the experiences of young Black individuals in every decision we make. From street-level advocacy to policy change, from community care to political organizing — YBNC exists at the intersection of where movement-building actually happens.") %></p>
<blockquote class="mission__pull-quote reveal d3">
<p class="mission__pull-quote-text"><%= LightekDesign::Catalog.value(section, "text_10", "\"We will be here every day and every night until we see some justice. The support in the comments is not the same as tangible support in the form of showing up.\"") %></p>
<footer class="mission__pull-quote-attr"><%= LightekDesign::Catalog.value(section, "text_11", "— Ashley Dorelus, Founder · YBNC") %></footer>
</blockquote>
</div>
</div>
</div>
</section>
</div>
