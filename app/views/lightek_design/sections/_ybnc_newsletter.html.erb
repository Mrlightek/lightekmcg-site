<div class="lt-design-ybnc" data-design-section="ybnc_newsletter">
<section aria-label="Join the YBNC community" class="newsletter" id="newsletter">
<div class="container">
<div class="newsletter__inner">
<div class="newsletter__label"><%= LightekDesign::Catalog.value(section, "text_1", "Stay Connected") %></div>
<h2 class="newsletter__title"><%= LightekDesign::Catalog.value(section, "text_2", "Be Part") %><br/><%= LightekDesign::Catalog.value(section, "text_3", "of the") %><em><%= LightekDesign::Catalog.value(section, "text_4", "Fight.") %></em>
</h2>
<p class="newsletter__sub"><%= LightekDesign::Catalog.value(section, "text_5", "Get updates on actions, events, and how to plug in. No spam — just the movement news that matters.") %></p>
<div aria-label="Newsletter signup" class="newsletter__form" data-demo-signup="true">
<input aria-disabled="true" aria-label="Email address" class="newsletter__input" disabled="disabled" placeholder="Your email address" required="" type="email"/>
<button aria-disabled="true" class="newsletter__submit" disabled="disabled" type="submit"><%= LightekDesign::Catalog.value(section, "text_6", "Join YBNC →") %></button>
<p class="lt-demo-note" role="status">Signup is not connected yet.</p></div>
<p class="newsletter__note"><%= LightekDesign::Catalog.value(section, "text_7", "Your information will never be sold or shared. This is a community, not a product.") %></p>
</div>
</div>
</section>
</div>
