<% content_for :title, "#{@listing.title} · Lightek Marketplace" %>
<% if @draft_preview %><div class="lm-review-note">Private product preview · <%= link_to "Back to product editor", main_app.edit_dashboard_marketplace_listing_path(@listing) %></div><% end %>
<%= link_to "← All services", main_app.marketplace_path, class: "lm-textbutton" %>
<div class="lm-detail"><div><p class="lm-eyebrow"><%= DymondCatalog::MarketplaceListing.category_labels.fetch(@listing.category) %></p><h1><%= @listing.marketing_headline.presence || @listing.title %></h1><p class="lm-lead"><%= @listing.marketing_subheadline.presence || @listing.summary %></p><% if @listing.best_for.present? %><p><strong>Best for:</strong> <%= @listing.best_for %></p><% end %><% if @listing.marketing_features.any? %><h2>Everything included</h2><ul class="lm-feature-list"><% @listing.marketing_features.each do |feature| %><li><%= feature %></li><% end %></ul><% end %><% if @listing.fulfillment_summary.present? %><h2>After you subscribe</h2><p><%= @listing.fulfillment_summary %></p><% end %><% if @listing.marketing_faq.any? %><h2>Frequently asked questions</h2><% @listing.marketing_faq.each do |faq| %><details class="lm-faq"><summary><%= faq["question"] %></summary><p><%= faq["answer"] %></p></details><% end %><% end %><%= render "marketplace/art", category: @listing.category %></div><aside class="lm-detail-price"><span class="lm-tag">YOUR PLAN</span><h2><%= @offer.name %></h2>
<% if @intervals.length > 1 %><%= form_with url: (@draft_preview ? main_app.preview_dashboard_marketplace_listing_path(@listing) : main_app.marketplace_listing_path(@listing)), method: :get, class: "lm-fields" do %><label>Billing period<%= select_tag :interval, options_for_select(@intervals.map { |v| [v.humanize, v] }, @interval) %></label><%= submit_tag "Update price", class: "lm-action secondary" %><% end %><% end %>
<div class="lm-checkline"><span>Due today</span><strong><%= marketplace_money(@preview.fetch(:due_today_cents), @offer.currency) %></strong></div>
<% if @preview[:recurring_cents].to_i.positive? %><div class="lm-checkline"><span>Recurring / <%= @interval == "annual" ? "year" : "month" %></span><strong><%= marketplace_money(@preview[:recurring_cents], @offer.currency) %></strong></div><% end %>
<div class="lm-checkline"><span><%= @offer.meta.to_h.dig("lightek_marketplace", "billing") == "once" ? "One-time total, including setup" : "Setup fee" %></span><span><%= marketplace_money(@preview[:setup_fee_cents].to_i, @offer.currency) %></span></div><div class="lm-checkline"><span>Free trial</span><span><%= @preview[:trial_days].to_i.positive? ? "#{@preview[:trial_days]} days" : "None" %></span></div>
<p class="lm-muted lm-small"><%= @preview[:terms].to_s %></p>
<% if @draft_preview %><div class="lm-review-note">Checkout is available after this product is published.</div><% else %><%= link_to "Continue to checkout →", marketplace_checkout_url(@offer, @interval), class: "lm-action", data: {turbo: false} %><p class="lm-muted lm-small">Sign in to review and confirm your order.</p><% end %></aside></div>
