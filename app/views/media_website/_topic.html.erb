<% content_for :description, intro %>
<section class="media-hero media-hero--topic">
  <div class="media-wrap">
    <p class="media-kicker"><%= @title %></p>
    <h1><%= headline %></h1>
    <p><%= intro %></p>
    <div class="media-actions">
      <%= render "inquiry", label: action, subject: subject, prompts: prompts %>
      <% if @agency_demo_available %>
        <%= link_to "Request an agency demo", request_agency_demo_path, class: "media-button media-button--outline" %>
      <% end %>
    </div>
    <small>Opens your email app.</small>
  </div>
</section>
<div class="media-wrap media-section media-split">
  <%= yield %>
</div>
