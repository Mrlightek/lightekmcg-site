<div class="lr-section-heading"><div><span class="lr-eyebrow">YOUR RESORT EARNINGS</span><h1><%= @site.name %></h1><p>Sales, protected infrastructure costs, and your earnings in one place.</p></div><%= link_to 'Add or manage payout account ↗', dashboard_susu_payout_account_path, class: 'lr-button' %></div><section class="lr-card"><h2>Your payday</h2><%= form_with url: resort_earnings_schedule_path(peer: @peer.key), method: :patch, class: 'lr-form' do %><label>Automatic earnings release<%= select_tag :cadence, options_for_select([['Every two weeks','biweekly'],['Every week','weekly']], @payout_schedule.cadence) %></label><label><span><%= check_box_tag :enabled, '1', @payout_schedule.enabled? %> Enable automatic releases</span></label><%= submit_tag 'Save payout schedule', class: 'lr-button' %><% end %><p>Next release: <%= @payout_schedule.next_run_at.in_time_zone('America/New_York').strftime('%B %-d, %Y · %-I:%M %p %Z') %>. Stripe controls bank arrival after release.</p><% if @payout_schedule.last_error.present? %><p class="lr-alert"><%= @payout_schedule.last_error %></p><% end %></section><section class="lr-card" style="margin-top:20px"><h2>Fulfilled sales</h2><div class="lr-table-wrap"><table class="lr-table"><thead><tr><th>Order</th><th>Sale</th><th>Infrastructure + margin</th><th>Net earnings</th><th>Release</th></tr></thead><tbody><% @orders.each do |order| %><% quote = LightekCommerce::MerchantPayouts.fee_quote(order) %><tr><td>#<%= order.id %></td><td><%= number_to_currency(quote[:gross_cents] / 100.0) %></td><td><%= number_to_currency(quote[:infrastructure_reserve_cents] / 100.0) %></td><td><%= number_to_currency(quote[:net_cents] / 100.0) %></td><td><%= order.merchant_transfer_ref.present? ? 'Released' : 'Awaiting scheduled release' %></td></tr><% end %></tbody></table></div></section>
