<% content_for :title, "Set your password · Lightek" %>
<main class="auth-shell">
  <section class="auth-story" aria-label="Lightek">
    <a class="auth-brand" href="/" aria-label="Lightek home">
      <img src="/lightek/lightek-auth-mark.svg" alt="" width="46" height="46">
      <span class="auth-wordmark">Light<span>ek</span></span>
    </a>
    <div class="auth-story-copy">
      <p class="auth-kicker">Your space. Your next chapter.</p>
      <h2>A fresh start.<br><em>All yours.</em></h2>
      <p>Your application is ready. Choose a password and make yourself at home.</p>
    </div>
  </section>
  <section class="auth-panel" aria-labelledby="password-title">
    <div class="auth-card">
      <p class="auth-card-kicker">Secure account access</p>
      <h1 id="password-title">Make it<br><span>yours.</span></h1>
      <p class="auth-intro">Set a new password to sign in to your application. Your email address stays the same.</p>
      <% if flash[:alert].present? %><div class="auth-flash" role="alert"><%= flash[:alert] %></div><% end %>
      <%= form_with url: password_path(params[:token]), method: :put, class: "auth-form", data: {turbo: false} do |form| %>
        <div class="auth-field">
          <%= form.label :password, "New password" %>
          <%= form.password_field :password, class: "auth-input auth-input-plain", required: true, autocomplete: "new-password", placeholder: "Choose a strong password", maxlength: 72, aria: {describedby: "password-guidance"} %>
          <p class="auth-field-help" id="password-guidance">Use a unique password or a passphrase. Your password manager can help.</p>
        </div>
        <div class="auth-field">
          <%= form.label :password_confirmation, "Confirm new password" %>
          <%= form.password_field :password_confirmation, class: "auth-input auth-input-plain", required: true, autocomplete: "new-password", placeholder: "Enter it once more", maxlength: 72 %>
        </div>
        <%= form.submit "Save password & continue →", class: "auth-submit" %>
      <% end %>
      <p class="auth-footnote">This private setup link expires after 20 minutes.<br>After saving, sign in with your new password.</p>
      <div class="auth-divider">Already have access?</div>
      <%= link_to "Back to sign in", new_session_path, class: "auth-secondary" %>
    </div>
  </section>
</main>
