<% content_for :title, "Reset your password · Lightek" %>
<main class="auth-shell">
  <section class="auth-story" aria-label="Lightek">
    <a class="auth-brand" href="/" aria-label="Lightek home">
      <img src="/lightek/lightek-auth-mark.svg" alt="" width="46" height="46">
      <span class="auth-wordmark">Light<span>ek</span></span>
    </a>
    <div class="auth-story-copy">
      <p class="auth-kicker">Your space is waiting.</p>
      <h2>Pick up<br><em>where you left off.</em></h2>
      <p>Your stories, your community, your work. Let's get you back to it.</p>
    </div>
  </section>
  <section class="auth-panel" aria-labelledby="password-title">
    <div class="auth-card">
      <p class="auth-card-kicker">Lightek account recovery</p>
      <h1 id="password-title">Find your<br><span>way back.</span></h1>
      <p class="auth-intro">Enter your account email and we'll send you a link to choose a new password.</p>
      <% if flash[:alert].present? %><div class="auth-flash" role="alert"><%= flash[:alert] %></div><% end %>
      <%= form_with url: passwords_path, class: "auth-form", data: {turbo: false} do |form| %>
        <div class="auth-field">
          <%= form.label :email_address, "Email address" %>
          <%= form.email_field :email_address, class: "auth-input auth-input-plain", required: true, autocomplete: "username", inputmode: "email", autocapitalize: "none", spellcheck: false, placeholder: "you@example.com", value: params[:email_address] %>
        </div>
        <%= form.submit "Send reset link →", class: "auth-submit" %>
      <% end %>
      <div class="auth-divider">Remember your password?</div>
      <%= link_to "Back to sign in", new_session_path, class: "auth-secondary" %>
      <p class="auth-footnote">Setting up a new application? You can also open password setup from your installation page on Lightek.</p>
    </div>
  </section>
</main>
