<% content_for :title, "Edit My Space — Lightek" %>

<main class="profile-editor">
  <div class="space-wrap">
    <header class="profile-editor-head">
      <span class="space-eyebrow">My Space</span>

      <h1>Shape your public identity.</h1>

      <p>
        Your account name and private contact information stay separate.
        Only the profile fields below are presented as your public
        Lightek identity.
      </p>
    </header>

    <%= render "form",
               profile: @profile %>
  </div>
</main>
