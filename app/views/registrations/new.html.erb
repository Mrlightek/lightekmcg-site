<% content_for :title, "Create account · #{authentication_branding.name}" %>
<main class="auth-shell">
  <%= render "authentication/story" %>
  <section class="auth-panel" aria-labelledby="registration-title"><div class="auth-card">
    <p class="auth-card-kicker"><%= authentication_branding.name %> account</p>
    <h1 id="registration-title">Your story<br><span>starts here.</span></h1>
    <p class="auth-intro">Create your account and join <%= authentication_branding.name %>.</p>
    <% if @user.errors.any? %><div class="auth-flash" role="alert"><%= @user.errors.full_messages.to_sentence %></div><% end %>
    <% if flash[:alert] %><div class="auth-flash" role="alert"><%= flash[:alert] %></div><% end %>
    <%= form_with model: @user, url: registrations_path, class: "auth-form", data: {turbo: false} do |form| %>
      <% {first_name: "First name", last_name: "Last name"}.each do |key, label| %>
        <div class="auth-field"><%= form.label key, label %><%= form.text_field key, class: "auth-input auth-input-plain", required: true, autocomplete: key == :first_name ? "given-name" : "family-name" %></div>
      <% end %>
      <div class="auth-field"><%= form.label :email_address, "Email address" %><%= form.email_field :email_address, class: "auth-input auth-input-plain", required: true, autocomplete: "username", autocapitalize: "none", spellcheck: false %></div>
      <% {password: "Password", password_confirmation: "Confirm password"}.each do |key, label| %>
        <div class="auth-field"><%= form.label key, label %><%= form.password_field key, class: "auth-input auth-input-plain", required: true, autocomplete: "new-password", maxlength: 72 %></div>
      <% end %>
      <%= form.submit "Create account →", class: "auth-submit" %>
    <% end %>
    <div class="auth-divider">Already have an account?</div>
    <%= link_to "Sign in", new_session_path, class: "auth-secondary" %>
  </div></section>
</main>
