<div class="lr-section-heading"><div><span class="lr-eyebrow">YOUR BUSINESS, CONNECTED</span><h2>Server resort experiences</h2><p>Your own private Lightek server, booked through <%= site.name %>.</p></div></div><div class="lr-grid"><% network.fetch('offers').select { |offer| offer['published'] }.each do |offer| %><article class="lr-card"><span class="lr-badge">Server resort</span><h2><%= offer['name'] %></h2><p><%= offer['description'] %></p><div class="lr-price"><%= number_to_currency(offer['price_cents'] / 100.0) %><small>Per <%= offer['billing_interval'] == 'annual' ? 'year' : 'month' %></small></div><ul class="lr-amenities"><% offer['accommodations'].each do |item| %><li>✓ <%= item %></li><% end %></ul><%= form_with url: my_reservations_path, data: {turbo: false}, class: 'lr-form' do %><%= hidden_field_tag :site_id, site.id %><%= hidden_field_tag :network_offer_id, offer['id'] %><%= hidden_field_tag :checkout_key, SecureRandom.uuid %><label>Starts · <%= offer['timezone'] %><%= datetime_local_field_tag :starts_at, nil, required: true %></label><p class="lr-muted">Continue to your Lightek account for secure payment and server access. Your seller receives earnings after protected infrastructure costs.</p><%= submit_tag 'Reserve on Lightek ↗', class: 'lr-button' %><% end %></article><% end %></div>
