<section class="lr-hero"><div><span class="lr-eyebrow">A PLACE FOR WHAT YOU DO</span><h1>Your experience.<br>Your own space.</h1><p>Reserve a server built for your business, a creative session, or time with someone who can help you move forward.</p><a class="lr-button" href="#experiences">Find your experience ↗</a></div><div class="lr-orbit" aria-hidden="true"><div class="lr-orbit-inner">L<span>ROOM TO CREATE</span></div><span class="lr-float">Servers · Sessions · Services</span></div></section>
<div class="lr-section-heading" id="experiences"><div><span class="lr-eyebrow">MAKE IT YOURS</span><h2>What brings you here?</h2></div><%= link_to 'All experiences', reservations_catalog_path(site_id: @site&.id), class: 'lr-link' %></div>
<div class="lr-filters"><% LightekDesign::StarterLibrary.designs.each do |key, design| %><%= link_to design['industry'].to_s.humanize, reservations_catalog_path(site_id: @site&.id, industry: key), class: "lr-chip#{' selected' if @industry == key}" %><% end %></div>
<% if @network %><%= render 'reservations/network_offers', network: @network, site: @site %><% end %>
<div class="lr-grid"><% @resources.each do |resource| %><article class="lr-card"><span class="lr-badge"><%= resource.kind.humanize %></span><h2><%= resource.name %></h2><p><%= resource.description %></p><div class="lr-price"><%= resource.price_cents.zero? ? 'Complimentary' : number_to_currency(resource.price_cents / 100.0) %><small><%= resource.server? ? "/ #{resource.billing_interval == 'annual' ? 'year' : 'month'}" : "/ #{resource.duration_minutes} min · per person" %></small></div><ul class="lr-amenities"><% resource.accommodations.each do |item| %><li>✓ <%= item %></li><% end %></ul>
<%= form_with url: my_reservations_path, method: :post, data: {turbo: false, reservation_slots: !resource.server?}, class: 'lr-form' do %><%= hidden_field_tag :resource_id, resource.id %><%= hidden_field_tag :site_id, @site.id %><%= hidden_field_tag :checkout_key, SecureRandom.uuid %><label>Arrival / start · <%= resource.timezone %><%= datetime_local_field_tag :starts_at, nil, required: true %></label><% unless resource.server? %><div class="lr-slots" data-slots-output aria-live="polite"></div><label>Guests / participants<%= number_field_tag :quantity, 1, min: 1, max: resource.capacity, required: true %></label><% end %><label>Anything we should know?<%= text_area_tag :notes, nil, maxlength: 3000, rows: 2 %></label><p class="lr-muted"><%= resource.server? ? 'Your isolated server is prepared after verified payment, at your reserved start time. Renew before the paid term ends; unpaid compute pauses after a three-day grace period.' : "Reserve at least #{resource.notice_minutes} minutes ahead. A paid hold lasts until checkout expiry is confirmed." %></p><%= submit_tag 'Reserve this experience ↗', class: 'lr-button' %><% end %></article><% end %></div>
<% if @resources.empty? && @network.to_h.fetch('offers', []).none? { |offer| offer['published'] } %><section class="lr-card lr-empty"><h2>Your next experience is on its way.</h2><p>No published experiences match this selection yet.</p><% if current_user&.role.in?(%w[admin super_admin]) %><%= link_to 'Create reservation experiences', dashboard_reservations_path(site_id: @site&.id), class: 'lr-button' %><% end %></section><% end %>
