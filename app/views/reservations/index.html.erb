<% Array(@network_reservations).each do |reservation| %><article class="lr-card"><span class="lr-badge"><%= reservation['status'].humanize %></span><h2><%= reservation['name'] %></h2><p><%= reservation['reference'] %> · <%= reservation['starts_at'] %></p><%= link_to 'Manage my network reservation ↗', reservation['url'], class: 'lr-button', rel: 'noopener' %></article><% end %>
<div class="lr-section-heading"><div><span class="lr-eyebrow">YOUR PERSONAL CONCIERGE</span><h1>My reservations</h1><p>Every space, session, and next step. Together.</p></div><%= link_to 'Book an experience ↗', reservations_catalog_path, class: 'lr-button' %></div>
<% if @central_reservation && @central_reservation['manage_url'].to_s.start_with?('https://') %><article class="lr-card"><h2>Your server resort reservation</h2><p><%= @central_reservation['name'] %> · <%= @central_reservation['reference'] %></p><%= link_to 'Manage my server package ↗', @central_reservation['manage_url'], class: 'lr-button', rel: 'noopener' %></article><% end %>
<div class="lr-grid"><% @reservations.each do |reservation| %><article class="lr-card"><span class="lr-badge"><%= reservation.status.humanize %></span><h2><%= reservation.package_snapshot['name'] %></h2><p><%= reservation.resource.site.name %></p><p><%= reservation.starts_at.in_time_zone(reservation.package_snapshot['timezone']).strftime('%b %-d, %Y · %-I:%M %p %Z') %></p><small><%= reservation.reference %></small><p><%= link_to 'Manage reservation ↗', my_reservation_path(reservation), class: 'lr-link' %></p></article><% end %></div><% if @reservations.empty? && !@central_reservation %><section class="lr-card lr-empty"><h2>Make room for something good.</h2><p>Your reservations will appear here as soon as you book.</p></section><% end %>
