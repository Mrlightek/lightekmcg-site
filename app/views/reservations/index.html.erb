<% content_for :page_title, "My reservations" %>
<header class="lr-section-heading"><div><span class="lr-eyebrow">Your bookings</span><h1>My reservations</h1><p>Review your dates, access your sessions and manage your bookings.</p></div><%= link_to 'Book an experience', reservations_catalog_path, class: 'lr-button' %></header>
<div class="lr-booking-list">
  <% @reservations.each do |reservation| %>
    <article class="lr-card lr-booking-row">
      <div><span class="lr-badge"><%= reservation.status.humanize %></span><h2><%= reservation.package_snapshot['name'] %></h2><p><%= reservation.resource.site.name %></p><small><%= reservation.reference %></small></div>
      <div><time datetime="<%= reservation.starts_at.iso8601 %>"><%= reservation.starts_at.in_time_zone(reservation.package_snapshot['timezone']).strftime('%b %-d, %Y · %-I:%M %p %Z') %></time><p><%= pluralize(reservation.quantity, 'participant') %></p></div>
      <%= link_to 'Manage booking', my_reservation_path(reservation), class: 'lr-button secondary' %>
    </article>
  <% end %>
</div>
<% if @central_reservation && @central_reservation['manage_url'].to_s.start_with?('https://') %><section class="lr-card lr-network-bookings"><div><span class="lr-eyebrow">Lightek network</span><h2>Your server reservation</h2><p><%= @central_reservation['name'] %> · <%= @central_reservation['reference'] %></p></div><%= link_to 'Manage server package', @central_reservation['manage_url'], class: 'lr-button secondary', rel: 'noopener' %></section><% end %>
<% if Array(@network_reservations).any? %><section class="lr-network-bookings"><h2>Network reservations</h2><% @network_reservations.each do |reservation| %><article class="lr-card lr-booking-row"><div><span class="lr-badge"><%= reservation['status'].humanize %></span><h2><%= reservation['name'] %></h2><small><%= reservation['reference'] %></small></div><p><%= reservation['starts_at'] %></p><%= link_to 'Manage booking', reservation['url'], class: 'lr-button secondary', rel: 'noopener' %></article><% end %></section><% end %>
<% if @reservations.empty? && !@central_reservation && Array(@network_reservations).empty? %><section class="lr-card lr-empty"><h2>No reservations yet</h2><p>Choose an experience to make your first booking. Your dates and session access will appear here.</p></section><% end %>
