<%= link_to '← My reservations', my_reservations_path, class: 'lr-link' %><div class="lr-section-heading"><div><span class="lr-eyebrow"><%= @reservation.reference %></span><h1><%= @reservation.package_snapshot['name'] %></h1><p><%= @resource.site.name %> · <span class="lr-badge"><%= @reservation.status.humanize %></span></p></div><%= link_to 'Add to calendar', calendar_my_reservation_path(@reservation), class: 'lr-button secondary' %></div>
<div class="lr-detail-grid"><article class="lr-card"><h2>Your reservation</h2><dl class="lr-details"><dt>Starts</dt><dd><%= @reservation.starts_at.in_time_zone(@reservation.package_snapshot['timezone']).strftime('%b %-d, %Y · %-I:%M %p %Z') %></dd><dt>Ends</dt><dd><%= @reservation.ends_at.in_time_zone(@reservation.package_snapshot['timezone']).strftime('%b %-d, %Y · %-I:%M %p %Z') %></dd><dt>Participants</dt><dd><%= @reservation.quantity %></dd><dt>Reserved rate</dt><dd><%= number_to_currency(@reservation.package_snapshot['price_cents'].to_i / 100.0) %><%= @reservation.server? ? " / #{@reservation.package_snapshot['billing_interval']} term" : ' per person' %></dd><dt>Location</dt><dd><%= @resource.location.presence || (@reservation.server? ? 'Your own Lightek server' : 'Provided by your host') %></dd></dl><ul class="lr-amenities"><% Array(@reservation.package_snapshot['accommodations']).each do |item| %><li>✓ <%= item %></li><% end %></ul>
<% if @reservation.status == 'held' %><p class="lr-muted">Your time is held while you complete payment. Payment is confirmed by the processor.</p><%= button_to 'Continue to secure payment ↗', checkout_my_reservation_path(@reservation), class: 'lr-button', data: {turbo: false} %><% end %>
<% if @reservation.access_ready? && @resource.native_session? %><%= button_to 'Enter Lightek session →', reservation_session_room_path(@reservation), class: 'lr-button', data: {turbo: false} %><% end %>
<% if @reservation.server? && @reservation.order %><p><%= link_to 'View server allocation & access ↗', installation_path(@reservation.order), class: 'lr-button' %></p><% elsif @reservation.access_ready? && @resource.join_url.present? %><%= link_to 'Join your session ↗', @resource.join_url, class: 'lr-button', rel: 'noopener' %><% end %>
<% if @reservation.status == 'payment_review' %><p class="lr-alert">Payment needs provider review. Your payment reference has been retained.</p><% end %></article>
<article class="lr-card"><h2><%= @reservation.server? ? 'Manage your server package' : 'Manage your booking' %></h2><% if @reservation.server? && %w[confirmed expired].include?(@reservation.status) %><p>Upgrade for the remaining paid term, or reserve a lower package for your next term. The price is calculated from your original booking. A change of server size can involve a restart. Renew before your term ends; after a three-day grace period unpaid server compute is paused. Your data is retained.</p><%= form_with url: quote_my_reservation_path(@reservation), class: 'lr-form' do %><label>Your next package<%= select_tag :target_resource_id, options_from_collection_for_select(@alternatives, :id, :name), required: true %></label><%= submit_tag 'Calculate my price', class: 'lr-button' %><% end %><% elsif @reservation.status == 'confirmed' && !@reservation.server? %><p>Changes must be made <%= @reservation.package_snapshot['cancellation_hours'] %> hours before your appointment. Refund requests are reviewed separately.</p><%= form_with url: reschedule_my_reservation_path(@reservation), method: :patch, class: 'lr-form' do %><label>New start · <%= @resource.timezone %><%= datetime_local_field_tag :starts_at, nil, required: true %></label><%= submit_tag 'Reschedule appointment', class: 'lr-button secondary' %><% end %><p><%= button_to 'Cancel reservation', cancel_my_reservation_path(@reservation), method: :post, class: 'lr-button secondary' %></p><% else %><p>Manage your reservation here after payment is confirmed.</p><% end %></article></div>
<% @changes.each do |change| %><article class="lr-card lr-quote"><div><span class="lr-eyebrow"><%= change.quote['renewal'] ? 'NEXT TERM · PREPAID RENEWAL' : 'PRORATED UPGRADE' %></span><h2><%= change.quote.dig('target', 'name') %></h2><p><%= number_to_currency(change.amount_cents / 100.0) %> before tax · Effective <%= change.effective_at.in_time_zone(@resource.timezone).strftime('%b %-d, %Y') %></p><p>Next full term: <%= number_to_currency(change.quote['renewal_price_cents'].to_i / 100.0) %>. <%= change.status.humanize %>.</p><% if change.error.present? %><p role="status"><%= change.error %></p><% end %></div><% if %w[quoted awaiting_payment].include?(change.status) && (change.order_id || change.expires_at > Time.current) %><%= button_to 'Accept & pay securely ↗', accept_change_my_reservation_path(@reservation, change_id: change.id), class: 'lr-button', data: {turbo: false} %><% end %></article><% end %>
