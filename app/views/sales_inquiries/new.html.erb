<% content_for :title, "Talk to sales | #{@site.name}" %>
<main class="auth-shell">
  <section class="auth-story" aria-label="<%= @site.name %>">
    <%= render 'authentication/brand' %>
    <div class="auth-story-copy">
      <h2>Talk with <%= @site.name %>.</h2>
      <p>Tell us what you’re looking for and we’ll follow up by email.</p>
    </div>
  </section>
  <section class="auth-panel">
    <div class="auth-card">
      <% if flash[:sales_inquiry_received] %>
        <h1>Inquiry received</h1>
        <p class="auth-intro" role="status">Thanks for reaching out. The sales team will use the email address you provided to follow up.</p>
        <%= link_to 'Back to the website', '/', class: 'auth-link' %>
      <% else %>
        <h1>Talk to sales</h1>
        <p class="auth-intro">Ask about pricing, a demo, or what would fit your business.</p>
        <% if @inquiry.errors.any? %>
          <div class="auth-field" role="alert"><ul><% @inquiry.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
        <% end %>
        <%= form_with scope: :sales_submission, url: sales_inquiry_path, local: true, data: {turbo: false} do |f| %>
          <% {name: ['Name', 'name'], email: ['Email', 'email'], company: ['Company (optional)', 'organization'], phone: ['Phone (optional)', 'tel']}.each do |field, (label, autocomplete)| %>
            <div class="auth-field">
              <%= f.label field, label %>
              <%= f.text_field field, value: @inquiry.fields[field.to_s], type: {email: 'email', phone: 'tel'}.fetch(field, 'text'),
                class: 'auth-input auth-input-plain', autocomplete: autocomplete, required: field.in?(%i[name email]),
                maxlength: WebsiteTemplateInquiry::SALES_FIELD_LIMITS.fetch(field) %>
            </div>
          <% end %>
          <div class="auth-field">
            <%= f.label :message, 'How can we help?' %>
            <%= f.text_area :message, value: @inquiry.fields['message'], class: 'auth-input auth-input-plain', rows: 4,
              style: 'height: auto; padding: 12px 18px; font: inherit; resize: vertical', required: true,
              maxlength: WebsiteTemplateInquiry::SALES_FIELD_LIMITS.fetch(:message) %>
          </div>
          <div hidden aria-hidden="true"><%= text_field_tag :website_url, nil, tabindex: -1, autocomplete: 'off' %></div>
          <%= f.submit(respond_to?(:experiment_text) ? experiment_text('sales_inquiry', 'Send inquiry') : 'Send inquiry', class: 'auth-submit') %>
        <% end %>
      <% end %>
    </div>
  </section>
</main>
