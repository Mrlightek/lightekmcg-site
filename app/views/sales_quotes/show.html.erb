<%= stylesheet_link_tag '/lightek/sales-workspace.css?v=3' %><main class="sales-workspace" style="padding:24px;max-width:1000px;margin:auto"><header class="sales-header"><div><span class="sales-eyebrow"><%= @quote.site.name %></span><h1>Your quote</h1></div></header><% if flash[:alert] %><p role="alert"><%= flash[:alert] %></p><% end %><%= render 'dashboard/sales_quotes/details', quote: @quote %>
<% if @quote.status == 'issued' && @quote.expires_on >= Date.current %><section class="sales-panel" style="margin-top:20px"><h2>Review and accept</h2><p>Acceptance records your agreement and creates an unpaid order. You can then review taxes and pay through the secure checkout.</p><%= form_with url: accept_public_sales_quote_path(token: params[:token]), class: 'sales-form' do %><label>Your name<%= text_field_tag :accepted_name, nil, required: true, maxlength: 160 %></label><label><%= check_box_tag :accepted, '1', false, required: true %> I reviewed and accept this quote's items, recurring interval where shown, and terms.</label><%= submit_tag 'Accept quote', class: 'sales-button' %><% end %></section>
<% elsif @quote.status == 'accepted' && @quote.order.status == 'pending_payment' %><section class="sales-panel" style="margin-top:20px"><h2>Complete your order</h2><%= button_to 'Review & pay securely', checkout_public_sales_quote_path(token: params[:token]), class: 'sales-button' %><p>Payment status updates only after processor confirmation. Returning from checkout alone does not mark the order paid.</p></section>
<% elsif @quote.status != 'accepted' %><p>This revision is expired or superseded. Ask the business for a current quote.</p><% end %></main>
