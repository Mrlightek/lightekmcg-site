<%= stylesheet_link_tag '/lightek/sessions/rooms.css?v=1' %>
<%= javascript_include_tag '/lightek/vendor/livekit-2.23.0.umd.js', defer: true %>
<%= javascript_include_tag '/lightek/sessions/room.js?v=1', defer: true %>
<section class="ls-room" data-session-room data-base="<%= session_room_path(@room.key) %>" data-host="<%= @host %>" data-voice="<%= @room.resource.kind == 'voice' %>">
  <header class="ls-header"><div><span class="lr-eyebrow">LIGHTEK / <%= @room.live? ? 'LIVE SESSION' : 'TOGETHER' %></span><h1><%= @room.resource.name %></h1><p><%= @site.name %> · <%= @room.starts_at.in_time_zone(@room.resource.timezone).strftime('%b %-d · %-I:%M %p %Z') %></p></div><span class="ls-status" data-status>Getting the room ready…</span></header>
  <div class="ls-layout"><section><div class="ls-stage" data-stage><p data-placeholder>Your space to connect. Join when you’re ready.</p></div><div class="ls-controls"><button type="button" data-join>Join session</button><button type="button" data-mic disabled>Microphone off</button><% unless @room.resource.kind == 'voice' %><button type="button" data-camera disabled>Camera off</button><button type="button" data-screen disabled>Share screen</button><% end %><button type="button" data-leave disabled>Leave</button><button type="button" data-audio>Enable speaker audio</button></div>
  <label class="ls-consent"><input type="checkbox" data-consent> I understand the host may broadcast this session to Lightek community and social channels. I’ll join when I’m ready to be seen or heard.</label>
  <p role="alert" data-error></p><p class="lr-muted">Your microphone and camera start off. Use headphones to prevent echo. Live-session audience members watch and chat; only the host publishes media.</p>
  <% if @host %><div class="ls-host"><h2>Host desk</h2><button type="button" data-control="open">Open room</button><button type="button" data-control="lock">Lock room</button><button type="button" data-control="unlock">Unlock room</button><button type="button" data-control="end">End for everyone</button><p><%= link_to 'Bring this session into Live Studio →', dashboard_live_path(session_room: @room.key), class: 'lr-button', target: '_blank', rel: 'noopener' %></p><p>Keep this room open when you enter Studio. Studio receives the session as a production source; you choose when and where to broadcast.</p><div data-lobby></div></div><% else %><details><summary>Assign a reserved place to a guest</summary><form data-invite><label>Guest’s Lightek account email<input type="email" name="email_address" required></label><button>Assign place</button></form><p data-invite-result></p></details><% end %>
  </section><aside class="ls-chat"><h2>In the room <span data-count>0</span></h2><ul data-roster></ul><h2>Conversation</h2><ol data-messages aria-live="polite"></ol><form data-chat><label>Message<input name="message" maxlength="1000" autocomplete="off" required></label><button disabled data-send>Send</button></form><p class="lr-muted">Room chat stays in the live session and is not saved as a transcript. Social comments appear in Studio’s audience desk where supported.</p></aside></div>
</section>
