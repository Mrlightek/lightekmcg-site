<% content_for :title, "Sign in · #{authentication_branding.name}" %>

<main class="auth-shell">
  <%= render "authentication/story" %>

  <section class="auth-panel">
    <div class="auth-card">
      <p class="auth-card-kicker">
        <%= authentication_branding.name %> account
      </p>

      <h1>
        Welcome <span>back.</span>
      </h1>

      <p class="auth-intro">
        Sign in to continue creating and managing
        your account.
      </p>

      <% if flash[:alert].present? %>
        <div
          class="auth-flash"
          role="alert"
        >
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice].present? %>
        <div
          class="auth-flash notice"
          role="status"
        >
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with(
        url: session_path,
        class: "auth-form"
      ) do |form| %>

        <div class="auth-field">
          <%= form.label(
            :email_address,
            "Email"
          ) %>

          <div class="auth-input-wrap">
            <svg
              class="auth-input-icon"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 6.5h18v11H3z"
                stroke="currentColor"
                stroke-width="1.7"
                rx="2"
              />
              <path
                d="m4 8 8 6 8-6"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <%= form.email_field(
              :email_address,
              class: "auth-input",
              required: true,
              autocomplete: "username",
              inputmode: "email",
              autocapitalize: "none",
              spellcheck: false,
              placeholder: "you@lightek.com",
              value: params[:email_address]
            ) %>
          </div>
        </div>

        <div class="auth-field">
          <%= form.label(
            :password,
            "Password"
          ) %>

          <div class="auth-input-wrap">
            <svg
              class="auth-input-icon"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <rect
                x="5"
                y="10"
                width="14"
                height="11"
                rx="2"
                stroke="currentColor"
                stroke-width="1.7"
              />
              <path
                d="M8 10V7a4 4 0 0 1 8 0v3"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              />
            </svg>

            <%= form.password_field(
              :password,
              class: "auth-input",
              required: true,
              autocomplete: "current-password",
              maxlength: 72,
              placeholder: "Enter your password"
            ) %>
          </div>
        </div>

        <div class="auth-meta">
          <%= link_to(
            "Forgot password?",
            new_password_path,
            class: "auth-link"
          ) %>
        </div>

        <%= form.submit(
          "Sign in →",
          class: "auth-submit"
        ) %>
      <% end %>

      <div class="auth-divider">
        New to <%= authentication_branding.name %>?
      </div>

      <%= link_to(
        "Create account",
        sign_up_path,
        class: "auth-secondary"
      ) %>

      <p class="auth-footnote">
        Your <%= authentication_branding.name %> account keeps your work and community in one place.
      </p>
    </div>
  </section>
</main>
