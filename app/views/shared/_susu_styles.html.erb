<style>
.susu-shell{max-width:1120px;margin:0 auto;padding:38px 22px 72px}.susu-narrow{max-width:760px}.susu-heading{margin-bottom:24px}.susu-heading h1{font-size:clamp(2rem,5vw,3.2rem);margin:.2rem 0}.susu-heading p{opacity:.72}.susu-eyebrow{font-size:.75rem;letter-spacing:.15em;text-transform:uppercase;opacity:.58}.susu-actions{display:flex;gap:10px;flex-wrap:wrap}.susu-primary-button,.susu-secondary-button,.susu-danger-button{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;padding:12px 16px;border-radius:12px;border:1px solid rgba(127,127,127,.3);font-weight:700;cursor:pointer}.susu-primary-button{background:#f4f4f6;color:#111;border-color:transparent}.susu-secondary-button{background:transparent;color:inherit}.susu-danger-button{background:transparent;color:inherit}.susu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}.susu-panel,.susu-card{border:1px solid rgba(127,127,127,.24);border-radius:18px;padding:22px;background:rgba(10,15,24,.22)}.susu-card h2,.susu-panel h2{margin-top:0}.susu-card-meta,.susu-stat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:16px 0}.susu-stat{border:1px solid rgba(127,127,127,.18);border-radius:14px;padding:14px}.susu-stat span{display:block;font-size:.78rem;opacity:.6}.susu-stat strong{display:block;margin-top:4px;font-size:1.05rem}.susu-badge{display:inline-flex;padding:5px 9px;border-radius:999px;border:1px solid rgba(127,127,127,.28);font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}.susu-badge--active,.susu-badge--succeeded{border-color:rgba(72,200,120,.6)}.susu-badge--pending{border-color:rgba(245,181,62,.65)}.susu-badge--failed{border-color:rgba(230,80,80,.65)}.susu-list{display:grid;gap:10px}.susu-member{display:grid;grid-template-columns:56px 1fr auto;gap:14px;align-items:center;padding:14px;border:1px solid rgba(127,127,127,.18);border-radius:14px}.susu-position{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(127,127,127,.28);font-weight:800}.susu-member small{display:block;opacity:.6;margin-top:3px}.susu-form{display:grid;gap:18px}.susu-form label{display:grid;gap:7px}.susu-form label span{font-size:.85rem;opacity:.72}.susu-form input,.susu-form select{width:100%;box-sizing:border-box;padding:13px 14px;border-radius:12px;border:1px solid rgba(127,127,127,.32);background:transparent;color:inherit;font:inherit}.susu-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.susu-summary{display:flex;justify-content:space-between;gap:20px;padding:14px 0;border-top:1px solid rgba(127,127,127,.2);border-bottom:1px solid rgba(127,127,127,.2)}.susu-alert{padding:12px 14px;border-radius:12px;border:1px solid rgba(220,90,90,.5)}.susu-section{margin-top:28px}.susu-section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:12px}.susu-empty{padding:28px;border:1px dashed rgba(127,127,127,.3);border-radius:18px;text-align:center;opacity:.72}.susu-inline-form{display:grid;grid-template-columns:1fr auto;gap:10px}.susu-note{font-size:.86rem;opacity:.65}.susu-status-line{display:flex;align-items:center;gap:10px;flex-wrap:wrap}@media(max-width:680px){.susu-form-grid,.susu-card-meta,.susu-stat-grid{grid-template-columns:1fr}.susu-member{grid-template-columns:48px 1fr}.susu-member>.susu-actions{grid-column:1/-1}.susu-inline-form{grid-template-columns:1fr}}
</style>
