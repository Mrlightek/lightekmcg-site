<%= turbo_frame_tag "macro_recent_runs" do %>
  <section aria-labelledby="macro-recent-runs-heading">
    <h2 id="macro-recent-runs-heading">Recent runs</h2>
    <% if @recent_runs.empty? %>
      <p>No runs yet.</p>
    <% else %>
      <ul class="macro-saved-list">
        <%= render partial: "studio/macro_maker/recent_run", collection: @recent_runs, as: :run %>
      </ul>
    <% end %>
  </section>
<% end %>
