<% content_for :title, "Susu Contribution" %>
<section class="susu-shell susu-narrow">
  <header class="susu-heading">
    <p class="susu-eyebrow">SUSU • ROUND <%= @susu_group.current_round_number %></p>
    <h1><%= @susu_group.name %></h1>
    <p>
      Make your contribution for this round.
      Your payout amount is not reduced by Dymond network fees.
    </p>
  </header>

  <% if params[:payment] == "processing" || @existing_contribution&.pending? || @existing_contribution&.status == "processing" %>
    <div class="susu-panel" style="margin-bottom:16px">
      <strong>Payment processing</strong>
      <p class="susu-note">
        Your bank payment was authorized. We’ll mark this round paid when ACH settlement is confirmed.
        No additional payment is needed.
      </p>
    </div>
  <% elsif params[:payment] == "cancelled" %>
    <div class="susu-panel" style="margin-bottom:16px">
      <strong>Payment cancelled</strong>
      <p class="susu-note">Nothing was recorded as paid.</p>
    </div>
  <% end %>

  <% if @existing_contribution&.succeeded? %>
    <div class="susu-panel">
      <p class="susu-eyebrow">ROUND PAID</p>
      <h2><%= number_to_currency(@existing_contribution.amount) %> settled</h2>
      <p>
        Your contribution for Round <%= @existing_contribution.round_number %>
        of Cycle <%= @existing_contribution.cycle_number %> is complete.
      </p>
      <%= link_to "Back to Susu", @susu_group, class: "susu-primary-button" %>
    </div>
  <% else %>
    <div class="susu-panel">
      <div class="susu-summary">
        <span>Your contribution</span>
        <strong><%= number_to_currency(@payment_quote.principal_cents / 100.0) %></strong>
      </div>

      <div class="susu-summary">
        <span>Dymond Network Fee</span>
        <strong><%= number_to_currency(@payment_quote.display_network_fee_cents / 100.0) %></strong>
      </div>

      <p class="susu-note">
        The network fee covers payment-network costs and Dymond’s service fee.
        It does not reduce your Susu contribution or future payout.
      </p>

      <div class="susu-summary">
        <span>Total today</span>
        <strong><%= number_to_currency(@payment_quote.total_cents / 100.0) %></strong>
      </div>

      <% if @existing_contribution&.pending? || @existing_contribution&.status == "processing" %>
        <div
          class="susu-secondary-button"
          style="width:100%;box-sizing:border-box;margin-top:18px;cursor:default"
        >
          ACH Processing
        </div>
      <% else %>
        <!-- Deliberately use a plain HTML POST form here.
             This removes Turbo/button_to from the submission path so the browser
             must make a normal POST directly to SusuGroupsController#contribute. -->
        <form
          action="<%= contribute_susu_group_path(@susu_group) %>"
          method="post"
          data-turbo="false"
          style="margin:0"
        >
          <input
            type="hidden"
            name="authenticity_token"
            value="<%= form_authenticity_token %>"
            autocomplete="off"
          >

          <button
            type="submit"
            class="susu-primary-button"
            style="width:100%;margin-top:18px"
          >
            Pay from Bank
          </button>
        </form>
      <% end %>
    </div>
  <% end %>

  <aside class="susu-panel" style="margin-top:16px">
    <div class="susu-summary">
      <span>Current round</span>
      <strong><%= @susu_group.current_round_number %> of <%= @susu_group.members.count %></strong>
    </div>

    <div class="susu-summary">
      <span>Cycle</span>
      <strong><%= @susu_group.current_cycle %></strong>
    </div>

    <% if (recipient = @susu_group.current_payout_recipient) %>
      <div class="susu-summary">
        <span>Current recipient</span>
        <strong>
          <%= recipient.respond_to?(:full_name) && recipient.full_name.present? ? recipient.full_name : recipient.email_address %>
        </strong>
      </div>
    <% end %>
  </aside>

  <div class="susu-actions" style="margin-top:16px">
    <%= link_to "Back to Susu", @susu_group, class: "susu-secondary-button" %>
    <%= link_to "All Susus", susu_groups_path, class: "susu-secondary-button" %>
  </div>
</section>
<%= render "shared/susu_styles" %>
