<% content_for :page_title, 'Payout account' %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><script src="/lightek/payout-accounts.js?v=20261115-recovery" defer></script><% end %>
<main class="dd-workspace" data-payout-state="<%= @payout_status[:state] %>" data-payout-workspace data-session-url="<%= dashboard_payout_account_session_path %>" data-status-url="<%= dashboard_payout_account_status_path %>">
  <header class="dd-page-header dd-page-hero"><div><span class="dd-eyebrow">Finance / Your earnings</span><h1>Your payout account</h1><p>Set up how you receive your earnings, keep your business details current, and manage your bank account in one place.</p></div><span class="dd-status" data-payout-badge data-tone="<%= @payout_status[:state] == 'ready' ? 'success' : 'warning' %>"><%= @payout_status[:state] == 'ready' ? 'Ready for payouts' : 'Verification required' %></span></header>
  <% if @payout_status[:replaceable] %>
    <section id="payout-repair" class="dd-form-section" data-payout-repair tabindex="-1"><h2>Repair an unavailable connection</h2><p class="dd-form-callout">Your saved payout connection cannot be accessed with this platform’s current configuration. First ask your administrator to check the platform credentials. If you choose to start a new connection, the old reference is kept for reconciliation. Existing balances and completed payouts are not moved to the new account.</p>
      <%= form_with url: replace_dashboard_payout_account_path, method: :post, class: 'dd-form-stack', data: {turbo: false} do %>
        <label class="dd-check"><%= check_box_tag :confirm_replacement, '1', false, required: true %> I understand that a new connection does not recover an old balance.</label>
        <%= submit_tag 'Create a new payout connection', class: 'dd-button dd-button-danger' %>
      <% end %>
    </section>
  <% end %>
  <section class="dd-form-section">
    <div class="dd-section-heading"><i class="ti ti-building-bank" aria-hidden="true"></i><div><h2>Set up & manage payouts</h2><p>For business owners, agencies, and individual clients. Each person manages their own payout information.</p></div></div>
    <p class="dd-form-callout">Your bank, tax, and identity details are collected in secure verification fields. Full account numbers and identity documents are not saved in Lightek forms or request logs. Any required verification or financial-service terms are presented inside the secure workflow.</p>
    <p data-payout-status role="status" aria-live="polite"><%= {'not_started'=>'Add your business or individual details and the bank account where you want to receive payouts.', 'ready'=>'Your account was verified and is enabled to receive payouts. You can still update your details below.', 'pending_verification'=>'Your information is under review. You can open setup to check for outstanding requirements.', 'needs_information'=>'Your payout setup needs more information. Open setup to complete verification.', 'unavailable'=>'We could not verify your payout connection. It is not currently marked ready. Try again, or ask your account administrator to check the connection.'}.fetch(@payout_status[:state]) %></p>
    <% if @payout_status[:state] == 'unavailable' %>
      <p class="dd-form-callout"><%= @payout_status[:replaceable] ? 'Your saved connection is inaccessible. Review the repair instructions above before starting verification again.' : 'Verification is unavailable. Ask your platform administrator to check the payment configuration and account access, then refresh status. Your existing connection is preserved.' %></p>
    <% elsif !@payout_configuration[:embedded_ready] %>
      <p class="dd-form-callout"><%= @payout_configuration[:hosted_ready] ? 'Use Open secure verification to complete your payout setup. Embedded fields are awaiting platform configuration.' : 'Payout setup is awaiting platform configuration. Contact your platform administrator.' %></p>
    <% end %>
    <div class="dd-action-group">
      <% if @payout_status[:state] != 'unavailable' && @payout_configuration[:embedded_ready] %>
        <button type="button" class="dd-button dd-btn-primary" data-payout-open="account-onboarding"><%= current_user.stripe_connect_account_id.present? ? 'Continue payout setup' : 'Set up payouts' %></button>
        <% if current_user.stripe_connect_account_id.present? %><button type="button" class="dd-button" data-payout-open="account-management">Manage account & bank details</button><% end %>
      <% end %>
      <button type="button" class="dd-button" data-payout-refresh>Refresh status</button>
    </div>
    <p data-payout-error role="alert" class="dd-field-error" hidden></p>
    <div data-payout-component aria-label="Secure payout account setup"></div>
    <% if @payout_status[:state] != 'unavailable' && @payout_configuration[:hosted_ready] %>
      <section data-payout-fallback aria-label="Alternative secure verification">
        <p class="dd-form-callout">You can also open secure verification directly. Required financial-service verification and terms are presented there.</p>
        <%= button_to 'Open secure verification', connect_dashboard_susu_payout_account_path, method: :post, class: 'dd-button', form: {data: {turbo: false}} %>
      </section>
    <% end %>
    <noscript><p class="dd-form-callout">Use Open secure verification to continue without embedded fields.</p></noscript>
  </section>
  <% if current_user.role == 'super_admin' && (@payout_status[:state] == 'unavailable' || !@payout_configuration[:embedded_ready]) %>
    <section class="dd-form-section"><h2>Platform administrator checks</h2>
      <p>Confirm that the backend payment credentials belong to the platform that owns this saved payout account and use the intended test or live mode. Restore the correct credentials before replacing a connection that has earned funds.</p>
      <% unless @payout_configuration[:hosted_ready] %><p>Backend payment credentials are missing. Configure the platform payment credentials before starting verification.</p><% end %>
      <% unless @payout_configuration[:embedded_ready] %><p>Embedded fields require a matching browser publishable key from the same platform. Configure the payment credential provider’s publishable key, or set <code>LIGHTEK_PAYOUT_PUBLISHABLE_KEY</code>, then restart the web process. Secure hosted verification can proceed with backend credentials alone.</p><% end %>
      <p>No private key, account number, or identity document should be entered in a support message.</p>
    </section>
  <% end %>
  <section class="dd-form-section"><div class="dd-section-heading"><i class="ti ti-calendar" aria-hidden="true"></i><div><h2>Your earnings schedule</h2><p>Earnings are scheduled for release <%= @payout_schedule.cadence == 'weekly' ? 'every week' : 'every two weeks' %>. Manage your release schedule from your store’s Merchant payouts page. Bank arrival depends on processing, verification, and bank availability.</p></div></div></section>
</main>
