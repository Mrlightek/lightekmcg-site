<% content_for :page_title, 'Stripe access checks' %>
<main class="dd-workspace">
  <header class="dd-page-header"><h1>Stripe access checks</h1></header>
  <p>Verify whether the configured account can read each resource. These checks leave balances and provider records unchanged.</p>
  <%= form_with url: dashboard_commerce_stripe_access_path, local: true, class: 'dd-form-stack' do |form| %>
    <label>Resource<%= form.select :check, options_for_select(@checks.map { |key, name| [name, key] }, @selected_check) %></label>
    <%= form.submit 'Check access', class: 'dd-button dd-btn-primary' %>
  <% end %>
  <% if @result %>
    <p role="status"><strong><%= @checks.fetch(@selected_check) %></strong> · <%= {
      'read_access_verified' => 'Read access verified', 'access_denied' => 'Read access denied',
      'unconfigured' => 'Connection not configured', 'unverified' => 'Could not verify access'
    }.fetch(@result.fetch(:state)) %><% if @result[:mode] %> · <%= @result[:mode].capitalize %> mode<% end %></p>
  <% end %>
  <p>Receiving payments, releasing money, and sending webhook events each require separate acceptance checks.</p>
</main>
