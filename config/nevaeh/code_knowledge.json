        "guides": [
          "docs/studio/cpu-economy.md",
          "docs/studio/shared-cpu-workers.md"
        ]
      },
      "gems": [
        "dymond_dispatch"
      ],
      "capability": {
        "key": "studio.workspace.render.quote",
        "worker": "Studio::Workers::Workspace",
        "action": "render_quote",
        "inputs": {
          "scene_id": "SCENE_ID",
          "output": "movie"
        },
        "result": "Returns an operation ID, a quote and the operation status. A quote does not submit a render."
      }
    },
