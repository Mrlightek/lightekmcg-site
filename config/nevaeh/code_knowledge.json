      "id": "studio.cpu.quote",
      "title": "Quote a Studio CPU render",
      "summary": "Quote a still or movie render for a saved scene. The scene and its installed compute configuration determine render routing.",
      "sources": {
        "entry_points": [
          "public/lightek/studio-app.js",
          "app/controllers/api/nevaeh_controller.rb"
