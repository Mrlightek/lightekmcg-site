{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lightek Studio scene render manifest v1",
  "$comment": "Time is in integer milliseconds. Rotation is XYZ Euler degrees. Blender world X is horizontal, Z is vertical and positive Y recedes from the default camera. Camera and transform keyframes have strictly increasing time_ms. Cue intervals are half-open, ordered, nonoverlapping and bounded by duration_ms. frame_count is ceil(duration_ms * fps / 1000). Cues use rest artwork when their viseme has no image; audio is silent when null. File paths are generated by Rails and relative to the manifest directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "aspect_ratio",
    "fps",
    "duration_ms",
    "width",
    "height",
    "frame_count",
    "camera",
    "layers",
    "audio"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "aspect_ratio": {
      "enum": [
        "9:16",
        "16:9"
      ]
    },
    "fps": {
      "enum": [
        24,
        30
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 30000
    },
    "width": {
      "enum": [
        720,
        1280
      ]
    },
    "height": {
      "enum": [
        720,
        1280
      ]
    },
    "frame_count": {
      "type": "integer",
      "minimum": 24,
      "maximum": 900
    },
    "camera": {
      "$ref": "#/$defs/camera"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      },
      "minItems": 1,
      "maxItems": 24
    },
    "audio": {
      "oneOf": [
        {
          "$ref": "#/$defs/audio"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "aspect_ratio": {
            "const": "9:16"
          }
        }
      },
      "then": {
        "properties": {
          "width": {
            "const": 720
          },
          "height": {
            "const": 1280
          }
        }
      },
      "else": {
        "properties": {
          "width": {
            "const": 1280
          },
          "height": {
            "const": 720
          }
        }
      }
    }
  ],
  "$defs": {
    "vector": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -3600,
        "maximum": 3600
      },
      "minItems": 3,
      "maxItems": 3
    },
    "scale": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.001,
        "maximum": 100
      },
      "minItems": 3,
      "maxItems": 3
    },
    "image": {
      "type": "string",
      "pattern": "^inputs/[1-9][0-9]*\\.(png|webp|svg)$"
    },
    "model": {
      "type": "string",
      "pattern": "^inputs/[1-9][0-9]*\\.(glb|gltf|fbx|blend)$"
    },
    "audio": {
      "type": "string",
      "pattern": "^inputs/[1-9][0-9]*\\.(wav|mp3|m4a|aac|ogg|flac)$"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotation",
        "lens",
        "keyframes"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector"
        },
        "rotation": {
          "$ref": "#/$defs/vector"
        },
        "lens": {
          "type": "number",
          "minimum": 12,
          "maximum": 100
        },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time_ms"
            ],
            "properties": {
              "time_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 29999
              },
              "position": {
                "$ref": "#/$defs/vector"
              },
              "rotation": {
                "$ref": "#/$defs/vector"
              },
              "lens": {
                "type": "number",
                "minimum": 12,
                "maximum": 100
              }
            },
            "minProperties": 2
          },
          "minItems": 0,
          "maxItems": 120
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_ms",
        "end_ms",
        "viseme"
      ],
      "properties": {
        "start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 29999
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "viseme": {
          "enum": [
            "X",
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G",
            "H"
          ]
        }
      }
    },
    "mouth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "scale",
        "variants",
        "cues"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "variants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "X"
          ],
          "properties": {
            "X": {
              "$ref": "#/$defs/image"
            },
            "A": {
              "$ref": "#/$defs/image"
            },
            "B": {
              "$ref": "#/$defs/image"
            },
            "C": {
              "$ref": "#/$defs/image"
            },
            "D": {
              "$ref": "#/$defs/image"
            },
            "E": {
              "$ref": "#/$defs/image"
            },
            "F": {
              "$ref": "#/$defs/image"
            },
            "G": {
              "$ref": "#/$defs/image"
            },
            "H": {
              "$ref": "#/$defs/image"
            }
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          },
          "minItems": 0,
          "maxItems": 600
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "source",
        "dimension_mode",
        "position",
        "rotation",
        "scale",
        "z_layer",
        "keyframes"
      ],
      "properties": {
        "asset_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "$ref": "#/$defs/model"
            }
          ]
        },
        "dimension_mode": {
          "enum": [
            "2d",
            "2_5d",
            "3d"
          ]
        },
        "position": {
          "$ref": "#/$defs/vector"
        },
        "rotation": {
          "$ref": "#/$defs/vector"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "z_layer": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "z_depth": {
          "type": "number",
          "minimum": -5,
          "maximum": 20
        },
        "relief": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "starter": {
          "const": true
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "pose_frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "mouth": {
          "$ref": "#/$defs/mouth"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time_ms"
            ],
            "properties": {
              "time_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 29999
              },
              "position": {
                "$ref": "#/$defs/vector"
              },
              "rotation": {
                "$ref": "#/$defs/vector"
              },
              "scale": {
                "$ref": "#/$defs/scale"
              }
            },
            "minProperties": 2
          },
          "minItems": 0,
          "maxItems": 120
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dimension_mode": {
                "const": "3d"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "$ref": "#/$defs/model"
              },
              "mouth": false,
              "z_depth": false,
              "relief": false
            }
          },
          "else": {
            "properties": {
              "source": {
                "$ref": "#/$defs/image"
              },
              "action": false,
              "pose_frame": false,
              "starter": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "dimension_mode": {
                "const": "2_5d"
              }
            }
          },
          "then": {
            "required": [
              "z_depth",
              "relief"
            ]
          },
          "else": {
            "properties": {
              "z_depth": false,
              "relief": false
            }
          }
        }
      ]
    }
  }
}
