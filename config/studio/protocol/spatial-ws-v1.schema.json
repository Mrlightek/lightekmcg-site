              },
              "required": [
                "num",
                "den"
              ],
              "additionalProperties": false
            },
            "playback_state": {
              "enum": [
                "paused",
                "playing",
                "scrubbing"
              ]
            },
            "evaluate_keyframes": {
              "const": true
