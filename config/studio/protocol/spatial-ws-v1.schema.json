            "mode": {
              "enum": [
                "preview",
                "commit"
              ]
            },
            "space": {
              "const": "WORLD"
            },
            "position": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
