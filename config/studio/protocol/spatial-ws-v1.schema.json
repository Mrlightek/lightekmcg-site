              "minItems": 4,
              "maxItems": 4
            },
            "scale": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000,
                "not": {
                  "minimum": -9.9999e-07,
                  "maximum": 9.9999e-07
                }
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "object_id",
            "mode",
            "space",
            "position",
            "rotation_quaternion",
            "scale"
