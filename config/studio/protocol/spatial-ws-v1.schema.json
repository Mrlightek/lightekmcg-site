{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightekmcg.com/schemas/spatial-ws-v1.json",
  "title": "Lightek Spatial control protocol v1",
  "$defs": {
    "HELLO": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "HELLO"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scene_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object",
          "properties": {
            "ticket": {
              "type": "string",
              "minLength": 20,
              "maxLength": 4096
            },
            "client_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "known_server_epoch": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            }
          },
          "required": [
            "ticket",
            "client_id",
            "known_server_epoch"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "type",
        "session_id",
        "message_id",
        "seq",
        "scene_revision",
        "payload"
      ],
      "additionalProperties": false
    },
    "CAMERA_UPDATE": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "CAMERA_UPDATE"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scene_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object",
          "properties": {
            "camera_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "mode": {
              "enum": [
                "preview",
                "commit"
              ]
            },
            "role": {
              "enum": [
                "viewer",
                "shot"
              ]
            },
            "matrix_order": {
              "const": "column-major"
            },
            "coordinate_space": {
              "const": "BLENDER_Z_UP_METERS"
            },
            "camera_world_matrix": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "minItems": 16,
              "maxItems": 16
            },
            "focal_length_mm": {
              "type": "number",
              "minimum": 2,
              "maximum": 250
            },
            "lens_shift": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "minItems": 2,
              "maxItems": 2
            },
            "activate": {
              "const": true
            }
          },
          "required": [
            "camera_id",
            "mode",
            "role",
            "matrix_order",
            "coordinate_space"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "camera_world_matrix"
              ]
            },
            {
              "required": [
                "focal_length_mm"
              ]
            },
            {
              "required": [
                "lens_shift"
              ]
            },
            {
              "required": [
                "activate"
              ]
            }
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "role": {
                    "const": "viewer"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "then": {
                "properties": {
                  "mode": {
                    "const": "preview"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "v",
        "type",
        "session_id",
        "message_id",
        "seq",
        "scene_revision",
        "payload"
      ],
      "additionalProperties": false
    },
    "TIMELINE_SCRUB": {
