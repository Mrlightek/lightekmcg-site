[Unit]
Description=Lightek Batch D staging TURN relay
After=network-online.target
Wants=network-online.target

[Service]
User=turnserver
Group=turnserver
ExecStart=/usr/bin/turnserver -c /etc/lightek/batch-d/turnserver.conf
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=lightek-batch-d-turn
WorkingDirectory=/var/lib/lightek-batch-d-turn

[Install]
WantedBy=multi-user.target
