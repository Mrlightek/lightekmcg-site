# Use the SAME service secret and root in Rails/Passenger environment.
STUDIO_SPATIAL_ROOT=/var/lib/lightek/spatial
STUDIO_SPATIAL_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
STUDIO_SPATIAL_URL=http://127.0.0.1:8095
STUDIO_SPATIAL_PORT=8095
BLENDER_BIN=blender
SPATIAL_CONTAINER_IMAGE=YOUR_EXISTING_LIGHTEK_BLENDER_IMAGE
# For development with trusted files only: SPATIAL_ALLOW_NATIVE=1
# Start with render to validate deployment. viewport requires a working GPU display.
SPATIAL_BACKEND=render
SPATIAL_RENDER_ENGINE=BLENDER_EEVEE_NEXT
SPATIAL_ENCODER=libx264
SPATIAL_WIDTH=640
SPATIAL_HEIGHT=360
SPATIAL_FPS=60
SPATIAL_MAX_SESSIONS=2
SPATIAL_ORIGINS=["https://YOUR_LIGHTEK_DOMAIN"]
SPATIAL_ICE_SERVERS=[]
SPATIAL_COMMIT_URL=https://YOUR_LIGHTEK_DOMAIN/internal/studio/spatial/commit
# For viewport, configure DISPLAY and access to an isolated GPU-backed Xorg display.
# DISPLAY=:99
# SPATIAL_VIEWPORT_SHADING=RENDERED
