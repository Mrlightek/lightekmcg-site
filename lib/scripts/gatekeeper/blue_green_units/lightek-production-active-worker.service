[Unit]
Description=Start the worker for the active Lightek production release
After=network.target systemd-tmpfiles-setup.service
ConditionPathExists=/var/lib/lightek/blue-green/active.conf

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /var/www/lightekmcg-site/lib/scripts/gatekeeper/blue_green.py start-active-worker
TimeoutStartSec=240
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
